366     AppendLog folder, "setup", "finish", 0, 0, finishText
367     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LastFinish", finishText
368     GoTo Cleanup
Fatal:
    fatalLine = Erl: fatalNumber = Err.Number: fatalDescription = Err.Description: fatalStep = stepLabel
371     finalMessage = fatalStep & " (line " & CStr(fatalLine) & "): " & fatalDescription
372     On Error Resume Next
373     swept = False        ' an error after the sweep (in the zip step) is swept again on the way out
374     If Len(folder) > 0 Then AppendLog folder, currentIdentity, fatalStep, fatalLine, fatalNumber, fatalDescription
375     Resume Cleanup
Cleanup:
377     On Error Resume Next
378     Err.Clear
    ' Every way out of main passes here (done, the error handler, an early exit): the folder is swept once, so an error part way leaves
    ' no unswept text file. The sweep before the zip counts as that once.
381     If Len(folder) > 0 And Not swept Then
382         swept = True
383         sweepNotes = PrivacySweep(folder)
384         If Len(sweepNotes) > 0 Then AppendLog folder, "setup", "privacy sweep", 0, 0, sweepNotes
    End If
386     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
388     If preferenceSet Then app.SetUserPreferenceIntegerValue 78, oldStep
389     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
390     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
392     If actionSaved Then app.SetUserPreferenceIntegerValue swRebuildErrorAction, oldAction
393     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
394     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
396     If warnSaved Then app.SetUserPreferenceToggle swWarnSaveUpdateErrors, oldWarn
397     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
398     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
400     If rebuildSaved Then app.SetUserPreferenceToggle swShowErrorsEveryRebuild, oldRebuild
401     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
402     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
404     If inputSaved Then app.SetUserPreferenceToggle swInputDimValOnCreate, oldInput
405     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
406     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", ""
407     Err.Clear
    ' FIXTURE_UNATTENDED=1: no Explorer window and no message box, only the log line written above.
409     If Len(finalMessage) > 0 Then
410         If Not IsUnattended() Then MsgBox PrivacyScrub(finalMessage)
    ElseIf Len(finishText) > 0 And Not launched And Not IsUnattended() Then
        ' A person is at the screen: show the zip in Explorer (never waits, errors ignored), then the message.
413         If zipMade Then
    stepLabel = currentIdentity & ": main Run"
415             CreateObject("WScript.Shell").Run "explorer.exe /select,""" & folder & ".zip""", 1, False
        Else
    stepLabel = currentIdentity & ": main Run"
418             CreateObject("WScript.Shell").Run "explorer.exe """ & folder & """", 1, False
        End If
