    stepLabel = currentIdentity & ": BuildDrawing GetName2"
8458         viewText = viewText & labels(k) & " " & activeView.GetName2() & " looks along " & Mid$("XYZ", axes(k) + 1, 1)
    Next k
8460     If axes(0) <> 1 Or axes(1) <> 2 Then Err.Raise 5, , "The views look along the wrong axes (" & viewText & "; the L is seen along Y and the hole along Z)"
8461     AppendLog currentFolder, currentIdentity, "option", 0, 0, "drawing: sheet scale 1:1, views " & viewText
8462     ReDim expected(UBound(dims))
