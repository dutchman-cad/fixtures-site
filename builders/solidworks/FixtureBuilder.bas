Private Function CheckedLocalPoint(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal values As Variant, ByVal sketchTransform As Object) As Variant
    ' Round 3 on revision 34.4.0: P09's sketch on the +Y end face built its boss
    ' centered at z = 0 instead of z = 5 (STEP bbox z from -2.5) with no zero
    ' detected, so a partly wrong transformed point gets past the all-zero test.
    ' The matrix path was right for all 28 recovered points, so cross-check
    ' every point against it and trust the matrix when they disagree.
    Dim matrix As Variant, localValues As Variant
6429     CheckedLocalPoint = Array(CDbl(values(0)), CDbl(values(1)), CDbl(values(2)))
6430     matrix = TransformValues(sketchTransform)
6431     If Not MatrixUsable(matrix) Then Exit Function
6432     localValues = MatrixPoint(matrix, x, y, z)
    ' All three coordinates: cvl's revision 31.5.0 W01f center was off the profile plane (sketch z -7.9e-4 m).
6434     If Sqr((localValues(0) - CDbl(values(0))) ^ 2 + (localValues(1) - CDbl(values(1))) ^ 2 + (localValues(2) - CDbl(values(2))) ^ 2) <= 0.000000001 Then Exit Function
6435     RecordMitigation "localpoint-arraydata-mismatch"
6436     AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-arraydata-mismatch model(m)=" & NumberList(Array(x, y, z)) & _
        " plane=" & sketchPlane & " arraydata=" & NumberList(Array(CDbl(values(0)), CDbl(values(1)), CDbl(values(2)))) & _
        " matrix-result=" & NumberList(localValues) & " matrix=" & NumberList(matrix)
6439     CheckedLocalPoint = localValues
End Function

Private Function RecoverLocalPoint(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal sketchTransform As Object) As Variant
    ' Revision 34.4.0 returned (0,0,0) for every transformed sketch point. A
    ' non-zero model point maps to exactly zero only at the sketch origin.
    ' Otherwise use the transform's own matrix, then the exact default-plane
    ' mapping; never draw a face sketch at its origin.
    Dim mapped As Variant, matrix As Variant, localValues As Variant, planar As Boolean, note As String
6448     planar = (sketchPlane = "XY" Or sketchPlane = "XZ" Or sketchPlane = "YZ")
6449     If planar Then
6450         mapped = PlaneMap(x, y, z)
6451         If Abs(mapped(0)) <= 0.000000000001 And Abs(mapped(1)) <= 0.000000000001 Then
6452             RecoverLocalPoint = mapped
6453             Exit Function
        End If
    End If
6456     RecordMitigation "localpoint-zero-detected"
6457     note = "model(m)=" & NumberList(Array(x, y, z)) & " plane=" & sketchPlane
6458     If Not sketchTransform Is Nothing Then matrix = TransformValues(sketchTransform)
6459     If Not matrixLogged Then
6460         If IsArray(matrix) Then
6461             note = note & " matrix=" & NumberList(matrix)
        Else
6463             note = note & " matrix=unavailable"
        End If
6465         matrixLogged = True
    End If
6467     If MatrixUsable(matrix) Then
6468         localValues = MatrixPoint(matrix, x, y, z)
6469         If planar Then
6470             If Sqr((localValues(0) - mapped(0)) ^ 2 + (localValues(1) - mapped(1)) ^ 2) > 0.000000001 Then
6471                 RecordMitigation "localpoint-matrix-mismatch"
6472                 note = note & " matrix-result=" & NumberList(localValues) & " planemap=" & NumberList(mapped)
6473                 localValues = Empty
            End If
        End If
6476         If IsArray(localValues) Then
6477             RecordMitigation "localpoint-matrix"
6478             AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-matrix " & note
6479             RecoverLocalPoint = localValues
6480             Exit Function
        End If
    End If
6483     If planar Then
6484         RecordMitigation "localpoint-planemap"
6485         AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-planemap " & note
6486         RecoverLocalPoint = mapped
6487         Exit Function
    End If
6489     AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-refused " & note
6490     Err.Raise 5, , "Sketch on a model face: SolidWorks returned (0,0,0) sketch coordinates for model point " & _
        NumberList(Array(x, y, z)) & " m and its ModelToSketchTransform matrix is unusable; refusing to draw at the sketch origin"
End Function

