988     If CandidateCount(index) = 0 And crashedUnits.Exists(identity & "|-") Then
989         message = "crashed SolidWorks in " & CStr(crashedUnits(identity & "|-")) & "; skipped"
990         AppendLog folder, identity, "crash guard", 0, 0, "skipped " & identity & ": " & message
991         status = "failed"
    ElseIf CandidateCount(index) = 0 Then
993         AttemptDesign index, folder, True
994         ClearMarker folder
995         status = "ok"
996         files = attemptFiles
997         If Left$(placementReport, 4) = "fail" Then
            ' The files are saved and stay in the zip; the result is not "ok": the answer key says a part is somewhere else.
999             status = "failed"
1000             message = "placement check: " & placementReport
1001             keepFiles = True
        End If
    Else
