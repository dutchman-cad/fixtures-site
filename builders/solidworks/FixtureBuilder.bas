Private Function DragOperatorMove(ByVal component As Object, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double) As String
    ' The first rung of a drag (flexible-move-drag-operator): IAssemblyDoc.GetDragOperator, AddComponent(part, False), collision detection off, DragMode minimum move,
    ' TransformType translation, BeginDrag, Drag(translation) and EndDrag, on the part found through the top assembly (a handle the route found can be the subassembly document's own, which the operator would not move). The text says what every call answered (it goes into the log
    ' and the error); a failure of any call is not raised, the next rung is tried.
    Dim dragOperator As Object, translation As Object, steps As String, began As Boolean, answer As Boolean, second As Boolean, selected As Object, selectionNote As String
3208     Set topHandle = Nothing
3209     topHandleTried = False
3210     On Error GoTo Failed
    stepLabel = currentIdentity & ": DragOperatorMove GetDragOperator"
3212     Set dragOperator = AssemblyDocument(doc).GetDragOperator()
3213     If dragOperator Is Nothing Then
3214         DragOperatorMove = "GetDragOperator returned Nothing"
3215         Exit Function
    End If
    ' Round 23 (field 2026.11.25.1, SolidWorks 2026: AddComponent answered False for the handle found through the top assembly's component tree, the operator did
    ' nothing): the part is selected by its full path and the operator is given the component ISelectionMgr.GetSelectedObjectsComponent4 answers, the part as the
    ' top assembly sees it; the handle used before is the fallback when that one is refused or there is none.
3220     Set selected = SelectedComponent(component, selectionNote)
    stepLabel = currentIdentity & ": DragOperatorMove Name2"
3222     NoteOption "drag handle of " & CStr(component.Name2) & ": " & selectionNote
3223     Set topHandle = selected
3224     topHandleTried = True
3225     If selected Is Nothing Then
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3227         answer = dragOperator.AddComponent(component, False)
3228         steps = "AddComponent returned " & CStr(answer)
    Else
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3231         answer = dragOperator.AddComponent(selected, False)
3232         steps = "AddComponent returned " & CStr(answer)
3233         If Not answer Then
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3235             second = dragOperator.AddComponent(component, False)
3236             steps = "AddComponent returned " & CStr(answer) & " (selected handle) and " & CStr(second) & " (current handle)"
        End If
    End If
3239     On Error Resume Next
    stepLabel = currentIdentity & ": DragOperatorMove CollisionDetectionEnabled"
3241     dragOperator.CollisionDetectionEnabled = False
3242     If Err.Number <> 0 Then
3243         steps = steps & ", CollisionDetectionEnabled raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
    Else
3245         steps = steps & ", CollisionDetectionEnabled = False"
    End If
3247     Err.Clear
3248     On Error GoTo Failed
    stepLabel = currentIdentity & ": DragOperatorMove DragMode"
3250     dragOperator.DragMode = swDragModeMinimumMove
    stepLabel = currentIdentity & ": DragOperatorMove TransformType"
3252     dragOperator.TransformType = swDragTransformTranslation
3253     Set translation = MovedTransform(Array(1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#), shiftX, shiftY, shiftZ)
    stepLabel = currentIdentity & ": DragOperatorMove BeginDrag"
3255     began = dragOperator.BeginDrag()
3256     steps = steps & ", BeginDrag returned " & CStr(began)
3257     If began Then
    stepLabel = currentIdentity & ": DragOperatorMove Drag"
3259         answer = dragOperator.Drag(translation)
3260         steps = steps & ", Drag returned " & CStr(answer)
    stepLabel = currentIdentity & ": DragOperatorMove EndDrag"
3262         dragOperator.EndDrag
3263         steps = steps & ", EndDrag called"
    End If
3265     DragOperatorMove = "IDragOperator: " & steps
3266     Exit Function
Failed:
3268     steps = steps & ", raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
3269     Err.Clear
3270     If began Then
3271         On Error Resume Next
    stepLabel = currentIdentity & ": DragOperatorMove EndDrag"
3273         dragOperator.EndDrag
3274         Err.Clear
3275         On Error GoTo 0
    End If
3277     DragOperatorMove = "IDragOperator: " & steps
End Function

Private Function SelectedComponent(ByVal component As Object, ByRef note As String) As Object
