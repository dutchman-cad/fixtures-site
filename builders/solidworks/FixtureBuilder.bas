Private Function JsonRowValue(ByVal row As String, ByVal key As String) As String
    ' The string value of a top-level key of one results.json row (rows are written by this builder).
    Dim i As Long, depth As Long, c As String, token As String, j As Long, isKey As Boolean
1065     i = 1
1066     Do While i <= Len(row)
1067         c = Mid$(row, i, 1)
1068         If c = "{" Then
1069             depth = depth + 1
        ElseIf c = "}" Then
1071             depth = depth - 1
        ElseIf c = Chr$(34) Then
1073             token = ""
1074             i = i + 1
1075             Do While i <= Len(row)
1076                 c = Mid$(row, i, 1)
1077                 If c = "\" Then
1078                     i = i + 1
1079                     token = token & Mid$(row, i, 1)
                ElseIf c = Chr$(34) Then
1081                     Exit Do
                Else
1083                     token = token & c
                End If
1085                 i = i + 1
            Loop
1087             j = i + 1
1088             Do While j <= Len(row) And Mid$(row, j, 1) = " "
1089                 j = j + 1
            Loop
1091             isKey = (depth = 1 And Mid$(row, j, 1) = ":")
1092             If isKey And token = key Then
1093                 j = j + 1
1094                 Do While j <= Len(row) And Mid$(row, j, 1) = " "
1095                     j = j + 1
                Loop
1097                 If Mid$(row, j, 1) = Chr$(34) Then
1098                     j = j + 1
1099                     Do While j <= Len(row)
1100                         c = Mid$(row, j, 1)
1101                         If c = "\" Then
1102                             j = j + 1
1103                             JsonRowValue = JsonRowValue & Mid$(row, j, 1)
                        ElseIf c = Chr$(34) Then
1105                             Exit Do
                        Else
1107                             JsonRowValue = JsonRowValue & c
                        End If
1109                         j = j + 1
                    Loop
                End If
1112                 Exit Function
            End If
        End If
1115         i = i + 1
    Loop
End Function

