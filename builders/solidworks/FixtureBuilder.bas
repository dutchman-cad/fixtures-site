Private Function ReadBackPart(ByVal entry As Object) As String
    ' Close the part (it is not referenced any more: the assembly is closed), open the file that was saved and read the depths back.
    Dim model As Object, errors As Long, warnings As Long, existing As Variant, item As Variant, configs As Variant, depths As Variant
    Dim names As String, found As Long, count As Long, i As Long, got As Double, report As String, message As String, listed As Boolean
    stepLabel = currentIdentity & ": ReadBackPart CloseDoc"
3919     app.CloseDoc CStr(entry("title"))
    stepLabel = currentIdentity & ": ReadBackPart CloseDoc"
