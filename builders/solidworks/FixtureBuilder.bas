Private Sub SetSheetKFactor(ByVal kFactor As Double, ByVal what As String)
    ' The base flange was built without a K-factor of its own (no allowance object passed, or no Initialize on SolidWorks 2021), so the Sheet-Metal
    ' feature holds the default 0.5. Revision 29 (field 2026.11.24.4): ModifyDefinition with BendAllowanceType and KFactor set on the Sheet-Metal
    ' feature data returned and changed nothing, and nothing was logged. Each try is logged with its returns and read back straight away: (0) those
    ' two members, (b) the ICustomBendAllowance from GetCustomBendAllowance set and put back with SetCustomBendAllowance
    ' (sheetmetal-kfactor-allowance-object), (c) the base flange feature's own definition (baseflange-kfactor-modify). When all fail the error says
    ' which were tried and what each read back.
    Dim tried As String, text As String
7143     If ReadSheetK(kFactor, text) Then
7144         KNote what & ": the Sheet-Metal feature reads " & text & ", wanted K-factor " & NumberList(Array(kFactor))
7145         Exit Sub
    End If
7147     KNote what & ": the Sheet-Metal feature reads " & text & ", wanted K-factor " & NumberList(Array(kFactor))
7148     If ModifySheetK(tried, "members of the Sheet-Metal data", kFactor, False) Then Exit Sub
7149     RecordMitigation "sheetmetal-kfactor-allowance-object", True, True
7150     If ModifySheetK(tried, "sheetmetal-kfactor-allowance-object", kFactor, True) Then
7151         fallbackSuccesses("sheetmetal-kfactor-allowance-object") = fallbackSuccesses("sheetmetal-kfactor-allowance-object") + 1
7152         Exit Sub
    End If
7154     RecordMitigation "baseflange-kfactor-modify", True, True
7155     If ModifyFlangeK(tried, "baseflange-kfactor-modify", kFactor) Then
7156         fallbackSuccesses("baseflange-kfactor-modify") = fallbackSuccesses("baseflange-kfactor-modify") + 1
7157         Exit Sub
    End If
    ' Round 23: the two steps for a revision before 30 (a revision of 30 or more runs the steps it ran before).
7160     If swMajor < BASEFLANGE_INITIALIZE_FROM Then
7161         RecordMitigation "sheetmetal-kfactor-gauge-off", True, True
7162         If ModifySheetGaugeOff(tried, "sheetmetal-kfactor-gauge-off", kFactor) Then
7163             fallbackSuccesses("sheetmetal-kfactor-gauge-off") = fallbackSuccesses("sheetmetal-kfactor-gauge-off") + 1
7164             KNote "sheetmetal-kfactor-gauge-off: the K-factor " & NumberList(Array(kFactor)) & " took with the gauge table off and UseMaterialSheetMetalParameters False; the part is saved with the gauge table off"
7165             Exit Sub
        End If
7167         RecordMitigation "baseflange-kfactor-members-modify", True, True
7168         If ModifyFlangeMembers(tried, "baseflange-kfactor-members-modify", kFactor) Then
7169             fallbackSuccesses("baseflange-kfactor-members-modify") = fallbackSuccesses("baseflange-kfactor-members-modify") + 1
7170             Exit Sub
        End If
    End If
    ' Round 23, kfactor-continue-diagnostic: the recipe is carried on so that one field run reports the next problem too (edge flanges, hems). The part
    ' is never saved and the row stays failed: AttemptDesign raises after the later features, and the handlers put this text in front of that outcome.
7175     RecordMitigation "kfactor-continue-diagnostic", True, True
7176     kFailure = "the K-factor " & NumberList(Array(kFactor)) & " did not take on the Sheet-Metal feature after the " & what & ": " & tried & " (" & callInputs & ")"
7177     KNote "kfactor-continue-diagnostic: " & kFailure & "; the recipe goes on to its later features and is not saved"
End Sub

