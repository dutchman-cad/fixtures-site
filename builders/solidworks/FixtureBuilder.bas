Private Function StepArgs(ByVal body As String) As Variant
    ' The top-level arguments of a STEP entity (a comma inside quotes or parentheses does not split), as an array.
    Dim i As Long, ch As String, depth As Long, quoted As Boolean, current As String, joined As String
1906     i = 1
1907     Do While i <= Len(body)
1908         ch = Mid$(body, i, 1)
1909         If quoted Then
1910             current = current & ch
1911             If ch = "'" Then
1912                 If Mid$(body, i + 1, 1) = "'" Then
1913                     current = current & "'"
1914                     i = i + 1
                Else
1916                     quoted = False
                End If
            End If
        ElseIf ch = "'" Then
1920             quoted = True
1921             current = current & ch
        ElseIf ch = "," And depth = 0 Then
1923             joined = joined & current & Chr$(1)
1924             current = ""
        Else
1926             If ch = "(" Then depth = depth + 1
1927             If ch = ")" Then depth = depth - 1
1928             current = current & ch
        End If
1930         i = i + 1
    Loop
1932     StepArgs = Split(joined & current, Chr$(1))
End Function

