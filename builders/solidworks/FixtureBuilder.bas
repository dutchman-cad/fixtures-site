1789     stream.Charset = "utf-8"
1790     stream.Open
1791     stream.WriteText text
1792     stream.Position = 0
1793     stream.Type = 1
1794     stream.Position = 3
1795     again = stream.Read
1796     stream.Close
1797     same = (UBound(again) = UBound(bytes))
1798     If same Then
1799         For i = 0 To UBound(bytes)
1800             If again(i) <> bytes(i) Then same = False: Exit For
        Next i
    End If
1803     SweepReencodes = same
End Function

Private Function SweepRead(ByVal path As String) As String
    ' The file as text, in the encoding it was written in (left in sweepEncoding): UTF-16 or UTF-8 with a byte-order mark, UTF-8 without
    ' one, else the ANSI codepage the builder's own log is written in. A file over 4 MB, NUL bytes without a UTF-16 mark, or any decode
    ' error raises: the caller counts that as a hit (truncate or delete), never as clean.
    Dim stream As Object, bytes As Variant, size As Long, text As String, i As Long, channel As Integer
1811     Set stream = CreateObject("ADODB.Stream")
1812     stream.Type = 1
1813     stream.Open
1814     stream.LoadFromFile path
1815     size = stream.Size
1816     If size > 4194304 Then Err.Raise 5, , "over the sweep size cap"
1817     If size = 0 Then
1818         stream.Close
1819         sweepEncoding = "utf-8"
1820         SweepRead = ""
1821         Exit Function
    End If
1823     bytes = stream.Read
1824     stream.Close
1825     If size >= 2 And bytes(0) = 255 And bytes(1) = 254 Then
1826         sweepEncoding = "utf-16-le-bom"
1827         SweepRead = SweepText(path, "unicode")
1828         Exit Function
    End If
1830     If size >= 2 And bytes(0) = 254 And bytes(1) = 255 Then
1831         sweepEncoding = "utf-16-be-bom"
1832         SweepRead = SweepText(path, "unicodeFFFE")
1833         Exit Function
    End If
1835     If size >= 3 Then
1836         If bytes(0) = 239 And bytes(1) = 187 And bytes(2) = 191 Then
1837             sweepEncoding = "utf-8-bom"
1838             SweepRead = SweepText(path, "utf-8")
1839             Exit Function
        End If
    End If
1842     For i = 0 To UBound(bytes)
1843         If bytes(i) = 0 Then Err.Raise 5, , "NUL bytes without a UTF-16 byte-order mark"
    Next i
1845     text = SweepText(path, "utf-8")
1846     If SweepReencodes(text, bytes) Then
1847         sweepEncoding = "utf-8"
1848         SweepRead = text
1849         Exit Function
    End If
1851     sweepEncoding = "ansi"
1852     channel = FreeFile
1853     Open path For Binary Access Read As #channel
1854     text = Space$(LOF(channel))
1855     Get #channel, , text
1856     Close #channel
1857     SweepRead = text
End Function

Private Sub SweepWrite(ByVal path As String, ByVal text As String)
    ' Back in the encoding SweepRead found (never a different one).
    Dim stream As Object, channel As Integer, fs As Object
1863     Select Case sweepEncoding
        Case "utf-8"
1865             WriteUtf8 path, text
        Case "utf-8-bom", "utf-16-le-bom", "utf-16-be-bom"
1867             Set stream = CreateObject("ADODB.Stream")
1868             stream.Type = 2
1869             If sweepEncoding = "utf-16-le-bom" Then
1870                 stream.Charset = "unicode"
            ElseIf sweepEncoding = "utf-16-be-bom" Then
1872                 stream.Charset = "unicodeFFFE"
            Else
1874                 stream.Charset = "utf-8"
            End If
1876             stream.Open
1877             stream.WriteText text
1878             stream.SaveToFile path, 2
1879             stream.Close
        Case Else
1881             Set fs = CreateObject("Scripting.FileSystemObject")
1882             If fs.FileExists(path) Then fs.DeleteFile path, True
1883             channel = FreeFile
1884             Open path For Binary Access Write As #channel
1885             Put #channel, , text
1886             Close #channel
    End Select
End Sub

