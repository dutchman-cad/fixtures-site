Private Function CheckedLocalPoint(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal values As Variant, ByVal sketchTransform As Object) As Variant
    ' Round 3 on revision 34.4.0: P09's sketch on the +Y end face built its boss
    ' centered at z = 0 instead of z = 5 (STEP bbox z from -2.5) with no zero
    ' detected, so a partly wrong transformed point gets past the all-zero test.
    ' The matrix path was right for all 28 recovered points, so cross-check
    ' every point against it and trust the matrix when they disagree.
    Dim matrix As Variant, localValues As Variant
6381     CheckedLocalPoint = Array(CDbl(values(0)), CDbl(values(1)), CDbl(values(2)))
6382     matrix = TransformValues(sketchTransform)
6383     If Not MatrixUsable(matrix) Then Exit Function
6384     localValues = MatrixPoint(matrix, x, y, z)
    ' All three coordinates: cvl's revision 31.5.0 W01f center was off the profile plane (sketch z -7.9e-4 m).
6386     If Sqr((localValues(0) - CDbl(values(0))) ^ 2 + (localValues(1) - CDbl(values(1))) ^ 2 + (localValues(2) - CDbl(values(2))) ^ 2) <= 0.000000001 Then Exit Function
6387     RecordMitigation "localpoint-arraydata-mismatch"
6388     AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-arraydata-mismatch model(m)=" & NumberList(Array(x, y, z)) & _
        " plane=" & sketchPlane & " arraydata=" & NumberList(Array(CDbl(values(0)), CDbl(values(1)), CDbl(values(2)))) & _
        " matrix-result=" & NumberList(localValues) & " matrix=" & NumberList(matrix)
6391     CheckedLocalPoint = localValues
End Function

Private Function RecoverLocalPoint(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal sketchTransform As Object) As Variant
    ' Revision 34.4.0 returned (0,0,0) for every transformed sketch point. A
    ' non-zero model point maps to exactly zero only at the sketch origin.
    ' Otherwise use the transform's own matrix, then the exact default-plane
    ' mapping; never draw a face sketch at its origin.
    Dim mapped As Variant, matrix As Variant, localValues As Variant, planar As Boolean, note As String
6400     planar = (sketchPlane = "XY" Or sketchPlane = "XZ" Or sketchPlane = "YZ")
6401     If planar Then
6402         mapped = PlaneMap(x, y, z)
6403         If Abs(mapped(0)) <= 0.000000000001 And Abs(mapped(1)) <= 0.000000000001 Then
6404             RecoverLocalPoint = mapped
6405             Exit Function
        End If
    End If
6408     RecordMitigation "localpoint-zero-detected"
6409     note = "model(m)=" & NumberList(Array(x, y, z)) & " plane=" & sketchPlane
6410     If Not sketchTransform Is Nothing Then matrix = TransformValues(sketchTransform)
6411     If Not matrixLogged Then
6412         If IsArray(matrix) Then
6413             note = note & " matrix=" & NumberList(matrix)
        Else
6415             note = note & " matrix=unavailable"
        End If
6417         matrixLogged = True
    End If
6419     If MatrixUsable(matrix) Then
6420         localValues = MatrixPoint(matrix, x, y, z)
6421         If planar Then
6422             If Sqr((localValues(0) - mapped(0)) ^ 2 + (localValues(1) - mapped(1)) ^ 2) > 0.000000001 Then
6423                 RecordMitigation "localpoint-matrix-mismatch"
6424                 note = note & " matrix-result=" & NumberList(localValues) & " planemap=" & NumberList(mapped)
6425                 localValues = Empty
            End If
        End If
6428         If IsArray(localValues) Then
6429             RecordMitigation "localpoint-matrix"
6430             AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-matrix " & note
6431             RecoverLocalPoint = localValues
6432             Exit Function
        End If
    End If
6435     If planar Then
6436         RecordMitigation "localpoint-planemap"
6437         AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-planemap " & note
6438         RecoverLocalPoint = mapped
6439         Exit Function
    End If
6441     AppendLog currentFolder, currentIdentity, "LocalPoint", 0, 0, "localpoint-refused " & note
6442     Err.Raise 5, , "Sketch on a model face: SolidWorks returned (0,0,0) sketch coordinates for model point " & _
        NumberList(Array(x, y, z)) & " m and its ModelToSketchTransform matrix is unusable; refusing to draw at the sketch origin"
End Function

