Private Function PlanDiameter(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant, ByVal length As Double) As Object
    ' A circle seen face-on whose diameter the two points are the ends of: selecting it alone makes IModelDoc2.AddDimension2 add a diameter dimension.
    Dim record As Object, centre As Variant
8441     For Each record In records
8442         If record("kind") = "circle" Then
8443             If record("faceOn") = 1 Then
8444                 centre = record("a")
8445                 If Abs(2# * CDbl(record("radius")) - length) <= 0.000001 And Abs(CDbl(centre(0)) - (first(0) + second(0)) / 2#) <= 0.000001 _
                   And Abs(CDbl(centre(1)) - (first(1) + second(1)) / 2#) <= 0.000001 Then
8447                     Set PlanDiameter = CloneRecord(record, "drawing-dimension-circle-diameter")
8448                     Exit Function
                End If
            End If
        End If
    Next record
End Function

Private Function PlanLine(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A line through the point that is perpendicular to the measuring direction.
    Dim record As Object, a As Variant, b As Variant, runX As Double, runY As Double, size As Double, along As Double, off As Double
8458     For Each record In records
8459         If record("kind") = "line" Then
8460             a = record("a")
8461             b = record("b")
8462             runX = b(0) - a(0)
8463             runY = b(1) - a(1)
8464             size = Sqr(runX * runX + runY * runY)
8465             If size > 0.000000001 Then
8466                 If Abs(runX * ux + runY * uy) <= 0.000001 * size Then
8467                     along = ((point(0) - a(0)) * runX + (point(1) - a(1)) * runY) / (size * size)
8468                     off = Abs((point(0) - a(0)) * runY - (point(1) - a(1)) * runX) / size
8469                     If along >= -0.000000001 And along <= 1.000000001 And off <= 0.000001 Then
8470                         Set PlanLine = record
8471                         Exit Function
                    End If
                End If
            End If
        End If
    Next record
End Function

Private Function PlanReference(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle centered on the point, else a line through it that is perpendicular to the measuring direction (D05a's own choice, tried first).
    Dim record As Object
8482     For Each record In records
8483         If record("kind") = "circle" Then
8484             If NearFlat(record("a"), point) Then
8485                 Set PlanReference = record
8486                 Exit Function
            End If
        End If
    Next record
8490     Set PlanReference = PlanLine(records, point, ux, uy)
End Function

Private Function PlanRim(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle seen edge-on (its axis known to lie across the view) is the straight line through its center, 2 x radius long, perpendicular to its axis: it
    ' is a reference when the point is on that line and the measuring direction is the axis's own.
    Dim record As Object, axisFlat As Variant, centre As Variant, runX As Double, runY As Double
8497     For Each record In records
8498         If record("kind") = "circle" Then
8499             If record("faceOn") = 0 Then
8500                 centre = record("a")
8501                 axisFlat = record("flatAxis")
8502                 runX = point(0) - centre(0)
8503                 runY = point(1) - centre(1)
8504                 If Abs(-axisFlat(1) * ux + axisFlat(0) * uy) <= 0.000001 And Abs(runX * axisFlat(0) + runY * axisFlat(1)) <= 0.000001 _
                   And Abs(-runX * axisFlat(1) + runY * axisFlat(0)) <= CDbl(record("radius")) + 0.000000001 Then
8506                     Set PlanRim = CloneRecord(record, "drawing-dimension-edge-on-circles")
8507                     Exit Function
                End If
            End If
        End If
    Next record
End Function

Private Function DimensionPlan(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Collection
    ' The one or two edges whose selection makes SolidWorks measure the distance between two flattened points, or Nothing when the view cannot show
    ' it. D05a's own plan (a line, or two references) is tried first; the diameter and edge-on forms only when it finds nothing.
    Dim lineRecord As Object, one As Object, two As Object, dx As Double, dy As Double, length As Double
8518     dx = second(0) - first(0)
8519     dy = second(1) - first(1)
8520     length = Sqr(dx * dx + dy * dy)
8521     If length < 0.000000001 Then Err.Raise 5, , "The two dimension points coincide in the view"
8522     Set lineRecord = PlanSingle(records, first, second)
8523     If Not lineRecord Is Nothing Then
8524         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8526         DimensionPlan.Add lineRecord
8527         Exit Function
    End If
8529     Set one = PlanReference(records, first, dx / length, dy / length)
8530     Set two = PlanReference(records, second, dx / length, dy / length)
8531     If Not one Is Nothing And Not two Is Nothing Then
8532         If Not one Is two Then
8533             Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8535             DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8537             DimensionPlan.Add two
8538             Exit Function
        End If
    End If
8541     Set lineRecord = PlanDiameter(records, first, second, length)
8542     If Not lineRecord Is Nothing Then
8543         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8545         DimensionPlan.Add lineRecord
8546         Exit Function
    End If
8548     Set one = PlanRim(records, first, dx / length, dy / length)
8549     Set two = PlanRim(records, second, dx / length, dy / length)
8550     If one Is Nothing And two Is Nothing Then Exit Function
8551     If one Is Nothing Then Set one = PlanReference(records, first, dx / length, dy / length)
8552     If two Is Nothing Then Set two = PlanReference(records, second, dx / length, dy / length)
8553     If one Is Nothing Or two Is Nothing Then Exit Function
8554     If one("entity") Is two("entity") Then Exit Function
8555     Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8557     DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8559     DimensionPlan.Add two
End Function

