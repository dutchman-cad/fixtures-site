Private Function ZipPowerShell(ByVal folder As String, ByVal errorFile As String) As Boolean
    ' Compress-Archive; a failure is written to errorFile (ASCII) and exits 1. True only if the exit code is 0, the zip exists and holds something,
    ' and no error file was written. The old zip and error file are deleted first.
    Dim command As String, quotedFolder As String, quotedZip As String, quotedError As String, code As Long, fs As Object
788     ZipRemoveOld folder
789     quotedFolder = Replace(folder, "'", "''")
790     quotedZip = Replace(folder & ".zip", "'", "''")
791     quotedError = Replace(errorFile, "'", "''")
792     command = "powershell.exe -NoProfile -NonInteractive -Command " & Chr$(34) & _
        "try { Compress-Archive -LiteralPath '" & quotedFolder & "' -DestinationPath '" & quotedZip & "' -Force -ErrorAction Stop } " & _
        "catch { $_ | Out-File -LiteralPath '" & quotedError & "' -Encoding ASCII; exit 1 }" & Chr$(34)
    stepLabel = currentIdentity & ": ZipPowerShell Run"
796     code = CreateObject("WScript.Shell").Run(command, 0, True)
797     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipPowerShell FileExists"
799     ZipPowerShell = (code = 0) And ZipReady(folder & ".zip") And Not fs.FileExists(errorFile)
End Function

Private Function ZipWithShell(ByVal folder As String) As Boolean
    ' In-process zip: an empty zip file, then Shell.Application copies the folder into it. The copy is asynchronous: wait until the
    ' folder's items are all inside, the zip stops growing, or about 120 seconds pass.
    Dim fs As Object, stream As Object, shellObject As Object, zipSpace As Object, parentSpace As Object, innerSpace As Object
    Dim zipPath As String, wanted As Long, started As Date, size As Double, lastSize As Double, steady As Long, pause As Double, complete As Boolean
807     On Error GoTo Failed
808     zipPath = folder & ".zip"
809     Set fs = CreateObject("Scripting.FileSystemObject")
810     ZipRemoveOld folder
    stepLabel = currentIdentity & ": ZipWithShell CreateTextFile" & " " & apiInputs & " " & callInputs
812     Set stream = fs.CreateTextFile(zipPath, True)
    stepLabel = currentIdentity & ": ZipWithShell Write"
814     stream.Write "PK" & Chr(5) & Chr(6) & String(18, 0)
    stepLabel = currentIdentity & ": ZipWithShell Close"
816     stream.Close
817     Set shellObject = CreateObject("Shell.Application")
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
819     Set parentSpace = shellObject.Namespace(CVar(fs.GetParentFolderName(folder)))
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
821     wanted = shellObject.Namespace(CVar(folder)).Items.Count
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
823     Set zipSpace = shellObject.Namespace(CVar(zipPath))
    stepLabel = currentIdentity & ": ZipWithShell CopyHere"
825     zipSpace.CopyHere parentSpace.ParseName(fs.GetFileName(folder))
826     started = Now
827     lastSize = -1
828     Do While DateDiff("s", started, Now) < 120
829         pause = Timer + 0.25
830         Do While Timer >= pause - 0.25 And Timer < pause
831             DoEvents
        Loop
833         size = 0
    stepLabel = currentIdentity & ": ZipWithShell FileExists"
835         If fs.FileExists(zipPath) Then size = fs.GetFile(zipPath).Size
    stepLabel = currentIdentity & ": ZipWithShell Count"
837         If zipSpace.Items.Count >= 1 Then
    stepLabel = currentIdentity & ": ZipWithShell Item"
839             Set innerSpace = zipSpace.Items.Item(0).GetFolder
840             If Not innerSpace Is Nothing Then
    stepLabel = currentIdentity & ": ZipWithShell Count"
842                 If innerSpace.Items.Count >= wanted And size > 22 Then
843                     If size = lastSize Then steady = steady + 1 Else steady = 0
844                     If steady >= 8 Then
845                         complete = True
846                         Exit Do
                    End If
                End If
            End If
        End If
851         lastSize = size
    Loop
    ' Only if every item arrived and the zip stopped growing; a timeout part way is not a zip.
854     ZipWithShell = complete And ZipReady(zipPath)
855     Exit Function
Failed:
857     ZipWithShell = False
End Function

Private Function ZipMitigationLine() As String
    ' A `mitigations:` line of the zip step alone (the recipes' lines are written before the zip).
    Dim itemName As Variant, text As String
863     For Each itemName In Array("zip-verify-retry", "zip-shell-application")
    stepLabel = currentIdentity & ": ZipMitigationLine Exists"
865         If mitigations.Exists(CStr(itemName)) Then
866             If Len(text) > 0 Then text = text & " "
867             text = text & CStr(itemName) & "=" & CStr(mitigations(itemName)) & ",primary-failed=" & CStr(primaryFailures(itemName)) & ",fallback-ok=" & CStr(fallbackSuccesses(itemName))
        End If
    Next itemName
870     ZipMitigationLine = "mitigations: " & text
End Function

Private Function MakeZip(ByVal folder As String) As Boolean
    ' folder & ".zip" for the run. Compress-Archive is checked by looking for the file and the error file, not by its exit code alone (field
    ' 2026.11.24.3: exit code 0 and no zip). An old zip or error file is deleted first and before every attempt. Then: all documents closed and a
    ' second Compress-Archive with its error text kept (zip-verify-retry), then a zip written in-process (zip-shell-application). Never raises: the
    ' finish message tells the person what to do by hand. The mitigations are logged in a line of their own.
    Dim zipPath As String, errorFile As String
879     zipPath = folder & ".zip"
880     errorFile = folder & "-zip-error.txt"
881     On Error Resume Next
882     ZipRemoveOld folder
883     If ZipPowerShell(folder, errorFile) Then MakeZip = True: Exit Function
884     Err.Clear
885     AppendLog folder, "setup", "zip", 0, 0, "zip: no zip was written; " & ZipErrorHead(errorFile)
886     RecordMitigation "zip-verify-retry", True, True
    stepLabel = currentIdentity & ": MakeZip CloseAllDocuments"
888     app.CloseAllDocuments True
889     Err.Clear
890     If ZipPowerShell(folder, errorFile) Then
891         fallbackSuccesses("zip-verify-retry") = fallbackSuccesses("zip-verify-retry") + 1
892         AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: the second Compress-Archive wrote the zip"
893         AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
894         MakeZip = True: Exit Function
    End If
896     Err.Clear
897     AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: still no zip; " & ZipErrorHead(errorFile)
898     RecordMitigation "zip-shell-application", True, True
899     If ZipWithShell(folder) Then
900         fallbackSuccesses("zip-shell-application") = fallbackSuccesses("zip-shell-application") + 1
901         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: Shell.Application wrote the zip"
902         MakeZip = True
    Else
904         Err.Clear
905         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: no zip either; the folder is complete, the person zips it by hand"
    End If
907     AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
End Function

Private Sub RunDesign(ByVal index As Long, ByVal folder As String, ByVal version As String, ByVal build As String, ByVal major As Long)
    Dim identity As String, status As String, message As String, files As String
    Dim started As Double, elapsed As Double
    Dim fs As Object, title As Variant
    Dim resultRow As String, priorRows As String
    Dim failureLine As Long, failureNumber As Long, failureDescription As String, failureStep As String
916     On Error GoTo Failed
917     Set doc = Nothing
918     Set loadedDocs = Nothing
919     probesJson = "": probeKept = "": probeCandidate = "": probeNote = "": attemptFiles = "[]"
920     attemptErrorsSaved = False
