4888             Err.Raise raisedNumber, , raisedText
        End If
4890         problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, Array(wanted(0), wanted(1), wanted(2)), Not newPart, IIf(newPart, "new part " & partFile & ".sldprt", "mirror orientation " & CStr(orientationList(orientLower + number))))
4891         If Len(problem) = 0 Then
4892             If number > 0 Then fallbackSuccesses("mirror-orientation-next") = fallbackSuccesses("mirror-orientation-next") + 1
4893             Exit For
        End If
4895         If newPart Then Err.Raise 5, , "The new mirrored part " & partFile & ".sldprt does not have the rounded corner at its mirror image about " & normal & " = " & NoteNumber(offset * 1000#) & " mm: " & problem
    Next number
4897     If Len(problem) > 0 Then
4898         Set madeComponent = MirrorLadder(plane, sourceComponent, path, before, corner, Array(wanted(0), wanted(1), wanted(2)), axisIndex, offset, orientationList, treeBefore, problem, ladderText)
