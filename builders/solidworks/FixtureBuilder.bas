3672         errors = 0
    stepLabel = currentIdentity & ": TemporaryMateMove AddMate5"
3674         Set mate = AssemblyDocument(doc).AddMate5(swMateCONCENTRIC, alignNow, False, 0#, 0#, 0#, 1#, 1#, 0#, 0#, 0#, False, False, 0, errors)
3675         tried = tried & IIf(Len(tried) > 0, ", ", "") & "Align " & CStr(alignNow) & " answered error " & CStr(errors)
3676         If errors = swAddMateError_NoError And Not mate Is Nothing Then Exit For
    Next j
