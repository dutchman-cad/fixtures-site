1298     Do
1299         changed = False
1300         For i = 0 To 170 - 1
    stepLabel = currentIdentity & ": ResolveSkips Exists"
1302             If Not skipBuilt.Exists(DesignId(i)) And Len(DependencyIds(i)) > 0 Then
1303                 parts = Split(DependencyIds(i), ",")
