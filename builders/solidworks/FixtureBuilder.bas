3641     Require face, "The part has no cylindrical face"
    stepLabel = currentIdentity & ": TemporaryMateMove CylinderParams"
3643     params = face.GetSurface().CylinderParams
    stepLabel = currentIdentity & ": TemporaryMateMove GetTotalTransform"
3645     totalValues = component.GetTotalTransform(True).ArrayData
3646     For j = 0 To 2
3647         heading(j) = 0#
3648         there(j) = CDbl(totalValues(9 + j))
3649         For k = 0 To 2
3650             heading(j) = heading(j) + CDbl(params(3 + k)) * CDbl(totalValues(3 * k + j))
3651             there(j) = there(j) + CDbl(params(k)) * CDbl(totalValues(3 * k + j))
        Next k
    Next j
3654     size = Sqr(heading(0) ^ 2 + heading(1) ^ 2 + heading(2) ^ 2)
