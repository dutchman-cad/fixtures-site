Private Function EscapeRegex(ByVal text As String) As String
    Dim i As Long, ch As String, result As String
631     For i = 1 To Len(text)
632         ch = Mid$(text, i, 1)
633         If InStr("\.+*?^$()[]{}|-", ch) > 0 Then result = result & "\"
634         result = result & ch
    Next i
636     EscapeRegex = result
End Function

Private Function RootPattern(ByVal root As String) As String
    ' A folder path as a pattern that also matches its doubled-backslash (JSON) and forward-slash forms.
641     RootPattern = Replace(EscapeRegex(root), "\\", "[\\/]+")
End Function

Private Function CaseForms(ByVal word As String) As String
    ' The word as written, lower-cased and upper-cased, as one escaped alternation: VBScript's RegExp folds the case of ASCII letters only, so a
    ' Cyrillic or Greek name written in another case would be missed. LCase$ and UCase$ are Unicode-aware.
647     CaseForms = "(?:" & EscapeRegex(word) & "|" & EscapeRegex(LCase$(word)) & "|" & EscapeRegex(UCase$(word)) & ")"
End Function

Private Function ScrubNeedle(ByVal regex As Object, ByVal text As String, ByVal needle As String, ByVal marker As String) As String
    ' A word-matched needle wherever no ASCII letter or digit is next to it (start of text, tab, quote ...); any other only as a whole folder name.
    Dim result As String
653     result = text
654     If Len(needle) > 0 Then
655         If NameInsideComponents(LCase$(needle)) Then
656             regex.Pattern = "(^|[^A-Za-z0-9])" & CaseForms(needle) & "(?=[^A-Za-z0-9]|$)"
657             result = regex.Replace(result, "$1" & marker)
        Else
659             regex.Pattern = "([\\/])" & CaseForms(needle) & "(?=[.,;)]*(?:[\\/\s""'<>|:*?]|$))"
660             result = regex.Replace(result, "$1" & marker)
        End If
    End If
663     ScrubNeedle = result
End Function

Private Function PrivacyScrub(ByVal text As String) As String
    ' Every message a volunteer might screenshot, every log line and every text file in the output goes through this. In order: the tail
    ' of any path under \Users\<x> (x is not Public; a name with a space, an 8.3 name, a Dropbox (Company) folder: all of it, up to a
    ' quote, a line end, a tab or the sentence end) becomes <user>\<path>; the profile, OneDrive and Documents folders likewise; the
    ' Windows user name and the profile folder's own name (anywhere when guarded, else only as a whole folder name) become <user>; the
    ' computer, domain and logon server names (whole tokens, guarded) become <host>; a \\server\share prefix becomes <share>.
    Dim regex As Object, result As String, roots(0 To 4) As String, names(0 To 1) As String, machines(0 To 2) As String
    Dim k As Long, tailEnd As String, swap As String, exempt As String
674     tailEnd = "(?=[.,;)]*(?:[""'\r\n<>|]|$))"
675     exempt = "(?!(?:public|default|all users|shared)(?:[\\/""'\r\n<>|]|$))"
676     result = text
677     Set regex = CreateObject("VBScript.RegExp")
678     regex.Global = True
679     regex.IgnoreCase = True
680     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
681     result = regex.Replace(result, "$1<user>$2<path>")
682     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?" & tailEnd
683     result = regex.Replace(result, "$1<user>")
684     roots(0) = EnvText("USERPROFILE")
685     roots(1) = EnvText("OneDrive")
686     roots(2) = EnvText("OneDriveCommercial")
687     roots(3) = EnvText("MYDOCUMENTS")
688     roots(4) = EnvText("OneDriveConsumer")
689     For k = 0 To 4
690         If Len(roots(k)) > 0 Then
691             regex.Pattern = RootPattern(roots(k)) & "((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
692             result = regex.Replace(result, "<user>$1<path>")
693             regex.Pattern = RootPattern(roots(k))
694             result = regex.Replace(result, "<user>")
        End If
    Next k
697     names(0) = EnvText("USERNAME")
698     names(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
    ' The longer of the two first (jsmith.ACME before jsmith), so no part of the profile folder's name is left behind.
700     If Len(names(1)) > Len(names(0)) Then
701         swap = names(0)
702         names(0) = names(1)
703         names(1) = swap
    End If
705     machines(0) = EnvText("COMPUTERNAME")
706     machines(1) = EnvText("USERDOMAIN")
707     machines(2) = Replace(EnvText("LOGONSERVER"), "\", "")
708     For k = 0 To 1
709         result = ScrubNeedle(regex, result, names(k), "<user>")
    Next k
711     For k = 0 To 2
712         result = ScrubNeedle(regex, result, machines(k), "<host>")
    Next k
714     regex.Pattern = "(^|[^\\/\w:])(?:\\\\|//){1,2}[^\\/\s""'<>|:*?]+(?:\\\\|[\\/](?![""']))+(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
715     result = regex.Replace(result, "$1<share>")
716     PrivacyScrub = result
End Function


Private Function EmptiedLine() As String
    ' "" unless the sweep had to empty or delete a text file it could not clean: then the volunteer is told the zip is incomplete.
722     If sweepEmptiedCount > 0 Then EmptiedLine = vbLf & CStr(sweepEmptiedCount) & " file(s) could not be cleaned and were emptied: " & sweepEmptied
End Function

Private Function FinishMessage(ByVal total As Long, ByVal built As Long, ByVal failed As Long, ByVal notScripted As Long, ByVal alreadyBuilt As Long, ByVal zipPath As String, ByVal zipMade As Boolean, ByVal folder As String) As String
    Dim noun As String, earlier As String, counts As String
727     noun = "recipes"
