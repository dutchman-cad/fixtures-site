Private Sub BuildDrawing(ByVal modelId As String, ByVal low As Variant, ByVal high As Variant, ByVal dims As Variant, ByVal layout As Variant)
    ' D05a: sheet 1:1, base view, two projected views, each linear dimension on the view edges its model
    ' points project to, then a read-back of every dimension in the drawing. layout: the three view
    ' positions (x, y pairs) and the dimension text step, meters.
