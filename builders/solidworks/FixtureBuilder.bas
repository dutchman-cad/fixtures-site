    Next item
5976     If count <> 2 Or found <> 2 Then Err.Raise 5, , "Saved file has configurations " & names & ", expected " & CStr(entry("master")) & " and " & CStr(entry("name"))
    stepLabel = currentIdentity & ": ReadBackConfiguration ConfigurationManager"
