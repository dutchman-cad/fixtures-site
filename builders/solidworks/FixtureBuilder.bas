Private Sub VerifyProfilePlane()
    ' The sketch plane must contain the helix start and be perpendicular to the helix there (1e-6 m, 1e-4 rad), by the sketch's own
    ' ModelToSketchTransform: the sketch z of the start is 0 and the sketch normal (column 3 of the rotation) is the helix tangent.
    Dim matrix As Variant, localValues As Variant, first As Long, dotValue As Double, angle As Double, farValues As Variant, farAngle As Double, i As Long, originValues As Variant
10009     If Not helixStartKnown Then Exit Sub
    stepLabel = currentIdentity & ": VerifyProfilePlane ModelToSketchTransform"
10011     matrix = TransformValues(doc.SketchManager.ActiveSketch.ModelToSketchTransform)
10012     If Not MatrixUsable(matrix) Then Err.Raise 5, , "The profile plane transform is unusable, so the plane could not be checked against the helix start"
10013     localValues = MatrixPoint(matrix, helixStart(0), helixStart(1), helixStart(2))
10014     first = LBound(matrix)
10015     dotValue = Abs(CDbl(matrix(first + 2)) * helixTangent(0) + CDbl(matrix(first + 5)) * helixTangent(1) + CDbl(matrix(first + 8)) * helixTangent(2))
10016     If dotValue > 1# Then dotValue = 1#
10017     If dotValue < 0.000000000001 Then
10018         angle = 1.5707963267949
    Else
10020         angle = Atn(Sqr(1# - dotValue * dotValue) / dotValue)
    End If
10022     AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "helix start in the sketch (m) = " & NumberList(Array(CDbl(localValues(0)), CDbl(localValues(1)), CDbl(localValues(2)))) & _
        "; the plane normal is " & NumberList(Array(angle)) & " rad off the helix tangent"
10024     originValues = MatrixInversePoint(matrix, 0#, 0#, 0#)
10025     diagPlaneText = NoteList(Array(CDbl(originValues(0)) * 1000#, CDbl(originValues(1)) * 1000#, CDbl(originValues(2)) * 1000#)) & " n=" & NoteList(Array(CDbl(matrix(first + 2)), CDbl(matrix(first + 5)), CDbl(matrix(first + 8)))) & " a=" & NoteNumber(angle * 57.2957795130823)
10026     NoteProbe
10027     If Abs(CDbl(localValues(2))) > 0.000001 And helixEndKnown Then
        ' Round 11 (field, W01a/c/d/e/g): the plane went through the curve END (SolidWorks picked the far vertex). A whole number of turns has the
        ' same tangent there, so the plane is still a valid profile plane: put the circle where the plane is, and sweep from there.
10030         farValues = MatrixPoint(matrix, helixEnd(0), helixEnd(1), helixEnd(2))
10031         dotValue = Abs(CDbl(matrix(first + 2)) * helixEndTangent(0) + CDbl(matrix(first + 5)) * helixEndTangent(1) + CDbl(matrix(first + 8)) * helixEndTangent(2))
10032         If dotValue > 1# Then dotValue = 1#
10033         If dotValue < 0.000000000001 Then
10034             farAngle = 1.5707963267949
        Else
10036             farAngle = Atn(Sqr(1# - dotValue * dotValue) / dotValue)
        End If
10038         AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "helix END in the sketch (m) = " & NumberList(Array(CDbl(farValues(0)), CDbl(farValues(1)), CDbl(farValues(2)))) & _
            "; the plane normal is " & NumberList(Array(farAngle)) & " rad off the tangent there"
10040         If Abs(CDbl(farValues(2))) <= 0.000001 Then
10041             RecordMitigation "profile-plane-through-curve-end", True, True
10042             fallbackSuccesses("profile-plane-through-curve-end") = fallbackSuccesses("profile-plane-through-curve-end") + 1
10043             For i = 0 To 2
10044                 helixStart(i) = helixEnd(i)
10045                 helixTangent(i) = helixEndTangent(i)
            Next i
10047             localValues = farValues
10048             angle = farAngle
10049             AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "the plane passes through the curve END, so the profile circle goes there"
        End If
    End If
10052     If Abs(CDbl(localValues(2))) > 0.000001 Then Err.Raise 5, , "The profile plane does not contain the helix start: its sketch z is " & NumberList(Array(CDbl(localValues(2)))) & " m at the helix start"
10053     If angle > 0.0001 Then Err.Raise 5, , "The profile plane is not perpendicular to the helix: its normal is " & NumberList(Array(angle)) & " rad off the helix tangent at the start"
End Sub

Private Sub StartSketchOnFeature(ByVal planeFeature As Object)
    ' A sketch on a plane that is not a principal plane (the plane normal to a helix).
    stepLabel = currentIdentity & ": StartSketchOnFeature ClearSelection2"
10059     doc.ClearSelection2 True
10060     sketchPlane = "on_plane"
10061     Require planeFeature, "Profile plane was not built"
10062     SelectFeature planeFeature, False, 0, "Profile plane", ""
    stepLabel = currentIdentity & ": StartSketchOnFeature InsertSketch" & " " & apiInputs & " " & callInputs
10064     doc.SketchManager.InsertSketch True
    stepLabel = currentIdentity & ": StartSketchOnFeature ActiveSketch" & " " & apiInputs & " " & callInputs
10066     Require doc.SketchManager.ActiveSketch, "Sketch not active after InsertSketch"
End Sub

Private Sub ProfileCentre(ByRef p As Variant)
    ' The circle center in the tilted profile plane must lie in that plane (sketch z = 0); log where it is.
10071     AppendLog currentFolder, currentIdentity, "profile circle", 0, 0, "center in the profile plane sketch (m) = " & NumberList(Array(CDbl(p(0)), CDbl(p(1)), CDbl(p(2))))
10072     If Abs(CDbl(p(2))) > 0.000001 Then Err.Raise 5, , "The profile plane does not contain the helix start: its sketch z is " & NumberList(Array(CDbl(p(2)))) & " m at the circle center"
10073     p(2) = 0#
End Sub

Private Sub PierceCircle(ByVal circleSegment As Object, ByVal curveFeature As Object)
    ' A Pierce relation between the circle center and the helix. The center is already at the helix start (plane
    ' transform), so a relation that cannot be added is logged and skipped, never fatal.
    Dim centrePoint As Object, selectData As Object, held As Long, reason As String
10080     If PlaneHas("no-pierce") Then
        ' Round 13: the Pierce relation lets the solver move the center to another crossing of the plane with the helix.
10082         diagPierceText = "off"
10083         AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation left out (candidate " & probeCandidate & "): the center stays on the plane origin, the helix start"
10084         Exit Sub
    End If
10086     diagPierceText = "on"
10087     On Error GoTo Skipped
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
10089     doc.ClearSelection2 True
    stepLabel = currentIdentity & ": PierceCircle GetCenterPoint2"
10091     Set centrePoint = circleSegment.GetCenterPoint2()
10092     If centrePoint Is Nothing Then Err.Raise 5, , "The circle center point is unavailable"
    stepLabel = currentIdentity & ": PierceCircle CreateSelectData" & " " & apiInputs & " " & callInputs
10094     Set selectData = doc.SelectionManager.CreateSelectData()
    stepLabel = currentIdentity & ": PierceCircle Mark"
10096     selectData.Mark = 0
    stepLabel = currentIdentity & ": PierceCircle Select4" & " " & apiInputs & " " & callInputs
10098     centrePoint.Select4 False, selectData
    stepLabel = currentIdentity & ": PierceCircle Select2" & " " & apiInputs & " " & callInputs
10100     curveFeature.Select2 True, 0
    stepLabel = currentIdentity & ": PierceCircle GetSelectedObjectCount2"
10102     held = doc.SelectionManager.GetSelectedObjectCount2(-1)
10103     If held <> 2 Then Err.Raise 5, , "The selection holds " & CStr(held) & " entities, expected the center and the helix"
    stepLabel = currentIdentity & ": PierceCircle SketchAddConstraints"
10105     doc.SketchAddConstraints "sgATPIERCE"
10106     AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation added between the circle center and the helix"
10107     On Error Resume Next
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
10109     doc.ClearSelection2 True
10110     Exit Sub
Skipped:
10112     reason = Err.Description
10113     On Error Resume Next
10114     RecordMitigation "pierce-relation-skipped", True, True
10115     fallbackSuccesses("pierce-relation-skipped") = fallbackSuccesses("pierce-relation-skipped") + 1
10116     AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation not added (" & reason & "); the center stays where the plane transform put it, on the helix start"
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
10118     doc.ClearSelection2 True
End Sub

