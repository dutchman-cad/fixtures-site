    stepLabel = currentIdentity & ": MirrorComponent GetModelDoc2"
4908             SaveModel madeComponent.GetModelDoc2(), path, True
4909             fallbackSuccesses("mirror-part-saved") = fallbackSuccesses("mirror-part-saved") + 1
            ' The file was written from the document, so the geometry is read again from the document that was saved.
4911             problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
