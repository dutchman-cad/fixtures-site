Private Function ShiftPoint(ByVal point As Variant, ByVal shift As Variant) As Variant
8265     ShiftPoint = Array(CDbl(point(0)) + CDbl(shift(0)), CDbl(point(1)) + CDbl(shift(1)), CDbl(point(2)) + CDbl(shift(2)))
