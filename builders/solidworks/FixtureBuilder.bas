Private Sub SweepStray(ByVal fs As Object, ByVal path As String, ByVal fileName As String, ByVal ext As String, ByRef notes As String)
    ' A file that is not text and not one the builder made (named in results.json, or the log): its bytes are searched for the needles and
    ' it is deleted on a hit, a cap or an error.
    Dim hit As Boolean, why As String
    ' Case-insensitive: SolidWorks writes .SLDPRT where the row says .sldprt, and that is still the builder's own file. Its own PDF is still
    ' scanned (never rewritten); the .sld* files are compressed and are not.
2199     If InStr(1, resultRows, Chr$(34) & fileName & Chr$(34), vbTextCompare) > 0 And ext <> "pdf" Then Exit Sub
2200     If InStr("|sldprt|sldasm|slddrw|step|dxf|zip|", "|" & ext & "|") > 0 And Len(resultRows) = 0 Then Exit Sub
2201     why = "stray file, name found"
2202     On Error Resume Next
2203     hit = StrayHasNeedle(path)
2204     If Err.Number <> 0 Then
2205         hit = True
2206         why = "stray file, unreadable"
2207         If InStr(Err.Description, "size cap") > 0 Then why = "stray file, too large to check (over 4 MB)"
    End If
2209     Err.Clear
2210     On Error GoTo 0
2211     If Not hit Then Exit Sub
2212     If SweepDelete(fs, path) Then
2213         SweepNote notes, "privacy sweep: " & fileName & " removed (" & why & ")"
    ElseIf SweepTruncate(fs, path) Then
2215         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & why & ")"
    Else
2217         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

Private Sub SweepFile(ByVal fs As Object, ByVal path As String, ByRef notes As String)
    ' Scrub one file. A text file that cannot be read or written (a lock, no permission) is retried, then truncated to zero bytes, then
    ' deleted; the note says which. Lock files (~$*) and temporary files are deleted. Never raises, so the whole list is always finished.
    Dim fileName As String, ext As String, text As String, cleaned As String, attempt As Long, done As Boolean, reason As String, capped As Boolean
2225     fileName = fs.GetFileName(path)
2226     ext = LCase$(fs.GetExtensionName(path))
2227     If Left$(fileName, 2) = "~$" Or ext = "tmp" Or ext = "temp" Or ext = "partial" Then
2228         If Not SweepDelete(fs, path) Then
2229             If SweepTruncate(fs, path) Then
2230                 SweepNote notes, "privacy sweep: " & fileName & " truncated (could not be removed)"
            Else
2232                 SweepNote notes, "privacy sweep: " & fileName & " could not be removed"
            End If
        End If
2235         Exit Sub
    End If
2237     If InStr("|log|json|txt|csv|tsv|xml|html|htm|md|ini|cfg|yaml|yml|dxf|", "|" & ext & "|") = 0 Then
2238         SweepStray fs, path, fileName, ext, notes
2239         Exit Sub
    End If
2241     For attempt = 1 To 3
2242         If Not done Then
2243             On Error Resume Next
2244             Err.Clear
2245             text = SweepRead(path)
2246             If Err.Number = 0 Then
2247                 cleaned = PrivacyScrub(text)
2248                 If cleaned <> text Then SweepWrite path, cleaned
            End If
2250             done = (Err.Number = 0)
2251             If InStr(Err.Description, "over the sweep size cap") > 0 Then capped = True
2252             Err.Clear
2253             On Error GoTo 0
        End If
    Next attempt
2256     If done Then Exit Sub
2257     reason = "unreadable"
2258     If capped Then reason = "too large to check (over 4 MB)"
2259     sweepEmptiedCount = sweepEmptiedCount + 1
2260     If Len(sweepEmptied) > 0 Then sweepEmptied = sweepEmptied & ", "
2261     sweepEmptied = sweepEmptied & fileName
2262     If SweepTruncate(fs, path) Then
2263         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & reason & ")"
    ElseIf SweepDelete(fs, path) Then
2265         SweepNote notes, "privacy sweep: " & fileName & " removed (" & reason & ")"
    Else
2267         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

Private Sub SweepListFailure(ByVal dirPath As String, ByRef notes As String)
