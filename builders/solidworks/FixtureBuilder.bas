6150     Set instanceMap = entry("components")
6151     For Each item In existing
6152         ActivateConfiguration model, CStr(item), "saved configuration"
6153         Set parts = SavedComponents(model)
    stepLabel = currentIdentity & ": ReadBackConfiguration Keys"
6155         For Each label In instanceMap.Keys
    stepLabel = currentIdentity & ": ReadBackConfiguration Exists"
6157             If Not parts.Exists(CStr(instanceMap(label))) Then Err.Raise 5, , "Saved component " & CStr(label) & " (" & CStr(instanceMap(label)) & ") not found in configuration " & CStr(item)
6158             Set component = parts(CStr(instanceMap(label)))
6159             expected = (CStr(item) = CStr(entry("name"))) And ArrayHas(entry("targets"), CStr(label))
    stepLabel = currentIdentity & ": ReadBackConfiguration IsSuppressed"
6161             If CBool(component.IsSuppressed()) <> expected Then Err.Raise 5, , "Saved configuration " & CStr(item) & ": component " & CStr(label) & " suppressed=" & CStr(Not expected) & ", expected " & CStr(expected)
