Private Function ChildCheck(ByVal path As String, ByVal child As Object, ByVal route As Long, ByRef text As String, ByRef totalOut As Variant, ByRef expectedOut As Variant) As Boolean
    ' True when `child` is the part as the top assembly has it, text for the log, its GetTotalTransform and where its instance puts it (mm). Read BEFORE the part is moved: its GetTotalTransform must be its instance's
    ' world transform carried onto the pose the part has in its own subassembly document (the pose it was inserted at; the instance of A24 is at X=50 mm, so the pin reads X=50).
    ' Round 22 (field 2026.11.24.6, SolidWorks 2023): the Transform2 of a handle found through the top assembly already reads the WORLD pose (50,0,10, not the
    ' local 0,0,10), so carrying the instance onto it counted the instance twice (100,0,10) and every handle was called wrong; the inserted pose is used
    ' (Transform2 of the handle only where none is known). The box center is NOT required to sit over the origin (a part whose origin is at a corner): it is logged as evidence only.
    Dim totalValues As Variant, localValues As Variant, parentValues As Variant, centre As Variant, expected(2) As Double, total(2) As Double
    Dim i As Long, j As Long, k As Long, depth As Long, poseOk As Boolean, worst As Double, boxText As String, parentPath As String, file As String, topLabel As String, key As String
    Dim useInserted As Boolean, scanFile As String
    Dim labels As Variant, stepComponent As Object, stepValues As Variant, rotation(8) As Double, turned(8) As Double, moved(2) As Double
    stepLabel = currentIdentity & ": ChildCheck GetTotalTransform"
2935     totalValues = child.GetTotalTransform(True).ArrayData
    stepLabel = currentIdentity & ": ChildCheck ArrayData"
2937     localValues = child.Transform2.ArrayData
    ' Where the top assembly puts the part: the top-level instance's world transform carried down the path by the pose each part has in its subassembly.
2939     labels = Split(path, "/")
    stepLabel = currentIdentity & ": ChildCheck ArrayData"
2941     parentValues = LocateComponent(CStr(labels(0))).GetTotalTransform(True).ArrayData
2942     topLabel = CStr(labels(0))
2943     If InStr(topLabel, "#") > 0 Then topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    stepLabel = currentIdentity & ": ChildCheck Exists"
2945     If fileOfLabel.Exists("|" & topLabel) Then file = fileOfLabel("|" & topLabel)
2946     For i = 0 To 2
2947         expected(i) = CDbl(parentValues(9 + i)) * 1000#
2948         For j = 0 To 2
2949             rotation(3 * i + j) = CDbl(parentValues(3 * j + i))
        Next j
    Next i
    ' All or nothing, as the twin: the inserted poses are used only when every level of the path has one (and a subassembly file); otherwise the Transform2 of the
    ' handle of every level is, as before round 22.
2954     useInserted = True
2955     scanFile = file
2956     For depth = 2 To UBound(labels) + 1
2957         key = scanFile & "|" & CStr(labels(depth - 1))
2958         If Len(scanFile) = 0 Then
2959             useInserted = False
        ElseIf Not poses.Exists(key) Then
2961             useInserted = False
        End If
    stepLabel = currentIdentity & ": ChildCheck Exists"
2964         If fileOfLabel.Exists(key) Then scanFile = fileOfLabel(key) Else scanFile = ""
    Next depth
2966     For depth = 2 To UBound(labels) + 1
2967         key = file & "|" & CStr(labels(depth - 1))
2968         If useInserted Then
2969             stepValues = poses(key)
        Else
2971             If depth = UBound(labels) + 1 Then
2972                 Set stepComponent = child
            Else
2974                 parentPath = labels(0)
2975                 For i = 1 To depth - 1
2976                     parentPath = parentPath & "/" & labels(i)
                Next i
2978                 Set stepComponent = LocateComponent(parentPath, route)
            End If
    stepLabel = currentIdentity & ": ChildCheck ArrayData"
2981             stepValues = stepComponent.Transform2.ArrayData
        End If
    stepLabel = currentIdentity & ": ChildCheck Exists"
2984         If fileOfLabel.Exists(key) Then file = fileOfLabel(key) Else file = ""
2985         For i = 0 To 2
2986             moved(i) = expected(i)
2987             For j = 0 To 2
2988                 moved(i) = moved(i) + rotation(3 * i + j) * CDbl(stepValues(9 + j)) * 1000#
            Next j
        Next i
2991         For i = 0 To 2
2992             expected(i) = moved(i)
2993             For j = 0 To 2
2994                 turned(3 * i + j) = 0#
2995                 For k = 0 To 2
2996                     turned(3 * i + j) = turned(3 * i + j) + rotation(3 * i + k) * CDbl(stepValues(3 * j + k))
                Next k
            Next j
        Next i
3000         For i = 0 To 8
3001             rotation(i) = turned(i)
        Next i
    Next depth
3004     For i = 0 To 2
3005         total(i) = CDbl(totalValues(9 + i)) * 1000#
3006         If Abs(total(i) - expected(i)) > worst Then worst = Abs(total(i) - expected(i))
    Next i
3008     poseOk = (worst <= 0.05)
3009     centre = BoxCentre(child)
3010     boxText = "unreadable"
3011     If IsArray(centre) Then boxText = NoteList(centre)
3012     ChildCheck = poseOk
3013     totalOut = Array(total(0), total(1), total(2))
3014     expectedOut = Array(expected(0), expected(1), expected(2))
3015     text = "GetTotalTransform (" & NoteList(total) & ") mm, Transform2 (" & NoteList(Array(CDbl(localValues(9)) * 1000#, CDbl(localValues(10)) * 1000#, CDbl(localValues(11)) * 1000#)) & ") mm, box center (" & boxText & ") mm, carried by its instance it should read (" & NoteList(expected) & ") mm: " & IIf(poseOk, "it is the part in the top assembly", "the wrong handle: it reads the subassembly document's own coordinates")
End Function

