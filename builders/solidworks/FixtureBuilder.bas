Private Function JsonRowValue(ByVal row As String, ByVal key As String) As String
    ' The string value of a top-level key of one results.json row (rows are written by this builder).
    Dim i As Long, depth As Long, c As String, token As String, j As Long, isKey As Boolean
1063     i = 1
1064     Do While i <= Len(row)
1065         c = Mid$(row, i, 1)
1066         If c = "{" Then
1067             depth = depth + 1
        ElseIf c = "}" Then
1069             depth = depth - 1
        ElseIf c = Chr$(34) Then
1071             token = ""
1072             i = i + 1
1073             Do While i <= Len(row)
1074                 c = Mid$(row, i, 1)
1075                 If c = "\" Then
1076                     i = i + 1
1077                     token = token & Mid$(row, i, 1)
                ElseIf c = Chr$(34) Then
1079                     Exit Do
                Else
1081                     token = token & c
                End If
1083                 i = i + 1
            Loop
1085             j = i + 1
1086             Do While j <= Len(row) And Mid$(row, j, 1) = " "
1087                 j = j + 1
            Loop
1089             isKey = (depth = 1 And Mid$(row, j, 1) = ":")
1090             If isKey And token = key Then
1091                 j = j + 1
1092                 Do While j <= Len(row) And Mid$(row, j, 1) = " "
1093                     j = j + 1
                Loop
1095                 If Mid$(row, j, 1) = Chr$(34) Then
1096                     j = j + 1
1097                     Do While j <= Len(row)
1098                         c = Mid$(row, j, 1)
1099                         If c = "\" Then
1100                             j = j + 1
1101                             JsonRowValue = JsonRowValue & Mid$(row, j, 1)
                        ElseIf c = Chr$(34) Then
1103                             Exit Do
                        Else
1105                             JsonRowValue = JsonRowValue & c
                        End If
1107                         j = j + 1
                    Loop
                End If
1110                 Exit Function
            End If
        End If
1113         i = i + 1
    Loop
End Function

