344     AppendLog folder, "setup", "summary info", 0, 0, ReadbackText()
345     AppendLog folder, "setup", "summary info", 0, 0, "SolidWorks stamps the saving user in each file: not removable by the API"
346     AppendLog folder, "setup", "summary info", 0, 0, "SolidWorks also records its Windows temp folder (under your user profile) in each native file; we keep native files private and publish only STEP and files we've checked clean."
    ' Before the zip: every file in the output folder, listed or not, is scrubbed (see PrivacySweep).
348     swept = True
349     sweepNotes = PrivacySweep(folder)
350     If Len(sweepNotes) > 0 Then AppendLog folder, "setup", "privacy sweep", 0, 0, sweepNotes
351     zipMade = False
352     If Not sweepListFailed Then zipMade = MakeZip(folder)        ' a folder that could not be checked is never zipped
353     zipError = folder & "-zip-error.txt"
    stepLabel = currentIdentity & ": main FileExists"
355     If fs.FileExists(zipError) Then SweepFile fs, zipError, sweepNotes
356     If zipMade Then SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LastZip", folder & ".zip"
357     finishText = FinishMessage(CountStatus("ok") + CountStatus("failed") + CountStatus("not_scripted") + CountStatus("skipped_built"), _
        CountStatus("ok"), CountStatus("failed"), CountStatus("not_scripted"), CountStatus("skipped_built"), folder & ".zip", zipMade, folder)
359     AppendLog folder, "setup", "finish", 0, 0, finishText
360     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LastFinish", finishText
361     GoTo Cleanup
Fatal:
    fatalLine = Erl: fatalNumber = Err.Number: fatalDescription = Err.Description: fatalStep = stepLabel
364     finalMessage = fatalStep & " (line " & CStr(fatalLine) & "): " & fatalDescription
365     On Error Resume Next
366     swept = False        ' an error after the sweep (in the zip step) is swept again on the way out
367     If Len(folder) > 0 Then AppendLog folder, currentIdentity, fatalStep, fatalLine, fatalNumber, fatalDescription
368     Resume Cleanup
Cleanup:
370     On Error Resume Next
371     Err.Clear
    ' Every way out of main passes here (done, the error handler, an early exit): the folder is swept once, so an error part way leaves
    ' no unswept text file. The sweep before the zip counts as that once.
374     If Len(folder) > 0 And Not swept Then
375         swept = True
376         sweepNotes = PrivacySweep(folder)
377         If Len(sweepNotes) > 0 Then AppendLog folder, "setup", "privacy sweep", 0, 0, sweepNotes
    End If
379     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
381     If preferenceSet Then app.SetUserPreferenceIntegerValue 78, oldStep
382     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
383     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
385     If actionSaved Then app.SetUserPreferenceIntegerValue swRebuildErrorAction, oldAction
386     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
387     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
389     If warnSaved Then app.SetUserPreferenceToggle swWarnSaveUpdateErrors, oldWarn
390     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
391     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
393     If rebuildSaved Then app.SetUserPreferenceToggle swShowErrorsEveryRebuild, oldRebuild
394     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
395     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
397     If inputSaved Then app.SetUserPreferenceToggle swInputDimValOnCreate, oldInput
398     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
399     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", ""
400     Err.Clear
    ' FIXTURE_UNATTENDED=1: no Explorer window and no message box, only the log line written above.
402     If Len(finalMessage) > 0 Then
403         If Not IsUnattended() Then MsgBox PrivacyScrub(finalMessage)
    ElseIf Len(finishText) > 0 And Not launched And Not IsUnattended() Then
        ' A person is at the screen: show the zip in Explorer (never waits, errors ignored), then the message.
406         If zipMade Then
    stepLabel = currentIdentity & ": main Run"
408             CreateObject("WScript.Shell").Run "explorer.exe /select,""" & folder & ".zip""", 1, False
        Else
    stepLabel = currentIdentity & ": main Run"
411             CreateObject("WScript.Shell").Run "explorer.exe """ & folder & """", 1, False
        End If
413         Err.Clear
414         MsgBox PrivacyScrub(finishText), vbInformation, "SolidWorks fixtures"
    End If
