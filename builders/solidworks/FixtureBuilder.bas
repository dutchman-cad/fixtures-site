2246     If InStr("|sldprt|sldasm|slddrw|step|dxf|zip|", "|" & ext & "|") > 0 And Len(resultRows) = 0 Then Exit Sub
2247     why = "stray file, name found"
2248     On Error Resume Next
2249     hit = StrayHasNeedle(path)
2250     If Err.Number <> 0 Then
2251         hit = True
2252         why = "stray file, unreadable"
2253         If InStr(Err.Description, "size cap") > 0 Then why = "stray file, too large to check (over 4 MB)"
    End If
2255     Err.Clear
2256     On Error GoTo 0
2257     If Not hit Then Exit Sub
2258     If SweepDelete(fs, path) Then
2259         SweepNote notes, "privacy sweep: " & fileName & " removed (" & why & ")"
    ElseIf SweepTruncate(fs, path) Then
2261         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & why & ")"
    Else
2263         sweepListFailed = True        ' neither clean nor gone: no zip (fail closed)
2264         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

Private Sub SweepFile(ByVal fs As Object, ByVal path As String, ByRef notes As String)
    ' Scrub one file. A text file that cannot be read or written (a lock, no permission) is retried, then truncated to zero bytes, then
    ' deleted; the note says which. Lock files (~$*) and temporary files are deleted. Never raises, so the whole list is always finished.
    Dim fileName As String, ext As String, text As String, cleaned As String, attempt As Long, done As Boolean, reason As String, capped As Boolean
2272     fileName = fs.GetFileName(path)
2273     ext = LCase$(fs.GetExtensionName(path))
2274     If Left$(fileName, 2) = "~$" Or ext = "tmp" Or ext = "temp" Or ext = "partial" Then
2275         If Not SweepDelete(fs, path) Then
2276             If SweepTruncate(fs, path) Then
2277                 SweepNote notes, "privacy sweep: " & fileName & " truncated (could not be removed)"
            Else
2279                 SweepNote notes, "privacy sweep: " & fileName & " could not be removed"
            End If
        End If
2282         Exit Sub
    End If
2284     If InStr("|log|json|txt|csv|tsv|xml|html|htm|md|ini|cfg|yaml|yml|dxf|", "|" & ext & "|") = 0 Then
2285         SweepStray fs, path, fileName, ext, notes
2286         Exit Sub
    End If
2288     For attempt = 1 To 3
2289         If Not done Then
2290             On Error Resume Next
2291             Err.Clear
2292             text = SweepRead(path)
2293             If Err.Number = 0 Then
2294                 cleaned = PrivacyScrub(text)
2295                 If cleaned <> text Then SweepWrite path, cleaned
            End If
2297             done = (Err.Number = 0)
2298             If InStr(Err.Description, "over the sweep size cap") > 0 Then capped = True
2299             Err.Clear
2300             On Error GoTo 0
        End If
    Next attempt
2303     If done Then Exit Sub
2304     reason = "unreadable"
2305     If capped Then reason = "too large to check (over 4 MB)"
2306     sweepEmptiedCount = sweepEmptiedCount + 1
2307     If Len(sweepEmptied) > 0 Then sweepEmptied = sweepEmptied & ", "
2308     sweepEmptied = sweepEmptied & fileName
2309     If SweepTruncate(fs, path) Then
2310         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & reason & ")"
    ElseIf SweepDelete(fs, path) Then
2312         SweepNote notes, "privacy sweep: " & fileName & " removed (" & reason & ")"
    Else
2314         sweepListFailed = True        ' neither clean nor gone: no zip (fail closed)
2315         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

