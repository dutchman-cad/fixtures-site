Private Function StepArgs(ByVal body As String) As Variant
    ' The top-level arguments of a STEP entity (a comma inside quotes or parentheses does not split), as an array.
    Dim i As Long, ch As String, depth As Long, quoted As Boolean, current As String, joined As String
1904     i = 1
1905     Do While i <= Len(body)
1906         ch = Mid$(body, i, 1)
1907         If quoted Then
1908             current = current & ch
1909             If ch = "'" Then
1910                 If Mid$(body, i + 1, 1) = "'" Then
1911                     current = current & "'"
1912                     i = i + 1
                Else
1914                     quoted = False
                End If
            End If
        ElseIf ch = "'" Then
1918             quoted = True
1919             current = current & ch
        ElseIf ch = "," And depth = 0 Then
1921             joined = joined & current & Chr$(1)
1922             current = ""
        Else
1924             If ch = "(" Then depth = depth + 1
1925             If ch = ")" Then depth = depth - 1
1926             current = current & ch
        End If
1928         i = i + 1
    Loop
1930     StepArgs = Split(joined & current, Chr$(1))
End Function

