Private Sub CurveStart(ByVal curveFeature As Object)
    ' The start point and unit tangent (meters) of a helix or spiral, evaluated on the curve SolidWorks built: the feature's
    ' IReferenceCurve, its first edge's ICurve at the start parameter (ICurve.GetEndParams, ICurve.Evaluate2 with one derivative).
    Dim reference As Object, firstEdge As Object, curveObject As Object, startParameter As Double, endParameter As Double
    Dim closedFlag As Boolean, periodicFlag As Boolean, values As Variant, length As Double, i As Long, first As Long
    stepLabel = currentIdentity & ": CurveStart GetSpecificFeature2"
9552     Set reference = curveFeature.GetSpecificFeature2()
9553     Require reference, "The helix feature has no reference curve (GetSpecificFeature2 returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetFirstSegment"
9555     Set firstEdge = reference.GetFirstSegment()
9556     Require firstEdge, "The helix has no first segment (IReferenceCurve.GetFirstSegment returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetCurve"
9558     Set curveObject = firstEdge.GetCurve()
9559     Require curveObject, "The helix edge has no curve (IEdge.GetCurve returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetEndParams"
9561     curveObject.GetEndParams startParameter, endParameter, closedFlag, periodicFlag
    stepLabel = currentIdentity & ": CurveStart Evaluate2"
9563     values = curveObject.Evaluate2(startParameter, 1)
9564     If Not IsArray(values) Then Err.Raise 5, , "ICurve.Evaluate2 returned nothing"
9565     first = LBound(values)
9566     If UBound(values) - first < 5 Then Err.Raise 5, , "ICurve.Evaluate2 returned " & CStr(UBound(values) - first + 1) & " values at the start parameter, expected the point and its first derivative"
9567     For i = 0 To 2
9568         helixStart(i) = CDbl(values(first + i))
9569         helixTangent(i) = CDbl(values(first + 3 + i))
    Next i
9571     length = Sqr(helixTangent(0) ^ 2 + helixTangent(1) ^ 2 + helixTangent(2) ^ 2)
9572     If length < 0.000000000001 Then Err.Raise 5, , "The helix has no tangent at its start parameter"
9573     For i = 0 To 2
9574         helixTangent(i) = helixTangent(i) / length
    Next i
9576     helixStartKnown = True
End Sub

Private Function CurveEdge(ByVal curveFeature As Object, ByVal wantLast As Boolean) As Object
    ' The first edge of a helix or spiral, or its last (IReferenceCurve.GetFirstSegment, then GetNextSegment up to GetSegmentCount).
    Dim reference As Object, edge As Object, count As Long, i As Long
    stepLabel = currentIdentity & ": CurveEdge GetSpecificFeature2"
9583     Set reference = curveFeature.GetSpecificFeature2()
9584     Require reference, "The helix feature has no reference curve (GetSpecificFeature2 returned nothing)"
    stepLabel = currentIdentity & ": CurveEdge GetFirstSegment"
9586     Set edge = reference.GetFirstSegment()
9587     Require edge, "The helix has no first segment (IReferenceCurve.GetFirstSegment returned nothing)"
9588     If wantLast Then
    stepLabel = currentIdentity & ": CurveEdge GetSegmentCount"
9590         count = reference.GetSegmentCount()
9591         For i = 2 To count
    stepLabel = currentIdentity & ": CurveEdge GetNextSegment"
9593             Set edge = reference.GetNextSegment()
9594             Require edge, "The helix has no segment " & CStr(i) & " (IReferenceCurve.GetNextSegment returned nothing)"
        Next i
    End If
9597     Set CurveEdge = edge
End Function

Private Sub CurveEnd(ByVal curveFeature As Object)
    ' The end point and unit tangent (meters) of the last segment of a helix or spiral, at its end parameter. Not fatal when unavailable.
    Dim lastEdge As Object, curveObject As Object, startParameter As Double, endParameter As Double, closedFlag As Boolean, periodicFlag As Boolean
    Dim values As Variant, length As Double, i As Long, first As Long
9604     helixEndKnown = False
9605     On Error GoTo Unavailable
9606     Set lastEdge = CurveEdge(curveFeature, True)
    stepLabel = currentIdentity & ": CurveEnd GetCurve"
9608     Set curveObject = lastEdge.GetCurve()
9609     Require curveObject, "The helix edge has no curve (IEdge.GetCurve returned nothing)"
    stepLabel = currentIdentity & ": CurveEnd GetEndParams"
9611     curveObject.GetEndParams startParameter, endParameter, closedFlag, periodicFlag
    stepLabel = currentIdentity & ": CurveEnd Evaluate2"
9613     values = curveObject.Evaluate2(endParameter, 1)
9614     If Not IsArray(values) Then Err.Raise 5, , "ICurve.Evaluate2 returned nothing at the end parameter"
9615     first = LBound(values)
9616     If UBound(values) - first < 5 Then Err.Raise 5, , "ICurve.Evaluate2 returned too few values at the end parameter"
9617     For i = 0 To 2
9618         helixEnd(i) = CDbl(values(first + i))
9619         helixEndTangent(i) = CDbl(values(first + 3 + i))
    Next i
9621     length = Sqr(helixEndTangent(0) ^ 2 + helixEndTangent(1) ^ 2 + helixEndTangent(2) ^ 2)
9622     If length < 0.000000000001 Then Err.Raise 5, , "The helix has no usable tangent at its end parameter"
9623     For i = 0 To 2
9624         helixEndTangent(i) = helixEndTangent(i) / length
    Next i
9626     helixEndKnown = True
