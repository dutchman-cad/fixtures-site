Private Sub ReadBackLimits(ByVal mateName As String, ByVal angular As Boolean, ByVal wantedLow As Double, ByVal wantedHigh As Double, ByVal limitText As String, ByVal poseValue As Double, ByVal flipped As Boolean, ByVal poseText As String)
    ' The limits SolidWorks stored for the mate just made: IMate2.MinimumVariation / MaximumVariation of the newest mate (via IFeature.GetSpecificFeature2),
    ' in meters or radians, RELATIVE to the mate's own value (field 2026.11.24.3): poseValue (mm or degrees, the value passed to AddMate5) is added back.
    ' wantedLow / wantedHigh are in the frame the mate was asked in (flipped: a negative distance passed as |value| with Flip toggled, limits [-max, -min]).
    Dim info As Object, low As Double, high As Double, haveLimits As Boolean, storedText As String, unitName As String, shownLow As Double, shownHigh As Double
5258     On Error Resume Next
    stepLabel = currentIdentity & ": ReadBackLimits GetSpecificFeature2"
5260     Set info = NewestMate().GetSpecificFeature2()
5261     If Err.Number = 0 Then
5262         If Not info Is Nothing Then
    stepLabel = currentIdentity & ": ReadBackLimits MinimumVariation"
5264             low = CDbl(info.MinimumVariation)
    stepLabel = currentIdentity & ": ReadBackLimits MaximumVariation"
5266             high = CDbl(info.MaximumVariation)
5267             If Err.Number = 0 Then haveLimits = True
        End If
    End If
5270     If Err.Number <> 0 Then NoteOption "mate " & mateName & ": IMate2 read-back failed (" & Err.Description & ")"
5271     On Error GoTo 0
5272     If Not haveLimits Then
5273         AddLimitNote mateName & ": limits " & limitText & " requested, limits not read back"
5274         Exit Sub
    End If
5276     unitName = "mm"
5277     If angular Then
5278         low = low * 180# / 3.14159265358979
5279         high = high * 180# / 3.14159265358979
5280         unitName = "deg"
    Else
5282         low = low * 1000#
5283         high = high * 1000#
    End If
5285     low = low + poseValue
5286     high = high + poseValue
5287     shownLow = low
5288     shownHigh = high
5289     If flipped Then
5290         shownLow = -high
5291         shownHigh = -low
    End If
5293     storedText = NoteNumber(shownLow) & ".." & NoteNumber(shownHigh) & " " & unitName
5294     If Abs(low - wantedLow) > 0.000001 Or Abs(high - wantedHigh) > 0.000001 Then
5295         limitDegraded = True
5296         AddLimitNote mateName & ": limits " & limitText & " requested but " & storedText & " stored (read back relative to the pose " & poseText & ")"
5297         Exit Sub
    End If
5299     AddLimitNote mateName & ": limits " & storedText & " stored (read back relative to the pose " & poseText & ")"
End Sub

