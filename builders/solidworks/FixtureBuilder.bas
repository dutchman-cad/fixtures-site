Private Sub ProfileCentre(ByRef p As Variant)
    ' The circle center in the tilted profile plane must lie in that plane (sketch z = 0); log where it is.
9751     AppendLog currentFolder, currentIdentity, "profile circle", 0, 0, "center in the profile plane sketch (m) = " & NumberList(Array(CDbl(p(0)), CDbl(p(1)), CDbl(p(2))))
9752     If Abs(CDbl(p(2))) > 0.000001 Then Err.Raise 5, , "The profile plane does not contain the helix start: its sketch z is " & NumberList(Array(CDbl(p(2)))) & " m at the circle center"
9753     p(2) = 0#
End Sub

Private Sub PierceCircle(ByVal circleSegment As Object, ByVal curveFeature As Object)
    ' A Pierce relation between the circle center and the helix. The center is already at the helix start (plane
    ' transform), so a relation that cannot be added is logged and skipped, never fatal.
    Dim centrePoint As Object, selectData As Object, held As Long, reason As String
9760     If PlaneHas("no-pierce") Then
        ' Round 13: the Pierce relation lets the solver move the center to another crossing of the plane with the helix.
9762         diagPierceText = "off"
9763         AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation left out (candidate " & probeCandidate & "): the center stays on the plane origin, the helix start"
9764         Exit Sub
    End If
9766     diagPierceText = "on"
9767     On Error GoTo Skipped
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
9769     doc.ClearSelection2 True
    stepLabel = currentIdentity & ": PierceCircle GetCenterPoint2"
9771     Set centrePoint = circleSegment.GetCenterPoint2()
9772     If centrePoint Is Nothing Then Err.Raise 5, , "The circle center point is unavailable"
    stepLabel = currentIdentity & ": PierceCircle CreateSelectData" & " " & apiInputs & " " & callInputs
9774     Set selectData = doc.SelectionManager.CreateSelectData()
    stepLabel = currentIdentity & ": PierceCircle Mark"
9776     selectData.Mark = 0
    stepLabel = currentIdentity & ": PierceCircle Select4" & " " & apiInputs & " " & callInputs
9778     centrePoint.Select4 False, selectData
    stepLabel = currentIdentity & ": PierceCircle Select2" & " " & apiInputs & " " & callInputs
9780     curveFeature.Select2 True, 0
    stepLabel = currentIdentity & ": PierceCircle GetSelectedObjectCount2"
9782     held = doc.SelectionManager.GetSelectedObjectCount2(-1)
9783     If held <> 2 Then Err.Raise 5, , "The selection holds " & CStr(held) & " entities, expected the center and the helix"
    stepLabel = currentIdentity & ": PierceCircle SketchAddConstraints"
9785     doc.SketchAddConstraints "sgATPIERCE"
9786     AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation added between the circle center and the helix"
9787     On Error Resume Next
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
9789     doc.ClearSelection2 True
9790     Exit Sub
Skipped:
9792     reason = Err.Description
9793     On Error Resume Next
9794     RecordMitigation "pierce-relation-skipped", True, True
9795     fallbackSuccesses("pierce-relation-skipped") = fallbackSuccesses("pierce-relation-skipped") + 1
9796     AppendLog currentFolder, currentIdentity, "pierce", 0, 0, "Pierce relation not added (" & reason & "); the center stays where the plane transform put it, on the helix start"
    stepLabel = currentIdentity & ": PierceCircle ClearSelection2"
9798     doc.ClearSelection2 True
End Sub

