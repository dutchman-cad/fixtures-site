Private Function FilletAxis(ByVal component As Object, ByRef direction As Variant) As Variant
    ' The rounded corner's fillet axis of the part the component is, in the top assembly (meters): the first cylindrical face of the part document's solid
    ' body (IFace2.GetSurface -> ISurface.CylinderParams: origin xyz, axis xyz, radius), carried by the component's world transform. Read from the part
    ' itself, so a part that was copied unmirrored shows it. The direction is returned in `direction`.
    Dim model As Object, bodies As Variant, body As Variant, faces As Variant, face As Variant, surface As Object, params As Variant, total As Variant, j As Long
    Dim point(2) As Double, axisDirection(2) As Double, paramLower As Long, paramUpper As Long, totalLower As Long, totalUpper As Long
    stepLabel = currentIdentity & ": FilletAxis GetModelDoc2"
4242     Set model = component.GetModelDoc2()
4243     Require model, "The mirrored part document is not loaded"
    stepLabel = currentIdentity & ": FilletAxis GetBodies2"
4245     bodies = PartDocument(model).GetBodies2(swSolidBody, True)
4246     If IsArray(bodies) Then
4247         For Each body In bodies
    stepLabel = currentIdentity & ": FilletAxis GetFaces"
4249             faces = body.GetFaces()
4250             If IsArray(faces) Then
4251                 For Each face In faces
    stepLabel = currentIdentity & ": FilletAxis GetSurface"
4253                     Set surface = face.GetSurface()
4254                     Require surface, "A face of the part has no surface"
    stepLabel = currentIdentity & ": FilletAxis IsCylinder"
4256                     If surface.IsCylinder() Then
    stepLabel = currentIdentity & ": FilletAxis CylinderParams"
4258                         params = surface.CylinderParams
    stepLabel = currentIdentity & ": FilletAxis Name2"
4260                         If Not ArrayItems(params, paramLower, paramUpper) Then Err.Raise 5, , "CylinderParams of a face of " & CStr(component.Name2) & " answered no array"
    stepLabel = currentIdentity & ": FilletAxis Name2"
4262                         If paramUpper - paramLower < 5 Then Err.Raise 5, , "CylinderParams of a face of " & CStr(component.Name2) & " answered " & CStr(paramUpper - paramLower + 1) & " numbers, not 7"
    stepLabel = currentIdentity & ": FilletAxis GetTotalTransform"
4264                         total = component.GetTotalTransform(True).ArrayData
    stepLabel = currentIdentity & ": FilletAxis Name2"
4266                         If Not ArrayItems(total, totalLower, totalUpper) Then Err.Raise 5, , "GetTotalTransform of " & CStr(component.Name2) & " answered no array"
    stepLabel = currentIdentity & ": FilletAxis Name2"
4268                         If totalUpper - totalLower < 12 Then Err.Raise 5, , "GetTotalTransform of " & CStr(component.Name2) & " answered " & CStr(totalUpper - totalLower + 1) & " numbers, not 16"
4269                         For j = 0 To 2
4270                             point(j) = (CDbl(params(paramLower)) * CDbl(total(totalLower + j)) + CDbl(params(paramLower + 1)) * CDbl(total(totalLower + 3 + j)) + CDbl(params(paramLower + 2)) * CDbl(total(totalLower + 6 + j))) * CDbl(total(totalLower + 12)) + CDbl(total(totalLower + 9 + j))
4271                             axisDirection(j) = CDbl(params(paramLower + 3)) * CDbl(total(totalLower + j)) + CDbl(params(paramLower + 4)) * CDbl(total(totalLower + 3 + j)) + CDbl(params(paramLower + 5)) * CDbl(total(totalLower + 6 + j))
                        Next j
4273                         direction = Array(axisDirection(0), axisDirection(1), axisDirection(2))
4274                         FilletAxis = Array(point(0), point(1), point(2))
4275                         Exit Function
                    End If
                Next face
            End If
        Next body
    End If
    stepLabel = currentIdentity & ": FilletAxis Name2"
4282     Err.Raise 5, , "The part " & CStr(component.Name2) & " has no cylindrical face to find its rounded corner by"
End Function

Private Function MirrorGeometryProblem(ByVal newComponent As Object, ByVal originalComponent As Object, ByVal axisIndex As Long, ByVal offset As Double) As String
    ' "" when the rounded corner of the new component lies at the mirror image (about the plane at offset, meters, along axisIndex) of the original's, else
    ' what was found. The fillet's axis is compared except along itself; 0.5 mm.
    Dim before As Variant, after As Variant, direction As Variant, other As Variant, wanted(2) As Double, size As Double, along As Double, worst As Double, i As Long
    Dim gap(2) As Double
4290     before = FilletAxis(originalComponent, direction)
4291     after = FilletAxis(newComponent, other)
4292     For i = 0 To 2
4293         wanted(i) = CDbl(before(i))
    Next i
4295     wanted(axisIndex) = 2# * offset - CDbl(before(axisIndex))
4296     size = Sqr(CDbl(direction(0)) ^ 2 + CDbl(direction(1)) ^ 2 + CDbl(direction(2)) ^ 2)
4297     For i = 0 To 2
4298         gap(i) = CDbl(after(i)) - wanted(i)
4299         along = along + gap(i) * CDbl(direction(i)) / size
    Next i
4301     For i = 0 To 2
4302         If Abs(gap(i) - along * CDbl(direction(i)) / size) > worst Then worst = Abs(gap(i) - along * CDbl(direction(i)) / size)
    Next i
4304     If worst > 0.0005 Then MirrorGeometryProblem = "the rounded corner of " & CStr(newComponent.Name2) & " is at (" & NoteList(Array(CDbl(after(0)) * 1000#, CDbl(after(1)) * 1000#, CDbl(after(2)) * 1000#)) & ") mm, the mirror image of the original is at (" & NoteList(Array(wanted(0) * 1000#, wanted(1) * 1000#, wanted(2) * 1000#)) & ")"
End Function

