Private Function FlangeSpan(ByVal edge As Object, ByVal kind As String, ByVal corner As Variant, ByVal firstValue As Double, ByVal secondValue As Double) As Variant
    ' Model end points (m) of a part-width flange. "width": firstValue from the
    ' given corner, secondValue wide. "offset": firstValue from the end with the
    ' lower coordinate along the edge, secondValue from the other end.
    Dim a As Variant, b As Variant, swap As Variant, length As Double, unit(2) As Double
    Dim startAt As Double, endAt As Double, i As Long, k As Long, startPoint(2) As Double, endPoint(2) As Double
    stepLabel = currentIdentity & ": FlangeSpan GetPoint"
8037     a = edge.GetStartVertex().GetPoint()
    stepLabel = currentIdentity & ": FlangeSpan GetPoint"
8039     b = edge.GetEndVertex().GetPoint()
8040     length = PointDistance(a, b)
8041     If kind = "width" Then
8042         If PointDistance(corner, b) < 0.000000001 Then
8043             swap = a: a = b: b = swap
        ElseIf PointDistance(corner, a) >= 0.000000001 Then
8045             Err.Raise 5, , "Flange width: from_corner is not an end of the flange edge"
        End If
8047         startAt = firstValue: endAt = firstValue + secondValue
    Else
8049         k = 0
8050         For i = 1 To 2
8051             If Abs(b(i) - a(i)) > Abs(b(k) - a(k)) Then k = i
        Next i
8053         If b(k) < a(k) Then
8054             swap = a: a = b: b = swap
        End If
8056         startAt = firstValue: endAt = length - secondValue
    End If
8058     If startAt < 0 Or endAt <= startAt Or endAt > length + 0.000000001 Then Err.Raise 5, , "Flange width: span " & NumberList(Array(startAt, endAt)) & " m is outside the " & NumberList(Array(length)) & " m edge"
8059     For i = 0 To 2
8060         unit(i) = (b(i) - a(i)) / length
8061         startPoint(i) = a(i) + unit(i) * startAt
8062         endPoint(i) = a(i) + unit(i) * endAt
    Next i
8064     FlangeSpan = Array(Array(startPoint(0), startPoint(1), startPoint(2)), Array(endPoint(0), endPoint(1), endPoint(2)))
End Function

Private Function ProfileOffset(ByVal matrix As Variant, ByVal pa As Variant, ByVal pb As Variant, ByVal height As Double, ByVal axisIndex As Long, ByVal side As Long) As Variant
    ' A sketch vector (u, v) is the model vector u * column 0 + v * column 1 of
    ' the transform's rotation; take the perpendicular of pa-pb along the axis.
    Dim first As Long, du As Double, dv As Double, length As Double, nu As Double, nv As Double, component As Double
8071     first = LBound(matrix)
8072     du = pb(0) - pa(0): dv = pb(1) - pa(1)
8073     length = Sqr(du * du + dv * dv)
8074     If length < 0.000000001 Then Err.Raise 5, , "Edge flange base line has zero length in the profile sketch"
8075     nu = -dv / length: nv = du / length
8076     component = nu * CDbl(matrix(first + 3 * axisIndex)) + nv * CDbl(matrix(first + 3 * axisIndex + 1))
8077     If component * side < 0 Then
8078         nu = -nu: nv = -nv: component = -component
    End If
8080     If component * side < 0.000001 Then Err.Raise 5, , "Edge flange profile plane has no component along the requested direction"
8081     ProfileOffset = Array(nu * height, nv * height)
End Function

Private Function HemFeature(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal dx As Double, ByVal dy As Double, ByVal dz As Double, ByVal hemType As Long, ByVal length As Double, ByVal gap As Double, ByVal hemAxis As Long, ByVal hemSide As Long, ByVal thickness As Double) As Object
    ' Point, lengths and thickness in meters. Round 9 probe candidates: Reverse False / True, each on the edge the recipe names or on the
    ' edge at the other face of the flange top (one sheet thickness away along the hem axis). The first one is also the one used outside
    ' probe mode. The + extreme along the hem axis rises by thickness plus gap on either side (field, S04a/b/g: 60 -> 63 for both Reverse
    ' values) and is information only. Round 10: the verdict is the added material's centroid (from the center of mass and volume before
    ' and after) against the flange mid-plane, which is one half sheet thickness below the + extreme.
    Dim feature As Object, reverseSide As Boolean, before As Double, after As Double, candidate As String, target(2) As Double, noteText As String
    Dim comBefore As Variant, comAfter As Variant, volumeBefore As Double, volumeAfter As Double, added As Double, centroid As Double, middle As Double, delta As Double
8092     candidate = probeCandidate
8093     If Len(candidate) = 0 Then candidate = "reverse-false"
8094     reverseSide = (Right$(candidate, 12) = "reverse-true")
8095     before = MeasuredExtreme(hemAxis, 1)
8096     volumeBefore = MeasuredVolume(): comBefore = MeasuredCenter()
8097     target(0) = x: target(1) = y: target(2) = z
8098     If Left$(candidate, 15) = "edge-other-face" Then
8099         If Abs(target(hemAxis) - before / 1000#) < 0.000000001 Then target(hemAxis) = target(hemAxis) - thickness Else target(hemAxis) = target(hemAxis) + thickness
    End If
    stepLabel = currentIdentity & ": HemFeature ClearSelection2"
8102     doc.ClearSelection2 True
8103     Pick Geom("edge", target(0), target(1), target(2), dx, dy, dz), False, 0
8104     callInputs = "Type=" & CStr(hemType) & " Position=Inside(" & CStr(swHemPositionTypeInside) & ") Reverse=" & CStr(reverseSide) & " DLength(m)=" & NumberList(Array(length)) & " DGap(m)=" & NumberList(Array(gap)) & " edge(m)=" & NumberList(Array(target(0), target(1), target(2))) & " candidate=" & candidate
    stepLabel = currentIdentity & ": HemFeature InsertSheetMetalHem2"
8106     Set feature = doc.FeatureManager.InsertSheetMetalHem2(hemType, swHemPositionTypeInside, reverseSide, length, gap, 0#, 0#, 0#, Nothing, True, swSheetMetalReliefRectangular, swReliefTearTypeRip, True, 0.5, 0#, 0#)
8107     If feature Is Nothing Then Err.Raise 5, , "InsertSheetMetalHem2 returned no feature: " & callInputs
    stepLabel = currentIdentity & ": HemFeature GetTypeName2"
8109     If feature.GetTypeName2() <> "Hem" Then Err.Raise 5, , "InsertSheetMetalHem2 returned a " & feature.GetTypeName2() & " feature"
8110     after = MeasuredExtreme(hemAxis, 1)
8111     volumeAfter = MeasuredVolume(): comAfter = MeasuredCenter()
8112     added = volumeAfter - volumeBefore
8113     noteText = Mid$("XYZ", hemAxis + 1, 1) & "+ extreme " & Replace(Format$(before, "0.0000"), ",", ".") & " -> " & Replace(Format$(after, "0.0000"), ",", ".") & " mm, recipe side " & IIf(hemSide > 0, "+", "-") & "; COM " & NumberList(Array(comBefore(0), comBefore(1), comBefore(2))) & " -> " & NumberList(Array(comAfter(0), comAfter(1), comAfter(2))) & " mm, added volume " & NumberList(Array(added)) & " mm3"
8114     If added < 0.001 Then
8115         AppendLog currentFolder, currentIdentity, "option", 0, 0, "hem side: " & noteText & "; " & callInputs
8116         Err.Raise 5, , "The hem added no material (" & noteText & "): " & callInputs
    End If
8118     centroid = (volumeAfter * comAfter(hemAxis) - volumeBefore * comBefore(hemAxis)) / added
8119     middle = before - thickness * 1000# / 2#
8120     delta = centroid - middle
8121     noteText = noteText & "; added material centroid " & Mid$("XYZ", hemAxis + 1, 1) & "=" & Replace(Format$(centroid, "0.0000"), ",", ".") & " vs flange mid-plane " & Replace(Format$(middle, "0.0000"), ",", ".")
8122     AppendLog currentFolder, currentIdentity, "option", 0, 0, "hem side: " & noteText & "; " & callInputs
8123     If delta * hemSide <= 0.001 Then Err.Raise 5, , "Hem folded to the wrong side of the flange (" & noteText & "): " & callInputs
8124     probeNote = noteText
8125     Set HemFeature = feature
End Function

