    Dim bodyList As Variant, scopeBefore As Object, scopeError As Long
7968     callInputs = "Initialize(TwoBend) CollectAllCorners(ReliefType=" & CStr(reliefType) & ") size(m)=" & NumberList(Array(sizeValue)) & " relief=" & reliefName
