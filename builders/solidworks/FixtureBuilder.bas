8476                 Exit For
            End If
        Next k
8479         If chosenView < 0 Then Err.Raise 5, , "No view shows the edges for the " & NumberList(Array(dimensionItem(0))) & " dimension between " & NumberList(dimensionItem(1)) & " and " & NumberList(dimensionItem(2)) & " (m)"
8480         Set activeView = views(chosenView)
    stepLabel = currentIdentity & ": BuildDrawing GetOutline"
8482         outline = activeView.GetOutline()
8483         measured = AddDrawingDimension(activeView, plan, IIf(outline(0) > outline(2), outline(0), outline(2)) + layout(6) * (index + 1), IIf(outline(1) > outline(3), outline(1), outline(3)) + layout(6) * (index + 1), CDbl(dimensionItem(0)), "dimension " & CStr(index + 1))
8484         text = ""
    stepLabel = currentIdentity & ": BuildDrawing Count"
8486         For k = 0 To plan.Count - 1
