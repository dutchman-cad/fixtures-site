478     UserNameNotice = "SolidWorks writes your Windows user name into each file it saves. We keep these native files private and publish only STEP and files we've checked clean; to keep your name out of the files entirely, run SolidWorks under a neutral Windows account."
End Function

Private Function NameInsideComponents(ByVal user As String) As Boolean
    ' A word-matched name: 3 or more characters and not a common word. It is matched wherever the characters on both sides are not ASCII
    ' letters or digits (the start of the text, a tab, a quote, a length byte, "-", "_" ...); any other name (and a shorter one) only as a
    ' whole path segment. The same for the user name, the profile folder's own name and the computer, domain and logon-server names.
    Dim inside As Boolean
486     inside = (Len(user) >= 3)
487     If InStr("|admin|user|users|owner|public|default|test|cad|work|data|home|the|and|pro|dev|lab|app|sys|doc|docs|temp|office|pc|laptop|desktop|", "|" & user & "|") > 0 Then inside = False
488     NameInsideComponents = inside
End Function

Private Function IsAsciiAlnum(ByVal ch As String) As Boolean
492     IsAsciiAlnum = (ch Like "[A-Za-z0-9]")
End Function

Private Function WordIn(ByVal text As String, ByVal needle As String) As Boolean
    ' The needle in the text with no ASCII letter or digit next to it (or the edge of the text): both already lower-cased.
    Dim pos As Long, before As String, after As String, found As Boolean
498     If Len(needle) > 0 Then
499         pos = InStr(1, text, needle, vbBinaryCompare)
500         Do While pos > 0 And Not found
501             before = ""
502             after = ""
503             If pos > 1 Then before = Mid$(text, pos - 1, 1)
504             If pos + Len(needle) <= Len(text) Then after = Mid$(text, pos + Len(needle), 1)
505             If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
506             pos = InStr(pos + 1, text, needle, vbBinaryCompare)
        Loop
    End If
509     WordIn = found
End Function

Private Function SegmentMatches(ByVal part As String, ByVal needle As String) As Boolean
    Dim hit As Boolean
514     If Len(needle) > 0 Then hit = (part = needle)
515     If Len(needle) > 0 And Not hit Then
516         If NameInsideComponents(needle) Then hit = WordIn(part, needle)
    End If
518     SegmentMatches = hit
End Function

Private Function NormalPath(ByVal path As String) As String
    Dim p As String
523     p = LCase$(Replace(Trim$(path), "/", "\"))
524     Do While Len(p) > 0 And Right$(p, 1) = "\"
525         p = Left$(p, Len(p) - 1)
    Loop
527     NormalPath = p
End Function

Private Function LeafOf(ByVal normal As String) As String
531     LeafOf = Mid$(normal, InStrRev(normal, "\") + 1)
End Function

Private Function UnderRoot(ByVal p As String, ByVal root As String) As Boolean
    Dim under As Boolean
536     If Len(root) > 0 Then under = (p = root Or Left$(p, Len(root) + 1) = root & "\")
537     UnderRoot = under
End Function

Private Function PersonalPathRefusal(ByVal what As String, ByVal why As String) As String
