Private Sub CheckState(ByVal path As String, ByVal config As Variant, ByVal external As Variant, ByVal flexible As Variant, ByVal mirroredPart As Variant)
    ' What expect.json says of an instance beyond its pose: config (the configuration the component references), external (a file link or a
    ' virtual copy), flexible (the solving option of the subassembly instance it is in) and mirroredPart (it is the new part file).
    Dim topLabel As String, component As Object, direct As Boolean, text As String, virtual As Boolean, solving As Long, stem As String
4939     topLabel = path
4940     If InStr(topLabel, "/") > 0 Then topLabel = Left$(topLabel, InStr(topLabel, "/") - 1)
4941     If InStr(topLabel, "#") > 0 Then topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    stepLabel = currentIdentity & ": CheckState Exists"
4943     If Not components.Exists(topLabel) Then Exit Sub
4944     direct = (InStr(path, "/") = 0)
4945     Set component = components(topLabel)
4946     On Error Resume Next
4947     If direct And Not IsEmpty(config) Then
    stepLabel = currentIdentity & ": CheckState ReferencedConfiguration"
4949         If CStr(component.ReferencedConfiguration) <> CStr(config) Then text = text & path & ": references configuration " & CStr(component.ReferencedConfiguration) & ", expected " & CStr(config) & "; "
    End If
4951     If direct And Not IsEmpty(external) Then
    stepLabel = currentIdentity & ": CheckState IsVirtual"
4953         virtual = component.IsVirtual
4954         If virtual = CBool(external) Then
4955             text = text & path & ": " & IIf(virtual, "a virtual copy", "a link to its own file") & ", expected " & IIf(CBool(external), "a link", "a virtual copy") & "; "
        ElseIf CBool(external) Then
    stepLabel = currentIdentity & ": CheckState GetPathName"
4958             If LCase$(Right$(CStr(component.GetPathName()), 7)) <> ".sldprt" Then text = text & path & ": file " & FileLeaf(CStr(component.GetPathName())) & " is not a part file; "
        End If
    End If
4961     If Not IsEmpty(flexible) Then
    stepLabel = currentIdentity & ": CheckState Solving"
4963         solving = CLng(component.Solving)
4964         If (solving = swComponentFlexibleSolving) <> CBool(flexible) Then text = text & path & ": its subassembly is " & IIf(solving = swComponentFlexibleSolving, "flexible", "rigid") & ", expected " & IIf(CBool(flexible), "flexible", "rigid") & "; "
    End If
4966     If direct And Not IsEmpty(mirroredPart) Then
    stepLabel = currentIdentity & ": CheckState GetPathName"
4968         stem = FileStem(CStr(component.GetPathName()))
    stepLabel = currentIdentity & ": CheckState GetPathName"
4970         If stem <> CStr(mirroredPart) Then text = text & path & ": made from " & FileLeaf(CStr(component.GetPathName())) & ", expected the new part " & CStr(mirroredPart) & "; "
    End If
4972     If Err.Number <> 0 Then text = text & path & ": cannot read its state (" & Err.Description & "); "
4973     On Error GoTo 0
4974     If Len(text) > 0 Then
        ' Each problem of the instance counts once (the text holds "; " between them).
4976         Do While Len(text) > 0
4977             If InStr(text, "; ") > 0 Then
4978                 AddPlacementProblem Left$(text, InStr(text, "; ") - 1)
4979                 text = Mid$(text, InStr(text, "; ") + 2)
            Else
4981                 AddPlacementProblem text
4982                 text = ""
            End If
        Loop
    End If
End Sub

Private Sub CheckBox(ByVal wanted As Variant)
    ' The union of the top-level components' boxes against expect.json's bbox (mm) (A20, where t and R are not scored). IComponent2.GetBox is
    ' padded by about 0.44 mm on every side, so the tolerance is 0.6 mm.
    Dim keyName As Variant, box As Variant, got(5) As Double, i As Long, first As Boolean, worst As Double, component As Object, reason As String
4992     first = True
4993     On Error Resume Next
    stepLabel = currentIdentity & ": CheckBox Keys"
4995     For Each keyName In components.Keys
4996         Set component = components(keyName)
    stepLabel = currentIdentity & ": CheckBox IsSuppressed"
4998         If Not component.IsSuppressed() Then
    stepLabel = currentIdentity & ": CheckBox GetBox"
5000             box = component.GetBox(False, False)
5001             If IsArray(box) Then
5002                 For i = 0 To 2
5003                     If first Or CDbl(box(i)) * 1000# < got(i) Then got(i) = CDbl(box(i)) * 1000#
5004                     If first Or CDbl(box(i + 3)) * 1000# > got(i + 3) Then got(i + 3) = CDbl(box(i + 3)) * 1000#
                Next i
5006                 first = False
            Else
5008                 reason = "component box unavailable"
            End If
        End If
    Next keyName
5012     If Err.Number <> 0 Then reason = Err.Description
5013     On Error GoTo 0
5014     If Len(reason) > 0 Or first Then
5015         AddPlacementProblem "bbox: cannot read it (" & reason & ")"
5016         Exit Sub
    End If
5018     For i = 0 To 5
5019         If Abs(got(i) - CDbl(wanted(i))) > worst Then worst = Abs(got(i) - CDbl(wanted(i)))
    Next i
5021     If worst > 0.6 Then AddPlacementProblem "bbox (" & NoteList(got) & ") mm, expected (" & NoteList(wanted) & ") (box padded about 0.44 mm)"
End Sub

