Private Sub ScanCrashes(ByVal parent As String, ByVal ownName As String, ByVal folder As String, ByVal version As String, ByVal build As String)
    ' Crash guard: an inprogress.txt left in a sibling output folder means that attempt crashed SolidWorks. It is renamed to crashed.txt
    ' (counted once) and, with the crashed.txt files of older runs, its recipe|candidate is skipped in this run, unless it was recorded on
    ' another SolidWorks version or build.
    Dim fs As Object, sub1 As Object, markerPath As String, knownPath As String, channel As Integer, textLine As String, fresh As Boolean
    Dim fields As Variant, sameBuild As Boolean, unitText As String, found As Boolean, lead As String
1191     Set crashedUnits = CreateObject("Scripting.Dictionary")
1192     Set fs = CreateObject("Scripting.FileSystemObject")
1193     On Error Resume Next
    stepLabel = currentIdentity & ": ScanCrashes GetFolder"
1195     For Each sub1 In fs.GetFolder(parent).SubFolders
    stepLabel = currentIdentity & ": ScanCrashes Name"
1197         If InStr(1, sub1.Name, "FixtureBuilder-SolidWorks-", vbTextCompare) = 1 And sub1.Name <> ownName Then
    stepLabel = currentIdentity & ": ScanCrashes BuildPath"
1199             markerPath = fs.BuildPath(sub1.Path, "inprogress.txt")
    stepLabel = currentIdentity & ": ScanCrashes BuildPath"
1201             knownPath = fs.BuildPath(sub1.Path, "crashed.txt")
1202             found = False
    stepLabel = currentIdentity & ": ScanCrashes FileExists"
1204             If fs.FileExists(markerPath) Then
    stepLabel = currentIdentity & ": ScanCrashes FileExists"
1206                 If fs.FileExists(knownPath) Then fs.DeleteFile knownPath, True
    stepLabel = currentIdentity & ": ScanCrashes MoveFile"
1208                 fs.MoveFile markerPath, knownPath
1209                 fresh = True: found = True
            ElseIf fs.FileExists(knownPath) Then
1211                 fresh = False: found = True
            End If
1213             If found Then
1214                 lead = IIf(fresh, "previous run crashed during ", "known crash (crashed.txt): ")
1215                 channel = FreeFile
1216                 Open knownPath For Input As #channel
1217                 Do While Not EOF(channel)
1218                     Line Input #channel, textLine
1219                     fields = Split(textLine, vbTab)
1220                     If UBound(fields) >= 1 Then
1221                         sameBuild = True
1222                         If UBound(fields) >= 3 Then
1223                             If Len(fields(3)) > 0 And fields(3) <> version Then sameBuild = False
                        End If
1225                         If UBound(fields) >= 4 Then
1226                             If Len(fields(4)) > 0 And fields(4) <> build Then sameBuild = False
                        End If
    stepLabel = currentIdentity & ": ScanCrashes Name"
1229                         unitText = fields(0) & " " & fields(1) & " (in " & sub1.Name & ")"
1230                         If sameBuild Then
    stepLabel = currentIdentity & ": ScanCrashes Exists"
1232                             If Not crashedUnits.Exists(fields(0) & "|" & fields(1)) Then crashedUnits.Add fields(0) & "|" & fields(1), sub1.Name
1233                             AppendLog folder, "setup", "crash guard", 0, 0, lead & unitText
                        Else
1235                             AppendLog folder, "setup", "crash guard", 0, 0, lead & unitText & "; recorded on another SolidWorks version or build, not skipped"
                        End If
                    End If
                Loop
1239                 Close #channel
            End If
        End If
    Next sub1
1243     Err.Clear
End Sub

Private Sub ResolveSkips(ByVal folder As String)
    ' A skipped part that a recipe which runs needs is rebuilt in this run (its row is an ordinary ok row).
    Dim i As Long, k As Long, changed As Boolean, parts As Variant, found As Long, rebuilt As String, dependency As String
1249     For i = 0 To 170 - 1
    stepLabel = currentIdentity & ": ResolveSkips Exists"
1251         If skipBuilt.Exists(DesignId(i)) Then found = found + 1
    Next i
1253     If found = 0 Then
1254         AppendLog folder, "setup", "run mode", 0, 0, "run mode: left (no previous results found; building everything)"
1255         Exit Sub
    End If
1257     Do
1258         changed = False
1259         For i = 0 To 170 - 1
    stepLabel = currentIdentity & ": ResolveSkips Exists"
1261             If Not skipBuilt.Exists(DesignId(i)) And Len(DependencyIds(i)) > 0 Then
1262                 parts = Split(DependencyIds(i), ",")
1263                 For k = 0 To UBound(parts)
1264                     dependency = CStr(parts(k))
    stepLabel = currentIdentity & ": ResolveSkips Exists"
1266                     If skipBuilt.Exists(dependency) Then
    stepLabel = currentIdentity & ": ResolveSkips Remove"
1268                         skipBuilt.Remove dependency
1269                         rebuilt = rebuilt & " " & dependency
1270                         found = found - 1
1271                         changed = True
                    End If
                Next k
            End If
        Next i
    Loop While changed
1277     AppendLog folder, "setup", "run mode", 0, 0, "run mode: left (" & CStr(found) & " skipped as already built on " & BuildLabel() & ")"
1278     If Len(rebuilt) > 0 Then AppendLog folder, "setup", "run mode", 0, 0, "rebuilt because a recipe in this run needs them:" & rebuilt
End Sub

