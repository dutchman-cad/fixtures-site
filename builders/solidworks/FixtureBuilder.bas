Private Function MakeZip(ByVal folder As String) As Boolean
    ' folder & ".zip" for the run. Compress-Archive is checked by looking for the file and the error file, not by its exit code alone (field
    ' 2026.11.24.3: exit code 0 and no zip). An old zip or error file is deleted first and before every attempt. Then: all documents closed and a
    ' second Compress-Archive with its error text kept (zip-verify-retry), then a zip written in-process (zip-shell-application). Never raises: the
    ' finish message tells the person what to do by hand. The mitigations are logged in a line of their own.
    Dim zipPath As String, errorFile As String
881     zipPath = folder & ".zip"
882     errorFile = folder & "-zip-error.txt"
883     On Error Resume Next
884     ZipRemoveOld folder
885     If ZipPowerShell(folder, errorFile) Then MakeZip = True: Exit Function
886     Err.Clear
887     AppendLog folder, "setup", "zip", 0, 0, "zip: no zip was written; " & ZipErrorHead(errorFile)
888     RecordMitigation "zip-verify-retry", True, True
    stepLabel = currentIdentity & ": MakeZip CloseAllDocuments"
890     app.CloseAllDocuments True
891     Err.Clear
892     If ZipPowerShell(folder, errorFile) Then
893         fallbackSuccesses("zip-verify-retry") = fallbackSuccesses("zip-verify-retry") + 1
894         AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: the second Compress-Archive wrote the zip"
895         AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
896         MakeZip = True: Exit Function
    End If
898     Err.Clear
899     AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: still no zip; " & ZipErrorHead(errorFile)
900     RecordMitigation "zip-shell-application", True, True
901     If ZipWithShell(folder) Then
902         fallbackSuccesses("zip-shell-application") = fallbackSuccesses("zip-shell-application") + 1
903         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: Shell.Application wrote the zip"
904         MakeZip = True
    Else
906         Err.Clear
907         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: no zip either; the folder is complete, the person zips it by hand"
    End If
909     AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
End Function

