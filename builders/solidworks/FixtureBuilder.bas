5990         For Each item In existing
5991             If Len(names) > 0 Then names = names & ", "
5992             names = names & CStr(item)
5993             If CStr(item) = configName Then Err.Raise 5, , "Configuration " & configName & " already exists (existing: " & names & ")"
        Next item
