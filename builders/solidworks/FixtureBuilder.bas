Private Function ProfileStartLocal(ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' The circle center of a profile on the plane normal to a helix: the helix start SolidWorks built, not the recipe's expected point.
9678     If helixStartKnown Then
9679         ProfileStartLocal = LocalPoint(helixStart(0), helixStart(1), helixStart(2))
    Else
9681         ProfileStartLocal = LocalPoint(x, y, z)
    End If
End Function

Private Sub VerifyProfilePlane()
    ' The sketch plane must contain the helix start and be perpendicular to the helix there (1e-6 m, 1e-4 rad), by the sketch's own
    ' ModelToSketchTransform: the sketch z of the start is 0 and the sketch normal (column 3 of the rotation) is the helix tangent.
    Dim matrix As Variant, localValues As Variant, first As Long, dotValue As Double, angle As Double, farValues As Variant, farAngle As Double, i As Long, originValues As Variant
9689     If Not helixStartKnown Then Exit Sub
    stepLabel = currentIdentity & ": VerifyProfilePlane ModelToSketchTransform"
9691     matrix = TransformValues(doc.SketchManager.ActiveSketch.ModelToSketchTransform)
9692     If Not MatrixUsable(matrix) Then Err.Raise 5, , "The profile plane transform is unusable, so the plane could not be checked against the helix start"
9693     localValues = MatrixPoint(matrix, helixStart(0), helixStart(1), helixStart(2))
9694     first = LBound(matrix)
9695     dotValue = Abs(CDbl(matrix(first + 2)) * helixTangent(0) + CDbl(matrix(first + 5)) * helixTangent(1) + CDbl(matrix(first + 8)) * helixTangent(2))
9696     If dotValue > 1# Then dotValue = 1#
9697     If dotValue < 0.000000000001 Then
9698         angle = 1.5707963267949
    Else
9700         angle = Atn(Sqr(1# - dotValue * dotValue) / dotValue)
    End If
9702     AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "helix start in the sketch (m) = " & NumberList(Array(CDbl(localValues(0)), CDbl(localValues(1)), CDbl(localValues(2)))) & _
        "; the plane normal is " & NumberList(Array(angle)) & " rad off the helix tangent"
9704     originValues = MatrixInversePoint(matrix, 0#, 0#, 0#)
9705     diagPlaneText = NoteList(Array(CDbl(originValues(0)) * 1000#, CDbl(originValues(1)) * 1000#, CDbl(originValues(2)) * 1000#)) & " n=" & NoteList(Array(CDbl(matrix(first + 2)), CDbl(matrix(first + 5)), CDbl(matrix(first + 8)))) & " a=" & NoteNumber(angle * 57.2957795130823)
9706     NoteProbe
9707     If Abs(CDbl(localValues(2))) > 0.000001 And helixEndKnown Then
        ' Round 11 (field, W01a/c/d/e/g): the plane went through the curve END (SolidWorks picked the far vertex). A whole number of turns has the
        ' same tangent there, so the plane is still a valid profile plane: put the circle where the plane is, and sweep from there.
9710         farValues = MatrixPoint(matrix, helixEnd(0), helixEnd(1), helixEnd(2))
9711         dotValue = Abs(CDbl(matrix(first + 2)) * helixEndTangent(0) + CDbl(matrix(first + 5)) * helixEndTangent(1) + CDbl(matrix(first + 8)) * helixEndTangent(2))
9712         If dotValue > 1# Then dotValue = 1#
9713         If dotValue < 0.000000000001 Then
9714             farAngle = 1.5707963267949
        Else
9716             farAngle = Atn(Sqr(1# - dotValue * dotValue) / dotValue)
        End If
9718         AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "helix END in the sketch (m) = " & NumberList(Array(CDbl(farValues(0)), CDbl(farValues(1)), CDbl(farValues(2)))) & _
            "; the plane normal is " & NumberList(Array(farAngle)) & " rad off the tangent there"
9720         If Abs(CDbl(farValues(2))) <= 0.000001 Then
9721             RecordMitigation "profile-plane-through-curve-end", True, True
9722             fallbackSuccesses("profile-plane-through-curve-end") = fallbackSuccesses("profile-plane-through-curve-end") + 1
9723             For i = 0 To 2
9724                 helixStart(i) = helixEnd(i)
9725                 helixTangent(i) = helixEndTangent(i)
            Next i
9727             localValues = farValues
9728             angle = farAngle
9729             AppendLog currentFolder, currentIdentity, "profile plane", 0, 0, "the plane passes through the curve END, so the profile circle goes there"
        End If
    End If
9732     If Abs(CDbl(localValues(2))) > 0.000001 Then Err.Raise 5, , "The profile plane does not contain the helix start: its sketch z is " & NumberList(Array(CDbl(localValues(2)))) & " m at the helix start"
9733     If angle > 0.0001 Then Err.Raise 5, , "The profile plane is not perpendicular to the helix: its normal is " & NumberList(Array(angle)) & " rad off the helix tangent at the start"
End Sub

