Private Sub SweepFolder(ByVal fs As Object, ByVal dirPath As String, ByRef notes As String)
    Dim item As Object, list As String, entries As Variant, i As Long, here As Object, children As Object
2278     On Error Resume Next
2279     Err.Clear
2280     Set here = fs.GetFolder(dirPath)
2281     If Err.Number = 0 Then Set children = here.Files
2282     If Err.Number = 0 Then
2283         For Each item In children
2284             list = list & item.Path & vbLf
        Next item
    End If
2287     If Err.Number <> 0 Then SweepListFailure dirPath, notes
2288     entries = Split(list, vbLf)
2289     For i = 0 To UBound(entries)
2290         If Len(entries(i)) > 0 Then SweepFile fs, CStr(entries(i)), notes
    Next i
2292     list = ""
2293     If Not here Is Nothing Then Set children = here.SubFolders
2294     If Err.Number = 0 And Not here Is Nothing Then
2295         For Each item In children
2296             list = list & item.Path & vbLf
        Next item
    End If
2299     If Err.Number <> 0 Then SweepListFailure dirPath, notes
2300     entries = Split(list, vbLf)
2301     For i = 0 To UBound(entries)
2302         If Len(entries(i)) > 0 Then SweepFolder fs, CStr(entries(i)), notes
    Next i
End Sub

Private Function PrivacySweep(ByVal folder As String) As String
    ' Before the zip: EVERY file in the output folder, listed in results.json or not. Returns the notes (files truncated or removed).
