6057         Exit Function
    End If
    stepLabel = currentIdentity & ": CheckSavedStates OpenDoc6"
6060     Set model = app.OpenDoc6(path, swDocASSEMBLY, swOpenDocOptions_Silent, "", errors, warnings)
