Private Function MatrixUsable(ByVal matrix As Variant) As Boolean
    ' IMathTransform.ArrayData: rotation 0-8, translation 9-11, scale 12.
    Dim i As Long, j As Long, k As Long, first As Long, dot As Double, expected As Double
6302     If Not IsArray(matrix) Then Exit Function
6303     first = LBound(matrix)
6304     If UBound(matrix) - first < 12 Then Exit Function
6305     For i = 0 To 12
6306         If Not IsNumeric(matrix(first + i)) Then Exit Function
    Next i
6308     For i = 0 To 2
6309         For j = 0 To 2
6310             dot = 0#
6311             For k = 0 To 2
6312                 dot = dot + CDbl(matrix(first + 3 * i + k)) * CDbl(matrix(first + 3 * j + k))
            Next k
6314             expected = 0#
6315             If i = j Then expected = 1#
6316             If Abs(dot - expected) > 0.000001 Then Exit Function
        Next j
    Next i
6319     MatrixUsable = Abs(CDbl(matrix(first + 12))) > 0.000000001
End Function

Private Function MatrixPoint(ByVal matrix As Variant, ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' Row-vector convention: local = (p x R) * scale + translation.
    Dim first As Long, scaleFactor As Double, result(2) As Double, j As Long
6325     first = LBound(matrix)
6326     scaleFactor = CDbl(matrix(first + 12))
6327     For j = 0 To 2
6328         result(j) = (x * CDbl(matrix(first + j)) + y * CDbl(matrix(first + 3 + j)) + z * CDbl(matrix(first + 6 + j))) * scaleFactor + CDbl(matrix(first + 9 + j))
    Next j
6330     MatrixPoint = Array(result(0), result(1), result(2))
End Function

