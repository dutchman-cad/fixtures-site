9057         Exit Sub
    End If
9059     pitchCount = "n/a"
9060     If wantVariable Then
9061         pitchCount = "unreadable"
9062         On Error Resume Next
    stepLabel = currentIdentity & ": HelixReadBack PitchCount"
9064         pitchCount = CStr(helixData.PitchCount)
9065         If Err.Number <> 0 Then pitchCount = "unreadable"
9066         Err.Clear
9067         On Error GoTo 0
    End If
    stepLabel = currentIdentity & ": HelixReadBack VariablePitch"
9070     variableFlag = helixData.VariablePitch
    stepLabel = currentIdentity & ": HelixReadBack DefinedBy"
9072     text = label & ": DefinedBy=" & CStr(helixData.DefinedBy) & " Height=" & NumberList(Array(helixData.Height * 1000#)) & " mm Pitch=" & NumberList(Array(helixData.Pitch * 1000#)) & _
        " mm Revolution=" & NumberList(Array(helixData.Revolution)) & " StartingAngle=" & NumberList(Array(helixData.StartingAngle * 180# / 3.14159265358979)) & _
        " deg Clockwise=" & YesNo(helixData.Clockwise) & " ReverseDirection=" & YesNo(helixData.ReverseDirection) & " Taper=" & YesNo(helixData.Taper) & _
        " TaperAngle=" & NumberList(Array(helixData.TaperAngle * 180# / 3.14159265358979)) & " deg TaperOutward=" & YesNo(helixData.TaperOutward) & _
        " VariablePitch=" & YesNo(variableFlag) & " PitchCount=" & pitchCount
9077     AppendLog currentFolder, currentIdentity, "helix read-back", 0, 0, text
9078     If expected(0) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Height"
9080         If Abs(helixData.Height - expected(0)) > 0.000000001 Then problems = problems & "; Height " & NumberList(Array(helixData.Height * 1000#)) & ", expected " & NumberList(Array(expected(0) * 1000#))
    End If
9082     If expected(1) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Pitch"
9084         If Abs(helixData.Pitch - expected(1)) > 0.000000001 Then problems = problems & "; Pitch " & NumberList(Array(helixData.Pitch * 1000#)) & ", expected " & NumberList(Array(expected(1) * 1000#))
    End If
9086     If expected(2) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Revolution"
9088         If Abs(helixData.Revolution - expected(2)) > 0.000001 Then problems = problems & "; Revolution " & NumberList(Array(helixData.Revolution)) & ", expected " & NumberList(Array(expected(2)))
    End If
9090     If wantVariable And Not variableFlag Then problems = problems & "; VariablePitch False, expected a variable-pitch helix"
9091     If wantVariable And IsNumeric(pitchCount) Then
