Private Sub DragComponent(ByVal path As String, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double)
    ' The ladder of one drag, on the handle the route in childRoutes finds (A24). Where it ends up is read from IComponent2.GetBox, the truth when GetTotalTransform
    ' disagrees (field 2026.11.24.3). The ladder: 1 SetTransformAndSolve2 with the WORLD transform (GetTotalTransform moved by the shift,
    ' flexible-move-world-transform), 2 SetTransformAndSolve2 with the child's local transform (Transform2 moved by the shift), 3 Transform2 put and the
    ' assembly rebuilt (2 and 3 are flexible-move-transform2). Round 22 (field 2026.11.24.6, SolidWorks 2023: SetTransformAndSolve2 answered True for every
    ' handle and moved nothing): rung 0 is the assembly's drag operator (DragOperatorMove, flexible-move-drag-operator). After EVERY rung "moved" is judged from a
    ' part found again through the top assembly (FreshChild), never from the handle kept from before the move (it goes stale).
    Dim component As Object, kept As Object, before As Variant, current As Variant, wanted As Variant, boxBefore As Variant, worldTransform As Object, localTransform As Object
    Dim solvedWorld As Boolean, solvedLocal As Boolean, shiftText As String, dragText As String, start As Object, startValues As Variant, mateText As String
3144     Set component = LocateComponent(path)
3145     Set kept = component
    ' Round 22: the starting pose and box are those of the part found through the top assembly (FreshChild), not of the handle the moves are made on.
3147     Set start = FreshChild(path)
    stepLabel = currentIdentity & ": DragComponent GetTotalTransform"
3149     startValues = start.GetTotalTransform(True).ArrayData
3150     before = Array(CDbl(startValues(9)) * 1000#, CDbl(startValues(10)) * 1000#, CDbl(startValues(11)) * 1000#)
3151     boxBefore = BoxCentre(start)
3152     If IsArray(boxBefore) Then movedParts(path) = Array(before, boxBefore)
3153     wanted = Array(CDbl(before(0)) + shiftX, CDbl(before(1)) + shiftY, CDbl(before(2)) + shiftZ)
3154     shiftText = "[" & NoteNumber(shiftX) & ", " & NoteNumber(shiftY) & ", " & NoteNumber(shiftZ) & "]"
3155     Set worldTransform = MovedTransform(startValues, shiftX, shiftY, shiftZ)
    stepLabel = currentIdentity & ": DragComponent ArrayData"
3157     Set localTransform = MovedTransform(component.Transform2.ArrayData, shiftX, shiftY, shiftZ)
3158     RecordMitigation "flexible-move-drag-operator"
3159     dragText = DragOperatorMove(start, shiftX, shiftY, shiftZ)
3160     If MoveRead(path, dragText, shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then Exit Sub
    ' Round 23 (field 2026.11.25.1, SolidWorks 2026): SetTransformAndSolve2 answered True and put the pin at its subassembly-local pose (0,0,10) for every handle,
    ' so before it the pin is moved by a TEMPORARY Concentric mate to a reference axis through the wanted place, deleted afterwards (TemporaryMateMove).
3163     If TemporaryMateMove(path, start, shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, mateText) Then Exit Sub
3164     dragText = dragText & "; " & mateText
3165     RecordMitigation "flexible-move-world-transform"
    stepLabel = currentIdentity & ": DragComponent SetTransformAndSolve2"
3167     solvedWorld = component.SetTransformAndSolve2(worldTransform)
3168     If MoveRead(path, "SetTransformAndSolve2 with the world transform returned " & CStr(solvedWorld), shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then Exit Sub
3169     RecordMitigation "flexible-move-transform2", True, True
3170     Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": DragComponent SetTransformAndSolve2"
3172     solvedLocal = component.SetTransformAndSolve2(localTransform)
3173     If Not MoveRead(path, "SetTransformAndSolve2 with the local transform returned " & CStr(solvedLocal), shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then
3174         Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": DragComponent Transform2"
3176         Set component.Transform2 = localTransform
    stepLabel = currentIdentity & ": DragComponent EditRebuild3"
3178         If Not doc.EditRebuild3() Then Err.Raise 5, , "Rebuild after moving the component failed"
3179         If Not MoveRead(path, "Transform2 put and the assembly rebuilt", shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then
3180             Err.Raise 5, , "The part " & path & " did not move by " & shiftText & " mm: " & dragText & "; SetTransformAndSolve2 returned " & CStr(solvedWorld) & " with the world transform and " & CStr(solvedLocal) & " with the local transform, it stayed at (" & NoteList(before) & ") and after Transform2 it is at (" & NoteList(current) & "), wanted (" & NoteList(wanted) & "); is its subassembly flexible?"
        End If
    End If
3183     fallbackSuccesses("flexible-move-transform2") = fallbackSuccesses("flexible-move-transform2") + 1
End Sub

