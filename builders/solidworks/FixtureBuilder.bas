Private Sub MoveComponent(ByVal path As String, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double)
    ' Drag a part of a flexible subassembly in the top assembly (A24). The part is found through the top assembly by the routes of FindChild in turn
    ' (SolidWorks 2021, field 2026.11.24.4: the pin handle taken from the subassembly's own tree read the local transform and box, so every try moved
    ' nothing in the top assembly); each handle is read BEFORE the move (ChildCheck, logged with the route) and the first one that reads where the top
    ' assembly has the part is moved by the ladder of DragComponent. A handle of an instance that stands at the origin cannot be told from the part by
    ' that reading (local and world agree), so when a ladder fails the next route is read again: where the part stands is where it stood (the earlier try
    ' moved nothing: it is dragged on that route) or at the wanted place (the earlier try moved it), and anywhere else the state is unknown and the recipe
    ' fails. A route other than the first is flexible-child-from-top-instance. Where no route reads right, the ladder runs on the first handle that was
    ' found all the same, and the error carries what each route found.
    Dim route As Long, ok As Boolean, text As String, notes As String, firstFound As Long, i As Long, totalNow As Variant, expectedNow As Variant
    Dim origin As Variant, haveOrigin As Boolean, failed As Boolean, failureText As String, shifts As Variant, movedAway As Double, unmoved As Double
3116     shifts = Array(shiftX, shiftY, shiftZ)
3117     firstFound = -1
3118     For route = 0 To 3
3119         If RouteHandle(path, route, ok, text, totalNow, expectedNow) Then
3120             NoteOption "locate " & path & ": " & RouteText(route) & " found the part before the move: " & text
3121             If firstFound < 0 Then firstFound = route
3122             If Not haveOrigin Then
3123                 origin = expectedNow
3124                 haveOrigin = True
            End If
3126             If Len(notes) > 0 Then notes = notes & " | "
3127             notes = notes & RouteText(route) & ": " & text
3128             If ok Then
3129                 If failed Then
                    ' An earlier ladder failed: where does the part stand now?
3131                     movedAway = 0
3132                     unmoved = 0
3133                     For i = 0 To 2
3134                         If Abs(CDbl(totalNow(i)) - CDbl(origin(i)) - CDbl(shifts(i))) > movedAway Then movedAway = Abs(CDbl(totalNow(i)) - CDbl(origin(i)) - CDbl(shifts(i)))
3135                         If Abs(CDbl(totalNow(i)) - CDbl(origin(i))) > unmoved Then unmoved = Abs(CDbl(totalNow(i)) - CDbl(origin(i)))
                    Next i
3137                     If movedAway <= 0.01 Then
3138                         childRoutes(path) = route
3139                         NoteOption "locate " & path & ": " & RouteText(route) & " reads the part at the wanted place: the earlier try had moved it"
3140                         Exit Sub
                    End If
3142                     If unmoved > 0.01 Then Exit For
                End If
3144                 On Error Resume Next
3145                 DragOnRoute path, route, shiftX, shiftY, shiftZ, notes
3146                 If Err.Number = 0 Then
3147                     On Error GoTo 0
3148                     Exit Sub
                End If
3150                 If Not failed Then failureText = Err.Description
3151                 failed = True
3152                 Err.Clear
3153                 On Error GoTo 0
            End If
        Else
3156             NoteOption "locate " & path & ": " & RouteText(route) & " " & text
3157             If Len(notes) > 0 Then notes = notes & " | "
3158             notes = notes & RouteText(route) & ": " & text
        End If
    Next route
3161     If failed Then Err.Raise 5, , failureText
3162     If firstFound < 0 Then Err.Raise 5, , "No route finds the part " & path & " in the top assembly: " & notes
3163     DragOnRoute path, firstFound, shiftX, shiftY, shiftZ, notes
End Sub

Private Sub DragOnRoute(ByVal path As String, ByVal route As Long, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double, ByVal notes As String)
    ' The ladder of DragComponent on the part the route found; flexible-child-from-top-instance when the route is not the first.
    Dim errorText As String
3169     If route > 0 Then RecordMitigation "flexible-child-from-top-instance", True, True
3170     childRoutes(path) = route
3171     On Error GoTo Failed
3172     DragComponent path, shiftX, shiftY, shiftZ
3173     On Error GoTo 0
3174     If route > 0 Then fallbackSuccesses("flexible-child-from-top-instance") = fallbackSuccesses("flexible-child-from-top-instance") + 1
3175     Exit Sub
Failed:
3177     errorText = Err.Description
3178     Err.Clear
    stepLabel = currentIdentity & ": DragOnRoute Exists"
3180     If childRoutes.Exists(path) Then childRoutes.Remove path
3181     If InStr(notes, " | ") > 0 Then errorText = errorText & " [handles read before the move: " & notes & "]"
3182     Err.Raise 5, , errorText
End Sub

Private Sub DragComponent(ByVal path As String, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double)
    ' The ladder of one drag, on the handle the route in childRoutes finds (A24). Where it ends up is read from IComponent2.GetBox, the truth when GetTotalTransform
    ' disagrees (field 2026.11.24.3). The ladder: 1 SetTransformAndSolve2 with the WORLD transform (GetTotalTransform moved by the shift,
    ' flexible-move-world-transform), 2 SetTransformAndSolve2 with the child's local transform (Transform2 moved by the shift), 3 Transform2 put and the
    ' assembly rebuilt (2 and 3 are flexible-move-transform2). Round 22 (field 2026.11.24.6, SolidWorks 2023: SetTransformAndSolve2 answered True for every
    ' handle and moved nothing): rung 0 is the assembly's drag operator (DragOperatorMove, flexible-move-drag-operator). After EVERY rung "moved" is judged from a
    ' part found again through the top assembly (FreshChild), never from the handle kept from before the move (it goes stale).
    Dim component As Object, kept As Object, before As Variant, current As Variant, wanted As Variant, boxBefore As Variant, worldTransform As Object, localTransform As Object
    Dim solvedWorld As Boolean, solvedLocal As Boolean, shiftText As String, dragText As String, start As Object, startValues As Variant, mateText As String
3194     Set component = LocateComponent(path)
3195     Set kept = component
    ' Round 22: the starting pose and box are those of the part found through the top assembly (FreshChild), not of the handle the moves are made on.
3197     Set start = FreshChild(path)
    stepLabel = currentIdentity & ": DragComponent GetTotalTransform"
3199     startValues = start.GetTotalTransform(True).ArrayData
3200     before = Array(CDbl(startValues(9)) * 1000#, CDbl(startValues(10)) * 1000#, CDbl(startValues(11)) * 1000#)
3201     boxBefore = BoxCentre(start)
3202     If IsArray(boxBefore) Then movedParts(path) = Array(before, boxBefore)
3203     wanted = Array(CDbl(before(0)) + shiftX, CDbl(before(1)) + shiftY, CDbl(before(2)) + shiftZ)
3204     shiftText = "[" & NoteNumber(shiftX) & ", " & NoteNumber(shiftY) & ", " & NoteNumber(shiftZ) & "]"
3205     Set worldTransform = MovedTransform(startValues, shiftX, shiftY, shiftZ)
    stepLabel = currentIdentity & ": DragComponent ArrayData"
3207     Set localTransform = MovedTransform(component.Transform2.ArrayData, shiftX, shiftY, shiftZ)
3208     RecordMitigation "flexible-move-drag-operator"
3209     dragText = DragOperatorMove(start, shiftX, shiftY, shiftZ)
3210     If MoveRead(path, dragText, shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then Exit Sub
    ' Round 23 (field 2026.11.25.1, SolidWorks 2026): SetTransformAndSolve2 answered True and put the pin at its subassembly-local pose (0,0,10) for every handle,
    ' so before it the pin is moved by a TEMPORARY Concentric mate to a reference axis through the wanted place, deleted afterwards (TemporaryMateMove).
3213     If TemporaryMateMove(path, start, shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, mateText) Then Exit Sub
3214     dragText = dragText & "; " & mateText
3215     RecordMitigation "flexible-move-world-transform"
    stepLabel = currentIdentity & ": DragComponent SetTransformAndSolve2"
3217     solvedWorld = component.SetTransformAndSolve2(worldTransform)
3218     If MoveRead(path, "SetTransformAndSolve2 with the world transform returned " & CStr(solvedWorld), shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then Exit Sub
3219     RecordMitigation "flexible-move-transform2", True, True
3220     Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": DragComponent SetTransformAndSolve2"
3222     solvedLocal = component.SetTransformAndSolve2(localTransform)
3223     If Not MoveRead(path, "SetTransformAndSolve2 with the local transform returned " & CStr(solvedLocal), shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then
3224         Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": DragComponent Transform2"
3226         Set component.Transform2 = localTransform
    stepLabel = currentIdentity & ": DragComponent EditRebuild3"
3228         If Not doc.EditRebuild3() Then Err.Raise 5, , "Rebuild after moving the component failed"
3229         If Not MoveRead(path, "Transform2 put and the assembly rebuilt", shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, current) Then
3230             Err.Raise 5, , "The part " & path & " did not move by " & shiftText & " mm: " & dragText & "; SetTransformAndSolve2 returned " & CStr(solvedWorld) & " with the world transform and " & CStr(solvedLocal) & " with the local transform, it stayed at (" & NoteList(before) & ") and after Transform2 it is at (" & NoteList(current) & "), wanted (" & NoteList(wanted) & "); is its subassembly flexible?"
        End If
    End If
3233     fallbackSuccesses("flexible-move-transform2") = fallbackSuccesses("flexible-move-transform2") + 1
End Sub

Private Function FreshChild(ByVal path As String) As Object
    ' The part found again through the top assembly (the component tree, route 3; else by the route it was found by): what a move is judged from. A handle
    ' kept from before the move goes stale (field 2026.11.24.6: it read the old pose after the part had moved).
    Dim found As Object
3240     If InStr(path, "/") > 0 Then
3241         On Error Resume Next
3242         Set found = LocateComponent(path, 3)
3243         If Err.Number <> 0 Then Set found = Nothing
3244         Err.Clear
3245         On Error GoTo 0
    End If
3247     If found Is Nothing Then Set found = LocateComponent(path)
3248     Set FreshChild = found
End Function

Private Function DragOperatorMove(ByVal component As Object, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double) As String
    ' The first rung of a drag (flexible-move-drag-operator): IAssemblyDoc.GetDragOperator, AddComponent(part, False), collision detection off, DragMode minimum move,
    ' TransformType translation, BeginDrag, Drag(translation) and EndDrag, on the part found through the top assembly (a handle the route found can be the subassembly document's own, which the operator would not move). The text says what every call answered (it goes into the log
    ' and the error); a failure of any call is not raised, the next rung is tried.
    Dim dragOperator As Object, translation As Object, steps As String, began As Boolean, answer As Boolean, second As Boolean, selected As Object, selectionNote As String
3256     Set topHandle = Nothing
3257     topHandleTried = False
3258     On Error GoTo Failed
    stepLabel = currentIdentity & ": DragOperatorMove GetDragOperator"
3260     Set dragOperator = AssemblyDocument(doc).GetDragOperator()
3261     If dragOperator Is Nothing Then
3262         DragOperatorMove = "GetDragOperator returned Nothing"
3263         Exit Function
    End If
    ' Round 23 (field 2026.11.25.1, SolidWorks 2026: AddComponent answered False for the handle found through the top assembly's component tree, the operator did
    ' nothing): the part is selected by its full path and the operator is given the component ISelectionMgr.GetSelectedObjectsComponent4 answers, the part as the
    ' top assembly sees it; the handle used before is the fallback when that one is refused or there is none.
3268     Set selected = SelectedComponent(component, selectionNote)
    stepLabel = currentIdentity & ": DragOperatorMove Name2"
3270     NoteOption "drag handle of " & CStr(component.Name2) & ": " & selectionNote
3271     Set topHandle = selected
3272     topHandleTried = True
3273     If selected Is Nothing Then
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3275         answer = dragOperator.AddComponent(component, False)
3276         steps = "AddComponent returned " & CStr(answer)
    Else
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3279         answer = dragOperator.AddComponent(selected, False)
3280         steps = "AddComponent returned " & CStr(answer)
3281         If Not answer Then
    stepLabel = currentIdentity & ": DragOperatorMove AddComponent"
3283             second = dragOperator.AddComponent(component, False)
3284             steps = "AddComponent returned " & CStr(answer) & " (selected handle) and " & CStr(second) & " (current handle)"
        End If
    End If
3287     On Error Resume Next
    stepLabel = currentIdentity & ": DragOperatorMove CollisionDetectionEnabled"
3289     dragOperator.CollisionDetectionEnabled = False
3290     If Err.Number <> 0 Then
3291         steps = steps & ", CollisionDetectionEnabled raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
    Else
3293         steps = steps & ", CollisionDetectionEnabled = False"
    End If
3295     Err.Clear
3296     On Error GoTo Failed
    stepLabel = currentIdentity & ": DragOperatorMove DragMode"
3298     dragOperator.DragMode = swDragModeMinimumMove
    stepLabel = currentIdentity & ": DragOperatorMove TransformType"
3300     dragOperator.TransformType = swDragTransformTranslation
3301     Set translation = MovedTransform(Array(1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#, 1#, 0#, 0#, 0#), shiftX, shiftY, shiftZ)
    stepLabel = currentIdentity & ": DragOperatorMove BeginDrag"
3303     began = dragOperator.BeginDrag()
3304     steps = steps & ", BeginDrag returned " & CStr(began)
3305     If began Then
    stepLabel = currentIdentity & ": DragOperatorMove Drag"
3307         answer = dragOperator.Drag(translation)
3308         steps = steps & ", Drag returned " & CStr(answer)
    stepLabel = currentIdentity & ": DragOperatorMove EndDrag"
3310         dragOperator.EndDrag
3311         steps = steps & ", EndDrag called"
    End If
3313     DragOperatorMove = "IDragOperator: " & steps
3314     Exit Function
Failed:
3316     steps = steps & ", raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
3317     Err.Clear
3318     If began Then
3319         On Error Resume Next
    stepLabel = currentIdentity & ": DragOperatorMove EndDrag"
3321         dragOperator.EndDrag
3322         Err.Clear
3323         On Error GoTo 0
    End If
3325     DragOperatorMove = "IDragOperator: " & steps
End Function

Private Function SelectedComponent(ByVal component As Object, ByRef note As String) As Object
