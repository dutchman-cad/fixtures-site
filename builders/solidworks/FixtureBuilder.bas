Private Function ArrayItems(ByVal value As Variant, ByRef lower As Long, ByRef upper As Long) As Boolean
    ' True when value is an allocated, non-empty array; lower and upper are its bounds (any base: a COM array can be 1-based). An unallocated or empty
    ' array (what SolidWorks answers for "none") makes UBound raise Err 9 "Subscript out of range" and answers False here.
4041     On Error Resume Next
4042     lower = 0
4043     upper = -1
4044     If IsArray(value) Then
4045         lower = LBound(value)
4046         upper = UBound(value)
4047         If Err.Number <> 0 Then
4048             lower = 0
4049             upper = -1
        End If
    End If
4052     ArrayItems = (upper >= lower)
4053     Err.Clear
4054     On Error GoTo 0
End Function

Private Function ItemAt(ByVal list As Variant, ByVal index As Long, ByRef entry As Object, ByRef reason As String) As Boolean
    ' list(index) as an object, read inside a guard: an element that cannot be indexed or is not an object (Empty, Nothing, a number) answers False with the
    ' reason, instead of ending the recipe with Err 9 "Subscript out of range" (SolidWorks 2023, field 2026.11.24.6: an A20 ended so, with nothing in the log).
4060     On Error Resume Next
4061     Set entry = Nothing
4062     Set entry = list(index)
4063     If Err.Number <> 0 Then
4064         reason = "item " & CStr(index) & " cannot be read (Err " & CStr(Err.Number) & " " & Err.Description & ")"
4065         ItemAt = False
    ElseIf entry Is Nothing Then
4067         reason = "item " & CStr(index) & " is Nothing"
4068         ItemAt = False
    Else
4070         ItemAt = True
    End If
4072     Err.Clear
4073     On Error GoTo 0
End Function

Private Function TypedEmpty(ByVal kind As Long) As Variant
    ' A zero-length array of one element type (0 Object, 1 Long, else String) for the "typed empty arrays" form of MirrorComponents3. Never made with
    ' ReDim x(0 To -1): that raises Err 9 "Subscript out of range" in VBA (A20 of the field run 2026.11.24.6 ended there, before any log line). An unallocated
    ' typed array is passed as it is (an unset array, as C# passes null); strings come from Split(""), which is documented to give an empty array. Where
    ' even that raises, VBA's Array() is used and the log says so.
    Dim emptyObjects() As Object, emptyLongs() As Long
4082     On Error Resume Next
4083     Select Case kind
        Case 0: TypedEmpty = emptyObjects
        Case 1: TypedEmpty = emptyLongs
        Case Else: TypedEmpty = Split("")
    End Select
4088     If Err.Number <> 0 Then
4089         NoteOption "an empty array of kind " & CStr(kind) & " could not be made (Err " & CStr(Err.Number) & " " & Err.Description & "); Array() is used"
4090         Err.Clear
4091         TypedEmpty = Array()
    End If
4093     On Error GoTo 0
End Function

