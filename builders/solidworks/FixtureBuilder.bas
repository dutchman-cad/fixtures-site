Private Sub ActivateConfiguration(ByVal model As Object, ByVal configName As String, ByVal what As String)
    ' ShowConfiguration2 with the active configuration checked first. Round 8 (field, 34.4.0, A08a/A08b): it returned
    ' False for the configuration that was already active (the new one right after AddConfiguration, and the one a
    ' reopened file starts in), though switching to another configuration returned True each time. So an
    ' already-active configuration is not asked for again, and a False return counts only when the active
    ' configuration is not the wanted one afterwards.
    Dim shown As Boolean, nowActive As String
    stepLabel = currentIdentity & ": ActivateConfiguration Name"
5795     If model.ConfigurationManager.ActiveConfiguration.Name = configName Then
5796         RecordMitigation "showconfiguration-already-active", False, True
5797         Exit Sub
    End If
    stepLabel = currentIdentity & ": ActivateConfiguration ShowConfiguration2"
5800     shown = model.ShowConfiguration2(configName)
    stepLabel = currentIdentity & ": ActivateConfiguration Name"
5802     nowActive = model.ConfigurationManager.ActiveConfiguration.Name
5803     If nowActive = configName Then
5804         If Not shown Then
5805             RecordMitigation "showconfiguration-false-but-active", True, True
5806             fallbackSuccesses("showconfiguration-false-but-active") = fallbackSuccesses("showconfiguration-false-but-active") + 1
        End If
5808         Exit Sub
    End If
5810     Err.Raise 5, , "Cannot activate " & what & " " & configName & ": ShowConfiguration2 returned " & CStr(shown) & " and the active configuration is " & nowActive
End Sub

Private Sub AddConfigurationState(ByVal configName As String, ByVal targets As Variant, ByVal requestedActive As String)
    ' A second configuration with some components suppressed in it.
    Dim configManager As Object, config As Object, existing As Variant, item As Variant, names As String
    Dim master As String, wanted As String, entry As Object, component As Object
    Dim instance As String, statuses As String, attempt As Long, status As Long
    stepLabel = currentIdentity & ": AddConfigurationState ConfigurationManager"
5819     Set configManager = doc.ConfigurationManager
5820     Require configManager, "Configuration manager unavailable"
    stepLabel = currentIdentity & ": AddConfigurationState GetConfigurationNames"
5822     existing = doc.GetConfigurationNames()
5823     If Not IsEmpty(existing) Then
5824         For Each item In existing
5825             If Len(names) > 0 Then names = names & ", "
5826             names = names & CStr(item)
5827             If CStr(item) = configName Then Err.Raise 5, , "Configuration " & configName & " already exists (existing: " & names & ")"
        Next item
    End If
    stepLabel = currentIdentity & ": AddConfigurationState ActiveConfiguration"
5831     Set config = configManager.ActiveConfiguration
5832     Require config, "No active configuration"
    stepLabel = currentIdentity & ": AddConfigurationState Name"
5834     master = config.Name
    ' Options 0: no alternate name, BOM, suppress-by-default or hide-by-default flags.
    stepLabel = currentIdentity & ": AddConfigurationState AddConfiguration"
5837     Set config = configManager.AddConfiguration(configName, "", "", 0, "", "")
5838     Require config, "AddConfiguration returned no configuration: name=" & configName & " existing=" & names
    stepLabel = currentIdentity & ": AddConfigurationState ActiveConfiguration"
5840     Set config = configManager.ActiveConfiguration
    stepLabel = currentIdentity & ": AddConfigurationState Name"
5842     If config.Name <> configName Then
5843         RecordMitigation "configuration-activate-after-add", True, True
5844         ActivateConfiguration doc, configName, "the new configuration"
5845         fallbackSuccesses("configuration-activate-after-add") = fallbackSuccesses("configuration-activate-after-add") + 1
    End If
5847     For Each item In targets
        ' Round 7: fetch the component again in the now-active configuration (the object from before the
        ' switch can be stale); if SetSuppression2 still fails, rebuild once and try again.
5850         instance = CStr(components(CStr(item)).Name2)
5851         statuses = ""
5852         For attempt = 0 To 1
5853             If attempt = 1 Then
5854                 RecordMitigation "configuration-suppress-rebuild", True, True
    stepLabel = currentIdentity & ": AddConfigurationState EditRebuild3"
5856                 statuses = statuses & "EditRebuild3 returned " & CStr(doc.EditRebuild3()) & "; "
            End If
    stepLabel = currentIdentity & ": AddConfigurationState ClearSelection2"
5859             doc.ClearSelection2 True
    stepLabel = currentIdentity & ": AddConfigurationState GetComponentByName"
5861             Set component = AssemblyDocument(doc).GetComponentByName(instance)
5862             Require component, "GetComponentByName(" & instance & ") returned nothing in configuration " & configName
5863             Set components(CStr(item)) = component
    stepLabel = currentIdentity & ": AddConfigurationState SetSuppression2"
5865             status = component.SetSuppression2(0)
5866             statuses = statuses & "SetSuppression2(0) on " & instance & " in configuration " & configName & " returned " & CStr(status) & "; "
5867             If status = swSuppressionChangeOk Then
5868                 If attempt = 1 Then fallbackSuccesses("configuration-suppress-rebuild") = fallbackSuccesses("configuration-suppress-rebuild") + 1
5869                 AppendLog currentFolder, currentIdentity, "option", 0, 0, "configuration suppression: " & statuses
5870                 Exit For
            End If
        Next attempt
5873         If status <> swSuppressionChangeOk Then Err.Raise 5, , "Component suppression failed: " & statuses & "(swSuppressionError_e: 0 bad component, 1 bad state, 2 ok, 3 change failed)"
    Next item
5875     wanted = master
5876     If requestedActive <> "master" Then wanted = configName
5877     ActivateConfiguration doc, wanted, "configuration (configurations: " & names & ", " & configName & ")"
    stepLabel = currentIdentity & ": AddConfigurationState ActiveConfiguration"
5879     Set config = configManager.ActiveConfiguration
    stepLabel = currentIdentity & ": AddConfigurationState Name"
5881     If config.Name <> wanted Then Err.Raise 5, , "Active configuration is " & config.Name & ", expected " & wanted
5882     Set entry = CreateObject("Scripting.Dictionary")
5883     entry("kind") = "configuration"
5884     entry("master") = master
5885     entry("name") = configName
5886     entry("active") = wanted
5887     entry("targets") = targets
5888     Set entry("components") = ComponentInstances()
    stepLabel = currentIdentity & ": AddConfigurationState Add"
5890     stateChecks.Add entry
End Sub

