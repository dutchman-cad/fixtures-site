Private Sub HelixReadBack(ByVal helix As Object, ByVal expected As Variant, ByVal label As String, ByVal wantVariable As Boolean, ByVal regionCount As Long)
    ' Log the definition SolidWorks shows (Height, Pitch, Revolution ...), then fail if it differs from the recipe.
    ' expected = Array(height m, pitch m, revolutions); -1 means not checked.
    Dim helixData As Object, text As String, problems As String, pitchCount As String, variableFlag As Boolean
    stepLabel = currentIdentity & ": HelixReadBack GetDefinition"
9374     Set helixData = helix.GetDefinition()
9375     If helixData Is Nothing Then
9376         AppendLog currentFolder, currentIdentity, "helix read-back", 0, 0, label & ": the helix definition is unavailable (IFeature.GetDefinition returned nothing)"
9377         Exit Sub
    End If
9379     pitchCount = "n/a"
9380     If wantVariable Then
9381         pitchCount = "unreadable"
9382         On Error Resume Next
    stepLabel = currentIdentity & ": HelixReadBack PitchCount"
9384         pitchCount = CStr(helixData.PitchCount)
9385         If Err.Number <> 0 Then pitchCount = "unreadable"
9386         Err.Clear
9387         On Error GoTo 0
    End If
    stepLabel = currentIdentity & ": HelixReadBack VariablePitch"
9390     variableFlag = helixData.VariablePitch
    stepLabel = currentIdentity & ": HelixReadBack DefinedBy"
9392     text = label & ": DefinedBy=" & CStr(helixData.DefinedBy) & " Height=" & NumberList(Array(helixData.Height * 1000#)) & " mm Pitch=" & NumberList(Array(helixData.Pitch * 1000#)) & _
        " mm Revolution=" & NumberList(Array(helixData.Revolution)) & " StartingAngle=" & NumberList(Array(helixData.StartingAngle * 180# / 3.14159265358979)) & _
        " deg Clockwise=" & YesNo(helixData.Clockwise) & " ReverseDirection=" & YesNo(helixData.ReverseDirection) & " Taper=" & YesNo(helixData.Taper) & _
        " TaperAngle=" & NumberList(Array(helixData.TaperAngle * 180# / 3.14159265358979)) & " deg TaperOutward=" & YesNo(helixData.TaperOutward) & _
        " VariablePitch=" & YesNo(variableFlag) & " PitchCount=" & pitchCount
9397     AppendLog currentFolder, currentIdentity, "helix read-back", 0, 0, text
9398     If expected(0) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Height"
9400         If Abs(helixData.Height - expected(0)) > 0.000000001 Then problems = problems & "; Height " & NumberList(Array(helixData.Height * 1000#)) & ", expected " & NumberList(Array(expected(0) * 1000#))
    End If
9402     If expected(1) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Pitch"
9404         If Abs(helixData.Pitch - expected(1)) > 0.000000001 Then problems = problems & "; Pitch " & NumberList(Array(helixData.Pitch * 1000#)) & ", expected " & NumberList(Array(expected(1) * 1000#))
    End If
9406     If expected(2) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Revolution"
9408         If Abs(helixData.Revolution - expected(2)) > 0.000001 Then problems = problems & "; Revolution " & NumberList(Array(helixData.Revolution)) & ", expected " & NumberList(Array(expected(2)))
    End If
9410     If wantVariable And Not variableFlag Then problems = problems & "; VariablePitch False, expected a variable-pitch helix"
9411     If wantVariable And IsNumeric(pitchCount) Then
9412         If CLng(pitchCount) <> regionCount Then problems = problems & "; PitchCount " & pitchCount & ", expected " & CStr(regionCount) & " regions"
    End If
9414     If Len(problems) > 0 Then Err.Raise 5, , "The " & label & " SolidWorks built differs from the recipe:" & Mid$(problems, 2) & " (" & text & ")"
End Sub

