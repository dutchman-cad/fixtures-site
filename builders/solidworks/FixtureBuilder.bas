Private Function TangentSide(ByVal component As Object, ByVal nx As Double, ByVal ny As Double, ByVal nz As Double, ByVal px As Double, ByVal py As Double, ByVal pz As Double, ByVal wantOutside As Boolean, ByVal radius As Double, ByRef sideOk As Boolean) As String
    ' Round 7: IComponent2.GetBox (assembly coordinates, meters) is padded by about 0.44 mm, so the side is
    ' judged by the box CENTER along the plane normal: +radius is outside, -radius is inside (SIDE_TOL).
    Dim box As Variant, index As Long, sign As Double, plane As Double
    Dim a As Double, b As Double, low As Double, high As Double, centre As Double
    stepLabel = currentIdentity & ": TangentSide GetBox"
5732     box = component.GetBox(False, False)
5733     If Not IsArray(box) Then Err.Raise 5, , "Component box unavailable after the tangent mate"
5734     If nx <> 0 Then
5735         index = 0: sign = nx: plane = px
    ElseIf ny <> 0 Then
5737         index = 1: sign = ny: plane = py
    Else
5739         index = 2: sign = nz: plane = pz
    End If
5741     a = sign * (box(index) - plane)
5742     b = sign * (box(index + 3) - plane)
5743     low = a: high = b
5744     If b < a Then
5745         low = b: high = a
    End If
5747     centre = (low + high) / 2
5748     If wantOutside Then
5749         sideOk = Abs(centre - radius) <= SIDE_TOL
    Else
5751         sideOk = Abs(centre + radius) <= SIDE_TOL
    End If
5753     TangentSide = "component box along the plane normal is " & Replace(Format$(low * 1000, "0.0000"), ",", ".") & ".." & Replace(Format$(high * 1000, "0.0000"), ",", ".") & " mm from the plane, center " & Replace(Format$(centre * 1000, "0.0000"), ",", ".") & " mm, cylinder radius " & Replace(Format$(radius * 1000, "0.0000"), ",", ".") & " mm (wanted " & IIf(wantOutside, "outside: center at +radius", "inside: center at -radius") & ")"
End Function

