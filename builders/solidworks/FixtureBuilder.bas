Private Sub SetSheetKFactor(ByVal kFactor As Double, ByVal what As String)
    ' The base flange was built without a K-factor of its own (no allowance object passed, or no Initialize on SolidWorks 2021), so the Sheet-Metal
    ' feature holds the default 0.5. Revision 29 (field 2026.11.24.4): ModifyDefinition with BendAllowanceType and KFactor set on the Sheet-Metal
    ' feature data returned and changed nothing, and nothing was logged. Each try is logged with its returns and read back straight away: (0) those
    ' two members, (b) the ICustomBendAllowance from GetCustomBendAllowance set and put back with SetCustomBendAllowance
    ' (sheetmetal-kfactor-allowance-object), (c) the base flange feature's own definition (baseflange-kfactor-modify). When all fail the error says
    ' which were tried and what each read back.
    Dim tried As String, text As String
6977     If ReadSheetK(kFactor, text) Then
6978         KNote what & ": the Sheet-Metal feature reads " & text & ", wanted K-factor " & NumberList(Array(kFactor))
6979         Exit Sub
    End If
6981     KNote what & ": the Sheet-Metal feature reads " & text & ", wanted K-factor " & NumberList(Array(kFactor))
6982     If ModifySheetK(tried, "members of the Sheet-Metal data", kFactor, False) Then Exit Sub
6983     RecordMitigation "sheetmetal-kfactor-allowance-object", True, True
6984     If ModifySheetK(tried, "sheetmetal-kfactor-allowance-object", kFactor, True) Then
6985         fallbackSuccesses("sheetmetal-kfactor-allowance-object") = fallbackSuccesses("sheetmetal-kfactor-allowance-object") + 1
6986         Exit Sub
    End If
6988     RecordMitigation "baseflange-kfactor-modify", True, True
6989     If ModifyFlangeK(tried, "baseflange-kfactor-modify", kFactor) Then
6990         fallbackSuccesses("baseflange-kfactor-modify") = fallbackSuccesses("baseflange-kfactor-modify") + 1
6991         Exit Sub
    End If
    ' Round 23: the two steps for a revision before 30 (a revision of 30 or more runs the steps it ran before).
6994     If swMajor < BASEFLANGE_INITIALIZE_FROM Then
6995         RecordMitigation "sheetmetal-kfactor-gauge-off", True, True
6996         If ModifySheetGaugeOff(tried, "sheetmetal-kfactor-gauge-off", kFactor) Then
6997             fallbackSuccesses("sheetmetal-kfactor-gauge-off") = fallbackSuccesses("sheetmetal-kfactor-gauge-off") + 1
6998             KNote "sheetmetal-kfactor-gauge-off: the K-factor " & NumberList(Array(kFactor)) & " took with the gauge table off and UseMaterialSheetMetalParameters False; the part is saved with the gauge table off"
6999             Exit Sub
        End If
7001         RecordMitigation "baseflange-kfactor-members-modify", True, True
7002         If ModifyFlangeMembers(tried, "baseflange-kfactor-members-modify", kFactor) Then
7003             fallbackSuccesses("baseflange-kfactor-members-modify") = fallbackSuccesses("baseflange-kfactor-members-modify") + 1
7004             Exit Sub
        End If
    End If
    ' Round 23, kfactor-continue-diagnostic: the recipe is carried on so that one field run reports the next problem too (edge flanges, hems). The part
    ' is never saved and the row stays failed: AttemptDesign raises after the later features, and the handlers put this text in front of that outcome.
7009     RecordMitigation "kfactor-continue-diagnostic", True, True
7010     kFailure = "the K-factor " & NumberList(Array(kFactor)) & " did not take on the Sheet-Metal feature after the " & what & ": " & tried & " (" & callInputs & ")"
7011     KNote "kfactor-continue-diagnostic: " & kFailure & "; the recipe goes on to its later features and is not saved"
End Sub

Private Function KFactorOnData(ByVal baseData As Object, ByVal allowance As Object, ByVal kFactor As Double) As Boolean
    ' Rung (a), baseflange-kfactor-on-data: without Initialize the allowance has no way in, so it is put on the feature data itself if the object has a
    ' custom bend allowance member (each call under its own guard; both answers are logged).
    Dim readBack As Object, overrideOk As Boolean
7018     On Error Resume Next
    stepLabel = currentIdentity & ": KFactorOnData SetCustomBendAllowance"
7020     baseData.SetCustomBendAllowance allowance
7021     If Err.Number <> 0 Then
7022         KNote "IBaseFlangeFeatureData.SetCustomBendAllowance raised Err " & CStr(Err.Number) & " " & Err.Description
    Else
7024         KNote "IBaseFlangeFeatureData.SetCustomBendAllowance returned"
7025         KFactorOnData = True
    End If
7027     Err.Clear
    stepLabel = currentIdentity & ": KFactorOnData GetCustomBendAllowance"
7029     Set readBack = baseData.GetCustomBendAllowance()
7030     If Err.Number <> 0 Then
7031         KNote "IBaseFlangeFeatureData.GetCustomBendAllowance raised Err " & CStr(Err.Number) & " " & Err.Description
    ElseIf readBack Is Nothing Then
7033         KNote "IBaseFlangeFeatureData.GetCustomBendAllowance returned nothing"
    Else
    stepLabel = currentIdentity & ": KFactorOnData Type"
7036         KNote "IBaseFlangeFeatureData.GetCustomBendAllowance returned Type=" & CStr(readBack.Type) & " KFactor=" & NumberList(Array(readBack.KFactor))
    End If
7038     Err.Clear
    ' Round 23: before 2022 the K-factor is a member of the base flange data itself (Help, 2017 member list: OverrideKFactor, KFactor);
    ' SetCustomBendAllowance is not in its member list at all (Err 438 is the Help's answer, not a binding fault).
7041     If swMajor < BASEFLANGE_INITIALIZE_FROM Then
    stepLabel = currentIdentity & ": KFactorOnData OverrideKFactor"
7043         baseData.OverrideKFactor = True
7044         If Err.Number <> 0 Then
7045             KNote "IBaseFlangeFeatureData.OverrideKFactor raised Err " & CStr(Err.Number) & " " & Err.Description
7046             overrideOk = False
        Else
7048             KNote "IBaseFlangeFeatureData.OverrideKFactor returned"
7049             overrideOk = True
        End If
7051         Err.Clear
    stepLabel = currentIdentity & ": KFactorOnData KFactor"
7053         baseData.KFactor = kFactor
7054         If Err.Number <> 0 Then
7055             KNote "IBaseFlangeFeatureData.KFactor raised Err " & CStr(Err.Number) & " " & Err.Description
        Else
7057             KNote "IBaseFlangeFeatureData.KFactor returned"
7058             If overrideOk Then KFactorOnData = True
        End If
    End If
7061     Err.Clear
7062     On Error GoTo 0
End Function

Private Function BaseFlangeByData(ByVal profileFeature As Object, ByVal thickness As Double, ByVal radius As Double, ByVal kFactor As Double, ByVal reverseSide As Boolean, ByVal reverseMember As String, ByVal baseInputs As String, ByRef failures As String, ByRef noInitialize As Boolean, ByRef onDataOk As Boolean) As Object
    ' Attempt 3: IBaseFlangeFeatureData. SolidWorks 2021 has no Initialize on it (Err 438): then the members are set directly and the caller
    ' sets the K-factor on the Sheet-Metal feature afterwards. Any error is logged and kept, and the answer is Nothing.
    Dim allowance As Object, baseData As Object, initError As String, errText As String
7069     On Error GoTo Failed
7070     Set allowance = PrepareBaseFlange(profileFeature, kFactor, True)
7071     callInputs = baseInputs & " feature data: Initialize(UseMaterial=False, OverrideAllowance=True, relief Rectangular ratio 0.5) UseGaugeTable=False"
    stepLabel = currentIdentity & ": BaseFlangeByData CreateDefinition" & " " & apiInputs & " " & callInputs
7073     Set baseData = doc.FeatureManager.CreateDefinition(swFmBaseFlange)
7074     Require baseData, "CreateDefinition(swFmBaseFlange) returned nothing"
7075     On Error Resume Next
    stepLabel = currentIdentity & ": BaseFlangeByData Initialize"
7077     baseData.Initialize False, True, allowance, False, swSheetMetalReliefRectangular, True, 0.5, 0#, 0#
