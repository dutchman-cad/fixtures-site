Private Sub ReadBackLimits(ByVal mateName As String, ByVal angular As Boolean, ByVal wantedLow As Double, ByVal wantedHigh As Double, ByVal limitText As String, ByVal poseValue As Double, ByVal flipped As Boolean, ByVal poseText As String)
    ' The limits SolidWorks stored for the mate just made: IMate2.MinimumVariation / MaximumVariation of the newest mate (via IFeature.GetSpecificFeature2),
    ' in meters or radians, RELATIVE to the mate's own value (field 2026.11.24.3): poseValue (mm or degrees, the value passed to AddMate5) is added back.
    ' wantedLow / wantedHigh are in the frame the mate was asked in (flipped: a negative distance passed as |value| with Flip toggled, limits [-max, -min]).
    Dim info As Object, low As Double, high As Double, haveLimits As Boolean, storedText As String, unitName As String, shownLow As Double, shownHigh As Double
5424     On Error Resume Next
    stepLabel = currentIdentity & ": ReadBackLimits GetSpecificFeature2"
5426     Set info = NewestMate().GetSpecificFeature2()
5427     If Err.Number = 0 Then
5428         If Not info Is Nothing Then
    stepLabel = currentIdentity & ": ReadBackLimits MinimumVariation"
5430             low = CDbl(info.MinimumVariation)
    stepLabel = currentIdentity & ": ReadBackLimits MaximumVariation"
5432             high = CDbl(info.MaximumVariation)
5433             If Err.Number = 0 Then haveLimits = True
        End If
    End If
5436     If Err.Number <> 0 Then NoteOption "mate " & mateName & ": IMate2 read-back failed (" & Err.Description & ")"
5437     On Error GoTo 0
5438     If Not haveLimits Then
5439         AddLimitNote mateName & ": limits " & limitText & " requested, limits not read back"
5440         Exit Sub
    End If
5442     unitName = "mm"
5443     If angular Then
5444         low = low * 180# / 3.14159265358979
5445         high = high * 180# / 3.14159265358979
5446         unitName = "deg"
    Else
5448         low = low * 1000#
5449         high = high * 1000#
    End If
5451     low = low + poseValue
5452     high = high + poseValue
5453     shownLow = low
5454     shownHigh = high
5455     If flipped Then
5456         shownLow = -high
5457         shownHigh = -low
    End If
5459     storedText = NoteNumber(shownLow) & ".." & NoteNumber(shownHigh) & " " & unitName
5460     If Abs(low - wantedLow) > 0.000001 Or Abs(high - wantedHigh) > 0.000001 Then
5461         limitDegraded = True
5462         AddLimitNote mateName & ": limits " & limitText & " requested but " & storedText & " stored (read back relative to the pose " & poseText & ")"
5463         Exit Sub
    End If
5465     AddLimitNote mateName & ": limits " & storedText & " stored (read back relative to the pose " & poseText & ")"
End Sub

