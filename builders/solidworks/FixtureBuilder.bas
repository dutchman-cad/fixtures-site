Private Function FindChild(ByVal component As Object, ByVal localName As String, ByVal route As Long, ByRef matches As Long) As Object
    ' The child of `component` named localName, found by a route: 0 IComponent2.GetChildren of the instance the build kept, 1 GetChildren of the top-level
    ' instance found again in the top assembly by name, 2 IAssemblyDoc.GetComponentByName with the path form ("pair2-1/pin-1"), 3 the top assembly's
    ' component tree (GetComponents(False)). SolidWorks 2021 (field 2026.11.24.4): the handles of route 0 read the subassembly document's own LOCAL
    ' transform and box, so moving them moved nothing in the top assembly. matches is how many children carry the name.
    Dim children As Variant, child As Variant, suffix As String, found As Object, topInstance As Object, parentName As String
    Dim i As Long, lower As Long, upper As Long, nameText As String
5550     matches = 0
    stepLabel = currentIdentity & ": FindChild Name2"
5552     parentName = CStr(component.Name2)
5553     If route = 2 Then
    stepLabel = currentIdentity & ": FindChild GetComponentByName"
5555         Set found = AssemblyDocument(doc).GetComponentByName(parentName & "/" & localName)
5556         If Not found Is Nothing Then matches = 1
5557         Set FindChild = found
5558         Exit Function
    End If
5560     If route = 0 Then
    stepLabel = currentIdentity & ": FindChild GetChildren"
5562         children = component.GetChildren()
    ElseIf route = 1 Then
    stepLabel = currentIdentity & ": FindChild GetComponentByName"
5565         Set topInstance = AssemblyDocument(doc).GetComponentByName(parentName)
    stepLabel = currentIdentity & ": FindChild GetChildren"
5567         If Not topInstance Is Nothing Then children = topInstance.GetChildren()
    Else
    stepLabel = currentIdentity & ": FindChild GetComponents"
5570         children = AssemblyDocument(doc).GetComponents(False)
    End If
5572     If ArrayItems(children, lower, upper) Then
5573         For i = lower To upper
5574             Set child = children(i)
5575             If ReadName2(child, nameText) Then
5576                 If route = 3 Then
5577                     If nameText = parentName & "/" & localName Then
5578                         matches = matches + 1
5579                         Set found = child
                    End If
                Else
5582                     suffix = nameText
5583                     If InStrRev(suffix, "/") > 0 Then suffix = Mid$(suffix, InStrRev(suffix, "/") + 1)
5584                     If suffix = localName Then
5585                         matches = matches + 1
5586                         Set found = child
                    End If
                End If
            End If
        Next i
    End If
5592     Set FindChild = found
End Function

Private Function LocateComponent(ByVal path As String, Optional ByVal route As Long = -1) As Object
    ' The component an answer-key path ("mid/pair/block") names: the top-level label, then each subassembly's localName instance name found among
    ' its children by a route (FindChild): by default the route a dragged part was found by (childRoutes), else 0.
    Dim labels As Variant, i As Long, component As Object, file As String, localName As String
    Dim matches As Long, found As Object, topLabel As String, instanceNumber As Long, instances As Variant
5600     If route < 0 Then
5601         route = 0
    stepLabel = currentIdentity & ": LocateComponent Exists"
5603         If childRoutes.Exists(path) Then route = childRoutes(path)
    End If
5605     labels = Split(path, "/")
5606     topLabel = CStr(labels(0))
5607     instanceNumber = 1
5608     If InStr(topLabel, "#") > 0 Then
        ' pair#2 is the second instance of a component pattern (the seed is #1)
5610         instanceNumber = CLng(Mid$(topLabel, InStr(topLabel, "#") + 1))
5611         topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5614     If Not components.Exists(topLabel) Then Err.Raise 5, , "No component " & topLabel & " in the assembly"
5615     Set component = components(topLabel)
5616     If instanceNumber > 1 Then
    stepLabel = currentIdentity & ": LocateComponent Exists"
5618         If Not patternInstances.Exists(topLabel) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5619         instances = patternInstances(topLabel)
5620         If instanceNumber - 2 > UBound(instances) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5621         Set component = instances(instanceNumber - 2)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5624     If fileOfLabel.Exists("|" & topLabel) Then file = fileOfLabel("|" & topLabel)
5625     For i = 1 To UBound(labels)
    stepLabel = currentIdentity & ": LocateComponent Exists"
5627         If Not localNames.Exists(file & "|" & CStr(labels(i))) Then Err.Raise 5, , "Subassembly " & file & " has no component " & CStr(labels(i))
5628         localName = localNames(file & "|" & CStr(labels(i)))
5629         Set found = FindChild(component, localName, route, matches)
    stepLabel = currentIdentity & ": LocateComponent Name2"
5631         If matches <> 1 Then Err.Raise 5, , CStr(matches) & " children of " & CStr(component.Name2) & " are named " & localName
5632         Set component = found
    stepLabel = currentIdentity & ": LocateComponent Exists"
5634         If fileOfLabel.Exists(file & "|" & CStr(labels(i))) Then file = fileOfLabel(file & "|" & CStr(labels(i))) Else file = ""
    Next i
5636     Set LocateComponent = component
End Function

Private Sub NoteFlexibleChild(ByVal path As String, ByVal component As Object, ByRef position As Variant)
    ' Only for a part a `move` dragged (MoveComponent kept its GetTotalTransform t0 and box center b0). If GetTotalTransform now disagrees in X or Y by
    ' more than 0.01 mm with t0 + (box center now - b0), X/Y are judged by that, Z stays (placement-flexible-box). position is in mm.
    Dim saved As Variant, t0 As Variant, b0 As Variant, centre As Variant, expected As Variant
    stepLabel = currentIdentity & ": NoteFlexibleChild Exists"
5644     If Not movedParts.Exists(path) Then Exit Sub
5645     saved = movedParts(path)
5646     t0 = saved(0)
5647     b0 = saved(1)
5648     On Error Resume Next
5649     centre = BoxCentre(component)
5650     If Err.Number <> 0 Then Exit Sub
5651     If Not IsArray(centre) Then Exit Sub
5652     expected = Array(CDbl(t0(0)) + CDbl(centre(0)) - CDbl(b0(0)), CDbl(t0(1)) + CDbl(centre(1)) - CDbl(b0(1)), CDbl(t0(2)) + CDbl(centre(2)) - CDbl(b0(2)))
5653     NoteOption "placement " & path & " (moved part): GetTotalTransform (" & NoteList(position) & ") mm, box center (" & NoteList(centre) & ") mm, before the move (" & NoteList(t0) & ") and (" & NoteList(b0) & "), so the part is at (" & NoteList(expected) & ")"
5654     If Abs(CDbl(expected(0)) - CDbl(position(0))) > 0.01 Or Abs(CDbl(expected(1)) - CDbl(position(1))) > 0.01 Then
5655         RecordMitigation "placement-flexible-box"
5656         NoteOption "placement " & path & ": GetTotalTransform misreports a flexible child; X/Y judged by the box center"
5657         position = Array(CDbl(expected(0)), CDbl(expected(1)), CDbl(position(2)))
    End If
5659     Err.Clear
End Sub

Private Sub CheckPlacement(ByVal path As String, ByVal t As Variant, ByVal rotation As Variant, ByVal scoreT As Boolean, ByVal scoreR As Boolean)
    ' Round 19: the world transform of one leaf instance against expect.json (t 0.01 mm, R 1e-4). ArrayData is row-vector: array row i is
    ' the world image of local axis i, so R(i, j) = values(3 * j + i). A mismatch is a problem for the report, never an error.
    Dim component As Object, values As Variant, position As Variant, i As Long, j As Long, worst As Double, worstSame As Double, worstFlipped As Double, reason As String
5666     On Error Resume Next
5667     SettleRoute path
5668     Err.Clear
5669     Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": CheckPlacement GetTotalTransform"
5671     If Err.Number = 0 Then values = component.GetTotalTransform(True).ArrayData
5672     If Err.Number <> 0 Then reason = Err.Description
5673     On Error GoTo 0
5674     If Len(reason) > 0 Or component Is Nothing Then
5675         AddPlacementProblem path & ": cannot read it (" & reason & ")"
5676         Exit Sub
    End If
5678     placementChecked = placementChecked + 1
5679     position = Array(CDbl(values(9)) * 1000#, CDbl(values(10)) * 1000#, CDbl(values(11)) * 1000#)
5680     NoteFlexibleChild path, component, position
5681     If scoreT Then
5682         For i = 0 To 2
5683             If Abs(CDbl(position(i)) - CDbl(t(i))) > worst Then worst = Abs(CDbl(position(i)) - CDbl(t(i)))
        Next i
5685         If worst > 0.01 Then AddPlacementProblem path & ": t = (" & NoteList(position) & ") mm, expected (" & NoteList(t) & ")"
    End If
5687     If scoreR Then
5688         For i = 0 To 2
5689             For j = 0 To 2
5690                 If Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j))) > worstSame Then worstSame = Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j)))
5691                 If Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j))) > worstFlipped Then worstFlipped = Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j)))
            Next j
        Next i
5694         If worstSame > 0.0001 Then AddPlacementProblem path & ": R differs from expect.json by " & NoteNumber(worstSame) & IIf(worstFlipped <= 0.0001, " (it matches when read the other way round)", "")
    End If
End Sub

