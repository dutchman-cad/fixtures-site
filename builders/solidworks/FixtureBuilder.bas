End Sub

Private Function SelectEdgeVertex(ByVal curveFeature As Object, ByVal wantEnd As Boolean) As String
    ' The start vertex of the first edge, or the end vertex of the last edge, selected by object (IVertex.Select4, mark 1): no view ray,
