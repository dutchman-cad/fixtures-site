    Next component
8347     AppendLog currentFolder, currentIdentity, "option", 0, 0, "drawing: view " & viewName & " shows " & CStr(shownCount) & " component" & IIf(shownCount = 1, "", "s") & ": " & shownNames
8348     seen = ","
8349     For Each component In shown
    stepLabel = currentIdentity & ": AddAssemblyEdges Name2"
8351         label = CStr(component.Name2)
8352         If InStr(label, "@") > 0 Then label = Left$(label, InStr(label, "@") - 1)
        ' Only a prefix that is exactly the assembly's own name is removed: a component under any other prefix (sub-1/pin-1) is not top-level and never matches.
8354         If InStr(label, "/") > 0 Then
8355             If StrComp(Left$(label, InStr(label, "/") - 1), assemblyName, vbTextCompare) = 0 And InStr(InStr(label, "/") + 1, label, "/") = 0 Then label = Mid$(label, InStr(label, "/") + 1)
        End If
8357         size = Len(label)
8358         Do While size > 0
8359             If Mid$(label, size, 1) Like "#" Then
8360                 size = size - 1
            Else
8362                 Exit Do
            End If
        Loop
8365         If size > 0 And size < Len(label) Then
8366             If Mid$(label, size, 1) = "-" Then label = Left$(label, size - 1)
        End If
8368         which = -1
8369         For k = 0 To UBound(components)
8370             If StrComp(CStr(components(k)(0)), label, vbTextCompare) = 0 Then which = k
        Next k
8372         If which >= 0 Then
8373             box = components(which)
8374             label = CStr(components(which)(0))
8375             seen = seen & label & ","
    stepLabel = currentIdentity & ": AddAssemblyEdges GetVisibleEntities2"
8377             raw = view.GetVisibleEntities2(component, swViewEntityType_Edge)
8378             If Not IsArray(raw) Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges for the component " & label
8379             Set mine = New Collection
8380             AddEdgeRecords mine, raw
    stepLabel = currentIdentity & ": AddAssemblyEdges Count"
8382             If mine.Count = 0 Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges for the component " & label
8383             shift = Array(0#, 0#, 0#)
8384             moved = False
8385             If Not ComponentFits(mine, box, shift) Then
8386                 shift = box(3)
8387                 moved = True
8388                 If Not ComponentFits(mine, box, shift) Then Err.Raise 5, , viewName & ": the edge points of the component " & label & " lie outside its box in assembly coordinates and in part coordinates moved to its place"
            End If
8390             If moved Then
8391                 RecordMitigation "drawing-assembly-edges-part-space", True, True
8392                 fallbackSuccesses("drawing-assembly-edges-part-space") = fallbackSuccesses("drawing-assembly-edges-part-space") + 1
            End If
8394             For Each record In mine
8395                 record("p0") = ShiftPoint(record("p0"), shift)
8396                 If record("kind") = "line" Then record("p1") = ShiftPoint(record("p1"), shift)
8397                 If record("kind") = "circle" Then record("raw") = Array(CDbl(record("p0")(0)), CDbl(record("p0")(1)), CDbl(record("p0")(2)), CDbl(record("raw")(3)), CDbl(record("raw")(4)), CDbl(record("raw")(5)), CDbl(record("raw")(6)))
    stepLabel = currentIdentity & ": AddAssemblyEdges Add"
8399                 found.Add record
            Next record
        End If
    Next component
8403     For k = 0 To UBound(components)
8404         If InStr(seen, "," & CStr(components(k)(0)) & ",") = 0 Then Err.Raise 5, , viewName & ": the view shows no edges of the component " & CStr(components(k)(0)) & "; the view showed: " & shownNames
    Next k
