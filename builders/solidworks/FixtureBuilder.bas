End Function

Private Function NameInsideComponents(ByVal user As String) As Boolean
    ' A word-matched name: 3 or more characters and not a common word. It is matched wherever the characters on both sides are not ASCII
    ' letters or digits (the start of the text, a tab, a quote, a length byte, "-", "_" ...); any other name (and a shorter one) only as a
    ' whole path segment. The same for the user name, the profile folder's own name and the computer, domain and logon-server names.
    Dim inside As Boolean
479     inside = (Len(user) >= 3)
480     If InStr("|admin|user|users|owner|public|default|test|cad|work|data|home|the|and|pro|dev|lab|app|sys|doc|docs|temp|office|pc|laptop|desktop|", "|" & user & "|") > 0 Then inside = False
481     NameInsideComponents = inside
End Function

Private Function IsAsciiAlnum(ByVal ch As String) As Boolean
485     IsAsciiAlnum = (ch Like "[A-Za-z0-9]")
End Function

Private Function WordIn(ByVal text As String, ByVal needle As String) As Boolean
    ' The needle in the text with no ASCII letter or digit next to it (or the edge of the text): both already lower-cased.
    Dim pos As Long, before As String, after As String, found As Boolean
491     If Len(needle) > 0 Then
492         pos = InStr(1, text, needle, vbBinaryCompare)
493         Do While pos > 0 And Not found
494             before = ""
495             after = ""
496             If pos > 1 Then before = Mid$(text, pos - 1, 1)
497             If pos + Len(needle) <= Len(text) Then after = Mid$(text, pos + Len(needle), 1)
498             If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
499             pos = InStr(pos + 1, text, needle, vbBinaryCompare)
        Loop
    End If
502     WordIn = found
End Function

Private Function SegmentMatches(ByVal part As String, ByVal needle As String) As Boolean
    Dim hit As Boolean
507     If Len(needle) > 0 Then hit = (part = needle)
508     If Len(needle) > 0 And Not hit Then
509         If NameInsideComponents(needle) Then hit = WordIn(part, needle)
    End If
511     SegmentMatches = hit
End Function

Private Function NormalPath(ByVal path As String) As String
    Dim p As String
516     p = LCase$(Replace(Trim$(path), "/", "\"))
517     Do While Len(p) > 0 And Right$(p, 1) = "\"
518         p = Left$(p, Len(p) - 1)
    Loop
520     NormalPath = p
End Function

Private Function LeafOf(ByVal normal As String) As String
524     LeafOf = Mid$(normal, InStrRev(normal, "\") + 1)
End Function

Private Function UnderRoot(ByVal p As String, ByVal root As String) As Boolean
    Dim under As Boolean
529     If Len(root) > 0 Then under = (p = root Or Left$(p, Len(root) + 1) = root & "\")
530     UnderRoot = under
End Function

Private Function PersonalPathRefusal(ByVal what As String, ByVal why As String) As String
534     PersonalPathRefusal = "The " & what & " was refused because " & why & ". " & _
        "SolidWorks stores this path inside every assembly and drawing it saves, so the files you send would show it. " & _
        "Choose a neutral one instead, for example " & DefaultOutputRoot() & " for the output folder. Nothing was built."
End Function

Private Function DriveRooted(ByVal path As String) As Boolean
    Dim t As String
541     t = Trim$(path)
542     DriveRooted = (Len(t) >= 3 And Mid$(t, 1, 1) Like "[A-Za-z]" And Mid$(t, 2, 1) = ":" And (Mid$(t, 3, 1) = "\" Or Mid$(t, 3, 1) = "/"))
End Function

Private Function PersonalWhy(ByVal path As String, ByVal identity As Boolean) As String
    ' With identity False (the default output root, the one folder the builder names itself) only the last two rules apply, so a user called
    ' Documents, Public or FixtureBuilder is not locked out of it. The first of these that applies, on the lower-cased path: inside %USERPROFILE%; inside a OneDrive folder or the redirected Documents
    ' folder; a folder that is, or (guarded names) contains, %USERNAME% or the profile folder's own name; a folder named after the computer,
    ' domain or logon server; a folder whose name contains "onedrive"; a UNC share; a Users\<name> folder that is not Public.
    Dim p As String, profile As String, parts As Variant, i As Long, k As Long, why As String
    Dim names(0 To 1) As String, machines(0 To 2) As String, roots(0 To 3) As String
552     p = NormalPath(path)
553     profile = NormalPath(EnvText("USERPROFILE"))
554     names(0) = LCase$(EnvText("USERNAME"))
555     names(1) = LeafOf(profile)
556     machines(0) = LCase$(EnvText("COMPUTERNAME"))
557     machines(1) = LCase$(EnvText("USERDOMAIN"))
558     machines(2) = LCase$(Replace(EnvText("LOGONSERVER"), "\", ""))
559     roots(0) = NormalPath(EnvText("OneDrive"))
560     roots(1) = NormalPath(EnvText("OneDriveCommercial"))
561     roots(2) = NormalPath(EnvText("OneDriveConsumer"))
562     roots(3) = NormalPath(EnvText("MYDOCUMENTS"))
563     parts = Split(p, "\")
564     If identity Then
565         If UnderRoot(p, profile) Then why = "it is inside your user profile folder"
    End If
567     If Len(why) = 0 And identity Then
568         For k = 0 To 3
569             If UnderRoot(p, roots(k)) Then why = "it is inside your OneDrive or redirected Documents folder"
        Next k
    End If
572     If Len(why) = 0 And identity Then
573         For k = 0 To 1
574             If Len(names(k)) > 0 Then
575                 For i = 0 To UBound(parts)
576                     If SegmentMatches(CStr(parts(i)), names(k)) Then why = "a folder in its path contains your Windows user name"
                Next i
            End If
        Next k
    End If
581     If Len(why) = 0 And identity Then
582         For k = 0 To 2
583             For i = 0 To UBound(parts)
584                 If SegmentMatches(CStr(parts(i)), machines(k)) Then why = "a folder in its path is named after this computer, its domain or its logon server"
            Next i
        Next k
    End If
588     If Len(why) = 0 And identity Then
589         For i = 0 To UBound(parts)
590             If InStr(parts(i), "onedrive") > 0 Then why = "a folder in its path is a OneDrive folder"
        Next i
    End If
593     If Len(why) = 0 And Left$(p, 2) = "\\" Then why = "it is on a network share (a \\server\share path)"
594     If Len(why) = 0 Then
595         For i = 0 To UBound(parts) - 1
596             If parts(i) = "users" And Len(parts(i + 1)) > 0 And parts(i + 1) <> "public" And parts(i + 1) <> "default" And parts(i + 1) <> "all users" And parts(i + 1) <> "shared" Then why = "it is inside the personal folder of a Windows user (a Users\<name> folder)"
        Next i
    End If
    ' Last, and for every folder (the default root too): a folder that is not a full path with a drive letter ("FixtureOut", "..\x",
    ' "%USERPROFILE%\x", which FileSystemObject does not expand) would resolve against SolidWorks' own current folder, which may be under the profile.
601     If Len(why) = 0 Then
602         If Not DriveRooted(path) Then why = "the folder must be a full path starting with a drive letter"
    End If
604     PersonalWhy = why
End Function

Private Function PersonalPathReason(ByVal path As String) As String
    Dim why As String
609     why = PersonalWhy(path, NormalPath(path) <> NormalPath(DefaultOutputRoot()))
610     If Len(why) = 0 Then
