Private Function StepHeaderGuard(ByVal path As String) As Boolean
    ' After every STEP export: in the first 4 KB FILE_NAME must be a bare file name and the author and organization empty (or neutral).
    ' Otherwise those fields are rewritten in the file. True when it rewrote; raises when it cannot read or rewrite, so the row fails.
    Dim text As String, regex As Object, found As Object, args As Variant, first As Object, bare As String, i As Long, rebuilt As String
    Dim stream As Object, entity As String, again As Variant
1993     text = StepReadLatin1(path)
1994     Set regex = CreateObject("VBScript.RegExp")
    stepLabel = currentIdentity & ": StepHeaderGuard Pattern"
1996     regex.Pattern = "FILE_NAME\s*\(([\s\S]*?)\)\s*;"
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
1998     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2000     If found.Count = 0 Then Err.Raise 5, , "step header: no FILE_NAME in the first 4 KB"
    stepLabel = currentIdentity & ": StepHeaderGuard Value"
2002     entity = found(0).Value
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2004     args = StepArgs(found(0).SubMatches(0))
2005     If Not StepHeaderProblem(args) Then Exit Function
2006     Set first = StepStrings(CStr(args(0)))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2008     If first.Count > 0 Then bare = first(0).SubMatches(0)
2009     If InStrRev(bare, "\") > 0 Then bare = Mid$(bare, InStrRev(bare, "\") + 1)
2010     If InStrRev(bare, "/") > 0 Then bare = Mid$(bare, InStrRev(bare, "/") + 1)
2011     args(0) = "'" & bare & "'"
2012     For i = 2 To 3
2013         If UBound(args) >= i Then
2014             If StepFieldBad(CStr(args(i))) Then args(i) = "('')"
        End If
    Next i
2017     rebuilt = "FILE_NAME(" & Join(args, ",") & ");"
2018     Set stream = CreateObject("ADODB.Stream")
    stepLabel = currentIdentity & ": StepHeaderGuard Type"
2020     stream.Type = 2
    stepLabel = currentIdentity & ": StepHeaderGuard Charset"
2022     stream.Charset = "iso-8859-1"
    stepLabel = currentIdentity & ": StepHeaderGuard Open"
2024     stream.Open
    stepLabel = currentIdentity & ": StepHeaderGuard WriteText"
2026     stream.WriteText Replace(text, entity, rebuilt, 1, 1)
    stepLabel = currentIdentity & ": StepHeaderGuard SaveToFile"
2028     stream.SaveToFile path, 2
    stepLabel = currentIdentity & ": StepHeaderGuard Close"
2030     stream.Close
2031     text = StepReadLatin1(path)
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
2033     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2035     If found.Count = 0 Then Err.Raise 5, , "step header: the rewrite did not take"
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2037     again = StepArgs(found(0).SubMatches(0))
2038     If StepHeaderProblem(again) Then Err.Raise 5, , "step header: the rewrite did not take"
2039     StepHeaderGuard = True
End Function

