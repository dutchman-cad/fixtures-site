Private Function BuildVariableHelix(ByVal sketchFeature As Object, ByVal reverse As Boolean, ByVal clockwise As Boolean, ByVal startAngle As Double, ByVal regions As Variant, ByVal label As String) As Object
    ' regions = Array(revolutions, pitch, diameter, ...) per region, meters. Round 13 candidates (see VARIABLE_HELIX_CANDIDATES): the first region as a
    ' plain segment, FirstPitchAndDiameter before Insert, and Helixdef HeightAndRevolution with the sketch picked by name and a rebuild before End.
    ' Every call is guarded (never fatal) and its return goes into the probe note, with the selection state before End.
    Dim beforeName As String, candidate As Object, made As Object, i As Long, chosen As String, defined As Long
    Dim total As Double, returns As String, editing As String
9375     chosen = probeCandidate
9376     If Not IsVariableCandidate(chosen) Then chosen = "segments-only-height-pitch"
9377     If chosen = "height-revolution-rebuild" Then defined = swHelixDefinedBy_HeightAndRevolution Else defined = swHelixDefinedBy_HeightAndPitch
    stepLabel = currentIdentity & ": BuildVariableHelix ClearSelection2"
9379     doc.ClearSelection2 True
9380     If chosen = "height-revolution-rebuild" Then
    stepLabel = currentIdentity & ": BuildVariableHelix SelectByID2" & " " & apiInputs & " " & callInputs
9382         doc.Extension.SelectByID2 sketchFeature.Name, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, 0
    stepLabel = currentIdentity & ": BuildVariableHelix GetSelectedObjectCount2"
9384         If doc.SelectionManager.GetSelectedObjectCount2(-1) <> 1 Then Err.Raise 5, , "The helix sketch """ & sketchFeature.Name & """ could not be selected by name" & SelectionSummary()
    Else
9386         SelectFeature sketchFeature, False, 0, "Helix sketch", ""
    End If
9388     beforeName = NewestName()
9389     probeNote = ""
9390     NoteAdd chosen & ": Helixdef " & CStr(defined)
9391     If chosen = "first-pitch-before-insert" Then returns = "F=" & HelixFirstCall(regions(1), regions(2))
9392     If Len(returns) > 0 Then returns = returns & " "
9393     returns = returns & "I=" & HelixInsertCall(reverse, clockwise, defined, startAngle)
9394     If chosen = "segments-only-height-pitch" Then
        ' The first region as an ordinary segment at height 0.
9396         returns = returns & " S0=" & HelixSegmentCall(0#, regions(2), regions(1))
    ElseIf chosen <> "first-pitch-before-insert" Then
9398         returns = returns & " F=" & HelixFirstCall(regions(1), regions(2))
    End If
9400     For i = 1 To (UBound(regions) + 1) \ 3 - 1
9401         total = total + (regions(3 * (i - 1) + 1) + regions(3 * i + 1)) / 2# * (regions(3 * i) - regions(3 * (i - 1)))
9402         returns = returns & " S" & CStr(i) & "=" & HelixSegmentCall(total, regions(3 * i + 2), regions(3 * i + 1))
    Next i
9404     NoteAdd returns
9405     If chosen = "height-revolution-rebuild" Then NoteAdd "rebuild=" & HelixRebuildCall()
9406     editing = "?"
9407     On Error Resume Next
    stepLabel = currentIdentity & ": BuildVariableHelix ActiveSketch" & " " & apiInputs & " " & callInputs
9409     If doc.SketchManager.ActiveSketch Is Nothing Then editing = "no" Else editing = "yes"
9410     Err.Clear
9411     On Error GoTo 0
9412     NoteAdd SelectionDetail() & " edit=" & editing & " newest=" & NewestName()
    stepLabel = currentIdentity & ": BuildVariableHelix EndVariablePitchHelix"
9414     Set candidate = doc.FeatureManager.EndVariablePitchHelix()
9415     NoteAdd "End=" & IIf(candidate Is Nothing, "none", "feature")
9416     Set made = NewFeatureAfter(beforeName, "EndVariablePitchHelix", "helix|spiral", candidate, "")
9417     HelixReadBack made, Array(-1#, -1#, -1#), label, True, (UBound(regions) + 1) \ 3
9418     Set BuildVariableHelix = made
End Function

