Private Function EscapeRegex(ByVal text As String) As String
    Dim i As Long, ch As String, result As String
633     For i = 1 To Len(text)
634         ch = Mid$(text, i, 1)
635         If InStr("\.+*?^$()[]{}|-", ch) > 0 Then result = result & "\"
636         result = result & ch
    Next i
638     EscapeRegex = result
End Function

Private Function RootPattern(ByVal root As String) As String
    ' A folder path as a pattern that also matches its doubled-backslash (JSON) and forward-slash forms.
643     RootPattern = Replace(EscapeRegex(root), "\\", "[\\/]+")
End Function

Private Function CaseForms(ByVal word As String) As String
    ' The word as written, lower-cased and upper-cased, as one escaped alternation: VBScript's RegExp folds the case of ASCII letters only, so a
    ' Cyrillic or Greek name written in another case would be missed. LCase$ and UCase$ are Unicode-aware.
649     CaseForms = "(?:" & EscapeRegex(word) & "|" & EscapeRegex(LCase$(word)) & "|" & EscapeRegex(UCase$(word)) & ")"
End Function

Private Function ScrubNeedle(ByVal regex As Object, ByVal text As String, ByVal needle As String, ByVal marker As String) As String
    ' A word-matched needle wherever no ASCII letter or digit is next to it (start of text, tab, quote ...); any other only as a whole folder name.
    Dim result As String
655     result = text
656     If Len(needle) > 0 Then
657         If NameInsideComponents(LCase$(needle)) Then
658             regex.Pattern = "(^|[^A-Za-z0-9])" & CaseForms(needle) & "(?=[^A-Za-z0-9]|$)"
659             result = regex.Replace(result, "$1" & marker)
        Else
661             regex.Pattern = "([\\/])" & CaseForms(needle) & "(?=[.,;)]*(?:[\\/\s""'<>|:*?]|$))"
662             result = regex.Replace(result, "$1" & marker)
        End If
    End If
665     ScrubNeedle = result
End Function

Private Function PrivacyScrub(ByVal text As String) As String
    ' Every message a volunteer might screenshot, every log line and every text file in the output goes through this. In order: the tail
    ' of any path under \Users\<x> (x is not Public; a name with a space, an 8.3 name, a Dropbox (Company) folder: all of it, up to a
    ' quote, a line end, a tab or the sentence end) becomes <user>\<path>; the profile, OneDrive and Documents folders likewise; the
    ' Windows user name and the profile folder's own name (anywhere when guarded, else only as a whole folder name) become <user>; the
    ' computer, domain and logon server names (whole tokens, guarded) become <host>; a \\server\share prefix becomes <share>.
    Dim regex As Object, result As String, roots(0 To 4) As String, names(0 To 1) As String, machines(0 To 2) As String
    Dim k As Long, tailEnd As String, swap As String, exempt As String
676     tailEnd = "(?=[.,;)]*(?:[""'\r\n<>|]|$))"
677     exempt = "(?!(?:public|default|all users|shared)(?:[\\/""'\r\n<>|]|$))"
678     result = text
679     Set regex = CreateObject("VBScript.RegExp")
680     regex.Global = True
681     regex.IgnoreCase = True
682     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
683     result = regex.Replace(result, "$1<user>$2<path>")
684     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?" & tailEnd
685     result = regex.Replace(result, "$1<user>")
686     roots(0) = EnvText("USERPROFILE")
687     roots(1) = EnvText("OneDrive")
688     roots(2) = EnvText("OneDriveCommercial")
689     roots(3) = EnvText("MYDOCUMENTS")
690     roots(4) = EnvText("OneDriveConsumer")
691     For k = 0 To 4
692         If Len(roots(k)) > 0 Then
693             regex.Pattern = RootPattern(roots(k)) & "((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
694             result = regex.Replace(result, "<user>$1<path>")
695             regex.Pattern = RootPattern(roots(k))
696             result = regex.Replace(result, "<user>")
        End If
    Next k
699     names(0) = EnvText("USERNAME")
700     names(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
    ' The longer of the two first (jsmith.ACME before jsmith), so no part of the profile folder's name is left behind.
702     If Len(names(1)) > Len(names(0)) Then
703         swap = names(0)
704         names(0) = names(1)
705         names(1) = swap
    End If
707     machines(0) = EnvText("COMPUTERNAME")
708     machines(1) = EnvText("USERDOMAIN")
709     machines(2) = Replace(EnvText("LOGONSERVER"), "\", "")
710     For k = 0 To 1
711         result = ScrubNeedle(regex, result, names(k), "<user>")
    Next k
713     For k = 0 To 2
714         result = ScrubNeedle(regex, result, machines(k), "<host>")
    Next k
716     regex.Pattern = "(^|[^\\/\w:])(?:\\\\|//){1,2}[^\\/\s""'<>|:*?]+(?:\\\\|[\\/](?![""']))+(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
717     result = regex.Replace(result, "$1<share>")
718     PrivacyScrub = result
End Function


