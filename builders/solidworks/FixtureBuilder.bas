4864             If plan > 0 Then RecordMitigation fallback, True, True
    stepLabel = currentIdentity & ": ComponentPattern ClearSelection2"
4866             doc.ClearSelection2 True
4867             Set feature = Nothing
4868             If plan = 1 And Not circular Then
4869                 text = "pattern feature data"
4870                 If reverse = 1 Then
                    ' The data has no flip member this builder has checked: the axis is made the other way round.
4872                     Set reversedAxis = WorldAxis(-CDbl(direction1(0)), -CDbl(direction1(1)), -CDbl(direction1(2)))
4873                     Set feature = PatternFromFeatureData(seed, reversedAxis, count1, spacing1)
                Else
4875                     Set feature = PatternFromFeatureData(seed, axis1, count1, spacing1)
                End If
            Else
4878                 If circular Then
4879                     If plan = 0 Then marks = Array(1, 2) Else marks = Array(4, 1)
4880                     text = IIf(plan = 0, "components mark 1, axis mark 2", "axis mark 1, components mark 4")
                Else
4882                     marks = Array(1, 2)
4883                     text = "FeatureLinearPattern3"
                End If
    stepLabel = currentIdentity & ": ComponentPattern CreateSelectData" & " " & apiInputs & " " & callInputs
4886                 Set data = doc.SelectionManager.CreateSelectData()
    stepLabel = currentIdentity & ": ComponentPattern Mark"
4888                 data.Mark = CLng(marks(0))
    stepLabel = currentIdentity & ": ComponentPattern Select4" & " " & apiInputs & " " & callInputs
