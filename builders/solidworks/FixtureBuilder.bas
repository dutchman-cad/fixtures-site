Private Function HemFeature(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal dx As Double, ByVal dy As Double, ByVal dz As Double, ByVal hemType As Long, ByVal length As Double, ByVal gap As Double, ByVal hemAxis As Long, ByVal hemSide As Long, ByVal thickness As Double) As Object
    ' Point, lengths and thickness in meters. Round 9 probe candidates: Reverse False / True, each on the edge the recipe names or on the
    ' edge at the other face of the flange top (one sheet thickness away along the hem axis). The first one is also the one used outside
    ' probe mode. The + extreme along the hem axis rises by thickness plus gap on either side (field, S04a/b/g: 60 -> 63 for both Reverse
    ' values) and is information only. Round 10: the verdict is the added material's centroid (from the center of mass and volume before
    ' and after) against the flange mid-plane, which is one half sheet thickness below the + extreme.
    Dim feature As Object, reverseSide As Boolean, before As Double, after As Double, candidate As String, target(2) As Double, noteText As String
    Dim comBefore As Variant, comAfter As Variant, volumeBefore As Double, volumeAfter As Double, added As Double, centroid As Double, middle As Double, delta As Double
7926     candidate = probeCandidate
7927     If Len(candidate) = 0 Then candidate = "reverse-false"
7928     reverseSide = (Right$(candidate, 12) = "reverse-true")
7929     before = MeasuredExtreme(hemAxis, 1)
7930     volumeBefore = MeasuredVolume(): comBefore = MeasuredCenter()
7931     target(0) = x: target(1) = y: target(2) = z
7932     If Left$(candidate, 15) = "edge-other-face" Then
7933         If Abs(target(hemAxis) - before / 1000#) < 0.000000001 Then target(hemAxis) = target(hemAxis) - thickness Else target(hemAxis) = target(hemAxis) + thickness
    End If
    stepLabel = currentIdentity & ": HemFeature ClearSelection2"
7936     doc.ClearSelection2 True
7937     Pick Geom("edge", target(0), target(1), target(2), dx, dy, dz), False, 0
7938     callInputs = "Type=" & CStr(hemType) & " Position=Inside(" & CStr(swHemPositionTypeInside) & ") Reverse=" & CStr(reverseSide) & " DLength(m)=" & NumberList(Array(length)) & " DGap(m)=" & NumberList(Array(gap)) & " edge(m)=" & NumberList(Array(target(0), target(1), target(2))) & " candidate=" & candidate
    stepLabel = currentIdentity & ": HemFeature InsertSheetMetalHem2"
7940     Set feature = doc.FeatureManager.InsertSheetMetalHem2(hemType, swHemPositionTypeInside, reverseSide, length, gap, 0#, 0#, 0#, Nothing, True, swSheetMetalReliefRectangular, swReliefTearTypeRip, True, 0.5, 0#, 0#)
7941     If feature Is Nothing Then Err.Raise 5, , "InsertSheetMetalHem2 returned no feature: " & callInputs
    stepLabel = currentIdentity & ": HemFeature GetTypeName2"
7943     If feature.GetTypeName2() <> "Hem" Then Err.Raise 5, , "InsertSheetMetalHem2 returned a " & feature.GetTypeName2() & " feature"
7944     after = MeasuredExtreme(hemAxis, 1)
7945     volumeAfter = MeasuredVolume(): comAfter = MeasuredCenter()
7946     added = volumeAfter - volumeBefore
7947     noteText = Mid$("XYZ", hemAxis + 1, 1) & "+ extreme " & Replace(Format$(before, "0.0000"), ",", ".") & " -> " & Replace(Format$(after, "0.0000"), ",", ".") & " mm, recipe side " & IIf(hemSide > 0, "+", "-") & "; COM " & NumberList(Array(comBefore(0), comBefore(1), comBefore(2))) & " -> " & NumberList(Array(comAfter(0), comAfter(1), comAfter(2))) & " mm, added volume " & NumberList(Array(added)) & " mm3"
7948     If added < 0.001 Then
7949         AppendLog currentFolder, currentIdentity, "option", 0, 0, "hem side: " & noteText & "; " & callInputs
7950         Err.Raise 5, , "The hem added no material (" & noteText & "): " & callInputs
    End If
7952     centroid = (volumeAfter * comAfter(hemAxis) - volumeBefore * comBefore(hemAxis)) / added
7953     middle = before - thickness * 1000# / 2#
7954     delta = centroid - middle
7955     noteText = noteText & "; added material centroid " & Mid$("XYZ", hemAxis + 1, 1) & "=" & Replace(Format$(centroid, "0.0000"), ",", ".") & " vs flange mid-plane " & Replace(Format$(middle, "0.0000"), ",", ".")
7956     AppendLog currentFolder, currentIdentity, "option", 0, 0, "hem side: " & noteText & "; " & callInputs
7957     If delta * hemSide <= 0.001 Then Err.Raise 5, , "Hem folded to the wrong side of the flange (" & noteText & "): " & callInputs
7958     probeNote = noteText
7959     Set HemFeature = feature
End Function

