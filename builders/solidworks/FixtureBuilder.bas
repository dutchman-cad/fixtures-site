    Dim target As String, folder As String, i As Long, attempt As Long
    Dim oldStep As Long, fs As Object, preferenceSet As Boolean
    Dim oldInput As Boolean, inputSaved As Boolean, oldRebuild As Boolean, rebuildSaved As Boolean
    Dim oldWarn As Boolean, warnSaved As Boolean, oldAction As Long, actionSaved As Boolean
    Dim finalMessage As String, fatalDescription As String, fatalStep As String
    Dim fatalNumber As Long, fatalLine As Long
    Dim finishText As String, launched As Boolean, zipMade As Boolean
    Dim noticeNote As String, sweepNotes As String, zipError As String, swept As Boolean
236     On Error GoTo Fatal
237     currentIdentity = "setup"
    ' First of all, before a preference is touched or a folder made: an output folder that carries a personal path is refused.
239     target = OUTPUT_FOLDER
240     If Len(target) = 0 Then target = DefaultOutputRoot()
241     finalMessage = PersonalPathReason(target)
242     If Len(finalMessage) > 0 Then GoTo Cleanup
    stepLabel = currentIdentity & ": main SldWorks"
244     Set app = Application.SldWorks
    ' The launcher sets LaunchedBy first and shows the finish text itself, so the builder stays quiet then.
246     launched = (GetSetting("DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", "") = "launcher")
    ' A template under a personal path is refused before anything is built (a drawing keeps the path of its template).
248     finalMessage = TemplateRefusal()
249     If Len(finalMessage) > 0 Then GoTo Cleanup
    ' The up-front notice, once per run (the launcher shows it itself): Cancel builds nothing.
251     noticeNote = NoticeStep(launched)
252     If Len(noticeNote) = 0 Then
253         finalMessage = "Canceled at the user name notice. Nothing was built."
254         GoTo Cleanup
    End If
256     For i = 2 To 5
257         rbStatus(i) = ""
    Next i
259     sweepEmptied = ""
260     sweepEmptiedCount = 0
261     sweepListFailed = False
262     sweepAnsiSkipped = False
    ' Ask once (a launcher macro normally sets RunMode first); the answer is remembered.
264     If Len(GetSetting("DutchmanFixtures", "SolidWorksBuilder", "RunMode", "")) = 0 Then
265         If MsgBox("Build only the recipes that haven't built yet on this SolidWorks version? (No = build everything)", vbYesNo + vbQuestion + vbDefaultButton1) = vbYes Then
266             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "left"
        Else
268             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "full"
        End If
    End If
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
272     oldInput = app.GetUserPreferenceToggle(swInputDimValOnCreate)
273     inputSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
275     app.SetUserPreferenceToggle swInputDimValOnCreate, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
277     oldRebuild = app.GetUserPreferenceToggle(swShowErrorsEveryRebuild)
278     rebuildSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
280     app.SetUserPreferenceToggle swShowErrorsEveryRebuild, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
282     oldWarn = app.GetUserPreferenceToggle(swWarnSaveUpdateErrors)
283     warnSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
285     app.SetUserPreferenceToggle swWarnSaveUpdateErrors, False
    stepLabel = currentIdentity & ": main GetUserPreferenceIntegerValue"
287     oldAction = app.GetUserPreferenceIntegerValue(swRebuildErrorAction)
288     actionSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
290     If Not app.SetUserPreferenceIntegerValue(swRebuildErrorAction, swContinueResponse_Stop) Then Err.Raise 5, , "Cannot disable rebuild prompt"
    stepLabel = currentIdentity & ": main RevisionNumber"
292     revision = app.RevisionNumber()
293     pieces = Split(revision, ".")
294     swMajor = CLng(pieces(0))
295     version = CStr(CLng(pieces(0)) + 1992)
296     build = "0"
297     If UBound(pieces) > 0 Then
298         build = pieces(1)
299         For i = 2 To UBound(pieces)
300             build = build & "-" & pieces(i)
