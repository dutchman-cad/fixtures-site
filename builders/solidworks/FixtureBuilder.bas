1867             WriteUtf8 path, text
        Case "utf-8-bom", "utf-16-le-bom", "utf-16-be-bom"
1869             Set stream = CreateObject("ADODB.Stream")
1870             stream.Type = 2
1871             If sweepEncoding = "utf-16-le-bom" Then
1872                 stream.Charset = "unicode"
            ElseIf sweepEncoding = "utf-16-be-bom" Then
1874                 stream.Charset = "unicodeFFFE"
            Else
1876                 stream.Charset = "utf-8"
            End If
1878             stream.Open
1879             stream.WriteText text
1880             stream.SaveToFile path, 2
1881             stream.Close
        Case Else
1883             Set fs = CreateObject("Scripting.FileSystemObject")
1884             If fs.FileExists(path) Then fs.DeleteFile path, True
1885             channel = FreeFile
1886             Open path For Binary Access Write As #channel
1887             Put #channel, , text
1888             Close #channel
    End Select
