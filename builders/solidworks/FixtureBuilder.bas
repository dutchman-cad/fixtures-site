    stepLabel = currentIdentity & ": ZipMitigationLine Exists"
867         If mitigations.Exists(CStr(itemName)) Then
868             If Len(text) > 0 Then text = text & " "
869             text = text & CStr(itemName) & "=" & CStr(mitigations(itemName)) & ",primary-failed=" & CStr(primaryFailures(itemName)) & ",fallback-ok=" & CStr(fallbackSuccesses(itemName))
        End If
