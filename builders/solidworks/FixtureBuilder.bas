Private Function BaseFlangeOlderMethod(ByVal profileFeature As Object, ByVal thickness As Double, ByVal radius As Double, ByVal kFactor As Double, ByVal reverseSide As Boolean, ByVal baseInputs As String, ByRef failures As String) As Object
    ' Round 23 (SolidWorks 2021): the older InsertSheetMetalBaseFlange, the first sixteen arguments of the 2 method. A public record of the SolidWorks API
    ' (CADapter, solidworks/docs/SHEET_METAL.md) says the 19-argument call did nothing there and this 16-argument one built the flange. It has never run
    ' on real SolidWorks here: an error in the call is noted and the ladder goes on.
    Dim allowance As Object, errText As String, feature As Object
7161     RecordMitigation "baseflange-insert-v1", True, True
7162     callInputs = baseInputs & " older method InsertSheetMetalBaseFlange (16 arguments), verified form: ExtrudeDist1=0.01 ExtrudeDist2=0 DirToUse=1 PCBA=K-factor allowance UseDefaultRelief=False ReliefType=Tear ReliefWidth=0.0001 ReliefDepth=0.0001 ReliefRatio=0.5 UseReliefRatio=True"
7163     On Error GoTo Failed
