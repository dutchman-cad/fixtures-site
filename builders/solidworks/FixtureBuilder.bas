Private Sub ExportGuard(ByVal path As String)
    ' Right after SolidWorks writes a DXF or a PDF the builder made: a DXF is text and is scrubbed like one; a PDF is scanned for the names (not
    ' rewritten). A PDF with a name in it, a file over 4 MB (too large to check) or one that cannot be read is deleted and the row fails. The
    ' .sld* files are compressed and are not scanned (the stamp in them is documented); a STEP file has its own guard.
    Dim fs As Object, ext As String, text As String, cleaned As String, problem As String
1667     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ExportGuard GetExtensionName"
1669     ext = LCase$(fs.GetExtensionName(path))
1670     If ext <> "dxf" And ext <> "pdf" Then Exit Sub
    stepLabel = currentIdentity & ": ExportGuard FileExists"
1672     If Not fs.FileExists(path) Then Exit Sub
1673     On Error Resume Next
1674     If ext = "dxf" Then
1675         text = SweepRead(path)
1676         If Err.Number = 0 Then
1677             cleaned = PrivacyScrub(text)
1678             If cleaned <> text Then SweepWrite path, cleaned
        End If
    ElseIf StrayHasNeedle(path) Then
1681         problem = "carried a personal name"
    End If
1683     If Err.Number <> 0 Then
1684         problem = "could not be checked"
1685         If InStr(Err.Description, "size cap") > 0 Then problem = "too large to check (over 4 MB)"
    End If
1687     Err.Clear
1688     On Error GoTo 0
1689     If Len(problem) > 0 Then
1690         If Not SweepDelete(fs, path) Then SweepTruncate fs, path
1691         Err.Raise 5, , "privacy: " & ext & " " & problem
    End If
End Sub

