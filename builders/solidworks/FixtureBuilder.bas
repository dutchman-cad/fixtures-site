Private Function MateOffPose(ByVal label As String, ByVal wantedT As Variant, ByVal wantedR As Variant, ByVal isFinal As Boolean, ByRef description As String) As Boolean
    ' Is the component off the pose it must have, where this mate is the one to say so? The pose is the answer key's (wantedT in mm, wantedR the nine
    ' numbers row by row, or Empty where it is not scored); with no answer key it is the pose the component was inserted at. Every mate counts while
    ' the component was inserted at its pose (the mates must not move it); a component inserted elsewhere is judged after the last mate of its composition.
    Dim inserted As Variant, values As Variant, key As String, i As Long, j As Long, moved As Double, turned As Double, drift As Double, spin As Double
    Dim t(2) As Double, r(8) As Double, current(2) As Double, haveR As Boolean, strict As Boolean
5327     key = currentScope & "|" & label
    stepLabel = currentIdentity & ": MateOffPose Exists"
5329     If Not poses.Exists(key) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose Exists"
5331     If Not components.Exists(label) Then Exit Function
5332     inserted = poses(key)
5333     If IsEmpty(wantedT) Then
5334         For i = 0 To 2
5335             t(i) = CDbl(inserted(9 + i)) * 1000#
5336             For j = 0 To 2
5337                 r(3 * i + j) = CDbl(inserted(3 * j + i))
            Next j
        Next i
5340         haveR = True
5341         strict = True
    Else
5343         For i = 0 To 2
5344             t(i) = CDbl(wantedT(i))
        Next i
5346         haveR = Not IsEmpty(wantedR)
5347         If haveR Then
5348             For i = 0 To 8
5349                 r(i) = CDbl(wantedR(i))
            Next i
        End If
5352         For i = 0 To 2
5353             If Abs(CDbl(inserted(9 + i)) * 1000# - t(i)) > drift Then drift = Abs(CDbl(inserted(9 + i)) * 1000# - t(i))
5354             If haveR Then
5355                 For j = 0 To 2
5356                     If Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j)) > spin Then spin = Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j))
                Next j
            End If
        Next i
5360         strict = (drift <= 0.01 And spin <= 0.0001)
    End If
5362     If Not (isFinal Or strict) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose GetTotalTransform"
5364     values = components(label).GetTotalTransform(True).ArrayData
5365     For i = 0 To 2
5366         current(i) = CDbl(values(9 + i)) * 1000#
5367         If Abs(current(i) - t(i)) > moved Then moved = Abs(current(i) - t(i))
5368         If haveR Then
5369             For j = 0 To 2
5370                 If Abs(CDbl(values(3 * j + i)) - r(3 * i + j)) > turned Then turned = Abs(CDbl(values(3 * j + i)) - r(3 * i + j))
            Next j
        End If
    Next i
5374     description = "at (" & NoteList(current) & ") mm, wanted (" & NoteList(t) & ")"
5375     If haveR Then description = description & ", the turn differs by " & NoteNumber(turned)
5376     MateOffPose = (moved > 0.01 Or turned > 0.0001)
End Function

Private Function NewestMate() As Object
    ' The newest mate feature is the last sub-feature of the assembly's MateGroup.
