3680     matesDuring = MateCount()
3681     moved = MoveRead(path, "temporary Concentric mate to the axis (" & steps & "; mates " & CStr(matesBefore) & " -> " & CStr(matesDuring) & ")", shiftText, wanted, boxBefore, shiftX, shiftY, shiftZ, kept, nowValues)
3682     If Not moved Then
3683         text = "the temporary Concentric mate left the part at (" & NoteList(nowValues) & ")"
    Else
3685         deleteProblems = CleanUpTemporary(namesBefore, mateNamesBefore)
    stepLabel = currentIdentity & ": TemporaryMateMove EditRebuild3"
3687         doc.EditRebuild3
