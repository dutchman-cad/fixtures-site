    Dim namesBefore As Object, mateNamesBefore As Object, matesBefore As Long, matesDuring As Long, nowValues As Variant, afterValues As Variant, failures As String, problem As String
    Dim moved As Boolean, movedAfter As Boolean, steps As String, leftOver As String, deleteProblems As String
3594     RecordMitigation "flexible-move-temporary-mate", True, True
3595     Set namesBefore = FeatureNames()
3596     Set mateNamesBefore = MateNames()
    stepLabel = currentIdentity & ": TemporaryMateMove Count"
3598     matesBefore = mateNamesBefore.Count
3599     matesDuring = matesBefore
3600     sketch3dOpen = False
3601     On Error GoTo Failed
3602     If Not topHandle Is Nothing Then
3603         Set component = topHandle
3604         handleKind = "the selected handle of the drag operator"
    Else
3606         If Not topHandleTried Then
3607             Set component = SelectedComponent(start, selectionNote)
    stepLabel = currentIdentity & ": TemporaryMateMove Name2"
3609             NoteOption "temporary mate handle of " & CStr(start.Name2) & ": " & selectionNote
3610             handleKind = "the handle selected for the mate"
        End If
3612         If component Is Nothing Then
3613             Set component = start
3614             handleKind = "the handle found by the route (no selected handle)"
        End If
    End If
3617     NoteOption "temporary mate: the face is mapped through " & handleKind
    stepLabel = currentIdentity & ": TemporaryMateMove GetModelDoc2"
3619     Set model = component.GetModelDoc2()
3620     Require model, "Component model is not loaded"
    stepLabel = currentIdentity & ": TemporaryMateMove GetBodies2"
3622     bodies = PartDocument(model).GetBodies2(0, False)
3623     If Not IsEmpty(bodies) Then
3624         For Each body In bodies
    stepLabel = currentIdentity & ": TemporaryMateMove GetFaces"
3626             faces = body.GetFaces()
3627             If Not IsEmpty(faces) And face Is Nothing Then
3628                 For Each candidate In faces
3629                     If face Is Nothing Then
    stepLabel = currentIdentity & ": TemporaryMateMove GetSurface"
3631                         Set surface = candidate.GetSurface()
3632                         If Not surface Is Nothing Then
    stepLabel = currentIdentity & ": TemporaryMateMove IsCylinder"
