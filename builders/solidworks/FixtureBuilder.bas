941         status = "not_scripted"
942         GoTo Finished
    End If
    stepLabel = currentIdentity & ": RunDesign Exists"
945     If CandidateCount(index) = 0 And crashedUnits.Exists(identity & "|-") Then
946         message = "crashed SolidWorks in " & CStr(crashedUnits(identity & "|-")) & "; skipped"
947         AppendLog folder, identity, "crash guard", 0, 0, "skipped " & identity & ": " & message
948         status = "failed"
    ElseIf CandidateCount(index) = 0 Then
950         AttemptDesign index, folder, True
951         ClearMarker folder
952         status = "ok"
953         files = attemptFiles
954         If Left$(placementReport, 4) = "fail" Then
            ' The files are saved and stay in the zip; the result is not "ok": the answer key says a part is somewhere else.
956             status = "failed"
