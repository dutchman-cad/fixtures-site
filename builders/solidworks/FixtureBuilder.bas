End Function

Private Function InsideBox(ByVal point As Variant, ByVal low As Variant, ByVal high As Variant) As Boolean
    Dim i As Long
8211     For i = 0 To 2
8212         If CDbl(point(i)) < CDbl(low(i)) - 0.000001 Or CDbl(point(i)) > CDbl(high(i)) + 0.000001 Then Exit Function
    Next i
8214     InsideBox = True
