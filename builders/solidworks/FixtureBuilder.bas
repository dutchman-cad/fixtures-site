Private Function StepArgs(ByVal body As String) As Variant
    ' The top-level arguments of a STEP entity (a comma inside quotes or parentheses does not split), as an array.
    Dim i As Long, ch As String, depth As Long, quoted As Boolean, current As String, joined As String
1952     i = 1
1953     Do While i <= Len(body)
1954         ch = Mid$(body, i, 1)
1955         If quoted Then
1956             current = current & ch
1957             If ch = "'" Then
1958                 If Mid$(body, i + 1, 1) = "'" Then
1959                     current = current & "'"
1960                     i = i + 1
                Else
1962                     quoted = False
                End If
            End If
        ElseIf ch = "'" Then
1966             quoted = True
1967             current = current & ch
        ElseIf ch = "," And depth = 0 Then
1969             joined = joined & current & Chr$(1)
1970             current = ""
        Else
1972             If ch = "(" Then depth = depth + 1
1973             If ch = ")" Then depth = depth - 1
1974             current = current & ch
        End If
1976         i = i + 1
    Loop
1978     StepArgs = Split(joined & current, Chr$(1))
End Function

