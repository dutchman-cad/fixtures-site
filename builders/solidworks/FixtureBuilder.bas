1010     AppendLog folder, currentIdentity, "recipe complete: " & status, 0, 0, MitigationText()
1011     Exit Sub
CleanupFailed:
    failureLine = Erl: failureNumber = Err.Number: failureDescription = Err.Description: failureStep = stepLabel
