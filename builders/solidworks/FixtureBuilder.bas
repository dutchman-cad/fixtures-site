4328     If IsArray(result) Then
4329         If ArrayItems(result, lower, upper) Then
4330             For i = lower To upper
4331                 If found Is Nothing Then
4332                     If ItemAt(result, i, entry, nameText) Then
4333                         If ReadName2(entry, nameText) Then
    stepLabel = currentIdentity & ": MirrorMade Exists"
4335                             If before.Exists(nameText) Then
4336                                 NoteOption "MirrorComponents3 answered " & nameText & ", which stood in the assembly before this call"
                            Else
4338                                 Set found = entry
