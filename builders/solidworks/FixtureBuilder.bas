6135     existing = model.GetConfigurationNames()
6136     For Each item In existing
6137         If Len(names) > 0 Then names = names & ", "
6138         names = names & CStr(item)
6139         count = count + 1
6140         If CStr(item) = CStr(entry("master")) Or CStr(item) = CStr(entry("name")) Then found = found + 1
    Next item
6142     If count <> 2 Or found <> 2 Then Err.Raise 5, , "Saved file has configurations " & names & ", expected " & CStr(entry("master")) & " and " & CStr(entry("name"))
    stepLabel = currentIdentity & ": ReadBackConfiguration ConfigurationManager"
6144     Set configManager = model.ConfigurationManager
    stepLabel = currentIdentity & ": ReadBackConfiguration ActiveConfiguration"
