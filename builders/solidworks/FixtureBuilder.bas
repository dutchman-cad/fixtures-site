    stepLabel = currentIdentity & ": FindBuilt FileExists"
1171             If fs.FileExists(fs.BuildPath(sub1.Path, "results.json")) Then
1172                 text = ""
    stepLabel = currentIdentity & ": FindBuilt BuildPath"
1174                 text = ReadUtf8(fs.BuildPath(sub1.Path, "results.json"))
