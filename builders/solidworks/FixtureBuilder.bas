7079         initError = "Err " & CStr(Err.Number) & " " & Err.Description
7080         Err.Clear
    End If
7082     On Error GoTo Failed
7083     If Len(initError) > 0 Then
7084         noInitialize = True
7085         RecordMitigation "baseflange-featuredata-no-initialize", True, True
7086         NoteBaseFlangeAttempt failures, "IBaseFlangeFeatureData.Initialize raised " & initError
7087         callInputs = baseInputs & " feature data without Initialize: members set directly, default relief, K-factor set on the Sheet-Metal feature after CreateFeature"
    End If
    stepLabel = currentIdentity & ": BaseFlangeByData Thickness"
7090     baseData.Thickness = thickness
    ' Round 7 (field, 34.4.0): ReverseThickness set before CreateFeature had no effect on the built side. The
    ' member named by the caller (ReverseThickness first, then ReverseDirection) is set after Initialize and Thickness.
7093     If reverseMember = "ReverseDirection" Then
    stepLabel = currentIdentity & ": BaseFlangeByData ReverseThickness"
7095         baseData.ReverseThickness = False
    stepLabel = currentIdentity & ": BaseFlangeByData ReverseDirection"
7097         baseData.ReverseDirection = reverseSide
    Else
    stepLabel = currentIdentity & ": BaseFlangeByData ReverseThickness"
7100         baseData.ReverseThickness = reverseSide
    End If
    stepLabel = currentIdentity & ": BaseFlangeByData BendRadius"
7103     baseData.BendRadius = radius
    stepLabel = currentIdentity & ": BaseFlangeByData UseGaugeTable"
7105     baseData.UseGaugeTable = False
7106     If noInitialize Then
7107         RecordMitigation "baseflange-kfactor-on-data", True, True
7108         onDataOk = KFactorOnData(baseData, allowance, kFactor)
    End If
    stepLabel = currentIdentity & ": BaseFlangeByData ReverseThickness"
7111     callInputs = callInputs & " " & reverseMember & "=" & CStr(reverseSide) & " (read back: ReverseThickness=" & CStr(baseData.ReverseThickness) & " ReverseDirection=" & CStr(baseData.ReverseDirection) & ")"
    stepLabel = currentIdentity & ": BaseFlangeByData CreateFeature" & " " & apiInputs & " " & callInputs
7113     Set BaseFlangeByData = doc.FeatureManager.CreateFeature(baseData)
7114     If BaseFlangeByData Is Nothing Then NoteBaseFlangeAttempt failures, "CreateFeature(IBaseFlangeFeatureData) returned no feature: " & callInputs & SelectionSummary() & ProfileNote(profileFeature)
7115     Exit Function
Failed:
7117     errText = "Err " & CStr(Err.Number) & " " & Err.Description
7118     Err.Clear
7119     NoteBaseFlangeAttempt failures, "IBaseFlangeFeatureData route failed with " & errText & " (" & callInputs & ")" & ProfileNote(profileFeature)
7120     Set BaseFlangeByData = Nothing
End Function

