Private Sub ReadBackLimits(ByVal mateName As String, ByVal angular As Boolean, ByVal wantedLow As Double, ByVal wantedHigh As Double, ByVal limitText As String, ByVal poseValue As Double, ByVal flipped As Boolean, ByVal poseText As String)
    ' The limits SolidWorks stored for the mate just made: IMate2.MinimumVariation / MaximumVariation of the newest mate (via IFeature.GetSpecificFeature2),
    ' in meters or radians, RELATIVE to the mate's own value (field 2026.11.24.3): poseValue (mm or degrees, the value passed to AddMate5) is added back.
    ' wantedLow / wantedHigh are in the frame the mate was asked in (flipped: a negative distance passed as |value| with Flip toggled, limits [-max, -min]).
    Dim info As Object, low As Double, high As Double, haveLimits As Boolean, storedText As String, unitName As String, shownLow As Double, shownHigh As Double
5472     On Error Resume Next
    stepLabel = currentIdentity & ": ReadBackLimits GetSpecificFeature2"
5474     Set info = NewestMate().GetSpecificFeature2()
5475     If Err.Number = 0 Then
5476         If Not info Is Nothing Then
    stepLabel = currentIdentity & ": ReadBackLimits MinimumVariation"
5478             low = CDbl(info.MinimumVariation)
    stepLabel = currentIdentity & ": ReadBackLimits MaximumVariation"
5480             high = CDbl(info.MaximumVariation)
5481             If Err.Number = 0 Then haveLimits = True
        End If
    End If
5484     If Err.Number <> 0 Then NoteOption "mate " & mateName & ": IMate2 read-back failed (" & Err.Description & ")"
5485     On Error GoTo 0
5486     If Not haveLimits Then
5487         AddLimitNote mateName & ": limits " & limitText & " requested, limits not read back"
5488         Exit Sub
    End If
5490     unitName = "mm"
5491     If angular Then
5492         low = low * 180# / 3.14159265358979
5493         high = high * 180# / 3.14159265358979
5494         unitName = "deg"
    Else
5496         low = low * 1000#
5497         high = high * 1000#
    End If
5499     low = low + poseValue
5500     high = high + poseValue
5501     shownLow = low
5502     shownHigh = high
5503     If flipped Then
5504         shownLow = -high
5505         shownHigh = -low
    End If
5507     storedText = NoteNumber(shownLow) & ".." & NoteNumber(shownHigh) & " " & unitName
5508     If Abs(low - wantedLow) > 0.000001 Or Abs(high - wantedHigh) > 0.000001 Then
5509         limitDegraded = True
5510         AddLimitNote mateName & ": limits " & limitText & " requested but " & storedText & " stored (read back relative to the pose " & poseText & ")"
5511         Exit Sub
    End If
5513     AddLimitNote mateName & ": limits " & storedText & " stored (read back relative to the pose " & poseText & ")"
End Sub

