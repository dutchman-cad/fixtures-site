Private Function RotationAbout(ByVal axisVector As Variant, ByVal angle As Double) As Variant
    ' The 3x3 turn (row by row) about a world axis through the origin (Rodrigues); the axis is a unit vector.
    Dim c As Double, sn As Double, k As Double, ux As Double, uy As Double, uz As Double
4895     ux = CDbl(axisVector(0))
4896     uy = CDbl(axisVector(1))
4897     uz = CDbl(axisVector(2))
4898     c = Cos(angle)
4899     sn = Sin(angle)
4900     k = 1# - c
4901     RotationAbout = Array(c + ux * ux * k, ux * uy * k - uz * sn, ux * uz * k + uy * sn, _
                          uy * ux * k + uz * sn, c + uy * uy * k, uy * uz * k - ux * sn, _
                          uz * ux * k - uy * sn, uz * uy * k + ux * sn, c + uz * uz * k)
End Function

Private Function InstanceProblem(ByVal component As Object, ByVal number As Long, ByVal wantedT As Variant, ByVal wantedR As Variant) As String
    ' "" when pattern instance #number is at the wanted pose (translation 0.01 mm, rotation 1e-4; wantedT in meters, wantedR row by row), else what was found.
    Dim values As Variant, i As Long, j As Long, moved As Double, turned As Double
    stepLabel = currentIdentity & ": InstanceProblem GetTotalTransform"
4910     values = component.GetTotalTransform(True).ArrayData
4911     For i = 0 To 2
4912         If Abs(CDbl(values(9 + i)) - CDbl(wantedT(i))) > moved Then moved = Abs(CDbl(values(9 + i)) - CDbl(wantedT(i)))
4913         For j = 0 To 2
4914             If Abs(CDbl(values(3 * j + i)) - CDbl(wantedR(3 * i + j))) > turned Then turned = Abs(CDbl(values(3 * j + i)) - CDbl(wantedR(3 * i + j)))
        Next j
    Next i
4917     If moved > 0.00001 Or turned > 0.0001 Then
    stepLabel = currentIdentity & ": InstanceProblem Name2"
4919         InstanceProblem = "instance #" & CStr(number) & " (" & CStr(component.Name2) & ") is at (" & NoteList(Array(CDbl(values(9)) * 1000#, CDbl(values(10)) * 1000#, CDbl(values(11)) * 1000#)) & ") mm, expected (" & NoteList(Array(CDbl(wantedT(0)) * 1000#, CDbl(wantedT(1)) * 1000#, CDbl(wantedT(2)) * 1000#)) & ")"
    End If
End Function

Private Function PatternProblem(ByVal seed As Object, ByVal fresh As Variant, ByVal circular As Boolean, ByVal direction1 As Variant, ByVal count1 As Long, ByVal spacing1 As Double, ByVal direction2 As Variant, ByVal count2 As Long, ByVal spacing2 As Double) As String
    ' "" when instance #k is where the pattern puts it, else what is wrong (the instances come out mirrored, the other direction, or swapped). The seed's world pose
    ' is carried by a shift along the axis (linear: dir1 first, then dir2) or a turn of angle / count about the world axis through the origin (circular).
    Dim values As Variant, r0(8) As Double, t0(2) As Double, i As Long, j As Long, m As Long, k As Long, number As Long, text As String, one As String
    Dim wantedT(2) As Double, wantedR(8) As Double, turn As Variant
    stepLabel = currentIdentity & ": PatternProblem GetTotalTransform"
4929     values = seed.GetTotalTransform(True).ArrayData
4930     For i = 0 To 2
4931         t0(i) = CDbl(values(9 + i))
4932         For j = 0 To 2
4933             r0(3 * i + j) = CDbl(values(3 * j + i))
        Next j
    Next i
4936     number = 1
4937     If circular Then
4938         For k = 1 To count1 - 1
4939             number = number + 1
4940             If number - 2 > UBound(fresh) Then Exit For
4941             turn = RotationAbout(direction1, k * spacing1 / count1)
4942             For i = 0 To 2
4943                 wantedT(i) = CDbl(turn(3 * i)) * t0(0) + CDbl(turn(3 * i + 1)) * t0(1) + CDbl(turn(3 * i + 2)) * t0(2)
4944                 For j = 0 To 2
4945                     wantedR(3 * i + j) = CDbl(turn(3 * i)) * r0(j) + CDbl(turn(3 * i + 1)) * r0(3 + j) + CDbl(turn(3 * i + 2)) * r0(6 + j)
                Next j
            Next i
4948             one = InstanceProblem(fresh(number - 2), number, wantedT, wantedR)
4949             If Len(one) > 0 Then text = text & IIf(Len(text) > 0, "; ", "") & one
        Next k
    Else
4952         For j = 0 To count2 - 1
4953             For m = 0 To count1 - 1
4954                 If j <> 0 Or m <> 0 Then
4955                     number = number + 1
4956                     If number - 2 > UBound(fresh) Then Exit For
4957                     For i = 0 To 2
4958                         wantedT(i) = t0(i) + CDbl(direction1(i)) * m * spacing1 + CDbl(direction2(i)) * j * spacing2
                    Next i
4960                     one = InstanceProblem(fresh(number - 2), number, wantedT, r0)
4961                     If Len(one) > 0 Then text = text & IIf(Len(text) > 0, "; ", "") & one
                End If
            Next m
        Next j
    End If
4966     PatternProblem = text
End Function

Private Function ComponentPattern(ByVal label As String, ByVal circular As Boolean, ByVal direction1 As Variant, ByVal count1 As Long, ByVal spacing1 As Double, ByVal direction2 As Variant, ByVal count2 As Long, ByVal spacing2 As Double) As Object
    ' A21 and A22: a linear or circular component pattern of one component (a part or a whole subassembly). Plans, in order:
    ' FeatureLinearPattern3 (linear) / FeatureCircularPattern5 with the components at mark 1 and the axis at mark 2, then the axis at mark 1 and
    ' the components at mark 4 (circular-pattern-marks), then for the linear one the pattern feature data of the 2024 interop
    ' (pattern-feature-data). The instances are the components that were not there before; the seed is #1. For a circular pattern spacing1 is
    ' the whole angle (radians) and count1 the number of instances. Where each instance ends up is read back; instances that are mirrored or
    ' swapped (the pattern went the other way) are undone and the pattern is made once more with the direction reversed (pattern-direction-reversed);
    ' wrong again fails the recipe.
    Dim seed As Object, axis1 As Object, axis2 As Object, reversedAxis As Object, data As Object, feature As Object, before As Object, plan As Long, fresh As Variant
    Dim marks As Variant, total As Long, text As String, fallback As String, reverse As Long, problem As String, firstProblem As String
4979     Set seed = components(label)
4980     Set before = ComponentNames()
4981     Set axis1 = WorldAxis(CDbl(direction1(0)), CDbl(direction1(1)), CDbl(direction1(2)))
4982     If count2 > 1 Then Set axis2 = WorldAxis(CDbl(direction2(0)), CDbl(direction2(1)), CDbl(direction2(2)))
4983     total = count1 * count2
4984     fallback = IIf(circular, "circular-pattern-marks", "pattern-feature-data")
4985     For reverse = 0 To 1
4986         For plan = 0 To 1
4987             If plan > 0 Then RecordMitigation fallback, True, True
    stepLabel = currentIdentity & ": ComponentPattern ClearSelection2"
4989             doc.ClearSelection2 True
4990             Set feature = Nothing
4991             If plan = 1 And Not circular Then
4992                 text = "pattern feature data"
4993                 If reverse = 1 Then
                    ' The data has no flip member this builder has checked: the axis is made the other way round.
4995                     Set reversedAxis = WorldAxis(-CDbl(direction1(0)), -CDbl(direction1(1)), -CDbl(direction1(2)))
4996                     Set feature = PatternFromFeatureData(seed, reversedAxis, count1, spacing1)
                Else
4998                     Set feature = PatternFromFeatureData(seed, axis1, count1, spacing1)
                End If
            Else
5001                 If circular Then
5002                     If plan = 0 Then marks = Array(1, 2) Else marks = Array(4, 1)
5003                     text = IIf(plan = 0, "components mark 1, axis mark 2", "axis mark 1, components mark 4")
                Else
5005                     marks = Array(1, 2)
5006                     text = "FeatureLinearPattern3"
                End If
    stepLabel = currentIdentity & ": ComponentPattern CreateSelectData" & " " & apiInputs & " " & callInputs
5009                 Set data = doc.SelectionManager.CreateSelectData()
    stepLabel = currentIdentity & ": ComponentPattern Mark"
5011                 data.Mark = CLng(marks(0))
    stepLabel = currentIdentity & ": ComponentPattern Select4" & " " & apiInputs & " " & callInputs
5013                 If Not seed.Select4(False, data, False) Then Err.Raise 5, , "Component pattern selection failed"
    stepLabel = currentIdentity & ": ComponentPattern Select2" & " " & apiInputs & " " & callInputs
5015                 If Not axis1.Select2(True, CLng(marks(1))) Then Err.Raise 5, , "Component pattern axis selection failed"
5016                 If count2 > 1 Then
    stepLabel = currentIdentity & ": ComponentPattern Select2" & " " & apiInputs & " " & callInputs
5018                     If Not axis2.Select2(True, 4) Then Err.Raise 5, , "Component pattern axis selection failed"
                End If
5020                 If circular Then
    stepLabel = currentIdentity & ": ComponentPattern FeatureCircularPattern5"
5022                     Set feature = doc.FeatureManager.FeatureCircularPattern5(count1, spacing1, (reverse = 1), "", False, True, False, False, False, False, 1, 0#, "", False)
                Else
    stepLabel = currentIdentity & ": ComponentPattern FeatureLinearPattern3"
5025                     Set feature = doc.FeatureManager.FeatureLinearPattern3(count1, spacing1, count2, spacing2, (reverse = 1), False, "", "", False, False)
                End If
            End If
5028             NoteOption "component pattern of " & label & " (" & text & IIf(reverse = 1, ", reversed", "") & ") returned " & IIf(feature Is Nothing, "nothing", "a feature")
5029             If Not feature Is Nothing Then
5030                 If plan > 0 Then fallbackSuccesses(fallback) = fallbackSuccesses(fallback) + 1
5031                 Exit For
            End If
5033             If circular And plan = 1 Then Exit For
        Next plan
5035         Require feature, "Every plan of the component pattern of " & label & " returned nothing"
5036         fresh = NewComponents(before)
5037         If UBound(fresh) + 1 <> total - 1 Then Err.Raise 5, , "The component pattern of " & label & " made " & CStr(UBound(fresh) + 1) & " new components, wanted " & CStr(total - 1)
5038         problem = PatternProblem(seed, fresh, circular, direction1, count1, spacing1, direction2, count2, spacing2)
5039         If Len(problem) = 0 Then
5040             If reverse = 1 Then fallbackSuccesses("pattern-direction-reversed") = fallbackSuccesses("pattern-direction-reversed") + 1
5041             Exit For
        End If
5043         NoteOption "component pattern of " & label & IIf(reverse = 1, " (reversed)", "") & ": " & problem
    stepLabel = currentIdentity & ": ComponentPattern EditUndo2"
5045         doc.EditUndo2 1
5046         If reverse = 0 Then
5047             firstProblem = problem
5048             RecordMitigation "pattern-direction-reversed", True, True
        Else
5050             Err.Raise 5, , "The component pattern of " & label & " puts its instances in the wrong places in both directions: " & firstProblem & "; reversed: " & problem
        End If
    Next reverse
5053     patternInstances(label) = fresh
5054     NoteOption "component pattern of " & label & " made " & CStr(total - 1) & " new instances"
5055     Set ComponentPattern = feature
End Function

Private Sub CheckState(ByVal path As String, ByVal config As Variant, ByVal external As Variant, ByVal flexible As Variant, ByVal mirroredPart As Variant)
    ' What expect.json says of an instance beyond its pose: config (the configuration the component references), external (a file link or a
    ' virtual copy), flexible (the solving option of the subassembly instance it is in) and mirroredPart (it is the new part file).
    Dim topLabel As String, component As Object, direct As Boolean, text As String, virtual As Boolean, solving As Long, stem As String
5062     topLabel = path
5063     If InStr(topLabel, "/") > 0 Then topLabel = Left$(topLabel, InStr(topLabel, "/") - 1)
5064     If InStr(topLabel, "#") > 0 Then topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    stepLabel = currentIdentity & ": CheckState Exists"
5066     If Not components.Exists(topLabel) Then Exit Sub
5067     direct = (InStr(path, "/") = 0)
5068     Set component = components(topLabel)
5069     On Error Resume Next
5070     If direct And Not IsEmpty(config) Then
    stepLabel = currentIdentity & ": CheckState ReferencedConfiguration"
5072         If CStr(component.ReferencedConfiguration) <> CStr(config) Then text = text & path & ": references configuration " & CStr(component.ReferencedConfiguration) & ", expected " & CStr(config) & "; "
    End If
5074     If direct And Not IsEmpty(external) Then
    stepLabel = currentIdentity & ": CheckState IsVirtual"
5076         virtual = component.IsVirtual
5077         If virtual = CBool(external) Then
5078             text = text & path & ": " & IIf(virtual, "a virtual copy", "a link to its own file") & ", expected " & IIf(CBool(external), "a link", "a virtual copy") & "; "
        ElseIf CBool(external) Then
    stepLabel = currentIdentity & ": CheckState GetPathName"
5081             If LCase$(Right$(CStr(component.GetPathName()), 7)) <> ".sldprt" Then text = text & path & ": file " & FileLeaf(CStr(component.GetPathName())) & " is not a part file; "
        End If
    End If
5084     If Not IsEmpty(flexible) Then
    stepLabel = currentIdentity & ": CheckState Solving"
5086         solving = CLng(component.Solving)
5087         If (solving = swComponentFlexibleSolving) <> CBool(flexible) Then text = text & path & ": its subassembly is " & IIf(solving = swComponentFlexibleSolving, "flexible", "rigid") & ", expected " & IIf(CBool(flexible), "flexible", "rigid") & "; "
    End If
5089     If direct And Not IsEmpty(mirroredPart) Then
    stepLabel = currentIdentity & ": CheckState GetPathName"
5091         stem = FileStem(CStr(component.GetPathName()))
    stepLabel = currentIdentity & ": CheckState GetPathName"
5093         If stem <> CStr(mirroredPart) Then text = text & path & ": made from " & FileLeaf(CStr(component.GetPathName())) & ", expected the new part " & CStr(mirroredPart) & "; "
    End If
5095     If Err.Number <> 0 Then text = text & path & ": cannot read its state (" & Err.Description & "); "
5096     On Error GoTo 0
5097     If Len(text) > 0 Then
        ' Each problem of the instance counts once (the text holds "; " between them).
5099         Do While Len(text) > 0
5100             If InStr(text, "; ") > 0 Then
5101                 AddPlacementProblem Left$(text, InStr(text, "; ") - 1)
5102                 text = Mid$(text, InStr(text, "; ") + 2)
            Else
5104                 AddPlacementProblem text
5105                 text = ""
            End If
        Loop
    End If
End Sub

Private Sub CheckBox(ByVal wanted As Variant)
    ' The union of the top-level components' boxes against expect.json's bbox (mm) (A20, where t and R are not scored). IComponent2.GetBox is
    ' padded by about 0.44 mm on every side, so the tolerance is 0.6 mm.
    Dim keyName As Variant, box As Variant, got(5) As Double, i As Long, first As Boolean, worst As Double, component As Object, reason As String
5115     first = True
5116     On Error Resume Next
    stepLabel = currentIdentity & ": CheckBox Keys"
5118     For Each keyName In components.Keys
5119         Set component = components(keyName)
    stepLabel = currentIdentity & ": CheckBox IsSuppressed"
5121         If Not component.IsSuppressed() Then
    stepLabel = currentIdentity & ": CheckBox GetBox"
5123             box = component.GetBox(False, False)
5124             If IsArray(box) Then
5125                 For i = 0 To 2
5126                     If first Or CDbl(box(i)) * 1000# < got(i) Then got(i) = CDbl(box(i)) * 1000#
5127                     If first Or CDbl(box(i + 3)) * 1000# > got(i + 3) Then got(i + 3) = CDbl(box(i + 3)) * 1000#
                Next i
5129                 first = False
            Else
5131                 reason = "component box unavailable"
            End If
        End If
    Next keyName
5135     If Err.Number <> 0 Then reason = Err.Description
5136     On Error GoTo 0
5137     If Len(reason) > 0 Or first Then
5138         AddPlacementProblem "bbox: cannot read it (" & reason & ")"
5139         Exit Sub
    End If
5141     For i = 0 To 5
5142         If Abs(got(i) - CDbl(wanted(i))) > worst Then worst = Abs(got(i) - CDbl(wanted(i)))
    Next i
5144     If worst > 0.6 Then AddPlacementProblem "bbox (" & NoteList(got) & ") mm, expected (" & NoteList(wanted) & ") (box padded about 0.44 mm)"
End Sub

