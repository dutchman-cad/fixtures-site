    End If
3690     GoTo Finished
Failed:
3692     problem = "(line " & CStr(Erl) & ") " & Err.Description
3693     Err.Clear
Finished:
3695     On Error Resume Next
3696     failures = CleanUpTemporary(namesBefore, mateNamesBefore)
3697     If Err.Number <> 0 Then failures = failures & " clean-up raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
3698     Err.Clear
3699     On Error GoTo 0
3700     leftOver = TemporaryLeftovers(namesBefore, mateNamesBefore)
3701     If Len(leftOver) > 0 Then
3702         Err.Raise 5, , "The temporary Concentric mate rung for " & path & " left " & leftOver & " in the assembly (" & IIf(Len(failures & deleteProblems) > 0, "clean-up: " & deleteProblems & " " & failures, "nothing reported failing") & IIf(Len(problem) > 0, "; the rung failed with: " & problem, "") & "); the recipe stops here, no later rung runs on it"
    End If
3704     If Len(problem) > 0 Then
3705         text = "temporary Concentric mate: " & problem
3706         Exit Function
    End If
3708     If Not moved Then Exit Function
3709     If Not movedAfter Then
3710         Err.Raise 5, , "The part " & path & " went back when the temporary Concentric mate was deleted: it read (" & NoteList(nowValues) & ") mm with the mate and (" & NoteList(afterValues) & ") mm after the mate, its axis and its 3D sketch were deleted and the assembly rebuilt, wanted (" & NoteList(wanted) & ") mm; the mate is not kept (the mate count would differ from the answer key)"
    End If
3712     fallbackSuccesses("flexible-move-temporary-mate") = fallbackSuccesses("flexible-move-temporary-mate") + 1
3713     text = "temporary Concentric mate moved the part"
3714     TemporaryMateMove = True
End Function

