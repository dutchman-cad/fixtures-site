Private Sub PartConfiguration(ByVal recipe As String, ByVal file As String, ByVal configName As String, ByVal originalMm As Double, ByVal heightMm As Double, ByVal activeName As String)
    ' A26: a copy of the part with a second configuration whose extrusion depth is heightMm. Every write is checked by the part's GEOMETRY
    ' (ConfigurationDepth), not by the dimension handle. Routes: 1 IDimension.SetSystemValue3 for the one configuration; 2 the configuration activated and
    ' SetSystemValue3 for this configuration (config-dimension-this-configuration); 3 the configuration activated, the dimension fetched again (a fresh
    ' handle) and SetSystemValue3 for this configuration (config-dimension-fresh-handle). When a route left the new depth right but changed the original
    ' configuration too, the original depth is set back for its own configuration with a fresh handle in it (also config-dimension-fresh-handle).
    Dim model As Object, lastDimension As Object, configManager As Object, defaultName As String, original As Double, height As Double
    Dim tallDepth As Double, defaultDepth As Double, addedConfig As Object, route As Long, enteredThis As Boolean, enteredFresh As Boolean, usedName As String
3839     Set model = CopyPartFile(recipe, file)
3840     original = originalMm * 0.001
3841     height = heightMm * 0.001
3842     Set lastDimension = DepthDimension(model, original)
    stepLabel = currentIdentity & ": PartConfiguration ConfigurationManager"
3844     Set configManager = model.ConfigurationManager
3845     Require configManager, "Configuration configManager unavailable"
    stepLabel = currentIdentity & ": PartConfiguration Name"
3847     defaultName = CStr(configManager.ActiveConfiguration.Name)
    ' The depth is the Z extent of the body: checked once in the original configuration, so a wrong axis assumption is an error, not a silent one.
3849     If Abs(PartDepthGeometry(model) - original) > 0.000001 Then Err.Raise 5, , "The part geometry is " & CStr(PartDepthGeometry(model)) & " m along Z in configuration " & defaultName & " but its extrusion depth is " & CStr(original) & " m: the depth is not the Z extent of its box"
    stepLabel = currentIdentity & ": PartConfiguration AddConfiguration"
3851     Set addedConfig = configManager.AddConfiguration(configName, "", "", 0, "", "")
3852     Require addedConfig, "AddConfiguration returned no configuration: name=" & configName
3853     SetDepth lastDimension, height, swSetValue_InSpecificConfigurations, configName
3854     tallDepth = ConfigurationDepth(model, lastDimension, configName)
3855     defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
3856     For route = 0 To 2
3857         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) > 0.000001 Then
            ' The new depth is right and the original is not: set the original back in its own configuration with a fresh handle.
3859             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3860             enteredFresh = True
3861             ActivateConfiguration model, defaultName, "the original configuration"
3862             SetDepth DepthDimension(model, -1#), original, swSetValue_InSpecificConfigurations, defaultName
3863             usedName = "config-dimension-fresh-handle"
3864             tallDepth = ConfigurationDepth(model, lastDimension, configName)
3865             defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
        End If
3867         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) <= 0.000001 Then Exit For
3868         If route = 2 Then Err.Raise 5, , "Configuration depths read back " & configName & " " & CStr(tallDepth) & " m and " & defaultName & " " & CStr(defaultDepth) & " m (by the geometry), wanted " & CStr(height) & " and " & CStr(original) & ", after SetSystemValue3 for the specific configuration, for this configuration, with a fresh handle, and the original set back"
3869         If route = 0 Then
3870             If Not enteredThis Then RecordMitigation "config-dimension-this-configuration", True, True
3871             enteredThis = True
3872             ActivateConfiguration model, configName, "the new configuration"
3873             SetDepth lastDimension, height, swSetValue_InThisConfiguration, ""
3874             usedName = "config-dimension-this-configuration"
        Else
3876             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3877             enteredFresh = True
3878             ActivateConfiguration model, configName, "the new configuration"
3879             SetDepth DepthDimension(model, -1#), height, swSetValue_InThisConfiguration, ""
3880             usedName = "config-dimension-fresh-handle"
        End If
3882         tallDepth = ConfigurationDepth(model, lastDimension, configName)
3883         defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
    Next route
3885     If Len(usedName) > 0 Then fallbackSuccesses(usedName) = fallbackSuccesses(usedName) + 1
3886     ActivateConfiguration model, IIf(activeName = "Default", defaultName, activeName), "the part configuration"
3887     NoteOption file & ".sldprt: configurations " & defaultName & " depth " & CStr(defaultDepth) & " m, " & configName & " depth " & CStr(tallDepth) & " m"
3888     SaveModel model, currentFolder & "\" & file & ".sldprt", True
    stepLabel = currentIdentity & ": PartConfiguration GetSaveFlag"
3890     If model.GetSaveFlag() Then Err.Raise 5, , file & ".sldprt still has unsaved changes after SaveAs"
3891     AddPartReadBack model, file, Array(defaultName, configName), Array(defaultDepth, tallDepth), IIf(activeName = "Default", defaultName, activeName)
    stepLabel = currentIdentity & ": PartConfiguration CloseDoc"
3893     app.CloseDoc model.GetTitle()
End Sub

