        End If
4868         Set madeComponent = Nothing
4869         raisedNumber = 0
4870         On Error Resume Next
4871         Set madeComponent = MirrorCall(plane, sourceComponent, newPart, path, CLng(orientationList(orientLower + number)), before, 0, -1)
4872         If Err.Number <> 0 Then
