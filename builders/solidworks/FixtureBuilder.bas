8449     labels = Array("base", "vertical", "beside")
8450     Set views(0) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "*Top", "base", layout(0), layout(1), Nothing)
8451     Set views(1) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "", "vertical", layout(2), layout(3), views(0))
8452     Set views(2) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "", "beside", layout(4), layout(5), views(0))
8453     For k = 0 To 2
