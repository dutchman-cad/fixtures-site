Private Function JsonRowValue(ByVal row As String, ByVal key As String) As String
    ' The string value of a top-level key of one results.json row (rows are written by this builder).
    Dim i As Long, depth As Long, c As String, token As String, j As Long, isKey As Boolean
1106     i = 1
1107     Do While i <= Len(row)
1108         c = Mid$(row, i, 1)
1109         If c = "{" Then
1110             depth = depth + 1
        ElseIf c = "}" Then
1112             depth = depth - 1
        ElseIf c = Chr$(34) Then
1114             token = ""
1115             i = i + 1
1116             Do While i <= Len(row)
1117                 c = Mid$(row, i, 1)
1118                 If c = "\" Then
1119                     i = i + 1
1120                     token = token & Mid$(row, i, 1)
                ElseIf c = Chr$(34) Then
1122                     Exit Do
                Else
1124                     token = token & c
                End If
1126                 i = i + 1
            Loop
1128             j = i + 1
1129             Do While j <= Len(row) And Mid$(row, j, 1) = " "
1130                 j = j + 1
            Loop
1132             isKey = (depth = 1 And Mid$(row, j, 1) = ":")
1133             If isKey And token = key Then
1134                 j = j + 1
1135                 Do While j <= Len(row) And Mid$(row, j, 1) = " "
1136                     j = j + 1
                Loop
1138                 If Mid$(row, j, 1) = Chr$(34) Then
1139                     j = j + 1
1140                     Do While j <= Len(row)
1141                         c = Mid$(row, j, 1)
1142                         If c = "\" Then
1143                             j = j + 1
1144                             JsonRowValue = JsonRowValue & Mid$(row, j, 1)
                        ElseIf c = Chr$(34) Then
1146                             Exit Do
                        Else
1148                             JsonRowValue = JsonRowValue & c
                        End If
1150                         j = j + 1
                    Loop
                End If
1153                 Exit Function
            End If
        End If
1156         i = i + 1
    Loop
End Function

Private Sub FindBuilt(ByVal parent As String, ByVal ownName As String, ByVal version As String, ByVal build As String)
    ' Recipes that were ok on this exact SolidWorks version and build in a sibling output folder.
    Dim fs As Object, sub1 As Object, text As String, i As Long, depth As Long, start As Long
    Dim inString As Boolean, c As String, row As String, identity As String
