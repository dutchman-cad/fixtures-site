Private Sub ExportGuard(ByVal path As String)
    ' Right after SolidWorks writes a DXF or a PDF the builder made: a DXF is text and is scrubbed like one; a PDF is scanned for the names (not
    ' rewritten). A PDF with a name in it, a file over 4 MB (too large to check) or one that cannot be read is deleted and the row fails. The
    ' .sld* files are compressed and are not scanned (the stamp in them is documented); a STEP file has its own guard.
    Dim fs As Object, ext As String, text As String, cleaned As String, problem As String
1710     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ExportGuard GetExtensionName"
1712     ext = LCase$(fs.GetExtensionName(path))
1713     If ext <> "dxf" And ext <> "pdf" Then Exit Sub
    stepLabel = currentIdentity & ": ExportGuard FileExists"
1715     If Not fs.FileExists(path) Then Exit Sub
1716     On Error Resume Next
1717     If ext = "dxf" Then
1718         text = SweepRead(path)
1719         If Err.Number = 0 Then
1720             cleaned = PrivacyScrub(text)
1721             If cleaned <> text Then SweepWrite path, cleaned
        End If
    ElseIf StrayHasNeedle(path) Then
1724         problem = "carried a personal name"
    End If
1726     If Err.Number <> 0 Then
1727         problem = "could not be checked"
1728         If InStr(Err.Description, "size cap") > 0 Then problem = "too large to check (over 4 MB)"
    End If
1730     Err.Clear
1731     On Error GoTo 0
1732     If Len(problem) > 0 Then
1733         If privateRun And ext = "pdf" And problem = "carried a personal name" Then
            ' Agreed at the run folder box (drawings package): the drawing stays, private.
1735             privateKept = True
1736             Exit Sub
        End If
1738         If Not SweepDelete(fs, path) Then SweepTruncate fs, path
1739         Err.Raise 5, , "privacy: " & ext & " " & problem
    End If
End Sub

