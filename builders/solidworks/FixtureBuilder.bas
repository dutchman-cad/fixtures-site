Private Function SweepReencodes(ByVal text As String, ByRef bytes As Variant) As Boolean
    ' True when the text, encoded as UTF-8, is byte for byte the file: the file really was UTF-8.
    Dim stream As Object, again As Variant, i As Long, same As Boolean
1835     Set stream = CreateObject("ADODB.Stream")
1836     stream.Type = 2
1837     stream.Charset = "utf-8"
1838     stream.Open
1839     stream.WriteText text
1840     stream.Position = 0
1841     stream.Type = 1
1842     stream.Position = 3
1843     again = stream.Read
1844     stream.Close
1845     same = (UBound(again) = UBound(bytes))
1846     If same Then
1847         For i = 0 To UBound(bytes)
1848             If again(i) <> bytes(i) Then same = False: Exit For
        Next i
    End If
1851     SweepReencodes = same
End Function

Private Function SweepRead(ByVal path As String) As String
    ' The file as text, in the encoding it was written in (left in sweepEncoding): UTF-16 or UTF-8 with a byte-order mark, UTF-8 without
    ' one, else the ANSI codepage the builder's own log is written in. A file over 4 MB, NUL bytes without a UTF-16 mark, or any decode
    ' error raises: the caller counts that as a hit (truncate or delete), never as clean.
    Dim stream As Object, bytes As Variant, size As Long, text As String, i As Long, channel As Integer
1859     Set stream = CreateObject("ADODB.Stream")
1860     stream.Type = 1
1861     stream.Open
1862     stream.LoadFromFile path
1863     size = stream.Size
1864     If size > 4194304 Then Err.Raise 5, , "over the sweep size cap"
1865     If size = 0 Then
1866         stream.Close
1867         sweepEncoding = "utf-8"
1868         SweepRead = ""
1869         Exit Function
    End If
1871     bytes = stream.Read
1872     stream.Close
1873     If size >= 2 And bytes(0) = 255 And bytes(1) = 254 Then
1874         sweepEncoding = "utf-16-le-bom"
1875         SweepRead = SweepText(path, "unicode")
1876         Exit Function
    End If
1878     If size >= 2 And bytes(0) = 254 And bytes(1) = 255 Then
1879         sweepEncoding = "utf-16-be-bom"
1880         SweepRead = SweepText(path, "unicodeFFFE")
1881         Exit Function
    End If
1883     If size >= 3 Then
1884         If bytes(0) = 239 And bytes(1) = 187 And bytes(2) = 191 Then
1885             sweepEncoding = "utf-8-bom"
1886             SweepRead = SweepText(path, "utf-8")
1887             Exit Function
        End If
    End If
1890     For i = 0 To UBound(bytes)
1891         If bytes(i) = 0 Then Err.Raise 5, , "NUL bytes without a UTF-16 byte-order mark"
    Next i
1893     text = SweepText(path, "utf-8")
1894     If SweepReencodes(text, bytes) Then
1895         sweepEncoding = "utf-8"
1896         SweepRead = text
1897         Exit Function
    End If
1899     sweepEncoding = "ansi"
1900     channel = FreeFile
1901     Open path For Binary Access Read As #channel
1902     text = Space$(LOF(channel))
1903     Get #channel, , text
1904     Close #channel
1905     SweepRead = text
End Function

Private Sub SweepWrite(ByVal path As String, ByVal text As String)
    ' Back in the encoding SweepRead found (never a different one).
    Dim stream As Object, channel As Integer, fs As Object
1911     Select Case sweepEncoding
        Case "utf-8"
1913             WriteUtf8 path, text
        Case "utf-8-bom", "utf-16-le-bom", "utf-16-be-bom"
1915             Set stream = CreateObject("ADODB.Stream")
1916             stream.Type = 2
1917             If sweepEncoding = "utf-16-le-bom" Then
1918                 stream.Charset = "unicode"
            ElseIf sweepEncoding = "utf-16-be-bom" Then
1920                 stream.Charset = "unicodeFFFE"
            Else
1922                 stream.Charset = "utf-8"
            End If
1924             stream.Open
1925             stream.WriteText text
1926             stream.SaveToFile path, 2
1927             stream.Close
        Case Else
1929             Set fs = CreateObject("Scripting.FileSystemObject")
1930             If fs.FileExists(path) Then fs.DeleteFile path, True
1931             channel = FreeFile
1932             Open path For Binary Access Write As #channel
1933             Put #channel, , text
1934             Close #channel
    End Select
End Sub

