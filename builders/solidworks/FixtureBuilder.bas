6033             If status = swSuppressionChangeOk Then
6034                 If attempt = 1 Then fallbackSuccesses("configuration-suppress-rebuild") = fallbackSuccesses("configuration-suppress-rebuild") + 1
6035                 AppendLog currentFolder, currentIdentity, "option", 0, 0, "configuration suppression: " & statuses
6036                 Exit For
            End If
        Next attempt
6039         If status <> swSuppressionChangeOk Then Err.Raise 5, , "Component suppression failed: " & statuses & "(swSuppressionError_e: 0 bad component, 1 bad state, 2 ok, 3 change failed)"
    Next item
6041     wanted = master
6042     If requestedActive <> "master" Then wanted = configName
6043     ActivateConfiguration doc, wanted, "configuration (configurations: " & names & ", " & configName & ")"
    stepLabel = currentIdentity & ": AddConfigurationState ActiveConfiguration"
