8005     If reliefError <> 0 Then Err.Raise 5, , "ICornerReliefFeatureData.CollectAllCorners returned swCornerReliefError_e " & CStr(reliefError) & ": " & callInputs
8006     If Not IsArray(corners) Then Err.Raise 5, , "ICornerReliefFeatureData.CollectAllCorners found no corners after the multi-edge flange: " & callInputs
