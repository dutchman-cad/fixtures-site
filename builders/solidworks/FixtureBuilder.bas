    ' the allowance put on it, IFeature.ModifyDefinition, the K-factor read back from the Sheet-Metal feature.
    Dim flange As Object, baseFlangeData As Object, allowance As Object, modified As Boolean, accessed As Boolean, text As String, putText As String
6754     On Error GoTo Failed
6755     Set flange = FindFeature("SMBaseFlange")
6756     Require flange, "No base flange feature"
    stepLabel = currentIdentity & ": ModifyFlangeK GetDefinition"
6758     Set baseFlangeData = flange.GetDefinition()
6759     Require baseFlangeData, "Base flange feature data unavailable"
    stepLabel = currentIdentity & ": ModifyFlangeK AccessSelections"
6761     accessed = baseFlangeData.AccessSelections(doc, Nothing)
6762     KNote label & ": AccessSelections returned " & CStr(accessed)
6763     If Not accessed Then Err.Raise 5, , "IBaseFlangeFeatureData.AccessSelections failed"
    stepLabel = currentIdentity & ": ModifyFlangeK CreateCustomBendAllowance" & " " & apiInputs & " " & callInputs
6765     Set allowance = doc.FeatureManager.CreateCustomBendAllowance()
6766     Require allowance, "CreateCustomBendAllowance returned nothing"
    stepLabel = currentIdentity & ": ModifyFlangeK Type"
6768     allowance.Type = swBendAllowanceKFactor
    stepLabel = currentIdentity & ": ModifyFlangeK KFactor"
6770     allowance.KFactor = kFactor
6771     On Error Resume Next
    stepLabel = currentIdentity & ": ModifyFlangeK SetCustomBendAllowance"
6773     baseFlangeData.SetCustomBendAllowance allowance
6774     If Err.Number <> 0 Then
6775         putText = "refused (Err " & CStr(Err.Number) & " " & Err.Description & ")"
    Else
6777         putText = "accepted"
    End If
6779     Err.Clear
6780     On Error GoTo Failed
6781     KNote label & ": SetCustomBendAllowance " & putText
    stepLabel = currentIdentity & ": ModifyFlangeK ModifyDefinition"
6783     modified = flange.ModifyDefinition(baseFlangeData, doc, Nothing)
    stepLabel = currentIdentity & ": ModifyFlangeK ReleaseSelectionAccess"
6785     baseFlangeData.ReleaseSelectionAccess
6786     KNote label & ": ModifyDefinition returned " & CStr(modified)
6787     ModifyFlangeK = ReadSheetK(kFactor, text)
6788     KNote label & ": read back " & text
6789     NoteK tried, label & ": SetCustomBendAllowance " & putText & ", ModifyDefinition returned " & CStr(modified) & ", read back " & text
6790     Exit Function
Failed:
6792     text = label & " raised Err " & CStr(Err.Number) & " " & Err.Description
6793     Err.Clear
6794     On Error Resume Next
    stepLabel = currentIdentity & ": ModifyFlangeK ReleaseSelectionAccess"
6796     baseFlangeData.ReleaseSelectionAccess
6797     Err.Clear
6798     On Error GoTo 0
6799     NoteK tried, text
6800     KNote text
6801     ModifyFlangeK = False
End Function

