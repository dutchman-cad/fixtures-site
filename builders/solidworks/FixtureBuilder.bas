Private Sub CurveStart(ByVal curveFeature As Object)
    ' The start point and unit tangent (meters) of a helix or spiral, evaluated on the curve SolidWorks built: the feature's
    ' IReferenceCurve, its first edge's ICurve at the start parameter (ICurve.GetEndParams, ICurve.Evaluate2 with one derivative).
    Dim reference As Object, firstEdge As Object, curveObject As Object, startParameter As Double, endParameter As Double
    Dim closedFlag As Boolean, periodicFlag As Boolean, values As Variant, length As Double, i As Long, first As Long
    stepLabel = currentIdentity & ": CurveStart GetSpecificFeature2"
9232     Set reference = curveFeature.GetSpecificFeature2()
9233     Require reference, "The helix feature has no reference curve (GetSpecificFeature2 returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetFirstSegment"
9235     Set firstEdge = reference.GetFirstSegment()
9236     Require firstEdge, "The helix has no first segment (IReferenceCurve.GetFirstSegment returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetCurve"
9238     Set curveObject = firstEdge.GetCurve()
9239     Require curveObject, "The helix edge has no curve (IEdge.GetCurve returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetEndParams"
9241     curveObject.GetEndParams startParameter, endParameter, closedFlag, periodicFlag
    stepLabel = currentIdentity & ": CurveStart Evaluate2"
9243     values = curveObject.Evaluate2(startParameter, 1)
9244     If Not IsArray(values) Then Err.Raise 5, , "ICurve.Evaluate2 returned nothing"
9245     first = LBound(values)
9246     If UBound(values) - first < 5 Then Err.Raise 5, , "ICurve.Evaluate2 returned " & CStr(UBound(values) - first + 1) & " values at the start parameter, expected the point and its first derivative"
9247     For i = 0 To 2
9248         helixStart(i) = CDbl(values(first + i))
9249         helixTangent(i) = CDbl(values(first + 3 + i))
    Next i
9251     length = Sqr(helixTangent(0) ^ 2 + helixTangent(1) ^ 2 + helixTangent(2) ^ 2)
9252     If length < 0.000000000001 Then Err.Raise 5, , "The helix has no tangent at its start parameter"
9253     For i = 0 To 2
9254         helixTangent(i) = helixTangent(i) / length
    Next i
9256     helixStartKnown = True
End Sub

