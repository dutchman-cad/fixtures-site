    stepLabel = currentIdentity & ": ProbeMateEntity GetTwoAdjacentFaces2"
5792     faces = edge.GetTwoAdjacentFaces2()
5793     circleLength = Sqr(circleData(3) * circleData(3) + circleData(4) * circleData(4) + circleData(5) * circleData(5))
5794     For i = LBound(faces) To UBound(faces)
5795         Set face = faces(i)
    stepLabel = currentIdentity & ": ProbeMateEntity Normal"
