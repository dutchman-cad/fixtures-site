Private Sub RunProbes(ByVal index As Long, ByVal folder As String, ByVal started As Double, ByRef status As String, ByRef message As String, ByRef files As String)
    ' Probe mode: each candidate approach of the recipe is built in its own fresh document. The first that passes is saved (its files are
    ' the recipe's); the others are built only to record whether they pass. After the first success no probe starts once the recipe has
    ' used PROBE_SECONDS. probesJson / probeKept go into the recipe's results.json row.
    Dim count As Long, k As Long, itemName As String, failure As String, kept As Boolean, elapsed As Double, entry As String, summary As String
    Dim keptMitigations As Object, keptPrimary As Object, keptFallback As Object
1453     count = CandidateCount(index)
1454     probesJson = ""
1455     probeKept = ""
1456     status = "failed"
1457     For k = 1 To count
1458         itemName = CandidateName(index, k)
1459         elapsed = Timer - started
1460         If elapsed < 0 Then elapsed = elapsed + 86400#
1461         If kept And elapsed > PROBE_SECONDS Then
1462             failure = "skipped: the recipe had already used " & CStr(CLng(elapsed)) & " s (limit " & CStr(PROBE_SECONDS) & " s for probes after the first success)"
1463             entry = ProbeEntry(itemName, False, failure, "")
1464             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
        ElseIf crashedUnits.Exists(currentIdentity & "|" & itemName) Then
1466             failure = "crashed SolidWorks in " & CStr(crashedUnits(currentIdentity & "|" & itemName)) & " (skipped)"
1467             entry = ProbeEntry(itemName, False, failure, "")
1468             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
1469             If Len(summary) > 0 Then summary = summary & " | "
1470             summary = summary & itemName & ": " & failure
        Else
1472             probeCandidate = itemName
1473             If k > 1 Then
                ' The mitigation counters of a recipe are the kept candidate's (or the last one's when none passes).
1475                 Set mitigations = CreateObject("Scripting.Dictionary")
1476                 Set primaryFailures = CreateObject("Scripting.Dictionary")
1477                 Set fallbackSuccesses = CreateObject("Scripting.Dictionary")
            End If
1479             failure = TryAttempt(index, folder, Not kept)
1480             ReleaseAttempt folder
1481             ClearMarker folder
1482             probeCandidate = ""
1483             If Len(failure) = 0 Then
1484                 entry = ProbeEntry(itemName, True, "", probeNote)
1485                 AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": ok"
1486                 If Not kept Then
1487                     kept = True
1488                     probeKept = Left$(itemName, 60)
1489                     files = attemptFiles
1490                     Set keptMitigations = mitigations
1491                     Set keptPrimary = primaryFailures
1492                     Set keptFallback = fallbackSuccesses
                End If
            Else
1495                 entry = ProbeEntry(itemName, False, failure, probeNote)
1496                 AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": failed " & failure
1497                 If Len(summary) > 0 Then summary = summary & " | "
1498                 summary = summary & itemName & ": " & failure
1499                 If Not kept Then DeleteResultFiles folder, currentIdentity
            End If
        End If
1502         If k <= 20 Then
1503             If Len(probesJson) > 0 Then probesJson = probesJson & ","
1504             probesJson = probesJson & entry
        End If
    Next k
1507     If kept Then
1508         status = "ok"
1509         Set mitigations = keptMitigations
1510         Set primaryFailures = keptPrimary
1511         Set fallbackSuccesses = keptFallback
    Else
1513         message = "Every candidate failed: " & summary
    End If
End Sub

