7998             If Not cornerData.Initialize(swCornerReliefBendType_TwoBend) Then Err.Raise 5, , "ICornerReliefFeatureData.Initialize(TwoBend) returned False after SetBodyScope: " & callInputs
7999             corners = Empty
    stepLabel = currentIdentity & ": CornerReliefFeature CollectAllCorners"
8001             reliefError = cornerData.CollectAllCorners(reliefType, corners)
        End If
8003         If reliefError = 0 Then fallbackSuccesses("corner-relief-body-scope") = fallbackSuccesses("corner-relief-body-scope") + 1
