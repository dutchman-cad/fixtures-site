3321             tried = tried & forms(i) & " raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
3322             Err.Clear
3323             Set handle = Nothing
        Else
3325             If Len(tried) > 0 Then tried = tried & " | "
3326             tried = tried & forms(i) & ": SelectByID2 returned " & CStr(returned) & ", " & CStr(selectedCount) & " selected, GetSelectedObjectsComponent4 gave " & IIf(handle Is Nothing, "nothing", "a component")
        End If
3328         On Error GoTo 0
