Private Function ComponentFits(ByVal mine As Collection, ByVal box As Variant, ByVal shift As Variant) As Boolean
    ' Do all the points of one component's edges lie in its box (meters, box(1) low, box(2) high) once moved by `shift`?
    Dim record As Object
8271     For Each record In mine
8272         If Not InsideBox(ShiftPoint(record("p0"), shift), box(1), box(2)) Then Exit Function
8273         If record("kind") = "line" Then
8274             If Not InsideBox(ShiftPoint(record("p1"), shift), box(1), box(2)) Then Exit Function
        End If
    Next record
8277     ComponentFits = True
End Function

Private Sub AddAssemblyEdges(ByVal view As Object, ByVal components As Variant, ByVal found As Collection)
    ' The drawing view of an assembly (D19a): IView.GetVisibleEntities2 takes the component whose edges are wanted (Nothing gives a part's), so each component
    ' the view shows is asked in turn (IView.GetVisibleComponents). components(k) = Array(name, low, high, shift) in meters: the component's box in the assembly
    ' and where its own origin stands there. The reported points are taken as assembly coordinates when they all lie in that box, else as the part's own
    ' coordinates moved by the shift (mitigation drawing-assembly-edges-part-space); when neither fits, the recipe fails naming the component.
    Dim shown As Variant, component As Variant, label As String, k As Long, which As Long, raw As Variant, mine As Collection, record As Object
    Dim shift As Variant, seen As String, viewName As String, moved As Boolean, box As Variant, size As Long
    stepLabel = currentIdentity & ": AddAssemblyEdges GetName2"
8288     viewName = view.GetName2()
    stepLabel = currentIdentity & ": AddAssemblyEdges GetVisibleComponents"
8290     shown = view.GetVisibleComponents()
8291     If Not IsArray(shown) Then Err.Raise 5, , viewName & ": GetVisibleComponents returned no components"
8292     seen = ","
8293     For Each component In shown
    stepLabel = currentIdentity & ": AddAssemblyEdges Name2"
8295         label = CStr(component.Name2)
8296         size = Len(label)
8297         Do While size > 0
8298             If Mid$(label, size, 1) Like "#" Then
8299                 size = size - 1
            Else
8301                 Exit Do
            End If
        Loop
8304         If size > 0 And size < Len(label) Then
8305             If Mid$(label, size, 1) = "-" Then label = Left$(label, size - 1)
        End If
8307         which = -1
8308         For k = 0 To UBound(components)
8309             If CStr(components(k)(0)) = label Then which = k
        Next k
8311         If which >= 0 Then
8312             box = components(which)
8313             seen = seen & label & ","
    stepLabel = currentIdentity & ": AddAssemblyEdges GetVisibleEntities2"
8315             raw = view.GetVisibleEntities2(component, swViewEntityType_Edge)
8316             If Not IsArray(raw) Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges for the component " & label
8317             Set mine = New Collection
8318             AddEdgeRecords mine, raw
    stepLabel = currentIdentity & ": AddAssemblyEdges Count"
8320             If mine.Count = 0 Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges for the component " & label
8321             shift = Array(0#, 0#, 0#)
8322             moved = False
8323             If Not ComponentFits(mine, box, shift) Then
8324                 shift = box(3)
8325                 moved = True
8326                 If Not ComponentFits(mine, box, shift) Then Err.Raise 5, , viewName & ": the edge points of the component " & label & " lie outside its box in assembly coordinates and in part coordinates moved to its place"
            End If
8328             If moved Then
8329                 RecordMitigation "drawing-assembly-edges-part-space", True, True
8330                 fallbackSuccesses("drawing-assembly-edges-part-space") = fallbackSuccesses("drawing-assembly-edges-part-space") + 1
            End If
8332             For Each record In mine
8333                 record("p0") = ShiftPoint(record("p0"), shift)
8334                 If record("kind") = "line" Then record("p1") = ShiftPoint(record("p1"), shift)
8335                 If record("kind") = "circle" Then record("raw") = Array(CDbl(record("p0")(0)), CDbl(record("p0")(1)), CDbl(record("p0")(2)), CDbl(record("raw")(3)), CDbl(record("raw")(4)), CDbl(record("raw")(5)), CDbl(record("raw")(6)))
    stepLabel = currentIdentity & ": AddAssemblyEdges Add"
8337                 found.Add record
            Next record
        End If
    Next component
8341     For k = 0 To UBound(components)
8342         If InStr(seen, "," & CStr(components(k)(0)) & ",") = 0 Then Err.Raise 5, , viewName & ": the view shows no edges of the component " & CStr(components(k)(0))
    Next k
End Sub

Private Function DrawingEdges(ByVal view As Object, ByVal low As Variant, ByVal high As Variant, ByRef drop As Long, ByRef spaceName As String, Optional ByVal components As Variant) As Collection
    ' The view's visible line and circle edges, flattened along its axis, in model meters. Entity
    ' coordinates are taken as model coordinates; if they do not all lie inside the model's box they
    ' are tried as view coordinates, and if that fails too the recipe fails. An assembly's view is read component by component (AddAssemblyEdges).
    Dim matrix As Variant, raw As Variant, found As Collection, record As Object
    Dim convert As Long, ok As Boolean, chosen As Long, viewName As String, axis As Variant, size As Double
    stepLabel = currentIdentity & ": DrawingEdges GetName2"
8353     viewName = view.GetName2()
    stepLabel = currentIdentity & ": DrawingEdges ArrayData"
8355     matrix = view.ModelToViewTransform.ArrayData
8356     drop = ViewDrop(view)
8357     Set found = New Collection
8358     If IsArray(components) Then
8359         AddAssemblyEdges view, components, found
    Else
    stepLabel = currentIdentity & ": DrawingEdges GetVisibleEntities2"
8362         raw = view.GetVisibleEntities2(Nothing, swViewEntityType_Edge)
8363         If Not IsArray(raw) Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges"
8364         AddEdgeRecords found, raw
    End If
    stepLabel = currentIdentity & ": DrawingEdges Count"
8367     If found.Count = 0 Then Err.Raise 5, , viewName & ": none of its visible edges is a line or a circle"
8368     chosen = -1
8369     For convert = 0 To 1
8370         ok = True
8371         For Each record In found
8372             If Not InsideBox(RecordPoint(record, "p0", convert, matrix), low, high) Then ok = False
8373             If record("kind") = "line" Then
8374                 If Not InsideBox(RecordPoint(record, "p1", convert, matrix), low, high) Then ok = False
            End If
        Next record
8377         If ok Then
8378             chosen = convert
8379             Exit For
        End If
    Next convert
8382     If chosen < 0 Then Err.Raise 5, , viewName & ": the visible edge points lie outside the model box as model coordinates and as view coordinates (transform " & NumberList(matrix) & ")"
8383     spaceName = IIf(chosen = 0, "model", "view")
8384     For Each record In found
8385         record("a") = FlatPoint(RecordPoint(record, "p0", chosen, matrix), drop)
8386         If record("kind") = "line" Then record("b") = FlatPoint(RecordPoint(record, "p1", chosen, matrix), drop)
8387         If record("kind") = "circle" Then
            ' The circle's axis in model space (a view-space axis is only rotated), and whether the view looks straight down it: then it shows as a
            ' circle; otherwise (edge-on) as a straight line through its center, 2 x radius long.
8390             axis = record("axis")
8391             If chosen = 1 Then axis = RotateToModel(matrix, axis)
            ' faceOn: 1 the view looks down the axis, 0 the axis lies across the view, -1 unknown (a zero or non-unit axis, or one at an angle).
8393             size = Sqr(CDbl(axis(0)) * CDbl(axis(0)) + CDbl(axis(1)) * CDbl(axis(1)) + CDbl(axis(2)) * CDbl(axis(2)))
8394             If Abs(size - 1#) > 0.000001 Then
8395                 record("faceOn") = -1
            ElseIf Abs(Abs(CDbl(axis(drop))) - 1#) <= 0.000001 Then
8397                 record("faceOn") = 1
            ElseIf Abs(CDbl(axis(drop))) <= 0.000001 Then
8399                 record("faceOn") = 0
            Else
8401                 record("faceOn") = -1
            End If
8403             record("flatAxis") = FlatPoint(axis, drop)
        End If
    Next record
8406     Set DrawingEdges = found
End Function

Private Function PlanSingle(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Object
