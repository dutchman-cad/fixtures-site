Private Function MatrixInversePoint(ByVal matrix As Variant, ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' The model point of a sketch point (the inverse of MatrixPoint; the rotation is orthonormal).
    Dim first As Long, scaleFactor As Double, shifted(2) As Double, result(2) As Double, i As Long, j As Long
9726     first = LBound(matrix)
9727     scaleFactor = CDbl(matrix(first + 12))
9728     shifted(0) = (x - CDbl(matrix(first + 9))) / scaleFactor
9729     shifted(1) = (y - CDbl(matrix(first + 10))) / scaleFactor
9730     shifted(2) = (z - CDbl(matrix(first + 11))) / scaleFactor
9731     For i = 0 To 2
9732         For j = 0 To 2
9733             result(i) = result(i) + shifted(j) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
9736     MatrixInversePoint = Array(result(0), result(1), result(2))
End Function

