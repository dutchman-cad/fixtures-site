Private Sub Build0()
    Dim feature As Object
    Dim segments As Variant
    Dim p As Variant
    Dim q As Variant
12252     apiInputs = "op=0 inputs(mm)={""dims"": true, ""entities"": [{""c"": [0, 0, 0], ""h"": 30, ""type"": ""rect_center"", ""w"": 20}], ""kind"": ""sketch"", ""plane"": ""XY"", ""type"": ""sketch""}"
12253     callInputs = ""
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12255     doc.ClearSelection2 True
12256     StartSketch "XY", Nothing, 0.0#
12257     p = LocalPoint(0.0#, 0.0#, 0.0#)
12258     q = p
12259     p(0) = p(0) - 0.01#
12260     p(1) = p(1) - 0.015#
12261     q(0) = q(0) + 0.01#
12262     q(1) = q(1) + 0.015#
12263     callInputs = "coordinates(m)=" & NumberList(Array(p(0), p(1), p(2), q(0), q(1), q(2)))
12264     BeginEntity
    stepLabel = currentIdentity & ": Build0 CreateCornerRectangle" & " " & apiInputs & " " & callInputs
12266     segments = doc.SketchManager.CreateCornerRectangle(p(0), p(1), p(2), q(0), q(1), q(2))
12267     EndEntity
12268     If Not IsArray(segments) Then Err.Raise 5, , "Rectangle creation failed"
12269     Dimension segments(0), Abs(q(0) - p(0)), q(0), p(1) - 0.005, 0#
12270     Dimension segments(1), Abs(q(1) - p(1)), q(0) + 0.005, q(1), 0#
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12272     doc.ClearSelection2 True
    stepLabel = currentIdentity & ": Build0 InsertSketch" & " " & apiInputs & " " & callInputs
12274     doc.SketchManager.InsertSketch True
12275     Set feature = NewestFeature()
12276     Remember "0", feature
12277     apiInputs = "op=1 inputs(mm)={""direction"": ""+"", ""distance"": 10, ""extent"": ""distance"", ""kind"": ""extrude"", ""op"": ""new"", ""profile"": ""last"", ""type"": ""extrude""}"
12278     callInputs = ""
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12280     doc.ClearSelection2 True
12281     Set feature = Ref("last")
    stepLabel = currentIdentity & ": Build0 Select2" & " " & apiInputs & " " & callInputs
12283     If Not feature.Select2(False, 0) Then Err.Raise 5, , "Profile selection failed"
    stepLabel = currentIdentity & ": Build0 FeatureExtrusion3"
12285     Set feature = doc.FeatureManager.FeatureExtrusion3(True, False, False, 0, 0, 0.01#, 0.01#, False, False, False, False, 0#, 0#, False, False, False, False, False, True, True, 0, 0#, False)
12286     Remember "1", feature
