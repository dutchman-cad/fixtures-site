Private Sub ScanCrashes(ByVal parent As String, ByVal ownName As String, ByVal folder As String, ByVal version As String, ByVal build As String)
    ' Crash guard: an inprogress.txt left in a sibling output folder means that attempt crashed SolidWorks. It is renamed to crashed.txt
    ' (counted once) and, with the crashed.txt files of older runs, its recipe|candidate is skipped in this run, unless it was recorded on
    ' another SolidWorks version or build.
    Dim fs As Object, sub1 As Object, markerPath As String, knownPath As String, channel As Integer, textLine As String, fresh As Boolean
    Dim fields As Variant, sameBuild As Boolean, unitText As String, found As Boolean, lead As String
1232     Set crashedUnits = CreateObject("Scripting.Dictionary")
1233     Set fs = CreateObject("Scripting.FileSystemObject")
1234     On Error Resume Next
    stepLabel = currentIdentity & ": ScanCrashes GetFolder"
1236     For Each sub1 In fs.GetFolder(parent).SubFolders
    stepLabel = currentIdentity & ": ScanCrashes Name"
1238         If InStr(1, sub1.Name, "FixtureBuilder-SolidWorks-", vbTextCompare) = 1 And sub1.Name <> ownName Then
    stepLabel = currentIdentity & ": ScanCrashes BuildPath"
1240             markerPath = fs.BuildPath(sub1.Path, "inprogress.txt")
    stepLabel = currentIdentity & ": ScanCrashes BuildPath"
1242             knownPath = fs.BuildPath(sub1.Path, "crashed.txt")
1243             found = False
    stepLabel = currentIdentity & ": ScanCrashes FileExists"
1245             If fs.FileExists(markerPath) Then
    stepLabel = currentIdentity & ": ScanCrashes FileExists"
1247                 If fs.FileExists(knownPath) Then fs.DeleteFile knownPath, True
    stepLabel = currentIdentity & ": ScanCrashes MoveFile"
1249                 fs.MoveFile markerPath, knownPath
1250                 fresh = True: found = True
            ElseIf fs.FileExists(knownPath) Then
1252                 fresh = False: found = True
            End If
1254             If found Then
1255                 lead = IIf(fresh, "previous run crashed during ", "known crash (crashed.txt): ")
1256                 channel = FreeFile
1257                 Open knownPath For Input As #channel
1258                 Do While Not EOF(channel)
1259                     Line Input #channel, textLine
1260                     fields = Split(textLine, vbTab)
1261                     If UBound(fields) >= 1 Then
1262                         sameBuild = True
1263                         If UBound(fields) >= 3 Then
1264                             If Len(fields(3)) > 0 And fields(3) <> version Then sameBuild = False
                        End If
1266                         If UBound(fields) >= 4 Then
1267                             If Len(fields(4)) > 0 And fields(4) <> build Then sameBuild = False
                        End If
    stepLabel = currentIdentity & ": ScanCrashes Name"
1270                         unitText = fields(0) & " " & fields(1) & " (in " & sub1.Name & ")"
1271                         If sameBuild Then
    stepLabel = currentIdentity & ": ScanCrashes Exists"
1273                             If Not crashedUnits.Exists(fields(0) & "|" & fields(1)) Then crashedUnits.Add fields(0) & "|" & fields(1), sub1.Name
1274                             AppendLog folder, "setup", "crash guard", 0, 0, lead & unitText
                        Else
1276                             AppendLog folder, "setup", "crash guard", 0, 0, lead & unitText & "; recorded on another SolidWorks version or build, not skipped"
                        End If
                    End If
                Loop
1280                 Close #channel
            End If
        End If
    Next sub1
1284     Err.Clear
End Sub

