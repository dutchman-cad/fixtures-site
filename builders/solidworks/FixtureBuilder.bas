Private Function MateOffPose(ByVal label As String, ByVal wantedT As Variant, ByVal wantedR As Variant, ByVal isFinal As Boolean, ByRef description As String) As Boolean
    ' Is the component off the pose it must have, where this mate is the one to say so? The pose is the answer key's (wantedT in mm, wantedR the nine
    ' numbers row by row, or Empty where it is not scored); with no answer key it is the pose the component was inserted at. Every mate counts while
    ' the component was inserted at its pose (the mates must not move it); a component inserted elsewhere is judged after the last mate of its composition.
    Dim inserted As Variant, values As Variant, key As String, i As Long, j As Long, moved As Double, turned As Double, drift As Double, spin As Double
    Dim t(2) As Double, r(8) As Double, current(2) As Double, haveR As Boolean, strict As Boolean
5161     key = currentScope & "|" & label
    stepLabel = currentIdentity & ": MateOffPose Exists"
5163     If Not poses.Exists(key) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose Exists"
5165     If Not components.Exists(label) Then Exit Function
5166     inserted = poses(key)
5167     If IsEmpty(wantedT) Then
5168         For i = 0 To 2
5169             t(i) = CDbl(inserted(9 + i)) * 1000#
5170             For j = 0 To 2
5171                 r(3 * i + j) = CDbl(inserted(3 * j + i))
            Next j
        Next i
5174         haveR = True
5175         strict = True
    Else
5177         For i = 0 To 2
5178             t(i) = CDbl(wantedT(i))
        Next i
5180         haveR = Not IsEmpty(wantedR)
5181         If haveR Then
5182             For i = 0 To 8
5183                 r(i) = CDbl(wantedR(i))
            Next i
        End If
5186         For i = 0 To 2
5187             If Abs(CDbl(inserted(9 + i)) * 1000# - t(i)) > drift Then drift = Abs(CDbl(inserted(9 + i)) * 1000# - t(i))
5188             If haveR Then
5189                 For j = 0 To 2
5190                     If Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j)) > spin Then spin = Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j))
                Next j
            End If
        Next i
5194         strict = (drift <= 0.01 And spin <= 0.0001)
    End If
5196     If Not (isFinal Or strict) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose GetTotalTransform"
5198     values = components(label).GetTotalTransform(True).ArrayData
5199     For i = 0 To 2
5200         current(i) = CDbl(values(9 + i)) * 1000#
5201         If Abs(current(i) - t(i)) > moved Then moved = Abs(current(i) - t(i))
5202         If haveR Then
5203             For j = 0 To 2
5204                 If Abs(CDbl(values(3 * j + i)) - r(3 * i + j)) > turned Then turned = Abs(CDbl(values(3 * j + i)) - r(3 * i + j))
            Next j
        End If
    Next i
5208     description = "at (" & NoteList(current) & ") mm, wanted (" & NoteList(t) & ")"
5209     If haveR Then description = description & ", the turn differs by " & NoteNumber(turned)
5210     MateOffPose = (moved > 0.01 Or turned > 0.0001)
End Function

