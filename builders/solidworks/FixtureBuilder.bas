        "SolidWorks stores this path inside every assembly and drawing it saves, so the files you send would show it. " & _
        "Choose a neutral one instead, for example " & DefaultOutputRoot() & " for the output folder. Nothing was built."
End Function

Private Function DriveRooted(ByVal path As String) As Boolean
    Dim t As String
548     t = Trim$(path)
549     DriveRooted = (Len(t) >= 3 And Mid$(t, 1, 1) Like "[A-Za-z]" And Mid$(t, 2, 1) = ":" And (Mid$(t, 3, 1) = "\" Or Mid$(t, 3, 1) = "/"))
End Function

Private Function PersonalWhy(ByVal path As String, ByVal identity As Boolean) As String
    ' With identity False (the default output root, the one folder the builder names itself) only the last two rules apply, so a user called
    ' Documents, Public or FixtureBuilder is not locked out of it. The first of these that applies, on the lower-cased path: inside %USERPROFILE%; inside a OneDrive folder or the redirected Documents
    ' folder; a folder that is, or (guarded names) contains, %USERNAME% or the profile folder's own name; a folder named after the computer,
    ' domain or logon server; a folder whose name contains "onedrive"; a UNC share; a Users\<name> folder that is not Public.
    Dim p As String, profile As String, parts As Variant, i As Long, k As Long, why As String
    Dim names(0 To 1) As String, machines(0 To 2) As String, roots(0 To 3) As String
559     p = NormalPath(path)
560     profile = NormalPath(EnvText("USERPROFILE"))
561     names(0) = LCase$(EnvText("USERNAME"))
562     names(1) = LeafOf(profile)
563     machines(0) = LCase$(EnvText("COMPUTERNAME"))
564     machines(1) = LCase$(EnvText("USERDOMAIN"))
565     machines(2) = LCase$(Replace(EnvText("LOGONSERVER"), "\", ""))
566     roots(0) = NormalPath(EnvText("OneDrive"))
567     roots(1) = NormalPath(EnvText("OneDriveCommercial"))
568     roots(2) = NormalPath(EnvText("OneDriveConsumer"))
569     roots(3) = NormalPath(EnvText("MYDOCUMENTS"))
570     parts = Split(p, "\")
571     If identity Then
572         If UnderRoot(p, profile) Then why = "it is inside your user profile folder"
    End If
574     If Len(why) = 0 And identity Then
575         For k = 0 To 3
576             If UnderRoot(p, roots(k)) Then why = "it is inside your OneDrive or redirected Documents folder"
        Next k
    End If
579     If Len(why) = 0 And identity Then
580         For k = 0 To 1
581             If Len(names(k)) > 0 Then
582                 For i = 0 To UBound(parts)
583                     If SegmentMatches(CStr(parts(i)), names(k)) Then why = "a folder in its path contains your Windows user name"
                Next i
            End If
        Next k
    End If
588     If Len(why) = 0 And identity Then
589         For k = 0 To 2
590             For i = 0 To UBound(parts)
591                 If SegmentMatches(CStr(parts(i)), machines(k)) Then why = "a folder in its path is named after this computer, its domain or its logon server"
            Next i
        Next k
    End If
595     If Len(why) = 0 And identity Then
596         For i = 0 To UBound(parts)
597             If InStr(parts(i), "onedrive") > 0 Then why = "a folder in its path is a OneDrive folder"
        Next i
    End If
600     If Len(why) = 0 And Left$(p, 2) = "\\" Then why = "it is on a network share (a \\server\share path)"
601     If Len(why) = 0 Then
602         For i = 0 To UBound(parts) - 1
603             If parts(i) = "users" And Len(parts(i + 1)) > 0 And parts(i + 1) <> "public" And parts(i + 1) <> "default" And parts(i + 1) <> "all users" And parts(i + 1) <> "shared" Then why = "it is inside the personal folder of a Windows user (a Users\<name> folder)"
        Next i
    End If
    ' Last, and for every folder (the default root too): a folder that is not a full path with a drive letter ("FixtureOut", "..\x",
    ' "%USERPROFILE%\x", which FileSystemObject does not expand) would resolve against SolidWorks' own current folder, which may be under the profile.
608     If Len(why) = 0 Then
609         If Not DriveRooted(path) Then why = "the folder must be a full path starting with a drive letter"
    End If
611     PersonalWhy = why
End Function

Private Function PersonalPathReason(ByVal path As String) As String
    Dim why As String
616     why = PersonalWhy(path, NormalPath(path) <> NormalPath(DefaultOutputRoot()))
617     If Len(why) = 0 Then
618         PersonalPathReason = ""
    Else
620         PersonalPathReason = PersonalPathRefusal("output folder", why)
    End If
End Function

Private Function PersonalTemplateReason(ByVal kind As String, ByVal path As String) As String
    Dim why As String
626     why = PersonalWhy(path, True)
627     If Len(why) = 0 Then
628         PersonalTemplateReason = ""
    Else
630         PersonalTemplateReason = "The " & kind & " template SolidWorks would use was refused because " & why & ". " & _
            "A SolidWorks drawing stores the path of its sheet format and template, so the files you send would show it. " & _
            "In SolidWorks, under Tools > Options > Default Templates, choose a " & kind & " template in a neutral folder (for example the SolidWorks install folder or C:\ProgramData). Nothing was built."
    End If
End Function

Private Function EscapeRegex(ByVal text As String) As String
    Dim i As Long, ch As String, result As String
638     For i = 1 To Len(text)
639         ch = Mid$(text, i, 1)
640         If InStr("\.+*?^$()[]{}|-", ch) > 0 Then result = result & "\"
641         result = result & ch
    Next i
643     EscapeRegex = result
End Function

Private Function RootPattern(ByVal root As String) As String
    ' A folder path as a pattern that also matches its doubled-backslash (JSON) and forward-slash forms.
648     RootPattern = Replace(EscapeRegex(root), "\\", "[\\/]+")
End Function

Private Function CaseForms(ByVal word As String) As String
    ' The word as written, lower-cased and upper-cased, as one escaped alternation: VBScript's RegExp folds the case of ASCII letters only, so a
    ' Cyrillic or Greek name written in another case would be missed. LCase$ and UCase$ are Unicode-aware.
654     CaseForms = "(?:" & EscapeRegex(word) & "|" & EscapeRegex(LCase$(word)) & "|" & EscapeRegex(UCase$(word)) & ")"
End Function

Private Function ScrubNeedle(ByVal regex As Object, ByVal text As String, ByVal needle As String, ByVal marker As String) As String
    ' A word-matched needle wherever no ASCII letter or digit is next to it (start of text, tab, quote ...); any other only as a whole folder name.
    Dim result As String
660     result = text
661     If Len(needle) > 0 Then
662         If NameInsideComponents(LCase$(needle)) Then
663             regex.Pattern = "(^|[^A-Za-z0-9])" & CaseForms(needle) & "(?=[^A-Za-z0-9]|$)"
664             result = regex.Replace(result, "$1" & marker)
        Else
666             regex.Pattern = "([\\/])" & CaseForms(needle) & "(?=[.,;)]*(?:[\\/\s""'<>|:*?]|$))"
667             result = regex.Replace(result, "$1" & marker)
        End If
    End If
670     ScrubNeedle = result
End Function

Private Function PrivacyScrub(ByVal text As String) As String
    ' Every message a volunteer might screenshot, every log line and every text file in the output goes through this. In order: the tail
    ' of any path under \Users\<x> (x is not Public; a name with a space, an 8.3 name, a Dropbox (Company) folder: all of it, up to a
    ' quote, a line end, a tab or the sentence end) becomes <user>\<path>; the profile, OneDrive and Documents folders likewise; the
    ' Windows user name and the profile folder's own name (anywhere when guarded, else only as a whole folder name) become <user>; the
    ' computer, domain and logon server names (whole tokens, guarded) become <host>; a \\server\share prefix becomes <share>.
    Dim regex As Object, result As String, roots(0 To 4) As String, names(0 To 1) As String, machines(0 To 2) As String
    Dim k As Long, tailEnd As String, swap As String, exempt As String
681     tailEnd = "(?=[.,;)]*(?:[""'\r\n<>|]|$))"
682     exempt = "(?!(?:public|default|all users|shared)(?:[\\/""'\r\n<>|]|$))"
683     result = text
684     Set regex = CreateObject("VBScript.RegExp")
685     regex.Global = True
686     regex.IgnoreCase = True
687     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
688     result = regex.Replace(result, "$1<user>$2<path>")
689     regex.Pattern = "([\\/]Users[\\/]+)" & exempt & "[^\\/""'\r\n<>|:*?]+?" & tailEnd
690     result = regex.Replace(result, "$1<user>")
691     roots(0) = EnvText("USERPROFILE")
692     roots(1) = EnvText("OneDrive")
693     roots(2) = EnvText("OneDriveCommercial")
694     roots(3) = EnvText("MYDOCUMENTS")
695     roots(4) = EnvText("OneDriveConsumer")
696     For k = 0 To 4
697         If Len(roots(k)) > 0 Then
698             regex.Pattern = RootPattern(roots(k)) & "((?:\\\\|[\\/](?![""']))+)(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
699             result = regex.Replace(result, "<user>$1<path>")
700             regex.Pattern = RootPattern(roots(k))
701             result = regex.Replace(result, "<user>")
        End If
    Next k
704     names(0) = EnvText("USERNAME")
705     names(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
    ' The longer of the two first (jsmith.ACME before jsmith), so no part of the profile folder's name is left behind.
707     If Len(names(1)) > Len(names(0)) Then
708         swap = names(0)
709         names(0) = names(1)
710         names(1) = swap
    End If
712     machines(0) = EnvText("COMPUTERNAME")
713     machines(1) = EnvText("USERDOMAIN")
714     machines(2) = Replace(EnvText("LOGONSERVER"), "\", "")
715     For k = 0 To 1
716         result = ScrubNeedle(regex, result, names(k), "<user>")
    Next k
718     For k = 0 To 2
719         result = ScrubNeedle(regex, result, machines(k), "<host>")
    Next k
721     regex.Pattern = "(^|[^\\/\w:])(?:\\\\|//){1,2}[^\\/\s""'<>|:*?]+(?:\\\\|[\\/](?![""']))+(?:[^""'\r\n<>|\\]|\\\\|\\(?![""']))*"
722     result = regex.Replace(result, "$1<share>")
723     PrivacyScrub = result
End Function


Private Function EmptiedLine() As String
    ' "" unless the sweep had to empty or delete a text file it could not clean: then the volunteer is told the zip is incomplete.
729     If sweepEmptiedCount > 0 Then EmptiedLine = vbLf & CStr(sweepEmptiedCount) & " file(s) could not be cleaned and were emptied: " & sweepEmptied
End Function

Private Function FinishMessage(ByVal total As Long, ByVal built As Long, ByVal failed As Long, ByVal notScripted As Long, ByVal alreadyBuilt As Long, ByVal zipPath As String, ByVal zipMade As Boolean, ByVal folder As String) As String
    Dim noun As String, earlier As String, counts As String
734     noun = "recipes"
735     If total = 1 Then noun = "recipe"
736     If alreadyBuilt > 0 Then earlier = ", " & CStr(alreadyBuilt) & " already built in an earlier run"
737     counts = CStr(total) & " " & noun & ": " & CStr(built) & " built, " & CStr(failed) & " failed, " & CStr(notScripted) & _
        " not scripted" & earlier & " (details in FixtureBuilder.log)." & EmptiedLine()
739     If sweepListFailed Then
