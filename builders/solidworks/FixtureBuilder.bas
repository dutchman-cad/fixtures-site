Private Function FlangeSpan(ByVal edge As Object, ByVal kind As String, ByVal corner As Variant, ByVal firstValue As Double, ByVal secondValue As Double) As Variant
    ' Model end points (m) of a part-width flange. "width": firstValue from the
    ' given corner, secondValue wide. "offset": firstValue from the end with the
    ' lower coordinate along the edge, secondValue from the other end.
    Dim a As Variant, b As Variant, swap As Variant, length As Double, unit(2) As Double
    Dim startAt As Double, endAt As Double, i As Long, k As Long, startPoint(2) As Double, endPoint(2) As Double
    stepLabel = currentIdentity & ": FlangeSpan GetPoint"
7871     a = edge.GetStartVertex().GetPoint()
    stepLabel = currentIdentity & ": FlangeSpan GetPoint"
7873     b = edge.GetEndVertex().GetPoint()
7874     length = PointDistance(a, b)
7875     If kind = "width" Then
7876         If PointDistance(corner, b) < 0.000000001 Then
7877             swap = a: a = b: b = swap
        ElseIf PointDistance(corner, a) >= 0.000000001 Then
7879             Err.Raise 5, , "Flange width: from_corner is not an end of the flange edge"
        End If
7881         startAt = firstValue: endAt = firstValue + secondValue
    Else
7883         k = 0
7884         For i = 1 To 2
7885             If Abs(b(i) - a(i)) > Abs(b(k) - a(k)) Then k = i
        Next i
7887         If b(k) < a(k) Then
7888             swap = a: a = b: b = swap
        End If
7890         startAt = firstValue: endAt = length - secondValue
    End If
7892     If startAt < 0 Or endAt <= startAt Or endAt > length + 0.000000001 Then Err.Raise 5, , "Flange width: span " & NumberList(Array(startAt, endAt)) & " m is outside the " & NumberList(Array(length)) & " m edge"
7893     For i = 0 To 2
7894         unit(i) = (b(i) - a(i)) / length
7895         startPoint(i) = a(i) + unit(i) * startAt
7896         endPoint(i) = a(i) + unit(i) * endAt
    Next i
7898     FlangeSpan = Array(Array(startPoint(0), startPoint(1), startPoint(2)), Array(endPoint(0), endPoint(1), endPoint(2)))
End Function

Private Function ProfileOffset(ByVal matrix As Variant, ByVal pa As Variant, ByVal pb As Variant, ByVal height As Double, ByVal axisIndex As Long, ByVal side As Long) As Variant
    ' A sketch vector (u, v) is the model vector u * column 0 + v * column 1 of
    ' the transform's rotation; take the perpendicular of pa-pb along the axis.
    Dim first As Long, du As Double, dv As Double, length As Double, nu As Double, nv As Double, component As Double
7905     first = LBound(matrix)
7906     du = pb(0) - pa(0): dv = pb(1) - pa(1)
7907     length = Sqr(du * du + dv * dv)
7908     If length < 0.000000001 Then Err.Raise 5, , "Edge flange base line has zero length in the profile sketch"
7909     nu = -dv / length: nv = du / length
7910     component = nu * CDbl(matrix(first + 3 * axisIndex)) + nv * CDbl(matrix(first + 3 * axisIndex + 1))
7911     If component * side < 0 Then
7912         nu = -nu: nv = -nv: component = -component
    End If
7914     If component * side < 0.000001 Then Err.Raise 5, , "Edge flange profile plane has no component along the requested direction"
