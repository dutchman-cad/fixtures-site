Private Function CreateMate(ByVal kind As Long, ByVal alignment As Long, ByVal flip As Boolean, ByVal distance As Double, ByVal upper As Double, ByVal lower As Double, ByVal numerator As Double, ByVal denominator As Double, ByVal angle As Double, ByVal angleUpper As Double, ByVal angleLower As Double, ByVal positioning As Boolean, ByVal lockRotation As Boolean, ByVal widthValue As Long) As Object
    Dim errors As Long, kept As Long, retried As String, alignOrder As Variant, alignNow As Long, retryNumber As Long, i As Long
    stepLabel = currentIdentity & ": CreateMate AddMate5"
5829     Set CreateMate = AssemblyDocument(doc).AddMate5(kind, alignment, flip, distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, positioning, lockRotation, widthValue, errors)
5830     If errors = swAddMateError_ErrorUknown And kind = swMateDISTANCE Then
        ' Round 8 (field, 34.4.0, A05b): a distance mate with DistUpper = DistLower = the distance came back as
        ' swAddMateError_ErrorUknown (0). Those two arguments are the limits of a limit-distance mate; for a plain
        ' distance mate they are 0. Once more with the limits 0, the same selections, alignment and flip.
5834         RecordMitigation "distance-mate-no-limits", True, True
    stepLabel = currentIdentity & ": CreateMate GetSelectedObjectCount2"
5836         kept = doc.SelectionManager.GetSelectedObjectCount2(-1)
5837         If kept <> 2 Then Err.Raise 5, , "SolidWorks AddMate5 error 0 (distance mate) and the failed call left " & CStr(kept) & " objects selected, not 2; no retry with limits 0: arguments " & NumberList(Array(kind, alignment, IIf(flip, 1, 0), distance, upper, lower))
5838         retried = "; the same call with DistUpper = DistLower = 0 was tried after error 0 for " & NumberList(Array(kind, alignment, IIf(flip, 1, 0), distance, upper, lower))
5839         upper = 0#
5840         lower = 0#
    stepLabel = currentIdentity & ": CreateMate AddMate5"
5842         Set CreateMate = AssemblyDocument(doc).AddMate5(kind, alignment, flip, distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, positioning, lockRotation, widthValue, errors)
5843         If errors = swAddMateError_NoError Then fallbackSuccesses("distance-mate-no-limits") = fallbackSuccesses("distance-mate-no-limits") + 1
    End If
5845     If kind = swMateCOINCIDENT And (errors = 3 Or errors = 4 Or errors = 5) Then
        ' Round 22 (field 2026.11.24.6, SolidWorks 2023, A05a): AddMate5 answered error 5 for an edge Coincident mate with Align 1 (the same call works on 2026).
        ' The other alignments are asked in turn, Closest (2) then Aligned (0), each with the same entities selected again; every answer is logged (mate-align-retry).
5848         alignOrder = Array(swMateAlignCLOSEST, swMateAlignALIGNED)
5849         For i = 0 To 1
5850             alignNow = CLng(alignOrder(i))
5851             If alignNow <> alignment Then
5852                 If retryNumber = 0 Then RecordMitigation "mate-align-retry", True, True
5853                 retryNumber = retryNumber + 1
5854                 If Not ReplayPicks() Then Exit For
    stepLabel = currentIdentity & ": CreateMate AddMate5"
5856                 Set CreateMate = AssemblyDocument(doc).AddMate5(kind, alignNow, flip, distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, positioning, lockRotation, widthValue, errors)
5857                 NoteOption "mate-align-retry: AddMate5 with Align " & CStr(alignNow) & " answered error " & CStr(errors)
5858                 retried = retried & "; Align " & CStr(alignNow) & " answered error " & CStr(errors)
5859                 If errors = swAddMateError_NoError Then
5860                     fallbackSuccesses("mate-align-retry") = fallbackSuccesses("mate-align-retry") + 1
5861                     Exit For
                End If
            End If
        Next i
    End If
    ' swAddMateError_e: swAddMateError_NoError = 1 is success (0 is ErrorUnknown); round 4 failed every mate on 1.
5867     If errors <> swAddMateError_NoError Then Err.Raise 5, , "SolidWorks AddMate5 error " & CStr(errors) & " (arguments (Type, Align, Flip, Dist, DistUpper, DistLower, GearNum, GearDen, Angle, AngleUpper, AngleLower, ForPositioning, LockRotation, WidthType) = " & NumberList(Array(kind, alignment, IIf(flip, 1, 0), distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, IIf(positioning, 1, 0), IIf(lockRotation, 1, 0), widthValue)) & "; " & callInputs & SelectionSummary() & retried & ")"
5868     Require CreateMate, "Mate API returned no mate"
End Function

Private Function CylinderFace(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal nx As Double, ByVal ny As Double, ByVal nz As Double) As Object
    ' A cylinder's IFace2.Normal is not one vector: match by the radial direction at the point
    ' (ISurface.CylinderParams: origin xyz, axis xyz, radius), ignoring the sense of the face.
    Dim bodies As Variant, body As Variant, entities As Variant, entity As Variant
    Dim closeFlag As Variant, params As Variant, surface As Object, count As Long
    Dim length As Double, along As Double, ax As Double, ay As Double, az As Double
    Dim rx As Double, ry As Double, rz As Double, size As Double
5878     callInputs = "cylindrical face point(m)=" & NumberList(Array(x, y, z)) & " direction=" & NumberList(Array(nx, ny, nz))
    stepLabel = currentIdentity & ": CylinderFace GetBodies2"
5880     bodies = PartDocument(doc).GetBodies2(0, False)
5881     If Not IsEmpty(bodies) Then
5882         For Each body In bodies
    stepLabel = currentIdentity & ": CylinderFace GetFaces"
5884             entities = body.GetFaces()
5885             If Not IsEmpty(entities) Then
5886                 For Each entity In entities
    stepLabel = currentIdentity & ": CylinderFace GetClosestPointOn"
5888                     closeFlag = entity.GetClosestPointOn(x, y, z)
5889                     If (closeFlag(0) - x) ^ 2 + (closeFlag(1) - y) ^ 2 + (closeFlag(2) - z) ^ 2 <= 0.0000001 ^ 2 Then
    stepLabel = currentIdentity & ": CylinderFace GetSurface"
5891                         Set surface = entity.GetSurface()
5892                         If Not surface Is Nothing Then
    stepLabel = currentIdentity & ": CylinderFace IsCylinder"
5894                             If surface.IsCylinder() Then
    stepLabel = currentIdentity & ": CylinderFace CylinderParams"
5896                                 params = surface.CylinderParams
5897                                 length = Sqr(params(3) ^ 2 + params(4) ^ 2 + params(5) ^ 2)
5898                                 If length > 0 Then
5899                                     ax = params(3) / length: ay = params(4) / length: az = params(5) / length
5900                                     along = (x - params(0)) * ax + (y - params(1)) * ay + (z - params(2)) * az
5901                                     rx = x - params(0) - along * ax: ry = y - params(1) - along * ay: rz = z - params(2) - along * az
5902                                     size = Sqr(rx ^ 2 + ry ^ 2 + rz ^ 2)
5903                                     If size > 0.000000001 Then
5904                                         If Abs((rx * nx + ry * ny + rz * nz) / size) >= 0.999999 Then
5905                                             count = count + 1
5906                                             Set CylinderFace = entity
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next entity
            End If
        Next body
    End If
5917     If count <> 1 Then Err.Raise 5, , "Geometric selector matched " & CStr(count) & " entities (cylindrical faces only)"
End Function

