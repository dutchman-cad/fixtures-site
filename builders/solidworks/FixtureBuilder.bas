982         Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": RunDesign FileExists"
984         If fs.FileExists(fs.BuildPath(folder, identity & ".sldprt")) Then fs.DeleteFile fs.BuildPath(folder, identity & ".sldprt")
    stepLabel = currentIdentity & ": RunDesign FileExists"
986         If fs.FileExists(fs.BuildPath(folder, identity & ".sldasm")) Then fs.DeleteFile fs.BuildPath(folder, identity & ".sldasm")
    stepLabel = currentIdentity & ": RunDesign FileExists"
988         If fs.FileExists(fs.BuildPath(folder, identity & ".slddrw")) Then fs.DeleteFile fs.BuildPath(folder, identity & ".slddrw")
    stepLabel = currentIdentity & ": RunDesign FileExists"
990         If fs.FileExists(fs.BuildPath(folder, identity & ".dxf")) Then fs.DeleteFile fs.BuildPath(folder, identity & ".dxf")
    stepLabel = currentIdentity & ": RunDesign FileExists"
