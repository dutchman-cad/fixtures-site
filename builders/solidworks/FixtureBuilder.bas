    ' what THIS call made is judged against the components standing right before it.
4750     Set standing = ComponentNames()
4751     For form = startForm To 4
4752         If form > startForm Then RecordMitigation MirrorFormName(form), True, True
4753         Select Case form
            Case 1
4755                 Set instance = Nothing
4756                 Set mirrored = Nothing
4757                 Set names = Nothing
4758                 Set orientations = Nothing
            Case 2
4760                 instance = Empty
4761                 mirrored = Empty
4762                 names = Empty
4763                 orientations = Empty
            Case 3
4765                 instance = emptyObjects
4766                 mirrored = emptyObjects
4767                 names = emptyStrings
4768                 orientations = emptyLongs
            Case Else
                ' Form 0 is VBA's Array(), a Variant empty array: what the field run passed. Form 3 above is the typed empty arrays.
4771                 instance = Array()
4772                 mirrored = Array()
4773                 names = Array()
4774                 orientations = Array()
        End Select
4776         If newPart Then
4777             mirrored = ObjectArray1(sourceComponent)
4778             names = StringArray1(path)
        Else
4780             instance = ObjectArray1(sourceComponent)
4781             Select Case arrayKind
                Case 1
4783                     orientations = IntegerArray1(orientation)
                Case 2
4785                     orientations = VariantArray1(orientation)
                Case Else
4787                     orientations = LongArray1(orientation)
            End Select
        End If
4790         aboutCenter = (form <> 3)
4791         If centerMode = 0 Then aboutCenter = False
4792         importOptions = 1
4793         If form = 3 Then importOptions = 0
4794         NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & "): calling"
    stepLabel = currentIdentity & ": MirrorCall ClearSelection2"
4796         doc.ClearSelection2 True
    stepLabel = currentIdentity & ": MirrorCall Select2" & " " & apiInputs & " " & callInputs
4798         If form = 3 Then plane.Select2 False, 0
4799         Set planeArgument = plane
4800         If form = 4 Then
4801             On Error Resume Next
4802             Set planeArgument = Nothing
    stepLabel = currentIdentity & ": MirrorCall GetSpecificFeature2"
4804             Set planeArgument = plane.GetSpecificFeature2()
4805             Err.Clear
4806             On Error GoTo 0
        End If
4808         If planeArgument Is Nothing Then
4809             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & "): the plane feature gave no IRefPlane"
4810             summaries = summaries & "; form " & CStr(form) & ": no IRefPlane"
        Else
    stepLabel = currentIdentity & ": MirrorCall MirrorComponents3"
4813             result = AssemblyDocument(doc).MirrorComponents3(planeArgument, instance, orientations, aboutCenter, mirrored, False, names, IIf(newPart, swMirrorNameCustom, swMirrorNameSuffix), "", currentFolder, importOptions, False, False, False)
4814             Set madeComponent = MirrorMade(result, standing)
4815             If madeComponent Is Nothing Then
4816                 summary = "no new component"
            Else
4818                 ReadName2 madeComponent, madeName
4819                 summary = "made " & madeName
            End If
4821             summary = "returned " & MirrorResultText(result) & "; " & summary & "; last feature " & LastFeatureType()
4822             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & ") " & summary
4823             summaries = summaries & "; form " & CStr(form) & " " & summary
4824             If Not madeComponent Is Nothing Then
