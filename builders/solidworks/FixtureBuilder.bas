Private Sub SettleRoute(ByVal path As String)
    ' For the placement check: a leaf of a FLEXIBLE subassembly is read through the first route (FindChild) whose handle reads where the top assembly has
    ' the part (ChildCheck), as the drag found it; every other leaf keeps route 0.
    Dim route As Long, ok As Boolean, text As String, totalOut As Variant, expectedOut As Variant, topLabel As String
3038     If InStr(path, "/") = 0 Then Exit Sub
    stepLabel = currentIdentity & ": SettleRoute Exists"
3040     If childRoutes.Exists(path) Then Exit Sub
3041     topLabel = Left$(path, InStr(path, "/") - 1)
    stepLabel = currentIdentity & ": SettleRoute Exists"
3043     If Not components.Exists(topLabel) Then Exit Sub
    stepLabel = currentIdentity & ": SettleRoute Solving"
3045     If CLng(components(topLabel).Solving) <> swComponentFlexibleSolving Then Exit Sub
3046     For route = 0 To 3
3047         If RouteHandle(path, route, ok, text, totalOut, expectedOut) Then
3048             If ok Then
3049                 childRoutes(path) = route
3050                 If route > 0 Then NoteOption "locate " & path & ": " & RouteText(route) & " reads where the top assembly has the part"
3051                 Exit Sub
            End If
        End If
    Next route
End Sub

Private Sub MoveComponent(ByVal path As String, ByVal shiftX As Double, ByVal shiftY As Double, ByVal shiftZ As Double)
    ' Drag a part of a flexible subassembly in the top assembly (A24). The part is found through the top assembly by the routes of FindChild in turn
    ' (SolidWorks 2021, field 2026.11.24.4: the pin handle taken from the subassembly's own tree read the local transform and box, so every try moved
    ' nothing in the top assembly); each handle is read BEFORE the move (ChildCheck, logged with the route) and the first one that reads where the top
    ' assembly has the part is moved by the ladder of DragComponent. A handle of an instance that stands at the origin cannot be told from the part by
    ' that reading (local and world agree), so when a ladder fails the next route is read again: where the part stands is where it stood (the earlier try
    ' moved nothing: it is dragged on that route) or at the wanted place (the earlier try moved it), and anywhere else the state is unknown and the recipe
    ' fails. A route other than the first is flexible-child-from-top-instance. Where no route reads right, the ladder runs on the first handle that was
    ' found all the same, and the error carries what each route found.
    Dim route As Long, ok As Boolean, text As String, notes As String, firstFound As Long, i As Long, totalNow As Variant, expectedNow As Variant
    Dim origin As Variant, haveOrigin As Boolean, failed As Boolean, failureText As String, shifts As Variant, movedAway As Double, unmoved As Double
3068     shifts = Array(shiftX, shiftY, shiftZ)
3069     firstFound = -1
3070     For route = 0 To 3
3071         If RouteHandle(path, route, ok, text, totalNow, expectedNow) Then
3072             NoteOption "locate " & path & ": " & RouteText(route) & " found the part before the move: " & text
3073             If firstFound < 0 Then firstFound = route
3074             If Not haveOrigin Then
3075                 origin = expectedNow
3076                 haveOrigin = True
            End If
3078             If Len(notes) > 0 Then notes = notes & " | "
3079             notes = notes & RouteText(route) & ": " & text
3080             If ok Then
3081                 If failed Then
                    ' An earlier ladder failed: where does the part stand now?
3083                     movedAway = 0
3084                     unmoved = 0
3085                     For i = 0 To 2
3086                         If Abs(CDbl(totalNow(i)) - CDbl(origin(i)) - CDbl(shifts(i))) > movedAway Then movedAway = Abs(CDbl(totalNow(i)) - CDbl(origin(i)) - CDbl(shifts(i)))
3087                         If Abs(CDbl(totalNow(i)) - CDbl(origin(i))) > unmoved Then unmoved = Abs(CDbl(totalNow(i)) - CDbl(origin(i)))
                    Next i
3089                     If movedAway <= 0.01 Then
3090                         childRoutes(path) = route
3091                         NoteOption "locate " & path & ": " & RouteText(route) & " reads the part at the wanted place: the earlier try had moved it"
3092                         Exit Sub
                    End If
3094                     If unmoved > 0.01 Then Exit For
                End If
3096                 On Error Resume Next
3097                 DragOnRoute path, route, shiftX, shiftY, shiftZ, notes
3098                 If Err.Number = 0 Then
3099                     On Error GoTo 0
3100                     Exit Sub
                End If
3102                 If Not failed Then failureText = Err.Description
3103                 failed = True
3104                 Err.Clear
3105                 On Error GoTo 0
            End If
        Else
3108             NoteOption "locate " & path & ": " & RouteText(route) & " " & text
3109             If Len(notes) > 0 Then notes = notes & " | "
3110             notes = notes & RouteText(route) & ": " & text
        End If
    Next route
3113     If failed Then Err.Raise 5, , failureText
3114     If firstFound < 0 Then Err.Raise 5, , "No route finds the part " & path & " in the top assembly: " & notes
3115     DragOnRoute path, firstFound, shiftX, shiftY, shiftZ, notes
End Sub

