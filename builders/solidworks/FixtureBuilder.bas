8231     For Each entity In raw
    stepLabel = currentIdentity & ": AddEdgeRecords GetCurve"
8233         Set curve = entity.GetCurve()
8234         If Not curve Is Nothing Then
    stepLabel = currentIdentity & ": AddEdgeRecords IsLine"
8236             If curve.IsLine() Then
