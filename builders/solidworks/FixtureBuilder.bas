5384     Do While Not feature Is Nothing
    stepLabel = currentIdentity & ": NewestMate GetTypeName2"
5386         If feature.GetTypeName2() = "MateGroup" Then Set group = feature
    stepLabel = currentIdentity & ": NewestMate GetNextFeature"
5388         Set feature = feature.GetNextFeature()
    Loop
5390     Require group, "The assembly has no MateGroup feature"
    stepLabel = currentIdentity & ": NewestMate GetFirstSubFeature"
5392     Set feature = group.GetFirstSubFeature()
5393     Do While Not feature Is Nothing
5394         Set newest = feature
    stepLabel = currentIdentity & ": NewestMate GetNextSubFeature"
5396         Set feature = feature.GetNextSubFeature()
    Loop
5398     Require newest, "The MateGroup has no mate"
5399     Set NewestMate = newest
End Function

