    End If
1006     GoTo Finished
Failed:
    failureLine = Erl: failureNumber = Err.Number: failureDescription = Err.Description: failureStep = stepLabel
1009     ClearMarker folder
1010     AppendLog folder, currentIdentity, failureStep, failureLine, failureNumber, failureDescription
1011     message = failureStep & " (line " & CStr(failureLine) & "): " & failureDescription
1012     If Len(kFailure) > 0 Then message = kFailure & "; " & message
1013     status = "failed"
1014     files = "[]"
1015     keepFiles = False
1016     Resume Finished
Finished:
1018     On Error GoTo ReportFailed
1019     priorRows = resultRows
1020     If Len(priorRows) > 0 Then priorRows = priorRows & ","
1021     GoSub PersistRow
1022     On Error GoTo CleanupFailed
1023     EndEntity
1024     If status <> "ok" And Not keepFiles Then
1025         Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": RunDesign FileExists"
1027         If fs.FileExists(fs.BuildPath(folder, identity & ".sldprt")) Then fs.DeleteFile fs.BuildPath(folder, identity & ".sldprt")
