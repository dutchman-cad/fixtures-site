Private Function DrawingEdges(ByVal view As Object, ByVal low As Variant, ByVal high As Variant, ByRef drop As Long, ByRef spaceName As String) As Collection
    ' The view's visible line and circle edges, flattened along its axis, in model meters. Entity
    ' coordinates are taken as model coordinates; if they do not all lie inside the model's box they
    ' are tried as view coordinates, and if that fails too the recipe fails.
    Dim matrix As Variant, raw As Variant, entity As Variant, curve As Object, found As Collection, record As Object
    Dim parameters As Variant, convert As Long, ok As Boolean, chosen As Long, viewName As String, axis As Variant, size As Double
    stepLabel = currentIdentity & ": DrawingEdges GetName2"
8069     viewName = view.GetName2()
    stepLabel = currentIdentity & ": DrawingEdges ArrayData"
8071     matrix = view.ModelToViewTransform.ArrayData
8072     drop = ViewDrop(view)
    stepLabel = currentIdentity & ": DrawingEdges GetVisibleEntities2"
8074     raw = view.GetVisibleEntities2(Nothing, swViewEntityType_Edge)
8075     If Not IsArray(raw) Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges"
8076     Set found = New Collection
8077     For Each entity In raw
    stepLabel = currentIdentity & ": DrawingEdges GetCurve"
8079         Set curve = entity.GetCurve()
8080         If Not curve Is Nothing Then
    stepLabel = currentIdentity & ": DrawingEdges IsLine"
8082             If curve.IsLine() Then
8083                 Set record = CreateObject("Scripting.Dictionary")
8084                 record("kind") = "line"
8085                 Set record("entity") = entity
    stepLabel = currentIdentity & ": DrawingEdges GetPoint"
8087                 record("p0") = entity.GetStartVertex().GetPoint()
    stepLabel = currentIdentity & ": DrawingEdges GetPoint"
8089                 record("p1") = entity.GetEndVertex().GetPoint()
    stepLabel = currentIdentity & ": DrawingEdges Add"
8091                 found.Add record
            ElseIf curve.IsCircle() Then
    stepLabel = currentIdentity & ": DrawingEdges CircleParams"
8094                 parameters = curve.CircleParams
8095                 Set record = CreateObject("Scripting.Dictionary")
8096                 record("kind") = "circle"
8097                 Set record("entity") = entity
8098                 record("p0") = Array(CDbl(parameters(0)), CDbl(parameters(1)), CDbl(parameters(2)))
                ' ICurve.CircleParams: center x, y, z, axis x, y, z, radius.
8100                 record("axis") = Array(CDbl(parameters(3)), CDbl(parameters(4)), CDbl(parameters(5)))
8101                 record("radius") = CDbl(parameters(6))
8102                 record("raw") = Array(CDbl(parameters(0)), CDbl(parameters(1)), CDbl(parameters(2)), CDbl(parameters(3)), CDbl(parameters(4)), CDbl(parameters(5)), CDbl(parameters(6)))
    stepLabel = currentIdentity & ": DrawingEdges Add"
8104                 found.Add record
            End If
        End If
    Next entity
    stepLabel = currentIdentity & ": DrawingEdges Count"
8109     If found.Count = 0 Then Err.Raise 5, , viewName & ": none of its visible edges is a line or a circle"
8110     chosen = -1
8111     For convert = 0 To 1
8112         ok = True
8113         For Each record In found
8114             If Not InsideBox(RecordPoint(record, "p0", convert, matrix), low, high) Then ok = False
8115             If record("kind") = "line" Then
8116                 If Not InsideBox(RecordPoint(record, "p1", convert, matrix), low, high) Then ok = False
            End If
        Next record
8119         If ok Then
8120             chosen = convert
8121             Exit For
        End If
    Next convert
8124     If chosen < 0 Then Err.Raise 5, , viewName & ": the visible edge points lie outside the model box as model coordinates and as view coordinates (transform " & NumberList(matrix) & ")"
8125     spaceName = IIf(chosen = 0, "model", "view")
8126     For Each record In found
8127         record("a") = FlatPoint(RecordPoint(record, "p0", chosen, matrix), drop)
8128         If record("kind") = "line" Then record("b") = FlatPoint(RecordPoint(record, "p1", chosen, matrix), drop)
8129         If record("kind") = "circle" Then
            ' The circle's axis in model space (a view-space axis is only rotated), and whether the view looks straight down it: then it shows as a
            ' circle; otherwise (edge-on) as a straight line through its center, 2 x radius long.
8132             axis = record("axis")
8133             If chosen = 1 Then axis = RotateToModel(matrix, axis)
            ' faceOn: 1 the view looks down the axis, 0 the axis lies across the view, -1 unknown (a zero or non-unit axis, or one at an angle).
8135             size = Sqr(CDbl(axis(0)) * CDbl(axis(0)) + CDbl(axis(1)) * CDbl(axis(1)) + CDbl(axis(2)) * CDbl(axis(2)))
8136             If Abs(size - 1#) > 0.000001 Then
8137                 record("faceOn") = -1
            ElseIf Abs(Abs(CDbl(axis(drop))) - 1#) <= 0.000001 Then
8139                 record("faceOn") = 1
            ElseIf Abs(CDbl(axis(drop))) <= 0.000001 Then
8141                 record("faceOn") = 0
            Else
8143                 record("faceOn") = -1
            End If
8145             record("flatAxis") = FlatPoint(axis, drop)
        End If
    Next record
8148     Set DrawingEdges = found
End Function

Private Function PlanSingle(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Object
