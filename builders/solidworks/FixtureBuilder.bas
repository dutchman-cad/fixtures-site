Private Function StepHeaderGuard(ByVal path As String) As Boolean
    ' After every STEP export: in the first 4 KB FILE_NAME must be a bare file name and the author and organization empty (or neutral).
    ' Otherwise those fields are rewritten in the file. True when it rewrote; raises when it cannot read or rewrite, so the row fails.
    Dim text As String, regex As Object, found As Object, args As Variant, first As Object, bare As String, i As Long, rebuilt As String
    Dim stream As Object, entity As String, again As Variant
1995     text = StepReadLatin1(path)
1996     Set regex = CreateObject("VBScript.RegExp")
    stepLabel = currentIdentity & ": StepHeaderGuard Pattern"
1998     regex.Pattern = "FILE_NAME\s*\(([\s\S]*?)\)\s*;"
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
2000     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2002     If found.Count = 0 Then Err.Raise 5, , "step header: no FILE_NAME in the first 4 KB"
    stepLabel = currentIdentity & ": StepHeaderGuard Value"
2004     entity = found(0).Value
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2006     args = StepArgs(found(0).SubMatches(0))
2007     If Not StepHeaderProblem(args) Then Exit Function
2008     Set first = StepStrings(CStr(args(0)))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2010     If first.Count > 0 Then bare = first(0).SubMatches(0)
2011     If InStrRev(bare, "\") > 0 Then bare = Mid$(bare, InStrRev(bare, "\") + 1)
2012     If InStrRev(bare, "/") > 0 Then bare = Mid$(bare, InStrRev(bare, "/") + 1)
2013     args(0) = "'" & bare & "'"
2014     For i = 2 To 3
2015         If UBound(args) >= i Then
2016             If StepFieldBad(CStr(args(i))) Then args(i) = "('')"
        End If
    Next i
2019     rebuilt = "FILE_NAME(" & Join(args, ",") & ");"
2020     Set stream = CreateObject("ADODB.Stream")
    stepLabel = currentIdentity & ": StepHeaderGuard Type"
2022     stream.Type = 2
    stepLabel = currentIdentity & ": StepHeaderGuard Charset"
2024     stream.Charset = "iso-8859-1"
    stepLabel = currentIdentity & ": StepHeaderGuard Open"
2026     stream.Open
    stepLabel = currentIdentity & ": StepHeaderGuard WriteText"
2028     stream.WriteText Replace(text, entity, rebuilt, 1, 1)
    stepLabel = currentIdentity & ": StepHeaderGuard SaveToFile"
2030     stream.SaveToFile path, 2
    stepLabel = currentIdentity & ": StepHeaderGuard Close"
2032     stream.Close
2033     text = StepReadLatin1(path)
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
2035     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2037     If found.Count = 0 Then Err.Raise 5, , "step header: the rewrite did not take"
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2039     again = StepArgs(found(0).SubMatches(0))
2040     If StepHeaderProblem(again) Then Err.Raise 5, , "step header: the rewrite did not take"
2041     StepHeaderGuard = True
End Function

