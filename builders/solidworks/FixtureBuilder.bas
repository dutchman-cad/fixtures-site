Private Function LocateComponent(ByVal path As String, Optional ByVal route As Long = -1) As Object
    ' The component an answer-key path ("mid/pair/block") names: the top-level label, then each subassembly's localName instance name found among
    ' its children by a route (FindChild): by default the route a dragged part was found by (childRoutes), else 0.
    Dim labels As Variant, i As Long, component As Object, file As String, localName As String
    Dim matches As Long, found As Object, topLabel As String, instanceNumber As Long, instances As Variant
5386     If route < 0 Then
5387         route = 0
    stepLabel = currentIdentity & ": LocateComponent Exists"
5389         If childRoutes.Exists(path) Then route = childRoutes(path)
    End If
5391     labels = Split(path, "/")
5392     topLabel = CStr(labels(0))
5393     instanceNumber = 1
5394     If InStr(topLabel, "#") > 0 Then
        ' pair#2 is the second instance of a component pattern (the seed is #1)
5396         instanceNumber = CLng(Mid$(topLabel, InStr(topLabel, "#") + 1))
5397         topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5400     If Not components.Exists(topLabel) Then Err.Raise 5, , "No component " & topLabel & " in the assembly"
5401     Set component = components(topLabel)
5402     If instanceNumber > 1 Then
    stepLabel = currentIdentity & ": LocateComponent Exists"
5404         If Not patternInstances.Exists(topLabel) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5405         instances = patternInstances(topLabel)
5406         If instanceNumber - 2 > UBound(instances) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5407         Set component = instances(instanceNumber - 2)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5410     If fileOfLabel.Exists("|" & topLabel) Then file = fileOfLabel("|" & topLabel)
5411     For i = 1 To UBound(labels)
    stepLabel = currentIdentity & ": LocateComponent Exists"
5413         If Not localNames.Exists(file & "|" & CStr(labels(i))) Then Err.Raise 5, , "Subassembly " & file & " has no component " & CStr(labels(i))
5414         localName = localNames(file & "|" & CStr(labels(i)))
5415         Set found = FindChild(component, localName, route, matches)
    stepLabel = currentIdentity & ": LocateComponent Name2"
5417         If matches <> 1 Then Err.Raise 5, , CStr(matches) & " children of " & CStr(component.Name2) & " are named " & localName
5418         Set component = found
    stepLabel = currentIdentity & ": LocateComponent Exists"
5420         If fileOfLabel.Exists(file & "|" & CStr(labels(i))) Then file = fileOfLabel(file & "|" & CStr(labels(i))) Else file = ""
    Next i
5422     Set LocateComponent = component
End Function

Private Sub NoteFlexibleChild(ByVal path As String, ByVal component As Object, ByRef position As Variant)
    ' Only for a part a `move` dragged (MoveComponent kept its GetTotalTransform t0 and box center b0). If GetTotalTransform now disagrees in X or Y by
    ' more than 0.01 mm with t0 + (box center now - b0), X/Y are judged by that, Z stays (placement-flexible-box). position is in mm.
    Dim saved As Variant, t0 As Variant, b0 As Variant, centre As Variant, expected As Variant
    stepLabel = currentIdentity & ": NoteFlexibleChild Exists"
5430     If Not movedParts.Exists(path) Then Exit Sub
5431     saved = movedParts(path)
5432     t0 = saved(0)
5433     b0 = saved(1)
5434     On Error Resume Next
5435     centre = BoxCentre(component)
5436     If Err.Number <> 0 Then Exit Sub
5437     If Not IsArray(centre) Then Exit Sub
5438     expected = Array(CDbl(t0(0)) + CDbl(centre(0)) - CDbl(b0(0)), CDbl(t0(1)) + CDbl(centre(1)) - CDbl(b0(1)), CDbl(t0(2)) + CDbl(centre(2)) - CDbl(b0(2)))
5439     NoteOption "placement " & path & " (moved part): GetTotalTransform (" & NoteList(position) & ") mm, box center (" & NoteList(centre) & ") mm, before the move (" & NoteList(t0) & ") and (" & NoteList(b0) & "), so the part is at (" & NoteList(expected) & ")"
5440     If Abs(CDbl(expected(0)) - CDbl(position(0))) > 0.01 Or Abs(CDbl(expected(1)) - CDbl(position(1))) > 0.01 Then
5441         RecordMitigation "placement-flexible-box"
5442         NoteOption "placement " & path & ": GetTotalTransform misreports a flexible child; X/Y judged by the box center"
5443         position = Array(CDbl(expected(0)), CDbl(expected(1)), CDbl(position(2)))
    End If
5445     Err.Clear
End Sub

Private Sub CheckPlacement(ByVal path As String, ByVal t As Variant, ByVal rotation As Variant, ByVal scoreT As Boolean, ByVal scoreR As Boolean)
    ' Round 19: the world transform of one leaf instance against expect.json (t 0.01 mm, R 1e-4). ArrayData is row-vector: array row i is
    ' the world image of local axis i, so R(i, j) = values(3 * j + i). A mismatch is a problem for the report, never an error.
    Dim component As Object, values As Variant, position As Variant, i As Long, j As Long, worst As Double, worstSame As Double, worstFlipped As Double, reason As String
5452     On Error Resume Next
5453     SettleRoute path
5454     Err.Clear
5455     Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": CheckPlacement GetTotalTransform"
5457     If Err.Number = 0 Then values = component.GetTotalTransform(True).ArrayData
5458     If Err.Number <> 0 Then reason = Err.Description
5459     On Error GoTo 0
5460     If Len(reason) > 0 Or component Is Nothing Then
5461         AddPlacementProblem path & ": cannot read it (" & reason & ")"
5462         Exit Sub
    End If
5464     placementChecked = placementChecked + 1
5465     position = Array(CDbl(values(9)) * 1000#, CDbl(values(10)) * 1000#, CDbl(values(11)) * 1000#)
5466     NoteFlexibleChild path, component, position
5467     If scoreT Then
5468         For i = 0 To 2
5469             If Abs(CDbl(position(i)) - CDbl(t(i))) > worst Then worst = Abs(CDbl(position(i)) - CDbl(t(i)))
        Next i
5471         If worst > 0.01 Then AddPlacementProblem path & ": t = (" & NoteList(position) & ") mm, expected (" & NoteList(t) & ")"
    End If
5473     If scoreR Then
5474         For i = 0 To 2
5475             For j = 0 To 2
5476                 If Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j))) > worstSame Then worstSame = Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j)))
5477                 If Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j))) > worstFlipped Then worstFlipped = Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j)))
            Next j
        Next i
5480         If worstSame > 0.0001 Then AddPlacementProblem path & ": R differs from expect.json by " & NoteNumber(worstSame) & IIf(worstFlipped <= 0.0001, " (it matches when read the other way round)", "")
    End If
End Sub

