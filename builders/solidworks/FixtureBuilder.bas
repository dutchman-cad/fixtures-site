Private Sub RunProbes(ByVal index As Long, ByVal folder As String, ByVal started As Double, ByRef status As String, ByRef message As String, ByRef files As String)
    ' Probe mode: each candidate approach of the recipe is built in its own fresh document. The first that passes is saved (its files are
    ' the recipe's); the others are built only to record whether they pass. After the first success no probe starts once the recipe has
    ' used PROBE_SECONDS. probesJson / probeKept go into the recipe's results.json row.
    Dim count As Long, k As Long, itemName As String, failure As String, kept As Boolean, elapsed As Double, entry As String, summary As String
    Dim keptMitigations As Object, keptPrimary As Object, keptFallback As Object
1494     count = CandidateCount(index)
1495     probesJson = ""
1496     probeKept = ""
1497     status = "failed"
1498     For k = 1 To count
1499         itemName = CandidateName(index, k)
1500         elapsed = Timer - started
1501         If elapsed < 0 Then elapsed = elapsed + 86400#
1502         If kept And elapsed > PROBE_SECONDS Then
1503             failure = "skipped: the recipe had already used " & CStr(CLng(elapsed)) & " s (limit " & CStr(PROBE_SECONDS) & " s for probes after the first success)"
1504             entry = ProbeEntry(itemName, False, failure, "")
1505             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
        ElseIf crashedUnits.Exists(currentIdentity & "|" & itemName) Then
1507             failure = "crashed SolidWorks in " & CStr(crashedUnits(currentIdentity & "|" & itemName)) & " (skipped)"
1508             entry = ProbeEntry(itemName, False, failure, "")
1509             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
1510             If Len(summary) > 0 Then summary = summary & " | "
1511             summary = summary & itemName & ": " & failure
        Else
1513             probeCandidate = itemName
1514             If k > 1 Then
                ' The mitigation counters of a recipe are the kept candidate's (or the last one's when none passes).
1516                 Set mitigations = CreateObject("Scripting.Dictionary")
1517                 Set primaryFailures = CreateObject("Scripting.Dictionary")
1518                 Set fallbackSuccesses = CreateObject("Scripting.Dictionary")
            End If
1520             failure = TryAttempt(index, folder, Not kept)
1521             ReleaseAttempt folder
1522             ClearMarker folder
1523             probeCandidate = ""
1524             If Len(failure) = 0 Then
1525                 entry = ProbeEntry(itemName, True, "", probeNote)
1526                 AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": ok"
1527                 If Not kept Then
1528                     kept = True
1529                     probeKept = Left$(itemName, 60)
1530                     files = attemptFiles
1531                     Set keptMitigations = mitigations
1532                     Set keptPrimary = primaryFailures
1533                     Set keptFallback = fallbackSuccesses
                End If
            Else
1536                 entry = ProbeEntry(itemName, False, failure, probeNote)
