    stepLabel = currentIdentity & ": ReadBackPart OpenDoc6"
3923     Set model = app.OpenDoc6(currentFolder & "\" & CStr(entry("file")) & ".sldprt", swDocPART, swOpenDocOptions_Silent, "", errors, warnings)
3924     If errors <> 0 Then Err.Raise 5, , "SolidWorks OpenDoc6 error " & CStr(errors) & " reopening " & CStr(entry("file")) & ".sldprt to read it back"
3925     Require model, "The saved part " & CStr(entry("file")) & ".sldprt could not be reopened to read it back"
3926     On Error GoTo Failed
3927     configs = entry("configs")
3928     depths = entry("depths")
    stepLabel = currentIdentity & ": ReadBackPart GetConfigurationNames"
3930     existing = model.GetConfigurationNames()
3931     For Each item In existing
3932         If Len(names) > 0 Then names = names & ", "
3933         names = names & CStr(item)
3934         count = count + 1
3935         listed = False
3936         For i = 0 To UBound(configs)
3937             If CStr(configs(i)) = CStr(item) Then listed = True
        Next i
3939         If listed Then found = found + 1
    Next item
3941     If count <> UBound(configs) + 1 Or found <> count Then Err.Raise 5, , "Saved part " & CStr(entry("file")) & ".sldprt has configurations " & names & ", expected " & Join(configs, ", ")
    stepLabel = currentIdentity & ": ReadBackPart Name"
3943     If CStr(model.ConfigurationManager.ActiveConfiguration.Name) <> CStr(entry("active")) Then Err.Raise 5, , "Saved part " & CStr(entry("file")) & ".sldprt has configuration " & CStr(model.ConfigurationManager.ActiveConfiguration.Name) & " active, expected " & CStr(entry("active"))
3944     For i = 0 To UBound(configs)
3945         ActivateConfiguration model, CStr(configs(i)), "the saved part configuration"
3946         RebuildNoted model, "activating the saved part configuration"
3947         got = PartDepthGeometry(model)
3948         If Abs(got - CDbl(depths(i))) > 0.000001 Then Err.Raise 5, , "Saved part " & CStr(entry("file")) & ".sldprt: the depth in configuration " & CStr(configs(i)) & " reads " & CStr(got) & " m, expected " & CStr(depths(i)) & " m (the change was not saved)"
3949         If Len(report) > 0 Then report = report & ", "
3950         report = report & CStr(configs(i)) & "=" & CStr(got) & " m"
    Next i
3952     ActivateConfiguration model, CStr(entry("active")), "the saved part configuration (reactivating)"
    stepLabel = currentIdentity & ": ReadBackPart CloseDoc"
3954     app.CloseDoc model.GetTitle()
3955     ReadBackPart = "part " & CStr(entry("file")) & ".sldprt read back from the file: depth " & report
3956     Exit Function
Failed:
3958     message = "(line " & CStr(Erl) & "): " & Err.Description
    stepLabel = currentIdentity & ": ReadBackPart CloseDoc"
3960     app.CloseDoc model.GetTitle()
3961     Err.Raise 5, , message
End Function

