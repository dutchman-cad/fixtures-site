Private Sub SweepStray(ByVal fs As Object, ByVal path As String, ByVal fileName As String, ByVal ext As String, ByRef notes As String)
    ' A file that is not text and not one the builder made (named in results.json, or the log): its bytes are searched for the needles and
    ' it is deleted on a hit, a cap or an error.
    Dim hit As Boolean, why As String
    ' Case-insensitive: SolidWorks writes .SLDPRT where the row says .sldprt, and that is still the builder's own file. Its own PDF is still
    ' scanned (never rewritten); the .sld* files are compressed and are not.
2197     If InStr(1, resultRows, Chr$(34) & fileName & Chr$(34), vbTextCompare) > 0 And ext <> "pdf" Then Exit Sub
2198     If InStr("|sldprt|sldasm|slddrw|step|dxf|zip|", "|" & ext & "|") > 0 And Len(resultRows) = 0 Then Exit Sub
2199     why = "stray file, name found"
2200     On Error Resume Next
2201     hit = StrayHasNeedle(path)
2202     If Err.Number <> 0 Then
2203         hit = True
2204         why = "stray file, unreadable"
2205         If InStr(Err.Description, "size cap") > 0 Then why = "stray file, too large to check (over 4 MB)"
    End If
2207     Err.Clear
2208     On Error GoTo 0
2209     If Not hit Then Exit Sub
2210     If SweepDelete(fs, path) Then
2211         SweepNote notes, "privacy sweep: " & fileName & " removed (" & why & ")"
    ElseIf SweepTruncate(fs, path) Then
2213         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & why & ")"
    Else
2215         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

Private Sub SweepFile(ByVal fs As Object, ByVal path As String, ByRef notes As String)
    ' Scrub one file. A text file that cannot be read or written (a lock, no permission) is retried, then truncated to zero bytes, then
    ' deleted; the note says which. Lock files (~$*) and temporary files are deleted. Never raises, so the whole list is always finished.
    Dim fileName As String, ext As String, text As String, cleaned As String, attempt As Long, done As Boolean, reason As String, capped As Boolean
2223     fileName = fs.GetFileName(path)
2224     ext = LCase$(fs.GetExtensionName(path))
2225     If Left$(fileName, 2) = "~$" Or ext = "tmp" Or ext = "temp" Or ext = "partial" Then
2226         If Not SweepDelete(fs, path) Then
2227             If SweepTruncate(fs, path) Then
2228                 SweepNote notes, "privacy sweep: " & fileName & " truncated (could not be removed)"
            Else
2230                 SweepNote notes, "privacy sweep: " & fileName & " could not be removed"
            End If
        End If
2233         Exit Sub
    End If
2235     If InStr("|log|json|txt|csv|tsv|xml|html|htm|md|ini|cfg|yaml|yml|dxf|", "|" & ext & "|") = 0 Then
2236         SweepStray fs, path, fileName, ext, notes
2237         Exit Sub
    End If
2239     For attempt = 1 To 3
2240         If Not done Then
2241             On Error Resume Next
2242             Err.Clear
2243             text = SweepRead(path)
2244             If Err.Number = 0 Then
2245                 cleaned = PrivacyScrub(text)
2246                 If cleaned <> text Then SweepWrite path, cleaned
            End If
2248             done = (Err.Number = 0)
2249             If InStr(Err.Description, "over the sweep size cap") > 0 Then capped = True
2250             Err.Clear
2251             On Error GoTo 0
        End If
    Next attempt
2254     If done Then Exit Sub
2255     reason = "unreadable"
2256     If capped Then reason = "too large to check (over 4 MB)"
2257     sweepEmptiedCount = sweepEmptiedCount + 1
2258     If Len(sweepEmptied) > 0 Then sweepEmptied = sweepEmptied & ", "
2259     sweepEmptied = sweepEmptied & fileName
2260     If SweepTruncate(fs, path) Then
2261         SweepNote notes, "privacy sweep: " & fileName & " truncated (" & reason & ")"
    ElseIf SweepDelete(fs, path) Then
2263         SweepNote notes, "privacy sweep: " & fileName & " removed (" & reason & ")"
    Else
2265         SweepNote notes, "privacy sweep: " & fileName & " could not be cleaned or removed"
    End If
End Sub

Private Sub SweepListFailure(ByVal dirPath As String, ByRef notes As String)
