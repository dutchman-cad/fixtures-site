Private Sub PartConfiguration(ByVal recipe As String, ByVal file As String, ByVal configName As String, ByVal originalMm As Double, ByVal heightMm As Double, ByVal activeName As String)
    ' A26: a copy of the part with a second configuration whose extrusion depth is heightMm. Every write is checked by the part's GEOMETRY
    ' (ConfigurationDepth), not by the dimension handle. Routes: 1 IDimension.SetSystemValue3 for the one configuration; 2 the configuration activated and
    ' SetSystemValue3 for this configuration (config-dimension-this-configuration); 3 the configuration activated, the dimension fetched again (a fresh
    ' handle) and SetSystemValue3 for this configuration (config-dimension-fresh-handle). When a route left the new depth right but changed the original
    ' configuration too, the original depth is set back for its own configuration with a fresh handle in it (also config-dimension-fresh-handle).
    Dim model As Object, lastDimension As Object, configManager As Object, defaultName As String, original As Double, height As Double
    Dim tallDepth As Double, defaultDepth As Double, addedConfig As Object, route As Long, enteredThis As Boolean, enteredFresh As Boolean, usedName As String
3841     Set model = CopyPartFile(recipe, file)
3842     original = originalMm * 0.001
3843     height = heightMm * 0.001
3844     Set lastDimension = DepthDimension(model, original)
    stepLabel = currentIdentity & ": PartConfiguration ConfigurationManager"
3846     Set configManager = model.ConfigurationManager
3847     Require configManager, "Configuration configManager unavailable"
    stepLabel = currentIdentity & ": PartConfiguration Name"
3849     defaultName = CStr(configManager.ActiveConfiguration.Name)
    ' The depth is the Z extent of the body: checked once in the original configuration, so a wrong axis assumption is an error, not a silent one.
3851     If Abs(PartDepthGeometry(model) - original) > 0.000001 Then Err.Raise 5, , "The part geometry is " & CStr(PartDepthGeometry(model)) & " m along Z in configuration " & defaultName & " but its extrusion depth is " & CStr(original) & " m: the depth is not the Z extent of its box"
    stepLabel = currentIdentity & ": PartConfiguration AddConfiguration"
3853     Set addedConfig = configManager.AddConfiguration(configName, "", "", 0, "", "")
3854     Require addedConfig, "AddConfiguration returned no configuration: name=" & configName
3855     SetDepth lastDimension, height, swSetValue_InSpecificConfigurations, configName
3856     tallDepth = ConfigurationDepth(model, lastDimension, configName)
3857     defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
3858     For route = 0 To 2
3859         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) > 0.000001 Then
            ' The new depth is right and the original is not: set the original back in its own configuration with a fresh handle.
3861             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3862             enteredFresh = True
3863             ActivateConfiguration model, defaultName, "the original configuration"
3864             SetDepth DepthDimension(model, -1#), original, swSetValue_InSpecificConfigurations, defaultName
3865             usedName = "config-dimension-fresh-handle"
3866             tallDepth = ConfigurationDepth(model, lastDimension, configName)
3867             defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
        End If
3869         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) <= 0.000001 Then Exit For
3870         If route = 2 Then Err.Raise 5, , "Configuration depths read back " & configName & " " & CStr(tallDepth) & " m and " & defaultName & " " & CStr(defaultDepth) & " m (by the geometry), wanted " & CStr(height) & " and " & CStr(original) & ", after SetSystemValue3 for the specific configuration, for this configuration, with a fresh handle, and the original set back"
3871         If route = 0 Then
3872             If Not enteredThis Then RecordMitigation "config-dimension-this-configuration", True, True
3873             enteredThis = True
3874             ActivateConfiguration model, configName, "the new configuration"
3875             SetDepth lastDimension, height, swSetValue_InThisConfiguration, ""
3876             usedName = "config-dimension-this-configuration"
        Else
3878             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3879             enteredFresh = True
3880             ActivateConfiguration model, configName, "the new configuration"
3881             SetDepth DepthDimension(model, -1#), height, swSetValue_InThisConfiguration, ""
3882             usedName = "config-dimension-fresh-handle"
        End If
3884         tallDepth = ConfigurationDepth(model, lastDimension, configName)
3885         defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
    Next route
3887     If Len(usedName) > 0 Then fallbackSuccesses(usedName) = fallbackSuccesses(usedName) + 1
3888     ActivateConfiguration model, IIf(activeName = "Default", defaultName, activeName), "the part configuration"
3889     NoteOption file & ".sldprt: configurations " & defaultName & " depth " & CStr(defaultDepth) & " m, " & configName & " depth " & CStr(tallDepth) & " m"
3890     SaveModel model, currentFolder & "\" & file & ".sldprt", True
    stepLabel = currentIdentity & ": PartConfiguration GetSaveFlag"
3892     If model.GetSaveFlag() Then Err.Raise 5, , file & ".sldprt still has unsaved changes after SaveAs"
3893     AddPartReadBack model, file, Array(defaultName, configName), Array(defaultDepth, tallDepth), IIf(activeName = "Default", defaultName, activeName)
    stepLabel = currentIdentity & ": PartConfiguration CloseDoc"
3895     app.CloseDoc model.GetTitle()
End Sub

