3935     If Len(usedName) > 0 Then fallbackSuccesses(usedName) = fallbackSuccesses(usedName) + 1
3936     ActivateConfiguration model, IIf(activeName = "Default", defaultName, activeName), "the part configuration"
3937     NoteOption file & ".sldprt: configurations " & defaultName & " depth " & CStr(defaultDepth) & " m, " & configName & " depth " & CStr(tallDepth) & " m"
3938     SaveModel model, currentFolder & "\" & file & ".sldprt", True
    stepLabel = currentIdentity & ": PartConfiguration GetSaveFlag"
