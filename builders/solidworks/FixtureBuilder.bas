    ' swDelete_Absorbed, so the components it made go with it), then any new top-level component still there (IComponent2.Select4 and the same
    ' delete). Each step is logged.
    Dim walker As Object, doomed As Collection, item As Variant, selected As Boolean, deleted As Boolean, i As Long, itemName As String, reason As String
    Dim fresh As Variant, lower As Long, upper As Long, entry As Object, nameText As String
4486     Set doomed = New Collection
    stepLabel = currentIdentity & ": MirrorDeleteMade FirstFeature"
4488     Set walker = doc.FirstFeature()
4489     For i = 1 To 5000
4490         If walker Is Nothing Then Exit For
    stepLabel = currentIdentity & ": MirrorDeleteMade GetTypeName2"
4492         If CStr(walker.GetTypeName2()) = "MirrorCompFeat" Then
    stepLabel = currentIdentity & ": MirrorDeleteMade Name"
4494             If InStr(1, treeBefore & "|", "|MirrorCompFeat:" & CStr(walker.Name) & "|", vbBinaryCompare) = 0 Then doomed.Add walker
        End If
    stepLabel = currentIdentity & ": MirrorDeleteMade GetNextFeature"
4497         Set walker = walker.GetNextFeature()
    Next i
4499     For Each item In doomed
4500         itemName = "?"
    stepLabel = currentIdentity & ": MirrorDeleteMade ClearSelection2"
4502         doc.ClearSelection2 True
4503         reason = ""
4504         selected = False
4505         deleted = False
4506         On Error Resume Next
    stepLabel = currentIdentity & ": MirrorDeleteMade Name"
4508         itemName = CStr(item.Name)
    stepLabel = currentIdentity & ": MirrorDeleteMade Select2" & " " & apiInputs & " " & callInputs
4510         If Err.Number = 0 Then selected = item.Select2(False, 0)
    stepLabel = currentIdentity & ": MirrorDeleteMade DeleteSelection2"
4512         If Err.Number = 0 Then deleted = doc.Extension.DeleteSelection2(swDelete_Children + swDelete_Absorbed)
4513         If Err.Number <> 0 Then reason = "raised (Err " & CStr(Err.Number) & " " & CleanError(Err.Description) & ")"
4514         Err.Clear
4515         On Error GoTo 0
4516         If Len(reason) = 0 Then reason = "Select2 returned " & CStr(selected) & ", DeleteSelection2 returned " & CStr(deleted)
4517         NoteOption "mirror cleanup: feature " & itemName & ", " & reason
    Next item
    stepLabel = currentIdentity & ": MirrorDeleteMade ClearSelection2"
4520     doc.ClearSelection2 True
4521     fresh = NewComponents(before)
4522     If ArrayItems(fresh, lower, upper) Then
4523         For i = lower To upper
4524             If ItemAt(fresh, i, entry, nameText) Then
4525                 ReadName2 entry, nameText
    stepLabel = currentIdentity & ": MirrorDeleteMade ClearSelection2"
4527                 doc.ClearSelection2 True
4528                 reason = ""
4529                 selected = False
4530                 deleted = False
4531                 On Error Resume Next
    stepLabel = currentIdentity & ": MirrorDeleteMade Select4" & " " & apiInputs & " " & callInputs
4533                 selected = entry.Select4(False, Nothing, False)
    stepLabel = currentIdentity & ": MirrorDeleteMade DeleteSelection2"
4535                 If Err.Number = 0 Then deleted = doc.Extension.DeleteSelection2(swDelete_Children + swDelete_Absorbed)
4536                 If Err.Number <> 0 Then reason = "raised (Err " & CStr(Err.Number) & " " & CleanError(Err.Description) & ")"
4537                 Err.Clear
4538                 On Error GoTo 0
4539                 If Len(reason) = 0 Then reason = "Select4 returned " & CStr(selected) & ", DeleteSelection2 returned " & CStr(deleted)
4540                 NoteOption "mirror cleanup: component " & nameText & ", " & reason
            End If
        Next i
    End If
    stepLabel = currentIdentity & ": MirrorDeleteMade ClearSelection2"
4545     doc.ClearSelection2 True
End Sub

Private Sub MirrorRestore(ByVal rungName As String, ByVal before As Object, ByVal treeBefore As String)
    ' Put the assembly back to what it was before the first mirror call, by diff and not by undo count (a successful ModifyDefinition adds an undo
    ' entry of its own, so one undo takes only that): EditUndo2 until the top-level components and the feature tree equal the snapshot, at most 4
    ' times, and not again after one that changed nothing of the mirror (it took something else). Round 28: where that leaves them different (SolidWorks 2023 does not undo a MirrorComponents3 result) the new mirror features and
    ' components are deleted (mirror-cleanup-delete). If they still differ the rung is named, with what was left, and the ladder stops.
    Dim attempt As Long, remains As String, remainsAfter As String
4554     remains = MirrorLeft(before, treeBefore)
4555     For attempt = 1 To 4
4556         If Len(remains) = 0 Then Exit Sub
    stepLabel = currentIdentity & ": MirrorRestore EditUndo2"
4558         doc.EditUndo2 1
4559         remainsAfter = MirrorLeft(before, treeBefore)
        ' An undo that changed nothing of the mirror took something else (the mirror plane, an earlier recipe's feature): no more of them.
4561         If remainsAfter = remains Then Exit For
4562         remains = remainsAfter
    Next attempt
4564     If Len(remains) = 0 Then Exit Sub
4565     RecordMitigation "mirror-cleanup-delete", True, True
4566     NoteOption "mirror cleanup after " & rungName & ": EditUndo2 left " & remains & "; deleting what the mirror made"
4567     MirrorDeleteMade before, treeBefore
4568     remainsAfter = MirrorLeft(before, treeBefore)
4569     If Len(remainsAfter) > 0 Then
4570         stepLabel = currentIdentity & ": MirrorRestore the assembly after the try"
4571         Err.Raise 5, , "the mirror rung " & rungName & " left " & remainsAfter & " in the assembly (EditUndo2 left " & remains & "; deleting the mirror feature and components did not clear it)"
    End If
4573     fallbackSuccesses("mirror-cleanup-delete") = fallbackSuccesses("mirror-cleanup-delete") + 1
4574     NoteOption "mirror cleanup after " & rungName & ": the assembly is back to its snapshot"
End Sub

Private Function MirrorCheck(ByVal madeComponent As Object, ByVal sourceComponent As Object, ByVal axisIndex As Long, ByVal offset As Double, ByVal corner As Variant, ByVal wanted As Variant, ByVal showPoint As Boolean, ByVal label As String) As String
    ' The corner test of one mirror try, logged: "" when the part's rounded corner (the fillet's axis, read from the part's own geometry) is at the
    ' mirror image of the original's, else what was found. The same test for an instance and for a new part.
    Dim values As Variant, point(2) As Double, worst As Double, r As Long, c As Long, problem As String
    Dim cornerLower As Long, cornerUpper As Long, valueLower As Long, valueUpper As Long
4582     problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
4583     ArrayItems corner, cornerLower, cornerUpper
    stepLabel = currentIdentity & ": MirrorCheck GetTotalTransform"
4585     values = madeComponent.GetTotalTransform(True).ArrayData
4586     If Not ArrayItems(values, valueLower, valueUpper) Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered no array"
4587     If valueUpper - valueLower < 12 Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered " & CStr(valueUpper - valueLower + 1) & " numbers, not 16"
4588     For r = 0 To 2
4589         point(r) = CDbl(values(valueLower + 9 + r)) * 1000#
4590         For c = 0 To 2
4591             point(r) = point(r) + CDbl(values(valueLower + 3 * c + r)) * CDbl(corner(cornerLower + c))
        Next c
    Next r
4594     If showPoint Then
4595         For r = 0 To 2
4596             If Abs(point(r) - CDbl(wanted(r))) > worst Then worst = Abs(point(r) - CDbl(wanted(r)))
        Next r
4598         NoteOption label & " puts the rounded corner at (" & NoteList(point) & ") mm" & IIf(worst <= 0.5, "", ", wanted (" & NoteList(wanted) & ")")
    End If
4600     If Len(problem) = 0 Then
4601         NoteOption label & ": the rounded corner (the fillet axis read from its own geometry) is at the mirror image of the original"
    Else
4603         NoteOption label & ": " & problem
    End If
4605     MirrorCheck = problem
End Function

Private Function MirrorLadder(ByVal plane As Object, ByVal sourceComponent As Object, ByVal path As String, ByVal before As Object, ByVal corner As Variant, ByVal wanted As Variant, ByVal axisIndex As Long, ByVal offset As Double, ByVal orientationList As Variant, ByVal treeBefore As String, ByRef problem As String, ByRef ladder As String) As Object
    ' Round 25 (field 2026.11.25.3, A20b: the orientation argument did not reach SolidWorks in the array form): the rungs after the orientation loop,
    ' each logged and judged by the same corner test, stopping at the first that is right. 0 and 1: mirror-orientation-int-array (an Integer array,
    ' then a Variant array); 2: mirror-orientation-definition (the orientation set through IMirrorComponentFeatureData and ModifyDefinition);
    ' 3: mirror-orientation-center-of-mass-off. problem is "" when a rung worked; ladder lists every try's result. The assembly is put back to its
    ' snapshot (MirrorRestore) before the first try and after every try that fails, made or not.
    Dim rung As Long, number As Long, lower As Long, upper As Long, orientation As Long, rungName As String, how As String
    Dim madeComponent As Object, label As String, reason As String, fresh As Variant, entry As Object, nameText As String, freshLower As Long, freshUpper As Long
4616     problem = "no rung ran"
4617     ladder = ""
4618     If Not ArrayItems(orientationList, lower, upper) Then Exit Function
4619     MirrorRestore "the orientation loop", before, treeBefore
4620     For rung = 0 To 3
4621         Select Case rung
            Case 0
4623                 rungName = "mirror-orientation-int-array": how = "Integer array"
            Case 1
4625                 rungName = "mirror-orientation-int-array": how = "Variant array"
            Case 2
4627                 rungName = "mirror-orientation-definition": how = "definition"
            Case Else
4629                 rungName = "mirror-orientation-center-of-mass-off": how = "OrientAboutCenterOfMass False"
        End Select
4631         If rung <> 1 Then RecordMitigation rungName, True, True
4632         For number = lower To upper
4633             orientation = CLng(orientationList(number))
4634             label = "mirror rung " & rungName & " (" & how & "), orientation " & CStr(orientation)
4635             reason = ""
4636             Set madeComponent = Nothing
4637             On Error Resume Next
4638             Select Case rung
                Case 0
4640                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 1, -1)
                Case 1
4642                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 2, -1)
                Case 2
4644                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, CLng(orientationList(lower)), before, 0, -1)
                Case Else
4646                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 0, 0)
            End Select
4648             If Err.Number <> 0 Then reason = CleanError(Err.Description)
4649             Err.Clear
4650             On Error GoTo 0
4651             If Len(reason) = 0 Then
4652                 If rung = 2 Then
4653                     reason = MirrorDefine(orientation)
4654                     If Len(reason) = 0 Then
4655                         RebuildNoted doc, "the mirror definition"
4656                         fresh = NewComponents(before)
4657                         If ArrayItems(fresh, freshLower, freshUpper) Then
4658                             If freshUpper > freshLower Then
4659                                 reason = CStr(freshUpper - freshLower + 1) & " new components after the definition changed, where one was expected"
                            ElseIf ItemAt(fresh, freshLower, entry, nameText) Then
4661                                 Set madeComponent = entry
                            End If
                        End If
                    End If
                End If
            End If
4667             If Len(reason) > 0 Then
4668                 NoteOption label & ": " & reason
4669                 problem = reason
            Else
4671                 problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, wanted, True, label)
4672                 If Len(problem) = 0 Then
4673                     fallbackSuccesses(rungName) = fallbackSuccesses(rungName) + 1
4674                     ladder = ""
4675                     Set MirrorLadder = madeComponent
4676                     Exit Function
                End If
4678                 reason = problem
            End If
4680             ladder = ladder & "; " & rungName & " (" & how & "), orientation " & CStr(orientation) & ": " & reason
4681             MirrorRestore rungName, before, treeBefore
        Next number
    Next rung
4684     Set MirrorLadder = madeComponent
End Function

Private Function MirrorCall(ByVal plane As Object, ByVal sourceComponent As Object, ByVal newPart As Boolean, ByVal path As String, ByVal orientation As Long, ByVal before As Object, ByVal arrayKind As Long, ByVal centerMode As Long) As Object
    ' MirrorComponents3 in the five forms in turn (MirrorFormText), starting from the one that made a component last. A form succeeds only if it
    ' yields a component: an object in its answer, or a new top-level component after a rebuild (field 2026.11.24.3: forms 0 and 1 answered an
    ' EMPTY array and made nothing, which was taken for success). Nothing is undone between forms. Round 25: arrayKind is the element type of the
    ' orientation array (0 Long, 1 Integer, 2 Variant) and centerMode 0 puts OrientAboutCenterOfMass False (-1: as the form says).
    Dim form As Long, startForm As Long, instance As Variant, mirrored As Variant, names As Variant, orientations As Variant, result As Variant
    Dim planeArgument As Object, madeComponent As Object, aboutCenter As Boolean, importOptions As Long, summary As String, summaries As String, madeName As String
    Dim emptyObjects As Variant, emptyLongs As Variant, emptyStrings As Variant, standing As Object
    ' No ReDim x(0 To -1) here: it raises Err 9 "Subscript out of range" in VBA (see TypedEmpty).
4696     emptyObjects = TypedEmpty(0)
4697     emptyLongs = TypedEmpty(1)
4698     emptyStrings = TypedEmpty(2)
4699     startForm = mirrorFormStart
    ' Round 28 (field 2026.11.26.2, SolidWorks 2023: EditUndo2 did not remove a MirrorComponents3 result, so every try judged the first try's copy):
    ' what THIS call made is judged against the components standing right before it.
4702     Set standing = ComponentNames()
4703     For form = startForm To 4
4704         If form > startForm Then RecordMitigation MirrorFormName(form), True, True
4705         Select Case form
            Case 1
4707                 Set instance = Nothing
4708                 Set mirrored = Nothing
4709                 Set names = Nothing
4710                 Set orientations = Nothing
            Case 2
4712                 instance = Empty
4713                 mirrored = Empty
4714                 names = Empty
4715                 orientations = Empty
            Case 3
4717                 instance = emptyObjects
4718                 mirrored = emptyObjects
4719                 names = emptyStrings
4720                 orientations = emptyLongs
            Case Else
                ' Form 0 is VBA's Array(), a Variant empty array: what the field run passed. Form 3 above is the typed empty arrays.
4723                 instance = Array()
4724                 mirrored = Array()
4725                 names = Array()
4726                 orientations = Array()
        End Select
4728         If newPart Then
4729             mirrored = ObjectArray1(sourceComponent)
4730             names = StringArray1(path)
        Else
4732             instance = ObjectArray1(sourceComponent)
4733             Select Case arrayKind
                Case 1
4735                     orientations = IntegerArray1(orientation)
                Case 2
4737                     orientations = VariantArray1(orientation)
                Case Else
4739                     orientations = LongArray1(orientation)
            End Select
        End If
4742         aboutCenter = (form <> 3)
4743         If centerMode = 0 Then aboutCenter = False
4744         importOptions = 1
4745         If form = 3 Then importOptions = 0
4746         NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & "): calling"
    stepLabel = currentIdentity & ": MirrorCall ClearSelection2"
4748         doc.ClearSelection2 True
    stepLabel = currentIdentity & ": MirrorCall Select2" & " " & apiInputs & " " & callInputs
4750         If form = 3 Then plane.Select2 False, 0
4751         Set planeArgument = plane
4752         If form = 4 Then
4753             On Error Resume Next
4754             Set planeArgument = Nothing
    stepLabel = currentIdentity & ": MirrorCall GetSpecificFeature2"
4756             Set planeArgument = plane.GetSpecificFeature2()
4757             Err.Clear
4758             On Error GoTo 0
        End If
4760         If planeArgument Is Nothing Then
4761             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & "): the plane feature gave no IRefPlane"
4762             summaries = summaries & "; form " & CStr(form) & ": no IRefPlane"
        Else
    stepLabel = currentIdentity & ": MirrorCall MirrorComponents3"
4765             result = AssemblyDocument(doc).MirrorComponents3(planeArgument, instance, orientations, aboutCenter, mirrored, False, names, IIf(newPart, swMirrorNameCustom, swMirrorNameSuffix), "", currentFolder, importOptions, False, False, False)
4766             Set madeComponent = MirrorMade(result, standing)
4767             If madeComponent Is Nothing Then
4768                 summary = "no new component"
            Else
4770                 ReadName2 madeComponent, madeName
4771                 summary = "made " & madeName
            End If
4773             summary = "returned " & MirrorResultText(result) & "; " & summary & "; last feature " & LastFeatureType()
4774             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & ") " & summary
4775             summaries = summaries & "; form " & CStr(form) & " " & summary
4776             If Not madeComponent Is Nothing Then
4777                 If form > startForm Then fallbackSuccesses(MirrorFormName(form)) = fallbackSuccesses(MirrorFormName(form)) + 1
4778                 mirrorFormStart = form
4779                 Set MirrorCall = madeComponent
4780                 Exit Function
            End If
        End If
    Next form
4784     Err.Raise 5, , "MirrorComponents3 made no component in " & IIf(startForm = 0, "any of its forms", "the forms from " & CStr(startForm) & " on") & " (orientation " & CStr(orientation) & ")" & Mid$(summaries, 2)
End Function

Private Sub MirrorComponent(ByVal sourceLabel As String, ByVal newLabel As String, ByVal normal As String, ByVal offset As Double, ByVal newPart As Boolean, ByVal partFile As String, ByVal corner As Variant, ByVal orientationList As Variant)
    ' A20: Mirror Components. IAssemblyDoc.MirrorComponents3 about a reference plane at the recipe's offset (meters), once as a same-file instance
    ' (a/b) and once as a new part file saved beside the top file (c). For an instance the component orientation (an enum whose axes depend on
    ' the plane) is tried in turn until the part's rounded corner lands on the mirrored corner (mirror-orientation-next); an empty array argument
    ' that makes no component (an empty answer is not one) is made again in the next form of MirrorCall (mirror-empty-array-nothing, mirror-empty-variant,
    ' mirror-plane-selected, mirror-refplane-object); a mirrored part file that is not on disk is saved from its document (mirror-part-saved).
    Dim sourceComponent As Object, plane As Object, before As Object, number As Long, madeComponent As Object, raisedNumber As Long, raisedText As String, raisedStep As String
    Dim wanted(2) As Double, axisIndex As Long, c As Long, path As String, problem As String, ladderText As String, treeBefore As String
    Dim cornerLower As Long, cornerUpper As Long, orientLower As Long, orientUpper As Long, orientCount As Long
4796     If Not ArrayItems(corner, cornerLower, cornerUpper) Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe's corner point is empty"
4797     If cornerUpper - cornerLower < 2 Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe's corner point has " & CStr(cornerUpper - cornerLower + 1) & " number(s), not 3"
4798     If Not ArrayItems(orientationList, orientLower, orientUpper) Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe has no component orientation to try"
4799     orientCount = orientUpper - orientLower + 1
    stepLabel = currentIdentity & ": MirrorComponent Exists"
4801     If Not components.Exists(sourceLabel) Then Err.Raise 5, , "Mirror " & newLabel & ": the source component " & sourceLabel & " was not placed"
4802     Set sourceComponent = components(sourceLabel)
4803     axisIndex = InStr(1, "XYZ", normal, vbBinaryCompare) - 1
4804     Set plane = ReferencePlaneAt(IIf(normal = "X", "YZ", IIf(normal = "Y", "XZ", "XY")), offset)
4805     Require plane, "The mirror plane was not made"
4806     path = currentFolder & "\" & partFile & ".sldprt"
4807     For c = 0 To 2
4808         wanted(c) = CDbl(corner(cornerLower + c))
    Next c
4810     wanted(axisIndex) = 2# * offset * 1000# - CDbl(corner(cornerLower + axisIndex))
4811     Set before = ComponentNames()
4812     treeBefore = TreeText()
    stepLabel = currentIdentity & ": MirrorComponent Count"
4814     NoteOption "mirror " & newLabel & ": " & sourceLabel & " about " & normal & " = " & NoteList(Array(offset * 1000#)) & " mm, " & CStr(before.Count) & " top-level component(s) before, " & CStr(orientCount) & " orientation(s) to try"
4815     For number = 0 To orientCount - 1
4816         If number > 0 Then
4817             RecordMitigation "mirror-orientation-next", True, True
4818             MirrorRestore "the orientation loop", before, treeBefore
        End If
4820         Set madeComponent = Nothing
4821         raisedNumber = 0
4822         On Error Resume Next
4823         Set madeComponent = MirrorCall(plane, sourceComponent, newPart, path, CLng(orientationList(orientLower + number)), before, 0, -1)
4824         If Err.Number <> 0 Then
4825             raisedNumber = Err.Number
4826             raisedText = Err.Description
4827             raisedStep = stepLabel
        End If
4829         Err.Clear
4830         On Error GoTo 0
4831         If raisedNumber <> 0 Then
            ' The mirror may have run before the error (two new components): no copies are left behind. The cleanup sets its own step
            ' labels, so the failing step is put back before the error goes on (the row names the call that failed, not the cleanup).
4834             On Error Resume Next
4835             MirrorRestore "the orientation loop (orientation " & CStr(orientationList(orientLower + number)) & " raised)", before, treeBefore
4836             If Err.Number <> 0 Then NoteOption "mirror cleanup after a raised try failed: " & CleanError(Err.Description)
4837             Err.Clear
4838             On Error GoTo 0
4839             stepLabel = raisedStep
4840             Err.Raise raisedNumber, , raisedText
        End If
4842         problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, Array(wanted(0), wanted(1), wanted(2)), Not newPart, IIf(newPart, "new part " & partFile & ".sldprt", "mirror orientation " & CStr(orientationList(orientLower + number))))
4843         If Len(problem) = 0 Then
4844             If number > 0 Then fallbackSuccesses("mirror-orientation-next") = fallbackSuccesses("mirror-orientation-next") + 1
4845             Exit For
        End If
4847         If newPart Then Err.Raise 5, , "The new mirrored part " & partFile & ".sldprt does not have the rounded corner at its mirror image about " & normal & " = " & NoteNumber(offset * 1000#) & " mm: " & problem
    Next number
4849     If Len(problem) > 0 Then
4850         Set madeComponent = MirrorLadder(plane, sourceComponent, path, before, corner, Array(wanted(0), wanted(1), wanted(2)), axisIndex, offset, orientationList, treeBefore, problem, ladderText)
4851         If Len(problem) > 0 Then
4852             stepLabel = currentIdentity & ": MirrorComponent orientation ladder exhausted"
4853             Err.Raise 5, , "No component orientation of MirrorComponents3 puts the rounded corner at its mirror image about " & normal & " = " & NoteNumber(offset * 1000#) & " mm: " & problem & "; then, with the orientation given another way:" & Mid$(ladderText, 2)
        End If
    End If
4856     If newPart Then
4857         If Len(Dir$(path)) = 0 Then
4858             RecordMitigation "mirror-part-saved", True, True
    stepLabel = currentIdentity & ": MirrorComponent GetModelDoc2"
4860             SaveModel madeComponent.GetModelDoc2(), path, True
4861             fallbackSuccesses("mirror-part-saved") = fallbackSuccesses("mirror-part-saved") + 1
            ' The file was written from the document, so the geometry is read again from the document that was saved.
4863             problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
4864             If Len(problem) > 0 Then Err.Raise 5, , "After saving the mirrored part " & partFile & ".sldprt: " & problem
        End If
4866         If InStr(extraFiles, Quote(partFile & ".sldprt")) = 0 Then extraFiles = extraFiles & "," & Quote(partFile & ".sldprt")
    End If
4868     Set components(newLabel) = madeComponent
4869     RebuildNoted doc, "the mirror"
    stepLabel = currentIdentity & ": MirrorComponent Name2"
4871     NoteOption newLabel & " is " & CStr(madeComponent.Name2) & IIf(newPart, " (new part " & partFile & ".sldprt)", " (an instance of " & CStr(sourceComponent.Name2) & ")")
End Sub

Private Function PatternFromFeatureData(ByVal seed As Object, ByVal axis As Object, ByVal count As Long, ByVal spacing As Double) As Object
    ' The 2024 interop's ILocalLinearPatternFeatureData (CreateDefinition(swFmLocalLPattern) then CreateFeature).
    Dim definition As Object
    stepLabel = currentIdentity & ": PatternFromFeatureData CreateDefinition" & " " & apiInputs & " " & callInputs
4878     Set definition = doc.FeatureManager.CreateDefinition(swFmLocalLPattern)
4879     Require definition, "CreateDefinition(swFmLocalLPattern) returned nothing"
    stepLabel = currentIdentity & ": PatternFromFeatureData SeedComponentArray"
4881     definition.SeedComponentArray = ObjectArray1(seed)
