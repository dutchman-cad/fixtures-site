Private Function BaseFlange(ByVal thickness As Double, ByVal radius As Double, ByVal kFactor As Double, ByVal axisIndex As Long, ByVal side As Long, ByVal planeOffset As Double) As Object
    ' thickness, radius and planeOffset in meters. Thickness must lie on the requested side of the sketch plane;
    ' a wrong side is undone and rebuilt: ThickenDir reversed, then (feature-data route) ReverseDirection, then
    ' the built feature is flipped with ModifyDefinition. Never accepts the wrong side.
    Dim profileFeature As Object, feature As Object, tried As String, member As Variant
    Dim near As Double, far As Double, origin As Double, depth As Double, verdict As String
7516     Set profileFeature = lastFeature
7517     Require profileFeature, "Base flange profileFeature sketch missing"
7518     origin = planeOffset * 1000#
7519     depth = thickness * 1000#
    ' Step 0: the recipe's side.
7521     Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, False, "ReverseThickness")
7522     verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7523     If verdict = "other" Then BaseFlangeRefuse near, far, origin
7524     If verdict = "wrong" Then
        ' Step 1: undo and rebuild with the reverse flag.
7526         RecordMitigation "baseflange-thicken-reverse", True, True
7527         BaseFlangeUndo
7528         Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, True, "ReverseThickness")
7529         verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7530         If verdict = "ok" Then
7531             fallbackSuccesses("baseflange-thicken-reverse") = fallbackSuccesses("baseflange-thicken-reverse") + 1
        ElseIf verdict = "other" Or (baseRoute <> "featuredata" And swMajor >= BASEFLANGE_INITIALIZE_FROM) Then
7533             BaseFlangeRefuse near, far, origin
        Else
7535             If baseRoute = "featuredata" Then
                ' Step 2: the other reverse member, IBaseFlangeFeatureData.ReverseDirection.
7537                 RecordMitigation "baseflange-reverse-direction", True, True
7538                 BaseFlangeUndo
7539                 Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, True, "ReverseDirection")
7540                 verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7541                 If verdict = "ok" Then
7542                     fallbackSuccesses("baseflange-reverse-direction") = fallbackSuccesses("baseflange-reverse-direction") + 1
                ElseIf verdict = "other" Then
7544                     BaseFlangeRefuse near, far, origin
                End If
            End If
            ' Round 23, revisions before 30 only (a revision of 30 or more refuses as before): the insert route has no ReverseDirection step (it is
            ' a feature-data member), but a flange built by the insert call is an IBaseFlangeFeatureData too, so it goes straight to step 3.
7549             If verdict = "wrong" Then
                ' Step 3: build it as the recipe says, then flip the BUILT feature with ModifyDefinition.
7551                 RecordMitigation "baseflange-modify-reverse", True, True
7552                 BaseFlangeUndo
7553                 Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, False, "ReverseThickness")
7554                 verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7555                 For Each member In Array("ReverseThickness", "ReverseDirection")
7556                     If verdict = "ok" Then Exit For
7557                     If verdict = "other" Then BaseFlangeRefuse near, far, origin
7558                     FlipBuiltBaseFlange CStr(member), tried
7559                     verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7560                     tried = tried & CStr(member) & " -> extent " & NumberList(Array(near, far)) & " mm; "
7561                     If verdict = "wrong" And CStr(member) = "ReverseThickness" Then
7562                         FlipBuiltBaseFlange CStr(member), tried
7563                         verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
                    End If
                Next member
7566                 If verdict <> "ok" Then Err.Raise 5, , "Base flange thickness stays on the wrong side of its sketch after the reverse flag before CreateFeature, ReverseDirection and a ModifyDefinition toggle of each (" & callInputs & "; " & tried & ")"
7567                 fallbackSuccesses("baseflange-modify-reverse") = fallbackSuccesses("baseflange-modify-reverse") + 1
            End If
        End If
    End If
7571     AppendLog currentFolder, currentIdentity, "option", 0, 0, "base flange: corner_relief and corner_gap have no Sheet-Metal setting in SolidWorks; they belong to Corner Relief features and a flat base flange has no corners"
7572     Set BaseFlange = feature
End Function

