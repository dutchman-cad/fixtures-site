    stepLabel = currentIdentity & ": MirrorComponent Count"
4862     NoteOption "mirror " & newLabel & ": " & sourceLabel & " about " & normal & " = " & NoteList(Array(offset * 1000#)) & " mm, " & CStr(before.Count) & " top-level component(s) before, " & CStr(orientCount) & " orientation(s) to try"
4863     For number = 0 To orientCount - 1
4864         If number > 0 Then
