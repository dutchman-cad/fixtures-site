    stepLabel = currentIdentity & ": CreateMate AddMate5"
5794         Set CreateMate = AssemblyDocument(doc).AddMate5(kind, alignment, flip, distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, positioning, lockRotation, widthValue, errors)
5795         If errors = swAddMateError_NoError Then fallbackSuccesses("distance-mate-no-limits") = fallbackSuccesses("distance-mate-no-limits") + 1
    End If
5797     If kind = swMateCOINCIDENT And (errors = 3 Or errors = 4 Or errors = 5) Then
        ' Round 22 (field 2026.11.24.6, SolidWorks 2023, A05a): AddMate5 answered error 5 for an edge Coincident mate with Align 1 (the same call works on 2026).
        ' The other alignments are asked in turn, Closest (2) then Aligned (0), each with the same entities selected again; every answer is logged (mate-align-retry).
5800         alignOrder = Array(swMateAlignCLOSEST, swMateAlignALIGNED)
5801         For i = 0 To 1
5802             alignNow = CLng(alignOrder(i))
5803             If alignNow <> alignment Then
5804                 If retryNumber = 0 Then RecordMitigation "mate-align-retry", True, True
5805                 retryNumber = retryNumber + 1
5806                 If Not ReplayPicks() Then Exit For
    stepLabel = currentIdentity & ": CreateMate AddMate5"
5808                 Set CreateMate = AssemblyDocument(doc).AddMate5(kind, alignNow, flip, distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, positioning, lockRotation, widthValue, errors)
5809                 NoteOption "mate-align-retry: AddMate5 with Align " & CStr(alignNow) & " answered error " & CStr(errors)
5810                 retried = retried & "; Align " & CStr(alignNow) & " answered error " & CStr(errors)
5811                 If errors = swAddMateError_NoError Then
5812                     fallbackSuccesses("mate-align-retry") = fallbackSuccesses("mate-align-retry") + 1
5813                     Exit For
                End If
            End If
        Next i
    End If
    ' swAddMateError_e: swAddMateError_NoError = 1 is success (0 is ErrorUnknown); round 4 failed every mate on 1.
5819     If errors <> swAddMateError_NoError Then Err.Raise 5, , "SolidWorks AddMate5 error " & CStr(errors) & " (arguments (Type, Align, Flip, Dist, DistUpper, DistLower, GearNum, GearDen, Angle, AngleUpper, AngleLower, ForPositioning, LockRotation, WidthType) = " & NumberList(Array(kind, alignment, IIf(flip, 1, 0), distance, upper, lower, numerator, denominator, angle, angleUpper, angleLower, IIf(positioning, 1, 0), IIf(lockRotation, 1, 0), widthValue)) & "; " & callInputs & SelectionSummary() & retried & ")"
5820     Require CreateMate, "Mate API returned no mate"
End Function

Private Function CylinderFace(ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal nx As Double, ByVal ny As Double, ByVal nz As Double) As Object
    ' A cylinder's IFace2.Normal is not one vector: match by the radial direction at the point
    ' (ISurface.CylinderParams: origin xyz, axis xyz, radius), ignoring the sense of the face.
    Dim bodies As Variant, body As Variant, entities As Variant, entity As Variant
    Dim closeFlag As Variant, params As Variant, surface As Object, count As Long
    Dim length As Double, along As Double, ax As Double, ay As Double, az As Double
    Dim rx As Double, ry As Double, rz As Double, size As Double
5830     callInputs = "cylindrical face point(m)=" & NumberList(Array(x, y, z)) & " direction=" & NumberList(Array(nx, ny, nz))
    stepLabel = currentIdentity & ": CylinderFace GetBodies2"
5832     bodies = PartDocument(doc).GetBodies2(0, False)
5833     If Not IsEmpty(bodies) Then
5834         For Each body In bodies
    stepLabel = currentIdentity & ": CylinderFace GetFaces"
5836             entities = body.GetFaces()
5837             If Not IsEmpty(entities) Then
5838                 For Each entity In entities
    stepLabel = currentIdentity & ": CylinderFace GetClosestPointOn"
5840                     closeFlag = entity.GetClosestPointOn(x, y, z)
5841                     If (closeFlag(0) - x) ^ 2 + (closeFlag(1) - y) ^ 2 + (closeFlag(2) - z) ^ 2 <= 0.0000001 ^ 2 Then
    stepLabel = currentIdentity & ": CylinderFace GetSurface"
5843                         Set surface = entity.GetSurface()
5844                         If Not surface Is Nothing Then
    stepLabel = currentIdentity & ": CylinderFace IsCylinder"
5846                             If surface.IsCylinder() Then
    stepLabel = currentIdentity & ": CylinderFace CylinderParams"
5848                                 params = surface.CylinderParams
5849                                 length = Sqr(params(3) ^ 2 + params(4) ^ 2 + params(5) ^ 2)
5850                                 If length > 0 Then
5851                                     ax = params(3) / length: ay = params(4) / length: az = params(5) / length
5852                                     along = (x - params(0)) * ax + (y - params(1)) * ay + (z - params(2)) * az
5853                                     rx = x - params(0) - along * ax: ry = y - params(1) - along * ay: rz = z - params(2) - along * az
5854                                     size = Sqr(rx ^ 2 + ry ^ 2 + rz ^ 2)
5855                                     If size > 0.000000001 Then
5856                                         If Abs((rx * nx + ry * ny + rz * nz) / size) >= 0.999999 Then
5857                                             count = count + 1
5858                                             Set CylinderFace = entity
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next entity
            End If
        Next body
    End If
5869     If count <> 1 Then Err.Raise 5, , "Geometric selector matched " & CStr(count) & " entities (cylindrical faces only)"
End Function

