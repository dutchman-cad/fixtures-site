Private Sub MirrorRestore(ByVal rungName As String, ByVal before As Object, ByVal treeBefore As String)
    ' Put the assembly back to what it was before the first mirror call, by diff and not by undo count (a successful ModifyDefinition adds an undo
    ' entry of its own, so one undo takes only that): EditUndo2 until the top-level components and the feature tree equal the snapshot, at most 4
    ' times. If they still differ the rung is named and the ladder stops.
    Dim attempt As Long, remains As String
4472     For attempt = 1 To 4
4473         If Len(MirrorLeft(before, treeBefore)) = 0 Then Exit Sub
    stepLabel = currentIdentity & ": MirrorRestore EditUndo2"
4475         doc.EditUndo2 1
    Next attempt
4477     remains = MirrorLeft(before, treeBefore)
4478     If Len(remains) > 0 Then Err.Raise 5, , "the mirror rung " & rungName & " left " & remains & " in the assembly"
End Sub

Private Function MirrorCheck(ByVal madeComponent As Object, ByVal sourceComponent As Object, ByVal axisIndex As Long, ByVal offset As Double, ByVal corner As Variant, ByVal wanted As Variant, ByVal showPoint As Boolean, ByVal label As String) As String
    ' The corner test of one mirror try, logged: "" when the part's rounded corner (the fillet's axis, read from the part's own geometry) is at the
    ' mirror image of the original's, else what was found. The same test for an instance and for a new part.
    Dim values As Variant, point(2) As Double, worst As Double, r As Long, c As Long, problem As String
    Dim cornerLower As Long, cornerUpper As Long, valueLower As Long, valueUpper As Long
4486     problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
4487     ArrayItems corner, cornerLower, cornerUpper
    stepLabel = currentIdentity & ": MirrorCheck GetTotalTransform"
4489     values = madeComponent.GetTotalTransform(True).ArrayData
4490     If Not ArrayItems(values, valueLower, valueUpper) Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered no array"
4491     If valueUpper - valueLower < 12 Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered " & CStr(valueUpper - valueLower + 1) & " numbers, not 16"
4492     For r = 0 To 2
4493         point(r) = CDbl(values(valueLower + 9 + r)) * 1000#
4494         For c = 0 To 2
4495             point(r) = point(r) + CDbl(values(valueLower + 3 * c + r)) * CDbl(corner(cornerLower + c))
        Next c
    Next r
4498     If showPoint Then
4499         For r = 0 To 2
4500             If Abs(point(r) - CDbl(wanted(r))) > worst Then worst = Abs(point(r) - CDbl(wanted(r)))
        Next r
4502         NoteOption label & " puts the rounded corner at (" & NoteList(point) & ") mm" & IIf(worst <= 0.5, "", ", wanted (" & NoteList(wanted) & ")")
    End If
4504     If Len(problem) = 0 Then
4505         NoteOption label & ": the rounded corner (the fillet axis read from its own geometry) is at the mirror image of the original"
    Else
4507         NoteOption label & ": " & problem
    End If
4509     MirrorCheck = problem
End Function

Private Function MirrorLadder(ByVal plane As Object, ByVal sourceComponent As Object, ByVal path As String, ByVal before As Object, ByVal corner As Variant, ByVal wanted As Variant, ByVal axisIndex As Long, ByVal offset As Double, ByVal orientationList As Variant, ByVal treeBefore As String, ByRef problem As String, ByRef ladder As String) As Object
    ' Round 25 (field 2026.11.25.3, A20b: the orientation argument did not reach SolidWorks in the array form): the rungs after the orientation loop,
    ' each logged and judged by the same corner test, stopping at the first that is right. 0 and 1: mirror-orientation-int-array (an Integer array,
    ' then a Variant array); 2: mirror-orientation-definition (the orientation set through IMirrorComponentFeatureData and ModifyDefinition);
    ' 3: mirror-orientation-center-of-mass-off. problem is "" when a rung worked; ladder lists every try's result. The assembly is put back to its
    ' snapshot (MirrorRestore) before the first try and after every try that fails, made or not.
    Dim rung As Long, number As Long, lower As Long, upper As Long, orientation As Long, rungName As String, how As String
    Dim madeComponent As Object, label As String, reason As String, fresh As Variant, entry As Object, nameText As String, freshLower As Long, freshUpper As Long
4520     problem = "no rung ran"
4521     ladder = ""
4522     If Not ArrayItems(orientationList, lower, upper) Then Exit Function
4523     MirrorRestore "the orientation loop", before, treeBefore
4524     For rung = 0 To 3
4525         Select Case rung
            Case 0
4527                 rungName = "mirror-orientation-int-array": how = "Integer array"
            Case 1
4529                 rungName = "mirror-orientation-int-array": how = "Variant array"
            Case 2
4531                 rungName = "mirror-orientation-definition": how = "definition"
            Case Else
4533                 rungName = "mirror-orientation-center-of-mass-off": how = "OrientAboutCenterOfMass False"
        End Select
4535         If rung <> 1 Then RecordMitigation rungName, True, True
4536         For number = lower To upper
4537             orientation = CLng(orientationList(number))
4538             label = "mirror rung " & rungName & " (" & how & "), orientation " & CStr(orientation)
4539             reason = ""
4540             Set madeComponent = Nothing
4541             On Error Resume Next
4542             Select Case rung
                Case 0
4544                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 1, -1)
                Case 1
4546                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 2, -1)
                Case 2
4548                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, CLng(orientationList(lower)), before, 0, -1)
                Case Else
4550                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 0, 0)
            End Select
4552             If Err.Number <> 0 Then reason = CleanError(Err.Description)
4553             Err.Clear
4554             On Error GoTo 0
4555             If Len(reason) = 0 Then
4556                 If rung = 2 Then
4557                     reason = MirrorDefine(orientation)
4558                     If Len(reason) = 0 Then
4559                         RebuildNoted doc, "the mirror definition"
4560                         fresh = NewComponents(before)
4561                         If ArrayItems(fresh, freshLower, freshUpper) Then
4562                             If ItemAt(fresh, freshLower, entry, nameText) Then Set madeComponent = entry
                        End If
                    End If
                End If
            End If
4567             If Len(reason) > 0 Then
4568                 NoteOption label & ": " & reason
4569                 problem = reason
            Else
4571                 problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, wanted, True, label)
4572                 If Len(problem) = 0 Then
4573                     fallbackSuccesses(rungName) = fallbackSuccesses(rungName) + 1
4574                     ladder = ""
4575                     Set MirrorLadder = madeComponent
4576                     Exit Function
                End If
4578                 reason = problem
            End If
4580             ladder = ladder & "; " & rungName & " (" & how & "), orientation " & CStr(orientation) & ": " & reason
4581             MirrorRestore rungName, before, treeBefore
        Next number
    Next rung
4584     Set MirrorLadder = madeComponent
End Function

Private Function MirrorCall(ByVal plane As Object, ByVal sourceComponent As Object, ByVal newPart As Boolean, ByVal path As String, ByVal orientation As Long, ByVal before As Object, ByVal arrayKind As Long, ByVal centerMode As Long) As Object
    ' MirrorComponents3 in the five forms in turn (MirrorFormText), starting from the one that made a component last. A form succeeds only if it
    ' yields a component: an object in its answer, or a new top-level component after a rebuild (field 2026.11.24.3: forms 0 and 1 answered an
    ' EMPTY array and made nothing, which was taken for success). Nothing is undone between forms. Round 25: arrayKind is the element type of the
    ' orientation array (0 Long, 1 Integer, 2 Variant) and centerMode 0 puts OrientAboutCenterOfMass False (-1: as the form says).
    Dim form As Long, startForm As Long, instance As Variant, mirrored As Variant, names As Variant, orientations As Variant, result As Variant
    Dim planeArgument As Object, madeComponent As Object, aboutCenter As Boolean, importOptions As Long, summary As String, summaries As String, madeName As String
    Dim emptyObjects As Variant, emptyLongs As Variant, emptyStrings As Variant
    ' No ReDim x(0 To -1) here: it raises Err 9 "Subscript out of range" in VBA (see TypedEmpty).
4596     emptyObjects = TypedEmpty(0)
4597     emptyLongs = TypedEmpty(1)
4598     emptyStrings = TypedEmpty(2)
4599     startForm = mirrorFormStart
4600     For form = startForm To 4
4601         If form > startForm Then RecordMitigation MirrorFormName(form), True, True
4602         Select Case form
            Case 1
4604                 Set instance = Nothing
4605                 Set mirrored = Nothing
4606                 Set names = Nothing
4607                 Set orientations = Nothing
            Case 2
4609                 instance = Empty
4610                 mirrored = Empty
4611                 names = Empty
4612                 orientations = Empty
            Case 3
4614                 instance = emptyObjects
4615                 mirrored = emptyObjects
4616                 names = emptyStrings
4617                 orientations = emptyLongs
            Case Else
                ' Form 0 is VBA's Array(), a Variant empty array: what the field run passed. Form 3 above is the typed empty arrays.
4620                 instance = Array()
4621                 mirrored = Array()
4622                 names = Array()
4623                 orientations = Array()
        End Select
4625         If newPart Then
4626             mirrored = ObjectArray1(sourceComponent)
4627             names = StringArray1(path)
        Else
4629             instance = ObjectArray1(sourceComponent)
4630             Select Case arrayKind
                Case 1
4632                     orientations = IntegerArray1(orientation)
                Case 2
4634                     orientations = VariantArray1(orientation)
                Case Else
4636                     orientations = LongArray1(orientation)
            End Select
        End If
4639         aboutCenter = (form <> 3)
4640         If centerMode = 0 Then aboutCenter = False
4641         importOptions = 1
4642         If form = 3 Then importOptions = 0
4643         NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & "): calling"
    stepLabel = currentIdentity & ": MirrorCall ClearSelection2"
4645         doc.ClearSelection2 True
    stepLabel = currentIdentity & ": MirrorCall Select2" & " " & apiInputs & " " & callInputs
4647         If form = 3 Then plane.Select2 False, 0
4648         Set planeArgument = plane
4649         If form = 4 Then
4650             On Error Resume Next
4651             Set planeArgument = Nothing
    stepLabel = currentIdentity & ": MirrorCall GetSpecificFeature2"
4653             Set planeArgument = plane.GetSpecificFeature2()
4654             Err.Clear
4655             On Error GoTo 0
        End If
4657         If planeArgument Is Nothing Then
4658             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & "): the plane feature gave no IRefPlane"
4659             summaries = summaries & "; form " & CStr(form) & ": no IRefPlane"
        Else
    stepLabel = currentIdentity & ": MirrorCall MirrorComponents3"
4662             result = AssemblyDocument(doc).MirrorComponents3(planeArgument, instance, orientations, aboutCenter, mirrored, False, names, IIf(newPart, swMirrorNameCustom, swMirrorNameSuffix), "", currentFolder, importOptions, False, False, False)
4663             Set madeComponent = MirrorMade(result, before)
4664             If madeComponent Is Nothing Then
4665                 summary = "no new component"
            Else
4667                 ReadName2 madeComponent, madeName
4668                 summary = "made " & madeName
            End If
4670             summary = "returned " & MirrorResultText(result) & "; " & summary & "; last feature " & LastFeatureType()
4671             NoteOption "MirrorComponents3 form " & CStr(form) & " (" & MirrorFormText(form) & ", orientation " & CStr(orientation) & MirrorKindText(arrayKind, centerMode) & ") " & summary
4672             summaries = summaries & "; form " & CStr(form) & " " & summary
4673             If Not madeComponent Is Nothing Then
4674                 If form > startForm Then fallbackSuccesses(MirrorFormName(form)) = fallbackSuccesses(MirrorFormName(form)) + 1
4675                 mirrorFormStart = form
4676                 Set MirrorCall = madeComponent
4677                 Exit Function
            End If
        End If
    Next form
4681     Err.Raise 5, , "MirrorComponents3 made no component in " & IIf(startForm = 0, "any of its forms", "the forms from " & CStr(startForm) & " on") & " (orientation " & CStr(orientation) & ")" & Mid$(summaries, 2)
End Function

Private Sub MirrorComponent(ByVal sourceLabel As String, ByVal newLabel As String, ByVal normal As String, ByVal offset As Double, ByVal newPart As Boolean, ByVal partFile As String, ByVal corner As Variant, ByVal orientationList As Variant)
    ' A20: Mirror Components. IAssemblyDoc.MirrorComponents3 about a reference plane at the recipe's offset (meters), once as a same-file instance
    ' (a/b) and once as a new part file saved beside the top file (c). For an instance the component orientation (an enum whose axes depend on
    ' the plane) is tried in turn until the part's rounded corner lands on the mirrored corner (mirror-orientation-next); an empty array argument
    ' that makes no component (an empty answer is not one) is made again in the next form of MirrorCall (mirror-empty-array-nothing, mirror-empty-variant,
    ' mirror-plane-selected, mirror-refplane-object); a mirrored part file that is not on disk is saved from its document (mirror-part-saved).
    Dim sourceComponent As Object, plane As Object, before As Object, number As Long, madeComponent As Object
    Dim wanted(2) As Double, axisIndex As Long, c As Long, path As String, problem As String, ladderText As String, treeBefore As String
    Dim cornerLower As Long, cornerUpper As Long, orientLower As Long, orientUpper As Long, orientCount As Long
4693     If Not ArrayItems(corner, cornerLower, cornerUpper) Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe's corner point is empty"
4694     If cornerUpper - cornerLower < 2 Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe's corner point has " & CStr(cornerUpper - cornerLower + 1) & " number(s), not 3"
4695     If Not ArrayItems(orientationList, orientLower, orientUpper) Then Err.Raise 5, , "Mirror " & newLabel & ": the recipe has no component orientation to try"
4696     orientCount = orientUpper - orientLower + 1
    stepLabel = currentIdentity & ": MirrorComponent Exists"
4698     If Not components.Exists(sourceLabel) Then Err.Raise 5, , "Mirror " & newLabel & ": the source component " & sourceLabel & " was not placed"
4699     Set sourceComponent = components(sourceLabel)
4700     axisIndex = InStr(1, "XYZ", normal, vbBinaryCompare) - 1
4701     Set plane = ReferencePlaneAt(IIf(normal = "X", "YZ", IIf(normal = "Y", "XZ", "XY")), offset)
4702     Require plane, "The mirror plane was not made"
4703     path = currentFolder & "\" & partFile & ".sldprt"
4704     For c = 0 To 2
4705         wanted(c) = CDbl(corner(cornerLower + c))
    Next c
4707     wanted(axisIndex) = 2# * offset * 1000# - CDbl(corner(cornerLower + axisIndex))
4708     Set before = ComponentNames()
4709     treeBefore = TreeText()
    stepLabel = currentIdentity & ": MirrorComponent Count"
4711     NoteOption "mirror " & newLabel & ": " & sourceLabel & " about " & normal & " = " & NoteList(Array(offset * 1000#)) & " mm, " & CStr(before.Count) & " top-level component(s) before, " & CStr(orientCount) & " orientation(s) to try"
4712     For number = 0 To orientCount - 1
4713         If number > 0 Then
4714             RecordMitigation "mirror-orientation-next", True, True
    stepLabel = currentIdentity & ": MirrorComponent EditUndo2"
4716             doc.EditUndo2 1
        End If
4718         Set madeComponent = MirrorCall(plane, sourceComponent, newPart, path, CLng(orientationList(orientLower + number)), before, 0, -1)
4719         problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, Array(wanted(0), wanted(1), wanted(2)), Not newPart, IIf(newPart, "new part " & partFile & ".sldprt", "mirror orientation " & CStr(orientationList(orientLower + number))))
4720         If Len(problem) = 0 Then
4721             If number > 0 Then fallbackSuccesses("mirror-orientation-next") = fallbackSuccesses("mirror-orientation-next") + 1
4722             Exit For
        End If
4724         If newPart Then Err.Raise 5, , "The new mirrored part " & partFile & ".sldprt does not have the rounded corner at its mirror image about " & normal & " = " & NoteNumber(offset * 1000#) & " mm: " & problem
    Next number
4726     If Len(problem) > 0 Then
4727         Set madeComponent = MirrorLadder(plane, sourceComponent, path, before, corner, Array(wanted(0), wanted(1), wanted(2)), axisIndex, offset, orientationList, treeBefore, problem, ladderText)
4728         If Len(problem) > 0 Then
4729             stepLabel = currentIdentity & ": MirrorComponent orientation ladder exhausted"
4730             Err.Raise 5, , "No component orientation of MirrorComponents3 puts the rounded corner at its mirror image about " & normal & " = " & NoteNumber(offset * 1000#) & " mm: " & problem & "; then, with the orientation given another way:" & Mid$(ladderText, 2)
        End If
    End If
4733     If newPart Then
4734         If Len(Dir$(path)) = 0 Then
4735             RecordMitigation "mirror-part-saved", True, True
    stepLabel = currentIdentity & ": MirrorComponent GetModelDoc2"
4737             SaveModel madeComponent.GetModelDoc2(), path, True
4738             fallbackSuccesses("mirror-part-saved") = fallbackSuccesses("mirror-part-saved") + 1
            ' The file was written from the document, so the geometry is read again from the document that was saved.
4740             problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
4741             If Len(problem) > 0 Then Err.Raise 5, , "After saving the mirrored part " & partFile & ".sldprt: " & problem
        End If
4743         If InStr(extraFiles, Quote(partFile & ".sldprt")) = 0 Then extraFiles = extraFiles & "," & Quote(partFile & ".sldprt")
    End If
4745     Set components(newLabel) = madeComponent
4746     RebuildNoted doc, "the mirror"
    stepLabel = currentIdentity & ": MirrorComponent Name2"
4748     NoteOption newLabel & " is " & CStr(madeComponent.Name2) & IIf(newPart, " (new part " & partFile & ".sldprt)", " (an instance of " & CStr(sourceComponent.Name2) & ")")
