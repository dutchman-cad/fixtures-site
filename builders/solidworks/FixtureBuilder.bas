    Dim i As Long, dotValue As Double, circleLength As Double, normalLength As Double, message As String
5777     If Left$(probeCandidate, 4) <> "face" Then
5778         Set ProbeMateEntity = ComponentGeom(componentName, kind, x, y, z, nx, ny, nz)
5779         Exit Function
    End If
5781     Set assemblyDoc = doc
5782     On Error GoTo Failed
