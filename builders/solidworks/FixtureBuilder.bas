2160             On Error Resume Next
2161             Err.Clear
2162             If fs.FileExists(path) Then fs.DeleteFile path, True
2163             done = (Err.Number = 0 And Not fs.FileExists(path))
2164             Err.Clear
2165             On Error GoTo 0
        End If
    Next attempt
2168     SweepDelete = done
