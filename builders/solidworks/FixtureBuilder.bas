Private Function MatrixInversePoint(ByVal matrix As Variant, ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' The model point of a sketch point (the inverse of MatrixPoint; the rotation is orthonormal).
    Dim first As Long, scaleFactor As Double, shifted(2) As Double, result(2) As Double, i As Long, j As Long
9788     first = LBound(matrix)
9789     scaleFactor = CDbl(matrix(first + 12))
9790     shifted(0) = (x - CDbl(matrix(first + 9))) / scaleFactor
9791     shifted(1) = (y - CDbl(matrix(first + 10))) / scaleFactor
9792     shifted(2) = (z - CDbl(matrix(first + 11))) / scaleFactor
9793     For i = 0 To 2
9794         For j = 0 To 2
9795             result(i) = result(i) + shifted(j) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
9798     MatrixInversePoint = Array(result(0), result(1), result(2))
End Function

