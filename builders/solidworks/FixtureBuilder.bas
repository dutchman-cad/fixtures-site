Public Sub main()
    Dim revision As String, pieces As Variant, version As String, build As String
    Dim target As String, folder As String, i As Long, attempt As Long
    Dim oldStep As Long, fs As Object, preferenceSet As Boolean
    Dim oldInput As Boolean, inputSaved As Boolean, oldRebuild As Boolean, rebuildSaved As Boolean
    Dim oldWarn As Boolean, warnSaved As Boolean, oldAction As Long, actionSaved As Boolean
    Dim finalMessage As String, fatalDescription As String, fatalStep As String
    Dim fatalNumber As Long, fatalLine As Long
    Dim finishText As String, launched As Boolean, zipMade As Boolean
    Dim noticeNote As String, sweepNotes As String, zipError As String, swept As Boolean
231     On Error GoTo Fatal
232     currentIdentity = "setup"
    ' First of all, before a preference is touched or a folder made: an output folder that carries a personal path is refused.
234     target = OUTPUT_FOLDER
235     If Len(target) = 0 Then target = DefaultOutputRoot()
236     finalMessage = PersonalPathReason(target)
237     If Len(finalMessage) > 0 Then GoTo Cleanup
    stepLabel = currentIdentity & ": main SldWorks"
239     Set app = Application.SldWorks
    ' The launcher sets LaunchedBy first and shows the finish text itself, so the builder stays quiet then.
241     launched = (GetSetting("DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", "") = "launcher")
    ' A template under a personal path is refused before anything is built (a drawing keeps the path of its template).
243     finalMessage = TemplateRefusal()
244     If Len(finalMessage) > 0 Then GoTo Cleanup
    ' The up-front notice, once per run (the launcher shows it itself): Cancel builds nothing.
246     noticeNote = NoticeStep(launched)
247     If Len(noticeNote) = 0 Then
248         finalMessage = "Canceled at the user name notice. Nothing was built."
249         GoTo Cleanup
    End If
251     For i = 2 To 5
252         rbStatus(i) = ""
    Next i
254     sweepEmptied = ""
255     sweepEmptiedCount = 0
256     sweepListFailed = False
257     sweepAnsiSkipped = False
    ' Ask once (a launcher macro normally sets RunMode first); the answer is remembered.
259     If Len(GetSetting("DutchmanFixtures", "SolidWorksBuilder", "RunMode", "")) = 0 Then
260         If MsgBox("Build only the recipes that haven't built yet on this SolidWorks version? (No = build everything)", vbYesNo + vbQuestion + vbDefaultButton1) = vbYes Then
261             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "left"
        Else
263             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "full"
        End If
    End If
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
267     oldInput = app.GetUserPreferenceToggle(swInputDimValOnCreate)
268     inputSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
270     app.SetUserPreferenceToggle swInputDimValOnCreate, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
272     oldRebuild = app.GetUserPreferenceToggle(swShowErrorsEveryRebuild)
273     rebuildSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
275     app.SetUserPreferenceToggle swShowErrorsEveryRebuild, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
277     oldWarn = app.GetUserPreferenceToggle(swWarnSaveUpdateErrors)
278     warnSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
280     app.SetUserPreferenceToggle swWarnSaveUpdateErrors, False
    stepLabel = currentIdentity & ": main GetUserPreferenceIntegerValue"
282     oldAction = app.GetUserPreferenceIntegerValue(swRebuildErrorAction)
283     actionSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
285     If Not app.SetUserPreferenceIntegerValue(swRebuildErrorAction, swContinueResponse_Stop) Then Err.Raise 5, , "Cannot disable rebuild prompt"
    stepLabel = currentIdentity & ": main RevisionNumber"
287     revision = app.RevisionNumber()
288     pieces = Split(revision, ".")
289     swMajor = CLng(pieces(0))
290     version = CStr(CLng(pieces(0)) + 1992)
291     build = "0"
292     If UBound(pieces) > 0 Then
293         build = pieces(1)
294         For i = 2 To UBound(pieces)
295             build = build & "-" & pieces(i)
        Next i
    End If
298     Set fs = CreateObject("Scripting.FileSystemObject")
    ' SolidWorks' working directory is often its install folder, which is not writable; the default root is made when missing.
300     EnsureFolder fs, target
    ' Always a NEW folder: FixtureBuilder-SolidWorks-<version>, then -2, -3 ... Never deleted or reused.
302     root = "FixtureBuilder-SolidWorks-" & BUILDER_VERSION
    stepLabel = currentIdentity & ": main BuildPath"
304     folder = fs.BuildPath(target, root)
305     attempt = 1
    stepLabel = currentIdentity & ": main FolderExists"
307     Do While fs.FolderExists(folder) Or fs.FileExists(folder & ".zip")
308         attempt = attempt + 1
309         root = "FixtureBuilder-SolidWorks-" & BUILDER_VERSION & "-" & CStr(attempt)
    stepLabel = currentIdentity & ": main BuildPath"
311         folder = fs.BuildPath(target, root)
    Loop
    stepLabel = currentIdentity & ": main CreateFolder" & " " & apiInputs & " " & callInputs
314     fs.CreateFolder folder
    stepLabel = currentIdentity & ": main GetUserPreferenceIntegerValue"
316     oldStep = app.GetUserPreferenceIntegerValue(78)
317     preferenceSet = True
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
319     If Not app.SetUserPreferenceIntegerValue(78, 214) Then Err.Raise 5, , "Cannot set AP214"
320     resultRows = ""
    stepLabel = currentIdentity & ": main BuildPath"
322     WriteUtf8 fs.BuildPath(folder, "results.json"), "[]"
323     AppendLog folder, "setup", "Fixture Builder " & BUILDER_VERSION, 0, 0, "SolidWorks revision " & revision & "; output folder " & folder & "; personal-path check: passed"
324     AppendLog folder, "setup", "template path", 0, 0, "template path: neutral"
325     AppendLog folder, "setup", "user name notice", 0, 0, noticeNote
326     Set skipBuilt = CreateObject("Scripting.Dictionary")
327     runBuild = build
328     runVersion = version
329     ScanCrashes target, root, folder, version, build
330     If GetSetting("DutchmanFixtures", "SolidWorksBuilder", "RunMode", "left") = "full" Then
331         AppendLog folder, "setup", "run mode", 0, 0, "run mode: full"
    Else
333         FindBuilt target, root, version, build
334         ResolveSkips folder
    End If
336     For i = 0 To 170 - 1
    stepLabel = currentIdentity & ": main Exists"
338         If skipBuilt.Exists(DesignId(i)) Then
339             RecordSkipped DesignId(i), CStr(skipBuilt(DesignId(i))), folder, version, build
        Else
341             RunDesign i, folder, version, build, CLng(pieces(0))
        End If
    Next i
344     AppendLog folder, "setup", "summary", 0, 0, "summary: ok=" & CStr(CountStatus("ok")) & " failed=" & CStr(CountStatus("failed")) & _
        " not_scripted=" & CStr(CountStatus("not_scripted")) & " skipped_built=" & CStr(CountStatus("skipped_built"))
346     AppendLog folder, "setup", "summary info", 0, 0, ReadbackText()
347     AppendLog folder, "setup", "summary info", 0, 0, "SolidWorks stamps the saving user in each file: not removable by the API"
348     AppendLog folder, "setup", "summary info", 0, 0, "SolidWorks also records its Windows temp folder (under your user profile) in each native file; we keep native files private and publish only STEP and files we've checked clean."
    ' Before the zip: every file in the output folder, listed or not, is scrubbed (see PrivacySweep).
350     swept = True
351     sweepNotes = PrivacySweep(folder)
352     If Len(sweepNotes) > 0 Then AppendLog folder, "setup", "privacy sweep", 0, 0, sweepNotes
353     zipMade = False
354     If Not sweepListFailed Then zipMade = MakeZip(folder)        ' a folder that could not be checked is never zipped
355     zipError = folder & "-zip-error.txt"
    stepLabel = currentIdentity & ": main FileExists"
357     If fs.FileExists(zipError) Then SweepFile fs, zipError, sweepNotes
358     If zipMade Then SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LastZip", folder & ".zip"
359     finishText = FinishMessage(CountStatus("ok") + CountStatus("failed") + CountStatus("not_scripted") + CountStatus("skipped_built"), _
        CountStatus("ok"), CountStatus("failed"), CountStatus("not_scripted"), CountStatus("skipped_built"), folder & ".zip", zipMade, folder)
361     AppendLog folder, "setup", "finish", 0, 0, finishText
362     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LastFinish", finishText
363     GoTo Cleanup
Fatal:
    fatalLine = Erl: fatalNumber = Err.Number: fatalDescription = Err.Description: fatalStep = stepLabel
366     finalMessage = fatalStep & " (line " & CStr(fatalLine) & "): " & fatalDescription
367     On Error Resume Next
368     swept = False        ' an error after the sweep (in the zip step) is swept again on the way out
369     If Len(folder) > 0 Then AppendLog folder, currentIdentity, fatalStep, fatalLine, fatalNumber, fatalDescription
370     Resume Cleanup
Cleanup:
372     On Error Resume Next
373     Err.Clear
    ' Every way out of main passes here (done, the error handler, an early exit): the folder is swept once, so an error part way leaves
    ' no unswept text file. The sweep before the zip counts as that once.
376     If Len(folder) > 0 And Not swept Then
377         swept = True
378         sweepNotes = PrivacySweep(folder)
379         If Len(sweepNotes) > 0 Then AppendLog folder, "setup", "privacy sweep", 0, 0, sweepNotes
    End If
381     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
383     If preferenceSet Then app.SetUserPreferenceIntegerValue 78, oldStep
384     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
385     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
387     If actionSaved Then app.SetUserPreferenceIntegerValue swRebuildErrorAction, oldAction
388     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
389     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
391     If warnSaved Then app.SetUserPreferenceToggle swWarnSaveUpdateErrors, oldWarn
392     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
393     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
395     If rebuildSaved Then app.SetUserPreferenceToggle swShowErrorsEveryRebuild, oldRebuild
396     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
397     Err.Clear
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
399     If inputSaved Then app.SetUserPreferenceToggle swInputDimValOnCreate, oldInput
400     If Err.Number <> 0 Then ReportCleanupError folder, finalMessage
401     SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", ""
402     Err.Clear
    ' FIXTURE_UNATTENDED=1: no Explorer window and no message box, only the log line written above.
404     If Len(finalMessage) > 0 Then
405         If Not IsUnattended() Then MsgBox PrivacyScrub(finalMessage)
    ElseIf Len(finishText) > 0 And Not launched And Not IsUnattended() Then
        ' A person is at the screen: show the zip in Explorer (never waits, errors ignored), then the message.
408         If zipMade Then
    stepLabel = currentIdentity & ": main Run"
410             CreateObject("WScript.Shell").Run "explorer.exe /select,""" & folder & ".zip""", 1, False
        Else
    stepLabel = currentIdentity & ": main Run"
413             CreateObject("WScript.Shell").Run "explorer.exe """ & folder & """", 1, False
        End If
415         Err.Clear
416         MsgBox PrivacyScrub(finishText), vbInformation, "SolidWorks fixtures"
    End If
End Sub

Private Function IsUnattended() As Boolean
421     IsUnattended = (Trim$(Environ$("FIXTURE_UNATTENDED")) = "1")
End Function

Private Sub EnsureFolder(ByVal fs As Object, ByVal path As String)
    Dim parent As String
    stepLabel = currentIdentity & ": EnsureFolder FolderExists"
427     If fs.FolderExists(path) Then Exit Sub
    stepLabel = currentIdentity & ": EnsureFolder GetParentFolderName"
429     parent = fs.GetParentFolderName(path)
430     If Len(parent) > 0 Then EnsureFolder fs, parent
    stepLabel = currentIdentity & ": EnsureFolder CreateFolder" & " " & apiInputs & " " & callInputs
432     fs.CreateFolder path
End Sub

' ---------------------------------------------------------------- personal-path check
' SolidWorks stores the full path of every file an assembly or a drawing references inside that file (a drawing also keeps its sheet
' format and template path), so an output folder or a template under the person's profile, a OneDrive folder or a folder named after
' them would put their user name into every file in the zip. Rules, in order, on the lower-cased path: inside %USERPROFILE%; a folder
' whose name is, or (for a user name of 3 or more characters that is not a common word) contains, %USERNAME%; a folder whose name
' contains "onedrive"; a folder under \Users\<name> (any drive, 8.3 short names included) where <name> is not Public.
' PersonalPathReason returns "" when the folder is neutral, else the refusal text, which never repeats the folder.
Private Function EnvText(ByVal variable As String) As String
    ' WScript.Shell reads the variable as UTF-16: Environ$ would turn a Cyrillic or CJK user name into "?" before any rule saw it.
    ' MYDOCUMENTS is the (possibly redirected) Documents folder, which has no environment variable.
    Dim value As String
446     On Error Resume Next
447     If variable = "MYDOCUMENTS" Then
448         value = CreateObject("WScript.Shell").SpecialFolders("MyDocuments")
    Else
450         value = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%" & variable & "%")
451         If value = "%" & variable & "%" Then value = ""
    End If
453     If Err.Number <> 0 Then value = ""
454     Err.Clear
455     EnvText = Trim$(value)
End Function

Private Function DefaultOutputRoot() As String
    Dim pub As String, result As String
460     pub = Replace(EnvText("PUBLIC"), "/", "\")
461     Do While Len(pub) > 0 And Right$(pub, 1) = "\"
462         pub = Left$(pub, Len(pub) - 1)
    Loop
464     If Len(pub) = 0 Then
465         result = "C:\FixtureBuilder"
    Else
467         result = pub & "\Documents\FixtureBuilder"
    End If
469     DefaultOutputRoot = result
End Function

Private Function UserNameNotice() As String
473     UserNameNotice = "SolidWorks writes your Windows user name into each file it saves. We keep these native files private and publish only STEP and files we've checked clean; to keep your name out of the files entirely, run SolidWorks under a neutral Windows account."
End Function

Private Function NameInsideComponents(ByVal user As String) As Boolean
    ' A word-matched name: 3 or more characters and not a common word. It is matched wherever the characters on both sides are not ASCII
    ' letters or digits (the start of the text, a tab, a quote, a length byte, "-", "_" ...); any other name (and a shorter one) only as a
    ' whole path segment. The same for the user name, the profile folder's own name and the computer, domain and logon-server names.
    Dim inside As Boolean
481     inside = (Len(user) >= 3)
482     If InStr("|admin|user|users|owner|public|default|test|cad|work|data|home|the|and|pro|dev|lab|app|sys|doc|docs|temp|office|pc|laptop|desktop|", "|" & user & "|") > 0 Then inside = False
483     NameInsideComponents = inside
End Function

Private Function IsAsciiAlnum(ByVal ch As String) As Boolean
487     IsAsciiAlnum = (ch Like "[A-Za-z0-9]")
End Function

Private Function WordIn(ByVal text As String, ByVal needle As String) As Boolean
    ' The needle in the text with no ASCII letter or digit next to it (or the edge of the text): both already lower-cased.
    Dim pos As Long, before As String, after As String, found As Boolean
493     If Len(needle) > 0 Then
494         pos = InStr(1, text, needle, vbBinaryCompare)
495         Do While pos > 0 And Not found
496             before = ""
497             after = ""
498             If pos > 1 Then before = Mid$(text, pos - 1, 1)
499             If pos + Len(needle) <= Len(text) Then after = Mid$(text, pos + Len(needle), 1)
500             If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
501             pos = InStr(pos + 1, text, needle, vbBinaryCompare)
        Loop
    End If
504     WordIn = found
End Function

Private Function SegmentMatches(ByVal part As String, ByVal needle As String) As Boolean
    Dim hit As Boolean
509     If Len(needle) > 0 Then hit = (part = needle)
510     If Len(needle) > 0 And Not hit Then
511         If NameInsideComponents(needle) Then hit = WordIn(part, needle)
    End If
513     SegmentMatches = hit
End Function

Private Function NormalPath(ByVal path As String) As String
    Dim p As String
518     p = LCase$(Replace(Trim$(path), "/", "\"))
519     Do While Len(p) > 0 And Right$(p, 1) = "\"
520         p = Left$(p, Len(p) - 1)
    Loop
522     NormalPath = p
End Function

Private Function LeafOf(ByVal normal As String) As String
526     LeafOf = Mid$(normal, InStrRev(normal, "\") + 1)
End Function

Private Function UnderRoot(ByVal p As String, ByVal root As String) As Boolean
    Dim under As Boolean
531     If Len(root) > 0 Then under = (p = root Or Left$(p, Len(root) + 1) = root & "\")
532     UnderRoot = under
End Function

Private Function PersonalPathRefusal(ByVal what As String, ByVal why As String) As String
536     PersonalPathRefusal = "The " & what & " was refused because " & why & ". " & _
        "SolidWorks stores this path inside every assembly and drawing it saves, so the files you send would show it. " & _
        "Choose a neutral one instead, for example " & DefaultOutputRoot() & " for the output folder. Nothing was built."
End Function

Private Function DriveRooted(ByVal path As String) As Boolean
    Dim t As String
543     t = Trim$(path)
544     DriveRooted = (Len(t) >= 3 And Mid$(t, 1, 1) Like "[A-Za-z]" And Mid$(t, 2, 1) = ":" And (Mid$(t, 3, 1) = "\" Or Mid$(t, 3, 1) = "/"))
End Function

Private Function PersonalWhy(ByVal path As String, ByVal identity As Boolean) As String
    ' With identity False (the default output root, the one folder the builder names itself) only the last two rules apply, so a user called
    ' Documents, Public or FixtureBuilder is not locked out of it. The first of these that applies, on the lower-cased path: inside %USERPROFILE%; inside a OneDrive folder or the redirected Documents
    ' folder; a folder that is, or (guarded names) contains, %USERNAME% or the profile folder's own name; a folder named after the computer,
    ' domain or logon server; a folder whose name contains "onedrive"; a UNC share; a Users\<name> folder that is not Public.
    Dim p As String, profile As String, parts As Variant, i As Long, k As Long, why As String
    Dim names(0 To 1) As String, machines(0 To 2) As String, roots(0 To 3) As String
554     p = NormalPath(path)
555     profile = NormalPath(EnvText("USERPROFILE"))
556     names(0) = LCase$(EnvText("USERNAME"))
557     names(1) = LeafOf(profile)
558     machines(0) = LCase$(EnvText("COMPUTERNAME"))
559     machines(1) = LCase$(EnvText("USERDOMAIN"))
560     machines(2) = LCase$(Replace(EnvText("LOGONSERVER"), "\", ""))
561     roots(0) = NormalPath(EnvText("OneDrive"))
562     roots(1) = NormalPath(EnvText("OneDriveCommercial"))
563     roots(2) = NormalPath(EnvText("OneDriveConsumer"))
564     roots(3) = NormalPath(EnvText("MYDOCUMENTS"))
565     parts = Split(p, "\")
566     If identity Then
567         If UnderRoot(p, profile) Then why = "it is inside your user profile folder"
    End If
569     If Len(why) = 0 And identity Then
570         For k = 0 To 3
571             If UnderRoot(p, roots(k)) Then why = "it is inside your OneDrive or redirected Documents folder"
        Next k
    End If
574     If Len(why) = 0 And identity Then
575         For k = 0 To 1
576             If Len(names(k)) > 0 Then
577                 For i = 0 To UBound(parts)
578                     If SegmentMatches(CStr(parts(i)), names(k)) Then why = "a folder in its path contains your Windows user name"
                Next i
            End If
        Next k
    End If
583     If Len(why) = 0 And identity Then
584         For k = 0 To 2
585             For i = 0 To UBound(parts)
586                 If SegmentMatches(CStr(parts(i)), machines(k)) Then why = "a folder in its path is named after this computer, its domain or its logon server"
            Next i
        Next k
    End If
590     If Len(why) = 0 And identity Then
591         For i = 0 To UBound(parts)
592             If InStr(parts(i), "onedrive") > 0 Then why = "a folder in its path is a OneDrive folder"
        Next i
    End If
595     If Len(why) = 0 And Left$(p, 2) = "\\" Then why = "it is on a network share (a \\server\share path)"
596     If Len(why) = 0 Then
597         For i = 0 To UBound(parts) - 1
598             If parts(i) = "users" And Len(parts(i + 1)) > 0 And parts(i + 1) <> "public" And parts(i + 1) <> "default" And parts(i + 1) <> "all users" And parts(i + 1) <> "shared" Then why = "it is inside the personal folder of a Windows user (a Users\<name> folder)"
        Next i
    End If
    ' Last, and for every folder (the default root too): a folder that is not a full path with a drive letter ("FixtureOut", "..\x",
    ' "%USERPROFILE%\x", which FileSystemObject does not expand) would resolve against SolidWorks' own current folder, which may be under the profile.
603     If Len(why) = 0 Then
604         If Not DriveRooted(path) Then why = "the folder must be a full path starting with a drive letter"
    End If
606     PersonalWhy = why
End Function

