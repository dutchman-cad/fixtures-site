    Next j
3344     forms(1) = reversed & "@" & title
3345     last = 1
3346     If UBound(parts) > 0 Then
3347         rest = CStr(parts(0))
3348         For j = 1 To UBound(parts) - 1
3349             rest = rest & "/" & CStr(parts(j))
        Next j
3351         forms(2) = CStr(parts(UBound(parts))) & "@" & title & "/" & rest
3352         last = 2
    End If
3354     For i = 0 To last
3355         Set handle = Nothing
3356         selectedCount = 0
3357         returned = False
3358         On Error Resume Next
    stepLabel = currentIdentity & ": SelectedComponent ClearSelection2"
3360         doc.ClearSelection2 True
    stepLabel = currentIdentity & ": SelectedComponent SelectByID2" & " " & apiInputs & " " & callInputs
3362         returned = doc.Extension.SelectByID2(forms(i), "COMPONENT", 0#, 0#, 0#, False, 0, Nothing, 0)
    stepLabel = currentIdentity & ": SelectedComponent GetSelectedObjectCount2"
3364         selectedCount = doc.SelectionManager.GetSelectedObjectCount2(-1)
    stepLabel = currentIdentity & ": SelectedComponent GetSelectedObjectsComponent4"
3366         If selectedCount > 0 Then Set handle = doc.SelectionManager.GetSelectedObjectsComponent4(1, -1)
3367         If Err.Number <> 0 Then
3368             If Len(tried) > 0 Then tried = tried & " | "
3369             tried = tried & forms(i) & " raised (Err " & CStr(Err.Number) & " " & Err.Description & ")"
3370             Err.Clear
3371             Set handle = Nothing
        Else
3373             If Len(tried) > 0 Then tried = tried & " | "
3374             tried = tried & forms(i) & ": SelectByID2 returned " & CStr(returned) & ", " & CStr(selectedCount) & " selected, GetSelectedObjectsComponent4 gave " & IIf(handle Is Nothing, "nothing", "a component")
        End If
3376         On Error GoTo 0
3377         If Not handle Is Nothing Then
    stepLabel = currentIdentity & ": SelectedComponent ClearSelection2"
3379             doc.ClearSelection2 True
3380             Set SelectedComponent = handle
3381             note = "selected as " & forms(i) & ": SelectByID2 returned " & CStr(returned) & ", " & CStr(selectedCount) & " selected, GetSelectedObjectsComponent4 gave a component"
3382             Exit Function
        End If
    Next i
    stepLabel = currentIdentity & ": SelectedComponent ClearSelection2"
3386     doc.ClearSelection2 True
3387     note = "no selection gave a component (" & tried & ")"
