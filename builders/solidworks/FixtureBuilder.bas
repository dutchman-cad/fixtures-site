Private Function FindChild(ByVal component As Object, ByVal localName As String, ByVal route As Long, ByRef matches As Long) As Object
    ' The child of `component` named localName, found by a route: 0 IComponent2.GetChildren of the instance the build kept, 1 GetChildren of the top-level
    ' instance found again in the top assembly by name, 2 IAssemblyDoc.GetComponentByName with the path form ("pair2-1/pin-1"), 3 the top assembly's
    ' component tree (GetComponents(False)). SolidWorks 2021 (field 2026.11.24.4): the handles of route 0 read the subassembly document's own LOCAL
    ' transform and box, so moving them moved nothing in the top assembly. matches is how many children carry the name.
    Dim children As Variant, child As Variant, suffix As String, found As Object, topInstance As Object, parentName As String
    Dim i As Long, lower As Long, upper As Long, nameText As String
5502     matches = 0
    stepLabel = currentIdentity & ": FindChild Name2"
5504     parentName = CStr(component.Name2)
5505     If route = 2 Then
    stepLabel = currentIdentity & ": FindChild GetComponentByName"
5507         Set found = AssemblyDocument(doc).GetComponentByName(parentName & "/" & localName)
5508         If Not found Is Nothing Then matches = 1
5509         Set FindChild = found
5510         Exit Function
    End If
5512     If route = 0 Then
    stepLabel = currentIdentity & ": FindChild GetChildren"
5514         children = component.GetChildren()
    ElseIf route = 1 Then
    stepLabel = currentIdentity & ": FindChild GetComponentByName"
5517         Set topInstance = AssemblyDocument(doc).GetComponentByName(parentName)
    stepLabel = currentIdentity & ": FindChild GetChildren"
5519         If Not topInstance Is Nothing Then children = topInstance.GetChildren()
    Else
    stepLabel = currentIdentity & ": FindChild GetComponents"
5522         children = AssemblyDocument(doc).GetComponents(False)
    End If
5524     If ArrayItems(children, lower, upper) Then
5525         For i = lower To upper
5526             Set child = children(i)
5527             If ReadName2(child, nameText) Then
5528                 If route = 3 Then
5529                     If nameText = parentName & "/" & localName Then
5530                         matches = matches + 1
5531                         Set found = child
                    End If
                Else
5534                     suffix = nameText
5535                     If InStrRev(suffix, "/") > 0 Then suffix = Mid$(suffix, InStrRev(suffix, "/") + 1)
5536                     If suffix = localName Then
5537                         matches = matches + 1
5538                         Set found = child
                    End If
                End If
            End If
        Next i
    End If
5544     Set FindChild = found
End Function

Private Function LocateComponent(ByVal path As String, Optional ByVal route As Long = -1) As Object
    ' The component an answer-key path ("mid/pair/block") names: the top-level label, then each subassembly's localName instance name found among
    ' its children by a route (FindChild): by default the route a dragged part was found by (childRoutes), else 0.
    Dim labels As Variant, i As Long, component As Object, file As String, localName As String
    Dim matches As Long, found As Object, topLabel As String, instanceNumber As Long, instances As Variant
5552     If route < 0 Then
5553         route = 0
    stepLabel = currentIdentity & ": LocateComponent Exists"
5555         If childRoutes.Exists(path) Then route = childRoutes(path)
    End If
5557     labels = Split(path, "/")
5558     topLabel = CStr(labels(0))
5559     instanceNumber = 1
5560     If InStr(topLabel, "#") > 0 Then
        ' pair#2 is the second instance of a component pattern (the seed is #1)
5562         instanceNumber = CLng(Mid$(topLabel, InStr(topLabel, "#") + 1))
5563         topLabel = Left$(topLabel, InStr(topLabel, "#") - 1)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5566     If Not components.Exists(topLabel) Then Err.Raise 5, , "No component " & topLabel & " in the assembly"
5567     Set component = components(topLabel)
5568     If instanceNumber > 1 Then
    stepLabel = currentIdentity & ": LocateComponent Exists"
5570         If Not patternInstances.Exists(topLabel) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5571         instances = patternInstances(topLabel)
5572         If instanceNumber - 2 > UBound(instances) Then Err.Raise 5, , "Component " & topLabel & " has no pattern instance " & CStr(instanceNumber)
5573         Set component = instances(instanceNumber - 2)
    End If
    stepLabel = currentIdentity & ": LocateComponent Exists"
5576     If fileOfLabel.Exists("|" & topLabel) Then file = fileOfLabel("|" & topLabel)
5577     For i = 1 To UBound(labels)
    stepLabel = currentIdentity & ": LocateComponent Exists"
5579         If Not localNames.Exists(file & "|" & CStr(labels(i))) Then Err.Raise 5, , "Subassembly " & file & " has no component " & CStr(labels(i))
5580         localName = localNames(file & "|" & CStr(labels(i)))
5581         Set found = FindChild(component, localName, route, matches)
    stepLabel = currentIdentity & ": LocateComponent Name2"
5583         If matches <> 1 Then Err.Raise 5, , CStr(matches) & " children of " & CStr(component.Name2) & " are named " & localName
5584         Set component = found
    stepLabel = currentIdentity & ": LocateComponent Exists"
5586         If fileOfLabel.Exists(file & "|" & CStr(labels(i))) Then file = fileOfLabel(file & "|" & CStr(labels(i))) Else file = ""
    Next i
5588     Set LocateComponent = component
End Function

Private Sub NoteFlexibleChild(ByVal path As String, ByVal component As Object, ByRef position As Variant)
    ' Only for a part a `move` dragged (MoveComponent kept its GetTotalTransform t0 and box center b0). If GetTotalTransform now disagrees in X or Y by
    ' more than 0.01 mm with t0 + (box center now - b0), X/Y are judged by that, Z stays (placement-flexible-box). position is in mm.
    Dim saved As Variant, t0 As Variant, b0 As Variant, centre As Variant, expected As Variant
    stepLabel = currentIdentity & ": NoteFlexibleChild Exists"
5596     If Not movedParts.Exists(path) Then Exit Sub
5597     saved = movedParts(path)
5598     t0 = saved(0)
5599     b0 = saved(1)
5600     On Error Resume Next
5601     centre = BoxCentre(component)
5602     If Err.Number <> 0 Then Exit Sub
5603     If Not IsArray(centre) Then Exit Sub
5604     expected = Array(CDbl(t0(0)) + CDbl(centre(0)) - CDbl(b0(0)), CDbl(t0(1)) + CDbl(centre(1)) - CDbl(b0(1)), CDbl(t0(2)) + CDbl(centre(2)) - CDbl(b0(2)))
5605     NoteOption "placement " & path & " (moved part): GetTotalTransform (" & NoteList(position) & ") mm, box center (" & NoteList(centre) & ") mm, before the move (" & NoteList(t0) & ") and (" & NoteList(b0) & "), so the part is at (" & NoteList(expected) & ")"
5606     If Abs(CDbl(expected(0)) - CDbl(position(0))) > 0.01 Or Abs(CDbl(expected(1)) - CDbl(position(1))) > 0.01 Then
5607         RecordMitigation "placement-flexible-box"
5608         NoteOption "placement " & path & ": GetTotalTransform misreports a flexible child; X/Y judged by the box center"
5609         position = Array(CDbl(expected(0)), CDbl(expected(1)), CDbl(position(2)))
    End If
5611     Err.Clear
End Sub

Private Sub CheckPlacement(ByVal path As String, ByVal t As Variant, ByVal rotation As Variant, ByVal scoreT As Boolean, ByVal scoreR As Boolean)
    ' Round 19: the world transform of one leaf instance against expect.json (t 0.01 mm, R 1e-4). ArrayData is row-vector: array row i is
    ' the world image of local axis i, so R(i, j) = values(3 * j + i). A mismatch is a problem for the report, never an error.
    Dim component As Object, values As Variant, position As Variant, i As Long, j As Long, worst As Double, worstSame As Double, worstFlipped As Double, reason As String
5618     On Error Resume Next
5619     SettleRoute path
5620     Err.Clear
5621     Set component = LocateComponent(path)
    stepLabel = currentIdentity & ": CheckPlacement GetTotalTransform"
5623     If Err.Number = 0 Then values = component.GetTotalTransform(True).ArrayData
5624     If Err.Number <> 0 Then reason = Err.Description
5625     On Error GoTo 0
5626     If Len(reason) > 0 Or component Is Nothing Then
5627         AddPlacementProblem path & ": cannot read it (" & reason & ")"
5628         Exit Sub
    End If
5630     placementChecked = placementChecked + 1
5631     position = Array(CDbl(values(9)) * 1000#, CDbl(values(10)) * 1000#, CDbl(values(11)) * 1000#)
5632     NoteFlexibleChild path, component, position
5633     If scoreT Then
5634         For i = 0 To 2
5635             If Abs(CDbl(position(i)) - CDbl(t(i))) > worst Then worst = Abs(CDbl(position(i)) - CDbl(t(i)))
        Next i
5637         If worst > 0.01 Then AddPlacementProblem path & ": t = (" & NoteList(position) & ") mm, expected (" & NoteList(t) & ")"
    End If
5639     If scoreR Then
5640         For i = 0 To 2
5641             For j = 0 To 2
5642                 If Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j))) > worstSame Then worstSame = Abs(CDbl(values(3 * j + i)) - CDbl(rotation(3 * i + j)))
5643                 If Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j))) > worstFlipped Then worstFlipped = Abs(CDbl(values(3 * i + j)) - CDbl(rotation(3 * i + j)))
            Next j
        Next i
5646         If worstSame > 0.0001 Then AddPlacementProblem path & ": R differs from expect.json by " & NoteNumber(worstSame) & IIf(worstFlipped <= 0.0001, " (it matches when read the other way round)", "")
    End If
End Sub

