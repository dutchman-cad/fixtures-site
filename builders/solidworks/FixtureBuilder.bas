Private Function BaseFlangeSide(ByVal axisIndex As Long, ByVal side As Long, ByVal origin As Double, ByVal depth As Double, ByRef near As Double, ByRef far As Double) As String
    ' "ok", "wrong" (the thickness is on the other side of the sketch) or "other", with the measured extent in mm.
7489     near = MeasuredExtreme(axisIndex, -side)
7490     far = MeasuredExtreme(axisIndex, side)
7491     If Abs(near - origin) <= 0.001 And Abs(far - (origin + side * depth)) <= 0.001 Then
7492         BaseFlangeSide = "ok"
    ElseIf Abs(far - origin) <= 0.001 And Abs(near - (origin - side * depth)) <= 0.001 Then
7494         BaseFlangeSide = "wrong"
    Else
7496         BaseFlangeSide = "other"
    End If
End Function

Private Sub BaseFlangeRefuse(ByVal near As Double, ByVal far As Double, ByVal origin As Double)
7501     Err.Raise 5, , "Base flange thickness is not on the requested side of its sketch: extent " & NumberList(Array(near, far)) & " mm, sketch plane at " & NumberList(Array(origin)) & " mm (" & callInputs & ")"
