Private Sub BuildDrawing(ByVal modelId As String, ByVal low As Variant, ByVal high As Variant, ByVal dims As Variant, ByVal layout As Variant)
    ' D05a: sheet 1:1, base view, two projected views, each linear dimension on the view edges its model
    ' points project to, then a read-back of every dimension in the drawing. layout: the three view
    ' positions (x, y pairs) and the dimension text step, meters.
    Dim sheetObject As Object, views(2) As Object, labels As Variant, axes(2) As Long, k As Long, index As Long
    Dim cacheRecords(2) As Collection, cacheDrop(2) As Long, cacheSpace(2) As String, cacheDone(2) As Boolean
    Dim dimensionItem As Variant, plan As Collection, chosenView As Long, activeView As Object, outline As Variant
    Dim expected() As Double, measured As Double, text As String, viewText As String
8762     Set drawingInterface = DrawingDocument(doc)
    stepLabel = currentIdentity & ": BuildDrawing GetCurrentSheet"
8764     Set sheetObject = drawingInterface.GetCurrentSheet()
8765     Require sheetObject, "The new drawing has no current sheet"
8766     callInputs = "Numerator=1 Denominator=1"
    stepLabel = currentIdentity & ": BuildDrawing SetScale"
8768     If Not sheetObject.SetScale(1#, 1#, False, False) Then Err.Raise 5, , "ISheet.SetScale(1, 1) failed: " & callInputs
8769     labels = Array("base", "vertical", "beside")
8770     Set views(0) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "*Top", "base", layout(0), layout(1), Nothing)
8771     Set views(1) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "", "vertical", layout(2), layout(3), views(0))
8772     Set views(2) = DrawingView(currentFolder & "\" & modelId & ".sldprt", "", "beside", layout(4), layout(5), views(0))
8773     For k = 0 To 2
8774         Set activeView = views(k)
8775         axes(k) = ViewDrop(activeView)
8776         If Len(viewText) > 0 Then viewText = viewText & ", "
    stepLabel = currentIdentity & ": BuildDrawing GetName2"
8778         viewText = viewText & labels(k) & " " & activeView.GetName2() & " looks along " & Mid$("XYZ", axes(k) + 1, 1)
    Next k
8780     If axes(0) <> 1 Or axes(1) <> 2 Then Err.Raise 5, , "The views look along the wrong axes (" & viewText & "; the L is seen along Y and the hole along Z)"
8781     AppendLog currentFolder, currentIdentity, "option", 0, 0, "drawing: sheet scale 1:1, views " & viewText
8782     ReDim expected(UBound(dims))
8783     For index = 0 To UBound(dims)
8784         dimensionItem = dims(index)
8785         expected(index) = CDbl(dimensionItem(0))
8786         chosenView = -1
8787         For k = 0 To 2
8788             If Not cacheDone(k) Then
8789                 Set activeView = views(k)
8790                 Set cacheRecords(k) = DrawingEdges(activeView, low, high, cacheDrop(k), cacheSpace(k))
8791                 cacheDone(k) = True
            End If
8793             Set plan = DimensionPlan(cacheRecords(k), FlatPoint(dimensionItem(1), cacheDrop(k)), FlatPoint(dimensionItem(2), cacheDrop(k)))
8794             If Not plan Is Nothing Then
8795                 chosenView = k
8796                 Exit For
