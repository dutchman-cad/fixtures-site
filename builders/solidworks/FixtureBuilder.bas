Private Function NewComponents(ByVal before As Object) As Variant
    ' The top-level components that were not there before, ordered by the number at the end of their instance name. Handles whose Name2 cannot be read
    ' are skipped (and logged); an empty answer gives an empty array.
    Dim all As Variant, item As Object, found() As Object, count As Long, i As Long, j As Long, holder As Object
    Dim lower As Long, upper As Long, nameText As String, unreadable As Long, reason As String
    stepLabel = currentIdentity & ": NewComponents GetComponents"
4142     all = AssemblyDocument(doc).GetComponents(True)
4143     If ArrayItems(all, lower, upper) Then
4144         For i = lower To upper
4145             If Not ItemAt(all, i, item, nameText) Then
4146                 unreadable = unreadable + 1
4147                 reason = nameText
            ElseIf ReadName2(item, nameText) Then
    stepLabel = currentIdentity & ": NewComponents Exists"
4150                 If Not before.Exists(nameText) Then
4151                     ReDim Preserve found(count)
4152                     Set found(count) = item
4153                     count = count + 1
                End If
            Else
4156                 unreadable = unreadable + 1
4157                 reason = nameText
            End If
        Next i
    End If
4161     If unreadable > 0 Then NoteOption CStr(unreadable) & " top-level component handle(s) have no readable Name2: " & reason
4162     If count = 0 Then
4163         NewComponents = Array()
4164         Exit Function
    End If
4166     For i = 0 To count - 2
4167         For j = 0 To count - 2 - i
4168             If InstanceSuffix(found(j)) > InstanceSuffix(found(j + 1)) Then
4169                 Set holder = found(j)
4170                 Set found(j) = found(j + 1)
4171                 Set found(j + 1) = holder
            End If
        Next j
    Next i
4175     NewComponents = found
End Function

Private Function InstanceSuffix(ByVal component As Object) As Long
    Dim text As String
4180     If Not ReadName2(component, text) Then Exit Function
4181     text = Mid$(text, InStrRev(text, "-") + 1)
4182     If IsNumeric(text) Then InstanceSuffix = CLng(text)
End Function

Private Function FilletAxis(ByVal component As Object, ByRef direction As Variant) As Variant
    ' The rounded corner's fillet axis of the part the component is, in the top assembly (meters): the first cylindrical face of the part document's solid
    ' body (IFace2.GetSurface -> ISurface.CylinderParams: origin xyz, axis xyz, radius), carried by the component's world transform. Read from the part
    ' itself, so a part that was copied unmirrored shows it. The direction is returned in `direction`.
    Dim model As Object, bodies As Variant, body As Variant, faces As Variant, face As Variant, surface As Object, params As Variant, total As Variant, j As Long
    Dim point(2) As Double, axisDirection(2) As Double, paramLower As Long, paramUpper As Long, totalLower As Long, totalUpper As Long
    stepLabel = currentIdentity & ": FilletAxis GetModelDoc2"
4192     Set model = component.GetModelDoc2()
4193     Require model, "The mirrored part document is not loaded"
    stepLabel = currentIdentity & ": FilletAxis GetBodies2"
4195     bodies = PartDocument(model).GetBodies2(swSolidBody, True)
4196     If IsArray(bodies) Then
4197         For Each body In bodies
    stepLabel = currentIdentity & ": FilletAxis GetFaces"
4199             faces = body.GetFaces()
4200             If IsArray(faces) Then
4201                 For Each face In faces
    stepLabel = currentIdentity & ": FilletAxis GetSurface"
4203                     Set surface = face.GetSurface()
4204                     Require surface, "A face of the part has no surface"
    stepLabel = currentIdentity & ": FilletAxis IsCylinder"
4206                     If surface.IsCylinder() Then
    stepLabel = currentIdentity & ": FilletAxis CylinderParams"
4208                         params = surface.CylinderParams
    stepLabel = currentIdentity & ": FilletAxis Name2"
4210                         If Not ArrayItems(params, paramLower, paramUpper) Then Err.Raise 5, , "CylinderParams of a face of " & CStr(component.Name2) & " answered no array"
    stepLabel = currentIdentity & ": FilletAxis Name2"
4212                         If paramUpper - paramLower < 5 Then Err.Raise 5, , "CylinderParams of a face of " & CStr(component.Name2) & " answered " & CStr(paramUpper - paramLower + 1) & " numbers, not 7"
    stepLabel = currentIdentity & ": FilletAxis GetTotalTransform"
4214                         total = component.GetTotalTransform(True).ArrayData
    stepLabel = currentIdentity & ": FilletAxis Name2"
4216                         If Not ArrayItems(total, totalLower, totalUpper) Then Err.Raise 5, , "GetTotalTransform of " & CStr(component.Name2) & " answered no array"
    stepLabel = currentIdentity & ": FilletAxis Name2"
4218                         If totalUpper - totalLower < 12 Then Err.Raise 5, , "GetTotalTransform of " & CStr(component.Name2) & " answered " & CStr(totalUpper - totalLower + 1) & " numbers, not 16"
4219                         For j = 0 To 2
4220                             point(j) = (CDbl(params(paramLower)) * CDbl(total(totalLower + j)) + CDbl(params(paramLower + 1)) * CDbl(total(totalLower + 3 + j)) + CDbl(params(paramLower + 2)) * CDbl(total(totalLower + 6 + j))) * CDbl(total(totalLower + 12)) + CDbl(total(totalLower + 9 + j))
4221                             axisDirection(j) = CDbl(params(paramLower + 3)) * CDbl(total(totalLower + j)) + CDbl(params(paramLower + 4)) * CDbl(total(totalLower + 3 + j)) + CDbl(params(paramLower + 5)) * CDbl(total(totalLower + 6 + j))
                        Next j
4223                         direction = Array(axisDirection(0), axisDirection(1), axisDirection(2))
4224                         FilletAxis = Array(point(0), point(1), point(2))
4225                         Exit Function
                    End If
                Next face
            End If
        Next body
    End If
    stepLabel = currentIdentity & ": FilletAxis Name2"
4232     Err.Raise 5, , "The part " & CStr(component.Name2) & " has no cylindrical face to find its rounded corner by"
End Function

Private Function MirrorGeometryProblem(ByVal newComponent As Object, ByVal originalComponent As Object, ByVal axisIndex As Long, ByVal offset As Double) As String
    ' "" when the rounded corner of the new component lies at the mirror image (about the plane at offset, meters, along axisIndex) of the original's, else
    ' what was found. The fillet's axis is compared except along itself; 0.5 mm.
    Dim before As Variant, after As Variant, direction As Variant, other As Variant, wanted(2) As Double, size As Double, along As Double, worst As Double, i As Long
    Dim gap(2) As Double
4240     before = FilletAxis(originalComponent, direction)
4241     after = FilletAxis(newComponent, other)
4242     For i = 0 To 2
4243         wanted(i) = CDbl(before(i))
    Next i
4245     wanted(axisIndex) = 2# * offset - CDbl(before(axisIndex))
4246     size = Sqr(CDbl(direction(0)) ^ 2 + CDbl(direction(1)) ^ 2 + CDbl(direction(2)) ^ 2)
4247     For i = 0 To 2
4248         gap(i) = CDbl(after(i)) - wanted(i)
4249         along = along + gap(i) * CDbl(direction(i)) / size
    Next i
4251     For i = 0 To 2
4252         If Abs(gap(i) - along * CDbl(direction(i)) / size) > worst Then worst = Abs(gap(i) - along * CDbl(direction(i)) / size)
    Next i
4254     If worst > 0.0005 Then MirrorGeometryProblem = "the rounded corner of " & CStr(newComponent.Name2) & " is at (" & NoteList(Array(CDbl(after(0)) * 1000#, CDbl(after(1)) * 1000#, CDbl(after(2)) * 1000#)) & ") mm, the mirror image of the original is at (" & NoteList(Array(wanted(0) * 1000#, wanted(1) * 1000#, wanted(2) * 1000#)) & ")"
End Function

