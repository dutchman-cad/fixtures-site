Private Function DrawingEdges(ByVal view As Object, ByVal low As Variant, ByVal high As Variant, ByRef drop As Long, ByRef spaceName As String, Optional ByVal components As Variant, Optional ByVal assemblyName As String) As Collection
    ' The view's visible line and circle edges, flattened along its axis, in model meters. Entity
    ' coordinates are taken as model coordinates; if they do not all lie inside the model's box they
    ' are tried as view coordinates, and if that fails too the recipe fails. An assembly's view is read component by component (AddAssemblyEdges).
    Dim matrix As Variant, raw As Variant, found As Collection, record As Object
    Dim convert As Long, ok As Boolean, chosen As Long, viewName As String, axis As Variant, size As Double
    stepLabel = currentIdentity & ": DrawingEdges GetName2"
8415     viewName = view.GetName2()
    stepLabel = currentIdentity & ": DrawingEdges ArrayData"
8417     matrix = view.ModelToViewTransform.ArrayData
8418     drop = ViewDrop(view)
8419     Set found = New Collection
8420     If IsArray(components) Then
8421         AddAssemblyEdges view, components, found, assemblyName
    Else
    stepLabel = currentIdentity & ": DrawingEdges GetVisibleEntities2"
8424         raw = view.GetVisibleEntities2(Nothing, swViewEntityType_Edge)
8425         If Not IsArray(raw) Then Err.Raise 5, , viewName & ": GetVisibleEntities2 returned no edges"
8426         AddEdgeRecords found, raw
    End If
    stepLabel = currentIdentity & ": DrawingEdges Count"
8429     If found.Count = 0 Then Err.Raise 5, , viewName & ": none of its visible edges is a line or a circle"
8430     chosen = -1
8431     For convert = 0 To 1
8432         ok = True
8433         For Each record In found
8434             If Not InsideBox(RecordPoint(record, "p0", convert, matrix), low, high) Then ok = False
8435             If record("kind") = "line" Then
8436                 If Not InsideBox(RecordPoint(record, "p1", convert, matrix), low, high) Then ok = False
            End If
        Next record
8439         If ok Then
8440             chosen = convert
8441             Exit For
        End If
    Next convert
8444     If chosen < 0 Then Err.Raise 5, , viewName & ": the visible edge points lie outside the model box as model coordinates and as view coordinates (transform " & NumberList(matrix) & ")"
8445     spaceName = IIf(chosen = 0, "model", "view")
8446     For Each record In found
8447         record("a") = FlatPoint(RecordPoint(record, "p0", chosen, matrix), drop)
8448         If record("kind") = "line" Then record("b") = FlatPoint(RecordPoint(record, "p1", chosen, matrix), drop)
8449         If record("kind") = "circle" Then
            ' The circle's axis in model space (a view-space axis is only rotated), and whether the view looks straight down it: then it shows as a
            ' circle; otherwise (edge-on) as a straight line through its center, 2 x radius long.
8452             axis = record("axis")
8453             If chosen = 1 Then axis = RotateToModel(matrix, axis)
            ' faceOn: 1 the view looks down the axis, 0 the axis lies across the view, -1 unknown (a zero or non-unit axis, or one at an angle).
8455             size = Sqr(CDbl(axis(0)) * CDbl(axis(0)) + CDbl(axis(1)) * CDbl(axis(1)) + CDbl(axis(2)) * CDbl(axis(2)))
8456             If Abs(size - 1#) > 0.000001 Then
8457                 record("faceOn") = -1
            ElseIf Abs(Abs(CDbl(axis(drop))) - 1#) <= 0.000001 Then
8459                 record("faceOn") = 1
            ElseIf Abs(CDbl(axis(drop))) <= 0.000001 Then
8461                 record("faceOn") = 0
            Else
8463                 record("faceOn") = -1
            End If
8465             record("flatAxis") = FlatPoint(axis, drop)
        End If
    Next record
8468     Set DrawingEdges = found
End Function

Private Function PlanSingle(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Object
    ' A line whose two ends are the two points: selecting it alone dimensions its length.
    Dim record As Object
8474     For Each record In records
8475         If record("kind") = "line" Then
8476             If (NearFlat(record("a"), first) And NearFlat(record("b"), second)) Or (NearFlat(record("a"), second) And NearFlat(record("b"), first)) Then
8477                 Set PlanSingle = record
8478                 Exit Function
            End If
        End If
    Next record
End Function

Private Function CloneRecord(ByVal record As Object, ByVal rung As String) As Object
    ' A copy of an edge record marked with the mitigation name of the plan form that uses it (the cached record itself stays unmarked).
    Dim copy As Object, key As Variant
8487     Set copy = CreateObject("Scripting.Dictionary")
    stepLabel = currentIdentity & ": CloneRecord Keys"
8489     For Each key In record.Keys
8490         If IsObject(record(key)) Then
8491             Set copy(key) = record(key)
        Else
8493             copy(key) = record(key)
        End If
    Next key
8496     copy("rung") = rung
8497     Set CloneRecord = copy
End Function

Private Function PlanDiameter(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant, ByVal length As Double) As Object
    ' A circle seen face-on whose diameter the two points are the ends of: selecting it alone makes IModelDoc2.AddDimension2 add a diameter dimension.
    Dim record As Object, centre As Variant
8503     For Each record In records
8504         If record("kind") = "circle" Then
8505             If record("faceOn") = 1 Then
8506                 centre = record("a")
8507                 If Abs(2# * CDbl(record("radius")) - length) <= 0.000001 And Abs(CDbl(centre(0)) - (first(0) + second(0)) / 2#) <= 0.000001 _
                   And Abs(CDbl(centre(1)) - (first(1) + second(1)) / 2#) <= 0.000001 Then
8509                     Set PlanDiameter = CloneRecord(record, "drawing-dimension-circle-diameter")
8510                     Exit Function
                End If
            End If
        End If
    Next record
End Function

Private Function PlanLine(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A line through the point that is perpendicular to the measuring direction.
    Dim record As Object, a As Variant, b As Variant, runX As Double, runY As Double, size As Double, along As Double, off As Double
8520     For Each record In records
8521         If record("kind") = "line" Then
8522             a = record("a")
8523             b = record("b")
8524             runX = b(0) - a(0)
8525             runY = b(1) - a(1)
8526             size = Sqr(runX * runX + runY * runY)
8527             If size > 0.000000001 Then
8528                 If Abs(runX * ux + runY * uy) <= 0.000001 * size Then
8529                     along = ((point(0) - a(0)) * runX + (point(1) - a(1)) * runY) / (size * size)
8530                     off = Abs((point(0) - a(0)) * runY - (point(1) - a(1)) * runX) / size
8531                     If along >= -0.000000001 And along <= 1.000000001 And off <= 0.000001 Then
8532                         Set PlanLine = record
8533                         Exit Function
                    End If
                End If
            End If
        End If
    Next record
End Function

Private Function PlanReference(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle centered on the point, else a line through it that is perpendicular to the measuring direction (D05a's own choice, tried first).
    Dim record As Object
8544     For Each record In records
8545         If record("kind") = "circle" Then
8546             If NearFlat(record("a"), point) Then
8547                 Set PlanReference = record
8548                 Exit Function
            End If
        End If
    Next record
8552     Set PlanReference = PlanLine(records, point, ux, uy)
End Function

Private Function PlanRim(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle seen edge-on (its axis known to lie across the view) is the straight line through its center, 2 x radius long, perpendicular to its axis: it
    ' is a reference when the point is on that line and the measuring direction is the axis's own.
    Dim record As Object, axisFlat As Variant, centre As Variant, runX As Double, runY As Double
8559     For Each record In records
8560         If record("kind") = "circle" Then
8561             If record("faceOn") = 0 Then
8562                 centre = record("a")
8563                 axisFlat = record("flatAxis")
8564                 runX = point(0) - centre(0)
8565                 runY = point(1) - centre(1)
8566                 If Abs(-axisFlat(1) * ux + axisFlat(0) * uy) <= 0.000001 And Abs(runX * axisFlat(0) + runY * axisFlat(1)) <= 0.000001 _
                   And Abs(-runX * axisFlat(1) + runY * axisFlat(0)) <= CDbl(record("radius")) + 0.000000001 Then
8568                     Set PlanRim = CloneRecord(record, "drawing-dimension-edge-on-circles")
8569                     Exit Function
                End If
            End If
        End If
    Next record
End Function

Private Function DimensionPlan(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Collection
    ' The one or two edges whose selection makes SolidWorks measure the distance between two flattened points, or Nothing when the view cannot show
    ' it. D05a's own plan (a line, or two references) is tried first; the diameter and edge-on forms only when it finds nothing.
    Dim lineRecord As Object, one As Object, two As Object, dx As Double, dy As Double, length As Double
8580     dx = second(0) - first(0)
8581     dy = second(1) - first(1)
8582     length = Sqr(dx * dx + dy * dy)
8583     If length < 0.000000001 Then Err.Raise 5, , "The two dimension points coincide in the view"
8584     Set lineRecord = PlanSingle(records, first, second)
8585     If Not lineRecord Is Nothing Then
8586         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8588         DimensionPlan.Add lineRecord
8589         Exit Function
    End If
8591     Set one = PlanReference(records, first, dx / length, dy / length)
8592     Set two = PlanReference(records, second, dx / length, dy / length)
8593     If Not one Is Nothing And Not two Is Nothing Then
8594         If Not one Is two Then
8595             Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8597             DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8599             DimensionPlan.Add two
8600             Exit Function
        End If
    End If
8603     Set lineRecord = PlanDiameter(records, first, second, length)
8604     If Not lineRecord Is Nothing Then
8605         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8607         DimensionPlan.Add lineRecord
8608         Exit Function
    End If
8610     Set one = PlanRim(records, first, dx / length, dy / length)
8611     Set two = PlanRim(records, second, dx / length, dy / length)
8612     If one Is Nothing And two Is Nothing Then Exit Function
8613     If one Is Nothing Then Set one = PlanReference(records, first, dx / length, dy / length)
8614     If two Is Nothing Then Set two = PlanReference(records, second, dx / length, dy / length)
8615     If one Is Nothing Or two Is Nothing Then Exit Function
8616     If one("entity") Is two("entity") Then Exit Function
8617     Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8619     DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8621     DimensionPlan.Add two
End Function

