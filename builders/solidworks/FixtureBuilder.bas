Private Function ViewDrop(ByVal view As Object) As Long
    ' The model axis a drawing view looks along: the z column of its model-to-view rotation (row-vector
    ' convention). Round 8 (field, 34.4.0): the view beside the Top view has the rows (0,0,1), (-1,0,0),
    ' (0,-1,0), so its z column names X and its z row Y; the rotation only has to be a signed axis
    ' permutation (one +-1 and two zeros in every row and column, within 1e-9). A tilted view fails.
    Dim matrix As Variant, i As Long, j As Long, first As Long, ones As Long, zeros As Long, value As Double
    stepLabel = currentIdentity & ": ViewDrop ArrayData"
8148     matrix = view.ModelToViewTransform.ArrayData
8149     If Not MatrixUsable(matrix) Then Err.Raise 5, , "The drawing view transform is not a rotation"
8150     first = LBound(matrix)
8151     For i = 0 To 5
8152         ones = 0
8153         zeros = 0
8154         For j = 0 To 2
8155             If i < 3 Then
8156                 value = CDbl(matrix(first + 3 * i + j))
            Else
8158                 value = CDbl(matrix(first + 3 * j + (i - 3)))
            End If
8160             If Abs(Abs(value) - 1#) <= 0.000000001 Then ones = ones + 1
8161             If Abs(value) <= 0.000000001 Then zeros = zeros + 1
        Next j
8163         If ones <> 1 Or zeros <> 2 Then Err.Raise 5, , "The drawing view is not an axis-aligned view: its rotation is not a signed axis permutation: " & NumberList(matrix)
    Next i
8165     For i = 0 To 2
8166         If Abs(CDbl(matrix(first + 3 * i + 2))) > 0.5 Then ViewDrop = i
    Next i
End Function

Private Function ViewToModel(ByVal matrix As Variant, ByVal point As Variant) As Variant
    ' Undo IView.ModelToViewTransform: view = (model x R) * scale + t, R orthonormal.
    Dim first As Long, i As Long, j As Long, v(2) As Double, result(2) As Double
8173     first = LBound(matrix)
8174     For j = 0 To 2
8175         v(j) = (CDbl(point(j)) - CDbl(matrix(first + 9 + j))) / CDbl(matrix(first + 12))
    Next j
8177     For i = 0 To 2
8178         For j = 0 To 2
8179             result(i) = result(i) + v(j) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
8182     ViewToModel = Array(result(0), result(1), result(2))
End Function

Private Function RotateToModel(ByVal matrix As Variant, ByVal axis As Variant) As Variant
    ' A direction from view space to model space: the rotation of ViewToModel only, no scale and no translation.
    Dim first As Long, i As Long, j As Long, result(2) As Double
8188     first = LBound(matrix)
8189     For i = 0 To 2
8190         For j = 0 To 2
8191             result(i) = result(i) + CDbl(axis(j)) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
8194     RotateToModel = Array(result(0), result(1), result(2))
End Function

Private Function FlatPoint(ByVal point As Variant, ByVal drop As Long) As Variant
