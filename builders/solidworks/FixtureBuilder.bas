8414             If (NearFlat(record("a"), first) And NearFlat(record("b"), second)) Or (NearFlat(record("a"), second) And NearFlat(record("b"), first)) Then
8415                 Set PlanSingle = record
8416                 Exit Function
            End If
        End If
