Private Function BuildFlangeData(ByVal count As Long, ByVal angle As Double, ByVal height As Double, ByVal dimType As Long, ByVal positionType As Long, ByVal radius As Double, ByVal reliefMode As Long, ByVal reliefType As Long, ByVal reliefWidth As Double, ByVal reliefDepth As Double, ByVal cornerGap As Double, ByVal kFactor As Double, ByVal exampleOrder As Boolean, ByRef notes As String) As Object
    ' IEdgeFlangeFeatureData for the edge flange: CreateDefinition, AddEdges and the members, each put under its own guard whose failure is logged and
    ' returned in notes, and its answer read back. There is no Initialize on this interface: the members are set directly. exampleOrder puts them in the
    ' order of the API Help "Create Edge Flange" example (the radius first, the flange's own allowance fetched from the data with
    ' GetCustomBendAllowance); the other order is the builder's first one. count edges are in flangeEdges/flangeSketches (typed Object arrays: the API
    ' wants dispatch arrays). cornerGap >= 0 sets IEdgeFlangeFeatureData.GapDistance (several edges).
    Dim edges() As Object, sketches() As Object, edgeList As Variant, sketchList As Variant, i As Long
    Dim result As Long, flangeData As Object
7605     notes = ""
7606     ReDim edges(count - 1)
7607     ReDim sketches(count - 1)
7608     For i = 0 To count - 1
7609         Set edges(i) = flangeEdges(i)
7610         Set sketches(i) = flangeSketches(i)
    Next i
    stepLabel = currentIdentity & ": BuildFlangeData CreateDefinition" & " " & apiInputs & " " & callInputs
7613     Set flangeData = doc.FeatureManager.CreateDefinition(swFmEdgeFlange)
7614     Require flangeData, "CreateDefinition(swFmEdgeFlange) returned nothing"
7615     edgeList = edges
7616     sketchList = sketches
    stepLabel = currentIdentity & ": BuildFlangeData AddEdges"
7618     result = flangeData.AddEdges(edgeList, sketchList)
7619     EdgeNote "IEdgeFlangeFeatureData.AddEdges returned " & CStr(result) & " for " & CStr(count) & " edge(s)"
7620     If result <> 0 Then Err.Raise 5, , "IEdgeFlangeFeatureData.AddEdges returned swEdgeFlangeError_e " & CStr(result)
7621     If exampleOrder Then
7622         FlangeRadiusSteps flangeData, radius, notes
7623         FlangeGapStep flangeData, cornerGap, notes
7624         FlangeSizeSteps flangeData, angle, height, dimType, positionType, notes
7625         FlangeAllowanceSteps flangeData, kFactor, True, notes
7626         FlangeReliefSteps flangeData, reliefMode, reliefType, reliefWidth, reliefDepth, notes
    Else
7628         FlangeSizeSteps flangeData, angle, height, dimType, positionType, notes
7629         FlangeAllowanceSteps flangeData, kFactor, False, notes
7630         FlangeRadiusSteps flangeData, radius, notes
7631         FlangeReliefSteps flangeData, reliefMode, reliefType, reliefWidth, reliefDepth, notes
7632         FlangeGapStep flangeData, cornerGap, notes
    End If
