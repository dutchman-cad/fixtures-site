Private Sub RunProbes(ByVal index As Long, ByVal folder As String, ByVal started As Double, ByRef status As String, ByRef message As String, ByRef files As String)
    ' Probe mode: each candidate approach of the recipe is built in its own fresh document. The first that passes is saved (its files are
    ' the recipe's); the others are built only to record whether they pass. After the first success no probe starts once the recipe has
    ' used PROBE_SECONDS. probesJson / probeKept go into the recipe's results.json row.
    Dim count As Long, k As Long, itemName As String, failure As String, kept As Boolean, elapsed As Double, entry As String, summary As String
    Dim keptMitigations As Object, keptPrimary As Object, keptFallback As Object
1451     count = CandidateCount(index)
1452     probesJson = ""
1453     probeKept = ""
1454     status = "failed"
1455     For k = 1 To count
1456         itemName = CandidateName(index, k)
1457         elapsed = Timer - started
1458         If elapsed < 0 Then elapsed = elapsed + 86400#
1459         If kept And elapsed > PROBE_SECONDS Then
1460             failure = "skipped: the recipe had already used " & CStr(CLng(elapsed)) & " s (limit " & CStr(PROBE_SECONDS) & " s for probes after the first success)"
1461             entry = ProbeEntry(itemName, False, failure, "")
1462             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
        ElseIf crashedUnits.Exists(currentIdentity & "|" & itemName) Then
1464             failure = "crashed SolidWorks in " & CStr(crashedUnits(currentIdentity & "|" & itemName)) & " (skipped)"
1465             entry = ProbeEntry(itemName, False, failure, "")
1466             AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": " & failure
1467             If Len(summary) > 0 Then summary = summary & " | "
1468             summary = summary & itemName & ": " & failure
        Else
1470             probeCandidate = itemName
1471             If k > 1 Then
                ' The mitigation counters of a recipe are the kept candidate's (or the last one's when none passes).
1473                 Set mitigations = CreateObject("Scripting.Dictionary")
1474                 Set primaryFailures = CreateObject("Scripting.Dictionary")
1475                 Set fallbackSuccesses = CreateObject("Scripting.Dictionary")
            End If
1477             failure = TryAttempt(index, folder, Not kept)
1478             ReleaseAttempt folder
1479             ClearMarker folder
1480             probeCandidate = ""
1481             If Len(failure) = 0 Then
1482                 entry = ProbeEntry(itemName, True, "", probeNote)
1483                 AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": ok"
1484                 If Not kept Then
1485                     kept = True
1486                     probeKept = Left$(itemName, 60)
1487                     files = attemptFiles
1488                     Set keptMitigations = mitigations
1489                     Set keptPrimary = primaryFailures
1490                     Set keptFallback = fallbackSuccesses
                End If
            Else
1493                 entry = ProbeEntry(itemName, False, failure, probeNote)
1494                 AppendLog folder, currentIdentity, "probe", 0, 0, "probe " & currentIdentity & " candidate " & CStr(k) & " " & itemName & ": failed " & failure
1495                 If Len(summary) > 0 Then summary = summary & " | "
1496                 summary = summary & itemName & ": " & failure
1497                 If Not kept Then DeleteResultFiles folder, currentIdentity
            End If
        End If
1500         If k <= 20 Then
1501             If Len(probesJson) > 0 Then probesJson = probesJson & ","
1502             probesJson = probesJson & entry
        End If
    Next k
1505     If kept Then
1506         status = "ok"
1507         Set mitigations = keptMitigations
1508         Set primaryFailures = keptPrimary
1509         Set fallbackSuccesses = keptFallback
    Else
1511         message = "Every candidate failed: " & summary
    End If
End Sub

