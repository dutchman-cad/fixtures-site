Private Function ZipReady(ByVal zipPath As String) As Boolean
    ' The zip exists and holds something (an empty zip is 22 bytes).
    Dim fs As Object
745     On Error Resume Next
746     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipReady FileExists"
748     ZipReady = fs.FileExists(zipPath)
    stepLabel = currentIdentity & ": ZipReady GetFile"
750     If ZipReady Then ZipReady = (fs.GetFile(zipPath).Size > 22)
751     If Err.Number <> 0 Then ZipReady = False
752     Err.Clear
End Function

Private Function ZipErrorHead(ByVal errorFile As String) As String
    ' The first 300 characters of the PowerShell error file, one line, or "no error text".
    Dim fs As Object, stream As Object, text As String
758     On Error Resume Next
759     Set fs = CreateObject("Scripting.FileSystemObject")
760     If fs.FileExists(errorFile) Then
761         Set stream = fs.OpenTextFile(errorFile, 1)
762         text = stream.ReadAll
763         stream.Close
    End If
765     text = Trim$(Replace(Replace(text, vbCr, " "), vbLf, " "))
766     If Len(text) > 300 Then text = Left$(text, 300)
767     If Len(text) = 0 Then text = "no error text"
768     ZipErrorHead = PrivacyScrub(text)
769     Err.Clear
End Function

Private Sub ZipRemoveOld(ByVal folder As String)
    ' An old zip or error file of the same name (a manual Send to, an earlier run) never counts and is never shown.
    Dim fs As Object
775     On Error Resume Next
776     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipRemoveOld FileExists"
778     If fs.FileExists(folder & ".zip") Then fs.DeleteFile folder & ".zip", True
    stepLabel = currentIdentity & ": ZipRemoveOld FileExists"
780     If fs.FileExists(folder & "-zip-error.txt") Then fs.DeleteFile folder & "-zip-error.txt", True
781     Err.Clear
