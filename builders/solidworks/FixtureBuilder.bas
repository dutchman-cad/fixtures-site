1794     stream.Position = 0
1795     stream.Type = 1
1796     stream.Position = 3
1797     again = stream.Read
1798     stream.Close
1799     same = (UBound(again) = UBound(bytes))
1800     If same Then
1801         For i = 0 To UBound(bytes)
1802             If again(i) <> bytes(i) Then same = False: Exit For
        Next i
    End If
1805     SweepReencodes = same
End Function

Private Function SweepRead(ByVal path As String) As String
    ' The file as text, in the encoding it was written in (left in sweepEncoding): UTF-16 or UTF-8 with a byte-order mark, UTF-8 without
    ' one, else the ANSI codepage the builder's own log is written in. A file over 4 MB, NUL bytes without a UTF-16 mark, or any decode
    ' error raises: the caller counts that as a hit (truncate or delete), never as clean.
    Dim stream As Object, bytes As Variant, size As Long, text As String, i As Long, channel As Integer
1813     Set stream = CreateObject("ADODB.Stream")
1814     stream.Type = 1
1815     stream.Open
1816     stream.LoadFromFile path
1817     size = stream.Size
1818     If size > 4194304 Then Err.Raise 5, , "over the sweep size cap"
1819     If size = 0 Then
1820         stream.Close
1821         sweepEncoding = "utf-8"
1822         SweepRead = ""
1823         Exit Function
    End If
1825     bytes = stream.Read
1826     stream.Close
1827     If size >= 2 And bytes(0) = 255 And bytes(1) = 254 Then
1828         sweepEncoding = "utf-16-le-bom"
1829         SweepRead = SweepText(path, "unicode")
1830         Exit Function
    End If
1832     If size >= 2 And bytes(0) = 254 And bytes(1) = 255 Then
1833         sweepEncoding = "utf-16-be-bom"
1834         SweepRead = SweepText(path, "unicodeFFFE")
1835         Exit Function
    End If
1837     If size >= 3 Then
1838         If bytes(0) = 239 And bytes(1) = 187 And bytes(2) = 191 Then
1839             sweepEncoding = "utf-8-bom"
1840             SweepRead = SweepText(path, "utf-8")
1841             Exit Function
        End If
    End If
1844     For i = 0 To UBound(bytes)
1845         If bytes(i) = 0 Then Err.Raise 5, , "NUL bytes without a UTF-16 byte-order mark"
    Next i
1847     text = SweepText(path, "utf-8")
1848     If SweepReencodes(text, bytes) Then
1849         sweepEncoding = "utf-8"
1850         SweepRead = text
1851         Exit Function
    End If
1853     sweepEncoding = "ansi"
1854     channel = FreeFile
1855     Open path For Binary Access Read As #channel
1856     text = Space$(LOF(channel))
1857     Get #channel, , text
1858     Close #channel
1859     SweepRead = text
End Function

Private Sub SweepWrite(ByVal path As String, ByVal text As String)
