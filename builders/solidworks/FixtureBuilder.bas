Private Function NeedleInBytes(ByVal data As String, ByVal needle As String, ByVal wide As Boolean, ByVal word As Boolean) As Boolean
    ' The needle's bytes (one character each) in the file's bytes (the data and the needle with A-Z folded): a word-matched needle (word, decided
    ' on the DECODED name, never on its encoded bytes) with no ASCII letter or digit next to it, any other with a path separator on both sides.
    ' A UTF-16 character is two bytes, so "next to" is two bytes there.
    Dim pos As Long, unit As Long, before As String, after As String, found As Boolean
2104     unit = 1
2105     If wide Then unit = 2
2106     If Len(needle) > 0 Then
2107         pos = InStr(1, data, needle, vbBinaryCompare)
2108         Do While pos > 0 And Not found
2109             before = ""
2110             after = ""
2111             If pos > unit Then before = Mid$(data, pos - unit, 1)
2112             If pos + Len(needle) <= Len(data) Then after = Mid$(data, pos + Len(needle), 1)
2113             If word Then
2114                 If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
            Else
2116                 If (before = "\" Or before = "/") And (after = "\" Or after = "/") Then found = True
            End If
2118             pos = InStr(pos + 1, data, needle, vbBinaryCompare)
        Loop
    End If
2121     NeedleInBytes = found
End Function

Private Function StrayHasNeedle(ByVal path As String) As Boolean
    ' True when a needle (the user name, the profile folder's name, the computer, domain or logon-server name) is in the file's bytes as
    ' UTF-8, UTF-16-LE or ANSI. A file over 4 MB or one that cannot be read raises.
    ' Each name is tried as written, lower-cased and upper-cased (Unicode-aware), so a Cyrillic name in another case is found too.
    Dim data As String, words(0 To 4) As String, k As Long, hit As Boolean, word As String, forms(0 To 2) As String, f As Long, isWord As Boolean
2129     data = AsciiLower(ReadLatin1(path, 4194304))
2130     words(0) = EnvText("USERNAME")
2131     words(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
2132     words(2) = EnvText("COMPUTERNAME")
2133     words(3) = EnvText("USERDOMAIN")
2134     words(4) = Replace(EnvText("LOGONSERVER"), "\", "")
2135     For k = 0 To 4
2136         word = words(k)
2137         If Len(word) > 0 Then
2138             isWord = NameInsideComponents(LCase$(word))
2139             forms(0) = word
2140             forms(1) = LCase$(word)
2141             forms(2) = UCase$(word)
2142             For f = 0 To 2
2143                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "utf-8")), False, isWord) Then hit = True
2144                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "unicode")), True, isWord) Then hit = True
2145                 If Len(AnsiAsLatin1(forms(f))) > 0 Then
2146                     If NeedleInBytes(data, AsciiLower(AnsiAsLatin1(forms(f))), False, isWord) Then hit = True
                Else
2148                     sweepAnsiSkipped = True        ' the codepage cannot hold it: never read as "matches nothing" in silence (PrivacySweep notes it)
                End If
            Next f
        End If
    Next k
2153     StrayHasNeedle = hit
End Function

Private Function SweepDelete(ByVal fs As Object, ByVal path As String) As Boolean
