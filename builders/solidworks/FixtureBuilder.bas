Private Sub Build0()
    Dim feature As Object
    Dim segments As Variant
    Dim p As Variant
    Dim q As Variant
12247     apiInputs = "op=0 inputs(mm)={""dims"": true, ""entities"": [{""c"": [0, 0, 0], ""h"": 30, ""type"": ""rect_center"", ""w"": 20}], ""kind"": ""sketch"", ""plane"": ""XY"", ""type"": ""sketch""}"
12248     callInputs = ""
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12250     doc.ClearSelection2 True
12251     StartSketch "XY", Nothing, 0.0#
12252     p = LocalPoint(0.0#, 0.0#, 0.0#)
12253     q = p
12254     p(0) = p(0) - 0.01#
12255     p(1) = p(1) - 0.015#
12256     q(0) = q(0) + 0.01#
12257     q(1) = q(1) + 0.015#
12258     callInputs = "coordinates(m)=" & NumberList(Array(p(0), p(1), p(2), q(0), q(1), q(2)))
12259     BeginEntity
    stepLabel = currentIdentity & ": Build0 CreateCornerRectangle" & " " & apiInputs & " " & callInputs
12261     segments = doc.SketchManager.CreateCornerRectangle(p(0), p(1), p(2), q(0), q(1), q(2))
12262     EndEntity
12263     If Not IsArray(segments) Then Err.Raise 5, , "Rectangle creation failed"
12264     Dimension segments(0), Abs(q(0) - p(0)), q(0), p(1) - 0.005, 0#
12265     Dimension segments(1), Abs(q(1) - p(1)), q(0) + 0.005, q(1), 0#
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12267     doc.ClearSelection2 True
    stepLabel = currentIdentity & ": Build0 InsertSketch" & " " & apiInputs & " " & callInputs
12269     doc.SketchManager.InsertSketch True
12270     Set feature = NewestFeature()
12271     Remember "0", feature
12272     apiInputs = "op=1 inputs(mm)={""direction"": ""+"", ""distance"": 10, ""extent"": ""distance"", ""kind"": ""extrude"", ""op"": ""new"", ""profile"": ""last"", ""type"": ""extrude""}"
12273     callInputs = ""
    stepLabel = currentIdentity & ": Build0 ClearSelection2"
12275     doc.ClearSelection2 True
12276     Set feature = Ref("last")
    stepLabel = currentIdentity & ": Build0 Select2" & " " & apiInputs & " " & callInputs
12278     If Not feature.Select2(False, 0) Then Err.Raise 5, , "Profile selection failed"
    stepLabel = currentIdentity & ": Build0 FeatureExtrusion3"
12280     Set feature = doc.FeatureManager.FeatureExtrusion3(True, False, False, 0, 0, 0.01#, 0.01#, False, False, False, False, 0#, 0#, False, False, False, False, False, True, True, 0, 0#, False)
12281     Remember "1", feature
