Private Sub SourceEdit(ByVal recipe As String, ByVal file As String, ByVal originalMm As Double, ByVal heightMm As Double)
    ' A23c: change the source part to heightMm high (the extrusion depth of the recipe's copy), rebuild it, go back to the assembly,
    ' rebuild that (the reference is updated) and read the block's top back from its box (padded about 0.44 mm).
    Dim keyName As Variant, label As String, component As Object, model As Object, lastDimension As Object, active As Object, errors As Long, box As Variant, topMm As Double
    stepLabel = currentIdentity & ": SourceEdit Keys"
4017     For Each keyName In partFiles.Keys
4018         If partFiles(keyName) = file Then label = CStr(keyName)
    Next keyName
4020     If Len(label) = 0 Then Err.Raise 5, , "No component was placed from " & file
4021     Set component = components(label)
    stepLabel = currentIdentity & ": SourceEdit GetModelDoc2"
4023     Set model = component.GetModelDoc2()
4024     Require model, "Component model is not loaded"
    stepLabel = currentIdentity & ": SourceEdit ActivateDoc3"
4026     Set active = app.ActivateDoc3(model.GetTitle(), False, swRebuildActiveDoc, errors)
4027     Require active, "Part activation failed"
4028     Set lastDimension = DepthDimension(model, originalMm * 0.001)
    stepLabel = currentIdentity & ": SourceEdit SystemValue"
4030     lastDimension.SystemValue = heightMm * 0.001
    stepLabel = currentIdentity & ": SourceEdit EditRebuild3"
4032     If Not model.EditRebuild3() Then Err.Raise 5, , "Part rebuild failed"
    ' The assembly's SaveAs does not write a changed part it references, and a part closed unsaved loses the change: save the part itself, here, before
    ' the assembly is saved, and read the file back at the end (CheckSavedStates).
4035     SaveModel model, currentFolder & "\" & file & ".sldprt", True
    stepLabel = currentIdentity & ": SourceEdit GetSaveFlag"
4037     If model.GetSaveFlag() Then Err.Raise 5, , file & ".sldprt still has unsaved changes after SaveAs"
    stepLabel = currentIdentity & ": SourceEdit Name"
4039     AddPartReadBack model, file, Array(CStr(model.ConfigurationManager.ActiveConfiguration.Name)), Array(heightMm * 0.001), CStr(model.ConfigurationManager.ActiveConfiguration.Name)
    stepLabel = currentIdentity & ": SourceEdit ActivateDoc3"
4041     Set active = app.ActivateDoc3(doc.GetTitle(), False, swRebuildActiveDoc, errors)
4042     Require active, "Assembly activation failed"
    stepLabel = currentIdentity & ": SourceEdit ForceRebuild3"
4044     If Not doc.ForceRebuild3(False) Then Err.Raise 5, , "Assembly rebuild failed"
4045     Set component = components(label)
    stepLabel = currentIdentity & ": SourceEdit GetBox"
4047     box = component.GetBox(False, False)
4048     If Not IsArray(box) Then Err.Raise 5, , "Component box unavailable after the update"
4049     topMm = CDbl(box(5)) * 1000#
4050     NoteOption "source " & file & ".sldprt edited to " & CStr(heightMm) & " mm high; the block in the assembly now reaches z = " & CStr(topMm) & " mm (box padded about 0.44)"
4051     If Abs(topMm - heightMm) > 1# Then Err.Raise 5, , "The block is not " & CStr(heightMm) & " mm high after the reference update: its box top is at z = " & CStr(topMm) & " mm"
End Sub

