Private Sub CurveStart(ByVal curveFeature As Object)
    ' The start point and unit tangent (meters) of a helix or spiral, evaluated on the curve SolidWorks built: the feature's
    ' IReferenceCurve, its first edge's ICurve at the start parameter (ICurve.GetEndParams, ICurve.Evaluate2 with one derivative).
    Dim reference As Object, firstEdge As Object, curveObject As Object, startParameter As Double, endParameter As Double
    Dim closedFlag As Boolean, periodicFlag As Boolean, values As Variant, length As Double, i As Long, first As Long
    stepLabel = currentIdentity & ": CurveStart GetSpecificFeature2"
9490     Set reference = curveFeature.GetSpecificFeature2()
9491     Require reference, "The helix feature has no reference curve (GetSpecificFeature2 returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetFirstSegment"
9493     Set firstEdge = reference.GetFirstSegment()
9494     Require firstEdge, "The helix has no first segment (IReferenceCurve.GetFirstSegment returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetCurve"
9496     Set curveObject = firstEdge.GetCurve()
9497     Require curveObject, "The helix edge has no curve (IEdge.GetCurve returned nothing)"
    stepLabel = currentIdentity & ": CurveStart GetEndParams"
9499     curveObject.GetEndParams startParameter, endParameter, closedFlag, periodicFlag
    stepLabel = currentIdentity & ": CurveStart Evaluate2"
9501     values = curveObject.Evaluate2(startParameter, 1)
9502     If Not IsArray(values) Then Err.Raise 5, , "ICurve.Evaluate2 returned nothing"
9503     first = LBound(values)
9504     If UBound(values) - first < 5 Then Err.Raise 5, , "ICurve.Evaluate2 returned " & CStr(UBound(values) - first + 1) & " values at the start parameter, expected the point and its first derivative"
9505     For i = 0 To 2
9506         helixStart(i) = CDbl(values(first + i))
9507         helixTangent(i) = CDbl(values(first + 3 + i))
    Next i
9509     length = Sqr(helixTangent(0) ^ 2 + helixTangent(1) ^ 2 + helixTangent(2) ^ 2)
9510     If length < 0.000000000001 Then Err.Raise 5, , "The helix has no tangent at its start parameter"
9511     For i = 0 To 2
9512         helixTangent(i) = helixTangent(i) / length
    Next i
9514     helixStartKnown = True
End Sub

Private Function CurveEdge(ByVal curveFeature As Object, ByVal wantLast As Boolean) As Object
    ' The first edge of a helix or spiral, or its last (IReferenceCurve.GetFirstSegment, then GetNextSegment up to GetSegmentCount).
    Dim reference As Object, edge As Object, count As Long, i As Long
    stepLabel = currentIdentity & ": CurveEdge GetSpecificFeature2"
9521     Set reference = curveFeature.GetSpecificFeature2()
9522     Require reference, "The helix feature has no reference curve (GetSpecificFeature2 returned nothing)"
    stepLabel = currentIdentity & ": CurveEdge GetFirstSegment"
9524     Set edge = reference.GetFirstSegment()
9525     Require edge, "The helix has no first segment (IReferenceCurve.GetFirstSegment returned nothing)"
9526     If wantLast Then
    stepLabel = currentIdentity & ": CurveEdge GetSegmentCount"
9528         count = reference.GetSegmentCount()
9529         For i = 2 To count
    stepLabel = currentIdentity & ": CurveEdge GetNextSegment"
9531             Set edge = reference.GetNextSegment()
9532             Require edge, "The helix has no segment " & CStr(i) & " (IReferenceCurve.GetNextSegment returned nothing)"
        Next i
