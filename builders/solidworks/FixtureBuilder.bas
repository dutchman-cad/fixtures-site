Private Function MateOffPose(ByVal label As String, ByVal wantedT As Variant, ByVal wantedR As Variant, ByVal isFinal As Boolean, ByRef description As String) As Boolean
    ' Is the component off the pose it must have, where this mate is the one to say so? The pose is the answer key's (wantedT in mm, wantedR the nine
    ' numbers row by row, or Empty where it is not scored); with no answer key it is the pose the component was inserted at. Every mate counts while
    ' the component was inserted at its pose (the mates must not move it); a component inserted elsewhere is judged after the last mate of its composition.
    Dim inserted As Variant, values As Variant, key As String, i As Long, j As Long, moved As Double, turned As Double, drift As Double, spin As Double
    Dim t(2) As Double, r(8) As Double, current(2) As Double, haveR As Boolean, strict As Boolean
5375     key = currentScope & "|" & label
    stepLabel = currentIdentity & ": MateOffPose Exists"
5377     If Not poses.Exists(key) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose Exists"
5379     If Not components.Exists(label) Then Exit Function
5380     inserted = poses(key)
5381     If IsEmpty(wantedT) Then
5382         For i = 0 To 2
5383             t(i) = CDbl(inserted(9 + i)) * 1000#
5384             For j = 0 To 2
5385                 r(3 * i + j) = CDbl(inserted(3 * j + i))
            Next j
        Next i
5388         haveR = True
5389         strict = True
    Else
5391         For i = 0 To 2
5392             t(i) = CDbl(wantedT(i))
        Next i
5394         haveR = Not IsEmpty(wantedR)
5395         If haveR Then
5396             For i = 0 To 8
5397                 r(i) = CDbl(wantedR(i))
            Next i
        End If
5400         For i = 0 To 2
5401             If Abs(CDbl(inserted(9 + i)) * 1000# - t(i)) > drift Then drift = Abs(CDbl(inserted(9 + i)) * 1000# - t(i))
5402             If haveR Then
5403                 For j = 0 To 2
5404                     If Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j)) > spin Then spin = Abs(CDbl(inserted(3 * j + i)) - r(3 * i + j))
                Next j
            End If
        Next i
5408         strict = (drift <= 0.01 And spin <= 0.0001)
    End If
5410     If Not (isFinal Or strict) Then Exit Function
    stepLabel = currentIdentity & ": MateOffPose GetTotalTransform"
5412     values = components(label).GetTotalTransform(True).ArrayData
5413     For i = 0 To 2
5414         current(i) = CDbl(values(9 + i)) * 1000#
5415         If Abs(current(i) - t(i)) > moved Then moved = Abs(current(i) - t(i))
5416         If haveR Then
5417             For j = 0 To 2
5418                 If Abs(CDbl(values(3 * j + i)) - r(3 * i + j)) > turned Then turned = Abs(CDbl(values(3 * j + i)) - r(3 * i + j))
            Next j
        End If
    Next i
5422     description = "at (" & NoteList(current) & ") mm, wanted (" & NoteList(t) & ")"
5423     If haveR Then description = description & ", the turn differs by " & NoteNumber(turned)
5424     MateOffPose = (moved > 0.01 Or turned > 0.0001)
End Function

