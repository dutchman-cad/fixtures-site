    Else
744         FinishMessage = counts & vbLf & "The zip could not be made (the reason is in FixtureBuilder.log and " & folder & "-zip-error.txt)." & vbLf & _
            "Next: right-click this folder, choose Send to > Compressed (zipped) folder, and send that zip to Dutchy in a Discord direct message:" & vbLf & folder
    End If
End Function

Private Function ZipReady(ByVal zipPath As String) As Boolean
    ' The zip exists and holds something (an empty zip is 22 bytes).
    Dim fs As Object
752     On Error Resume Next
753     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipReady FileExists"
755     ZipReady = fs.FileExists(zipPath)
    stepLabel = currentIdentity & ": ZipReady GetFile"
757     If ZipReady Then ZipReady = (fs.GetFile(zipPath).Size > 22)
758     If Err.Number <> 0 Then ZipReady = False
759     Err.Clear
End Function

Private Function ZipErrorHead(ByVal errorFile As String) As String
    ' The first 300 characters of the PowerShell error file, one line, or "no error text".
    Dim fs As Object, stream As Object, text As String
765     On Error Resume Next
766     Set fs = CreateObject("Scripting.FileSystemObject")
767     If fs.FileExists(errorFile) Then
768         Set stream = fs.OpenTextFile(errorFile, 1)
769         text = stream.ReadAll
770         stream.Close
    End If
772     text = Trim$(Replace(Replace(text, vbCr, " "), vbLf, " "))
773     If Len(text) > 300 Then text = Left$(text, 300)
774     If Len(text) = 0 Then text = "no error text"
775     ZipErrorHead = PrivacyScrub(text)
776     Err.Clear
End Function

Private Sub ZipRemoveOld(ByVal folder As String)
    ' An old zip or error file of the same name (a manual Send to, an earlier run) never counts and is never shown.
    Dim fs As Object
782     On Error Resume Next
783     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipRemoveOld FileExists"
785     If fs.FileExists(folder & ".zip") Then fs.DeleteFile folder & ".zip", True
    stepLabel = currentIdentity & ": ZipRemoveOld FileExists"
787     If fs.FileExists(folder & "-zip-error.txt") Then fs.DeleteFile folder & "-zip-error.txt", True
788     Err.Clear
End Sub

Private Function ZipPowerShell(ByVal folder As String, ByVal errorFile As String) As Boolean
    ' Compress-Archive; a failure is written to errorFile (ASCII) and exits 1. True only if the exit code is 0, the zip exists and holds something,
    ' and no error file was written. The old zip and error file are deleted first.
    Dim command As String, quotedFolder As String, quotedZip As String, quotedError As String, code As Long, fs As Object
795     ZipRemoveOld folder
796     quotedFolder = Replace(folder, "'", "''")
797     quotedZip = Replace(folder & ".zip", "'", "''")
798     quotedError = Replace(errorFile, "'", "''")
799     command = "powershell.exe -NoProfile -NonInteractive -Command " & Chr$(34) & _
        "try { Compress-Archive -LiteralPath '" & quotedFolder & "' -DestinationPath '" & quotedZip & "' -Force -ErrorAction Stop } " & _
        "catch { $_ | Out-File -LiteralPath '" & quotedError & "' -Encoding ASCII; exit 1 }" & Chr$(34)
    stepLabel = currentIdentity & ": ZipPowerShell Run"
803     code = CreateObject("WScript.Shell").Run(command, 0, True)
804     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": ZipPowerShell FileExists"
806     ZipPowerShell = (code = 0) And ZipReady(folder & ".zip") And Not fs.FileExists(errorFile)
End Function

Private Function ZipWithShell(ByVal folder As String) As Boolean
    ' In-process zip: an empty zip file, then Shell.Application copies the folder into it. The copy is asynchronous: wait until the
    ' folder's items are all inside, the zip stops growing, or about 120 seconds pass.
    Dim fs As Object, stream As Object, shellObject As Object, zipSpace As Object, parentSpace As Object, innerSpace As Object
    Dim zipPath As String, wanted As Long, started As Date, size As Double, lastSize As Double, steady As Long, pause As Double, complete As Boolean
814     On Error GoTo Failed
815     zipPath = folder & ".zip"
816     Set fs = CreateObject("Scripting.FileSystemObject")
817     ZipRemoveOld folder
    stepLabel = currentIdentity & ": ZipWithShell CreateTextFile" & " " & apiInputs & " " & callInputs
819     Set stream = fs.CreateTextFile(zipPath, True)
    stepLabel = currentIdentity & ": ZipWithShell Write"
821     stream.Write "PK" & Chr(5) & Chr(6) & String(18, 0)
    stepLabel = currentIdentity & ": ZipWithShell Close"
823     stream.Close
824     Set shellObject = CreateObject("Shell.Application")
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
826     Set parentSpace = shellObject.Namespace(CVar(fs.GetParentFolderName(folder)))
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
828     wanted = shellObject.Namespace(CVar(folder)).Items.Count
    stepLabel = currentIdentity & ": ZipWithShell Namespace"
830     Set zipSpace = shellObject.Namespace(CVar(zipPath))
    stepLabel = currentIdentity & ": ZipWithShell CopyHere"
832     zipSpace.CopyHere parentSpace.ParseName(fs.GetFileName(folder))
833     started = Now
834     lastSize = -1
835     Do While DateDiff("s", started, Now) < 120
836         pause = Timer + 0.25
837         Do While Timer >= pause - 0.25 And Timer < pause
838             DoEvents
        Loop
840         size = 0
    stepLabel = currentIdentity & ": ZipWithShell FileExists"
842         If fs.FileExists(zipPath) Then size = fs.GetFile(zipPath).Size
    stepLabel = currentIdentity & ": ZipWithShell Count"
844         If zipSpace.Items.Count >= 1 Then
    stepLabel = currentIdentity & ": ZipWithShell Item"
846             Set innerSpace = zipSpace.Items.Item(0).GetFolder
847             If Not innerSpace Is Nothing Then
    stepLabel = currentIdentity & ": ZipWithShell Count"
849                 If innerSpace.Items.Count >= wanted And size > 22 Then
850                     If size = lastSize Then steady = steady + 1 Else steady = 0
851                     If steady >= 8 Then
852                         complete = True
853                         Exit Do
                    End If
                End If
            End If
        End If
858         lastSize = size
    Loop
    ' Only if every item arrived and the zip stopped growing; a timeout part way is not a zip.
861     ZipWithShell = complete And ZipReady(zipPath)
862     Exit Function
Failed:
864     ZipWithShell = False
End Function

Private Function ZipMitigationLine() As String
    ' A `mitigations:` line of the zip step alone (the recipes' lines are written before the zip).
    Dim itemName As Variant, text As String
870     For Each itemName In Array("zip-verify-retry", "zip-shell-application")
    stepLabel = currentIdentity & ": ZipMitigationLine Exists"
872         If mitigations.Exists(CStr(itemName)) Then
873             If Len(text) > 0 Then text = text & " "
874             text = text & CStr(itemName) & "=" & CStr(mitigations(itemName)) & ",primary-failed=" & CStr(primaryFailures(itemName)) & ",fallback-ok=" & CStr(fallbackSuccesses(itemName))
        End If
    Next itemName
877     ZipMitigationLine = "mitigations: " & text
End Function

Private Function PrivateRunExtra(ByVal folder As String) As String
    ' "" when the folder holds exactly the files a personal run may zip (results.json, FixtureDrawings.log) and no subfolder; else the other names
    ' (names only), or "a folder that could not be listed".
    Dim fs As Object, item As Object, names As String, leaf As String
884     On Error GoTo unreadable
885     Set fs = CreateObject("Scripting.FileSystemObject")
    stepLabel = currentIdentity & ": PrivateRunExtra GetFolder"
887     For Each item In fs.GetFolder(folder).Files
    stepLabel = currentIdentity & ": PrivateRunExtra Name"
889         leaf = LCase$(CStr(item.Name))
    stepLabel = currentIdentity & ": PrivateRunExtra Name"
891         If leaf <> "results.json" And leaf <> "fixturedrawings.log" Then names = names & IIf(Len(names) > 0, ", ", "") & CStr(item.Name)
    Next item
    stepLabel = currentIdentity & ": PrivateRunExtra GetFolder"
894     For Each item In fs.GetFolder(folder).SubFolders
    stepLabel = currentIdentity & ": PrivateRunExtra Name"
896         names = names & IIf(Len(names) > 0, ", ", "") & CStr(item.Name) & " (a folder)"
    Next item
898     PrivateRunExtra = names
899     Exit Function
unreadable:
901     PrivateRunExtra = "a folder that could not be listed"
End Function

Private Function MakeZip(ByVal folder As String) As Boolean
    ' folder & ".zip" for the run. Compress-Archive is checked by looking for the file and the error file, not by its exit code alone (field
    ' 2026.11.24.3: exit code 0 and no zip). An old zip or error file is deleted first and before every attempt. Then: all documents closed and a
    ' second Compress-Archive with its error text kept (zip-verify-retry), then a zip written in-process (zip-shell-application). Never raises: the
    ' finish message tells the person what to do by hand. The mitigations are logged in a line of their own.
    Dim zipPath As String, errorFile As String, extra As String
910     zipPath = folder & ".zip"
911     errorFile = folder & "-zip-error.txt"
912     On Error Resume Next
913     ZipRemoveOld folder
    ' A personal run (the drawings package, after OK): every drawing is private and was moved out, so the folder must hold exactly results.json and
    ' FixtureDrawings.log. Checked before every zip route (both Compress-Archive tries and the Shell.Application fallback zip the whole folder):
    ' anything else there, or a folder that cannot be listed, means no zip.
917     If privateRun Then
918         extra = PrivateRunExtra(folder)
919         If Len(extra) > 0 Then
920             AppendLog folder, "setup", "zip", 0, 0, "zip: not made: on a personal run the folder may hold only results.json and FixtureDrawings.log; it also holds " & extra
921             privateStuck = privateStuck & IIf(Len(privateStuck) > 0, ", ", "") & extra
922             MakeZip = False
923             Exit Function
        End If
    End If
926     If ZipPowerShell(folder, errorFile) Then MakeZip = True: Exit Function
927     Err.Clear
928     AppendLog folder, "setup", "zip", 0, 0, "zip: no zip was written; " & ZipErrorHead(errorFile)
929     RecordMitigation "zip-verify-retry", True, True
    stepLabel = currentIdentity & ": MakeZip CloseAllDocuments"
931     app.CloseAllDocuments True
932     Err.Clear
933     If ZipPowerShell(folder, errorFile) Then
934         fallbackSuccesses("zip-verify-retry") = fallbackSuccesses("zip-verify-retry") + 1
935         AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: the second Compress-Archive wrote the zip"
936         AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
937         MakeZip = True: Exit Function
    End If
939     Err.Clear
940     AppendLog folder, "setup", "zip", 0, 0, "zip-verify-retry: still no zip; " & ZipErrorHead(errorFile)
941     RecordMitigation "zip-shell-application", True, True
942     If ZipWithShell(folder) Then
943         fallbackSuccesses("zip-shell-application") = fallbackSuccesses("zip-shell-application") + 1
944         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: Shell.Application wrote the zip"
945         MakeZip = True
    Else
947         Err.Clear
948         AppendLog folder, "setup", "zip", 0, 0, "zip-shell-application: no zip either; the folder is complete, the person zips it by hand"
    End If
950     AppendLog folder, "setup", "zip", 0, 0, ZipMitigationLine()
End Function

Private Sub RunDesign(ByVal index As Long, ByVal folder As String, ByVal version As String, ByVal build As String, ByVal major As Long)
    Dim identity As String, status As String, message As String, files As String
    Dim started As Double, elapsed As Double
    Dim fs As Object, title As Variant
    Dim resultRow As String, priorRows As String
    Dim failureLine As Long, failureNumber As Long, failureDescription As String, failureStep As String
959     On Error GoTo Failed
960     Set doc = Nothing
961     Set loadedDocs = Nothing
962     probesJson = "": probeKept = "": probeCandidate = "": probeNote = "": attemptFiles = "[]"
963     attemptErrorsSaved = False
