Private Function ChamferByReferenceFace(ByVal ex As Double, ByVal ey As Double, ByVal ez As Double, ByVal edx As Double, ByVal edy As Double, ByVal edz As Double, ByVal fx As Double, ByVal fy As Double, ByVal fz As Double, ByVal fnx As Double, ByVal fny As Double, ByVal fnz As Double, ByVal distance As Double, ByVal angle As Double, ByVal wantFlipped As Boolean) As Object
    ' Round 5. Angle-distance chamfer whose first distance runs along the reference
    ' face (wantFlipped: along the other face). Which face the distance lands on is
    ' not stated in the InsertFeatureChamfer Help, so it is measured: the reference
    ' face's closest point to the old edge is distance away when the distance runs
    ' along it and distance*tan(angle) away otherwise. A wrong side is deleted and
    ' rebuilt with the Flip option toggled once; anything else fails.
    Dim feature As Object, face As Object, closeFlag As Variant, attempt As Long, flipBit As Boolean
    Dim along As Double, across As Double, wanted As Double, other As Double, measured As Double
8555     along = distance: across = distance * Tan(angle)
8556     If wantFlipped Then
8557         wanted = across: other = along
    Else
8559         wanted = along: other = across
    End If
8561     flipBit = wantFlipped
8562     For attempt = 0 To 1
    stepLabel = currentIdentity & ": ChamferByReferenceFace ClearSelection2"
8564         doc.ClearSelection2 True
8565         Pick Geom("edge", ex, ey, ez, edx, edy, edz), False, 0
8566         callInputs = "InsertFeatureChamfer(" & CStr(IIf(flipBit, 5, 4)) & ", 1, " & NumberList(Array(distance, angle)) & ") ref face normal=" & NumberList(Array(fnx, fny, fnz)) & " flip option=" & CStr(flipBit)
    stepLabel = currentIdentity & ": ChamferByReferenceFace InsertFeatureChamfer"
8568         Set feature = doc.FeatureManager.InsertFeatureChamfer(IIf(flipBit, 5, 4), swChamferAngleDistance, distance, angle, 0#, 0#, 0#, 0#)
8569         If feature Is Nothing Then Err.Raise 5, , "InsertFeatureChamfer returned no feature: " & callInputs & SelectionSummary()
8570         Set face = Geom("face", fx, fy, fz, fnx, fny, fnz)
    stepLabel = currentIdentity & ": ChamferByReferenceFace GetClosestPointOn"
8572         closeFlag = face.GetClosestPointOn(ex, ey, ez)
8573         measured = Sqr((closeFlag(0) - ex) ^ 2 + (closeFlag(1) - ey) ^ 2 + (closeFlag(2) - ez) ^ 2)
8574         If Abs(measured - wanted) <= 0.000001 Or Abs(along - across) <= 0.000000001 Then Exit For
8575         If attempt = 1 Or Abs(measured - other) > 0.000001 Then Err.Raise 5, , "Chamfer: the reference face is " & NumberList(Array(measured)) & " m from the chamfered edge, expected " & NumberList(Array(wanted)) & " m (distance on " & IIf(wantFlipped, "the other", "the reference") & " face) or " & NumberList(Array(other)) & " m (distance on the other face) (" & callInputs & ")"
8576         RecordMitigation "chamfer-ref-face-flip-retry", True, True
    stepLabel = currentIdentity & ": ChamferByReferenceFace ClearSelection2"
8578         doc.ClearSelection2 True
    stepLabel = currentIdentity & ": ChamferByReferenceFace Select2" & " " & apiInputs & " " & callInputs
8580         If Not feature.Select2(False, 0) Then Err.Raise 5, , "Wrong-side chamfer selection failed"
    stepLabel = currentIdentity & ": ChamferByReferenceFace DeleteSelection2"
8582         If Not doc.Extension.DeleteSelection2(0) Then Err.Raise 5, , "DeleteSelection2 could not remove the chamfer built on the wrong face"
8583         flipBit = Not flipBit
    Next attempt
8585     If attempt > 0 Then fallbackSuccesses("chamfer-ref-face-flip-retry") = fallbackSuccesses("chamfer-ref-face-flip-retry") + 1
8586     Set ChamferByReferenceFace = feature
End Function

