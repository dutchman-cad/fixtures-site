Private Function StepHeaderGuard(ByVal path As String) As Boolean
    ' After every STEP export: in the first 4 KB FILE_NAME must be a bare file name and the author and organization empty (or neutral).
    ' Otherwise those fields are rewritten in the file. True when it rewrote; raises when it cannot read or rewrite, so the row fails.
    Dim text As String, regex As Object, found As Object, args As Variant, first As Object, bare As String, i As Long, rebuilt As String
    Dim stream As Object, entity As String, again As Variant
2041     text = StepReadLatin1(path)
2042     Set regex = CreateObject("VBScript.RegExp")
    stepLabel = currentIdentity & ": StepHeaderGuard Pattern"
2044     regex.Pattern = "FILE_NAME\s*\(([\s\S]*?)\)\s*;"
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
2046     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2048     If found.Count = 0 Then Err.Raise 5, , "step header: no FILE_NAME in the first 4 KB"
    stepLabel = currentIdentity & ": StepHeaderGuard Value"
2050     entity = found(0).Value
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2052     args = StepArgs(found(0).SubMatches(0))
2053     If Not StepHeaderProblem(args) Then Exit Function
2054     Set first = StepStrings(CStr(args(0)))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2056     If first.Count > 0 Then bare = first(0).SubMatches(0)
2057     If InStrRev(bare, "\") > 0 Then bare = Mid$(bare, InStrRev(bare, "\") + 1)
2058     If InStrRev(bare, "/") > 0 Then bare = Mid$(bare, InStrRev(bare, "/") + 1)
2059     args(0) = "'" & bare & "'"
2060     For i = 2 To 3
2061         If UBound(args) >= i Then
2062             If StepFieldBad(CStr(args(i))) Then args(i) = "('')"
        End If
    Next i
2065     rebuilt = "FILE_NAME(" & Join(args, ",") & ");"
2066     Set stream = CreateObject("ADODB.Stream")
    stepLabel = currentIdentity & ": StepHeaderGuard Type"
2068     stream.Type = 2
    stepLabel = currentIdentity & ": StepHeaderGuard Charset"
2070     stream.Charset = "iso-8859-1"
    stepLabel = currentIdentity & ": StepHeaderGuard Open"
2072     stream.Open
    stepLabel = currentIdentity & ": StepHeaderGuard WriteText"
2074     stream.WriteText Replace(text, entity, rebuilt, 1, 1)
    stepLabel = currentIdentity & ": StepHeaderGuard SaveToFile"
2076     stream.SaveToFile path, 2
    stepLabel = currentIdentity & ": StepHeaderGuard Close"
2078     stream.Close
2079     text = StepReadLatin1(path)
    stepLabel = currentIdentity & ": StepHeaderGuard Execute"
2081     Set found = regex.Execute(Left$(text, 4096))
    stepLabel = currentIdentity & ": StepHeaderGuard Count"
2083     If found.Count = 0 Then Err.Raise 5, , "step header: the rewrite did not take"
    stepLabel = currentIdentity & ": StepHeaderGuard SubMatches"
2085     again = StepArgs(found(0).SubMatches(0))
2086     If StepHeaderProblem(again) Then Err.Raise 5, , "step header: the rewrite did not take"
2087     StepHeaderGuard = True
End Function

Private Function BytesAsLatin1(ByVal text As String, ByVal charset As String) As String
    ' The text encoded in the charset (utf-8 or unicode = UTF-16-LE), one character per byte; any byte-order mark dropped.
    Dim stream As Object, bytes As Variant, i As Long, skip As Long, result As String
2093     Set stream = CreateObject("ADODB.Stream")
    stepLabel = currentIdentity & ": BytesAsLatin1 Type"
2095     stream.Type = 2
    stepLabel = currentIdentity & ": BytesAsLatin1 Charset"
2097     stream.Charset = charset
    stepLabel = currentIdentity & ": BytesAsLatin1 Open"
2099     stream.Open
    stepLabel = currentIdentity & ": BytesAsLatin1 WriteText"
2101     stream.WriteText text
    stepLabel = currentIdentity & ": BytesAsLatin1 Position"
2103     stream.Position = 0
    stepLabel = currentIdentity & ": BytesAsLatin1 Type"
2105     stream.Type = 1
2106     If charset = "utf-8" Then skip = 3
2107     If charset = "unicode" Then skip = 2
    stepLabel = currentIdentity & ": BytesAsLatin1 Position"
2109     stream.Position = skip
    stepLabel = currentIdentity & ": BytesAsLatin1 Size"
2111     If stream.Size > skip Then
    stepLabel = currentIdentity & ": BytesAsLatin1 Read"
2113         bytes = stream.Read
2114         For i = 0 To UBound(bytes)
2115             result = result & ChrW(bytes(i))
        Next i
    End If
    stepLabel = currentIdentity & ": BytesAsLatin1 Close"
2119     stream.Close
