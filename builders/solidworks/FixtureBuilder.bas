Private Function BaseFlange(ByVal thickness As Double, ByVal radius As Double, ByVal kFactor As Double, ByVal axisIndex As Long, ByVal side As Long, ByVal planeOffset As Double) As Object
    ' thickness, radius and planeOffset in meters. Thickness must lie on the requested side of the sketch plane;
    ' a wrong side is undone and rebuilt: ThickenDir reversed, then (feature-data route) ReverseDirection, then
    ' the built feature is flipped with ModifyDefinition. Never accepts the wrong side.
    Dim profileFeature As Object, feature As Object, tried As String, member As Variant
    Dim near As Double, far As Double, origin As Double, depth As Double, verdict As String
7350     Set profileFeature = lastFeature
7351     Require profileFeature, "Base flange profileFeature sketch missing"
7352     origin = planeOffset * 1000#
7353     depth = thickness * 1000#
    ' Step 0: the recipe's side.
7355     Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, False, "ReverseThickness")
7356     verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7357     If verdict = "other" Then BaseFlangeRefuse near, far, origin
7358     If verdict = "wrong" Then
        ' Step 1: undo and rebuild with the reverse flag.
7360         RecordMitigation "baseflange-thicken-reverse", True, True
7361         BaseFlangeUndo
7362         Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, True, "ReverseThickness")
7363         verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7364         If verdict = "ok" Then
7365             fallbackSuccesses("baseflange-thicken-reverse") = fallbackSuccesses("baseflange-thicken-reverse") + 1
        ElseIf verdict = "other" Or (baseRoute <> "featuredata" And swMajor >= BASEFLANGE_INITIALIZE_FROM) Then
7367             BaseFlangeRefuse near, far, origin
        Else
7369             If baseRoute = "featuredata" Then
                ' Step 2: the other reverse member, IBaseFlangeFeatureData.ReverseDirection.
7371                 RecordMitigation "baseflange-reverse-direction", True, True
7372                 BaseFlangeUndo
7373                 Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, True, "ReverseDirection")
7374                 verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7375                 If verdict = "ok" Then
7376                     fallbackSuccesses("baseflange-reverse-direction") = fallbackSuccesses("baseflange-reverse-direction") + 1
                ElseIf verdict = "other" Then
7378                     BaseFlangeRefuse near, far, origin
                End If
            End If
            ' Round 23, revisions before 30 only (a revision of 30 or more refuses as before): the insert route has no ReverseDirection step (it is
            ' a feature-data member), but a flange built by the insert call is an IBaseFlangeFeatureData too, so it goes straight to step 3.
7383             If verdict = "wrong" Then
                ' Step 3: build it as the recipe says, then flip the BUILT feature with ModifyDefinition.
7385                 RecordMitigation "baseflange-modify-reverse", True, True
7386                 BaseFlangeUndo
7387                 Set feature = BaseFlangeFeature(profileFeature, thickness, radius, kFactor, False, "ReverseThickness")
7388                 verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7389                 For Each member In Array("ReverseThickness", "ReverseDirection")
7390                     If verdict = "ok" Then Exit For
7391                     If verdict = "other" Then BaseFlangeRefuse near, far, origin
7392                     FlipBuiltBaseFlange CStr(member), tried
7393                     verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
7394                     tried = tried & CStr(member) & " -> extent " & NumberList(Array(near, far)) & " mm; "
7395                     If verdict = "wrong" And CStr(member) = "ReverseThickness" Then
7396                         FlipBuiltBaseFlange CStr(member), tried
7397                         verdict = BaseFlangeSide(axisIndex, side, origin, depth, near, far)
                    End If
                Next member
7400                 If verdict <> "ok" Then Err.Raise 5, , "Base flange thickness stays on the wrong side of its sketch after the reverse flag before CreateFeature, ReverseDirection and a ModifyDefinition toggle of each (" & callInputs & "; " & tried & ")"
7401                 fallbackSuccesses("baseflange-modify-reverse") = fallbackSuccesses("baseflange-modify-reverse") + 1
            End If
        End If
    End If
7405     AppendLog currentFolder, currentIdentity, "option", 0, 0, "base flange: corner_relief and corner_gap have no Sheet-Metal setting in SolidWorks; they belong to Corner Relief features and a flat base flange has no corners"
7406     Set BaseFlange = feature
End Function

