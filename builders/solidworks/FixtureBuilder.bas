Private Function AnsiAsLatin1(ByVal text As String) As String
    ' The single-byte ANSI form (empty when a character does not fit in one byte).
    Dim i As Long, result As String, ok As Boolean
2126     ok = True
2127     For i = 1 To Len(text)
2128         If AscW(Mid$(text, i, 1)) < 0 Or AscW(Mid$(text, i, 1)) > 255 Then ok = False
    Next i
2130     If ok Then
2131         For i = 1 To Len(text)
2132             result = result & ChrW(Asc(Mid$(text, i, 1)) And 255)
        Next i
    End If
2135     AnsiAsLatin1 = result
End Function

Private Function AsciiLower(ByVal text As String) As String
    ' Only A-Z become a-z (LCase$ on the bytes of a file would also change the bytes C0 to DE, which are parts of other characters).
    Dim code As Long
2141     For code = 65 To 90
2142         text = Replace(text, Chr$(code), Chr$(code + 32), 1, -1, vbBinaryCompare)
    Next code
2144     AsciiLower = text
End Function

Private Function NeedleInBytes(ByVal data As String, ByVal needle As String, ByVal wide As Boolean, ByVal word As Boolean) As Boolean
    ' The needle's bytes (one character each) in the file's bytes (the data and the needle with A-Z folded): a word-matched needle (word, decided
    ' on the DECODED name, never on its encoded bytes) with no ASCII letter or digit next to it, any other with a path separator on both sides.
    ' A UTF-16 character is two bytes, so "next to" is two bytes there.
    Dim pos As Long, unit As Long, before As String, after As String, found As Boolean
2152     unit = 1
2153     If wide Then unit = 2
2154     If Len(needle) > 0 Then
2155         pos = InStr(1, data, needle, vbBinaryCompare)
2156         Do While pos > 0 And Not found
2157             before = ""
2158             after = ""
2159             If pos > unit Then before = Mid$(data, pos - unit, 1)
2160             If pos + Len(needle) <= Len(data) Then after = Mid$(data, pos + Len(needle), 1)
2161             If word Then
2162                 If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
            Else
2164                 If (before = "\" Or before = "/") And (after = "\" Or after = "/") Then found = True
            End If
2166             pos = InStr(pos + 1, data, needle, vbBinaryCompare)
        Loop
    End If
2169     NeedleInBytes = found
End Function

Private Function StrayHasNeedle(ByVal path As String) As Boolean
    ' True when a needle (the user name, the profile folder's name, the computer, domain or logon-server name) is in the file's bytes as
    ' UTF-8, UTF-16-LE or ANSI. A file over 4 MB or one that cannot be read raises.
    ' Each name is tried as written, lower-cased and upper-cased (Unicode-aware), so a Cyrillic name in another case is found too.
    Dim data As String, words(0 To 4) As String, k As Long, hit As Boolean, word As String, forms(0 To 2) As String, f As Long, isWord As Boolean
2177     data = AsciiLower(ReadLatin1(path, 4194304))
2178     words(0) = EnvText("USERNAME")
2179     words(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
2180     words(2) = EnvText("COMPUTERNAME")
2181     words(3) = EnvText("USERDOMAIN")
2182     words(4) = Replace(EnvText("LOGONSERVER"), "\", "")
2183     For k = 0 To 4
2184         word = words(k)
2185         If Len(word) > 0 Then
2186             isWord = NameInsideComponents(LCase$(word))
2187             forms(0) = word
2188             forms(1) = LCase$(word)
2189             forms(2) = UCase$(word)
2190             For f = 0 To 2
2191                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "utf-8")), False, isWord) Then hit = True
2192                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "unicode")), True, isWord) Then hit = True
2193                 If Len(AnsiAsLatin1(forms(f))) > 0 Then
2194                     If NeedleInBytes(data, AsciiLower(AnsiAsLatin1(forms(f))), False, isWord) Then hit = True
                Else
2196                     sweepAnsiSkipped = True        ' the codepage cannot hold it: never read as "matches nothing" in silence (PrivacySweep notes it)
                End If
            Next f
        End If
    Next k
2201     StrayHasNeedle = hit
End Function

