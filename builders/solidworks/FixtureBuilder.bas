Private Function NeedleInBytes(ByVal data As String, ByVal needle As String, ByVal wide As Boolean, ByVal word As Boolean) As Boolean
    ' The needle's bytes (one character each) in the file's bytes (the data and the needle with A-Z folded): a word-matched needle (word, decided
    ' on the DECODED name, never on its encoded bytes) with no ASCII letter or digit next to it, any other with a path separator on both sides.
    ' A UTF-16 character is two bytes, so "next to" is two bytes there.
    Dim pos As Long, unit As Long, before As String, after As String, found As Boolean
2106     unit = 1
2107     If wide Then unit = 2
2108     If Len(needle) > 0 Then
2109         pos = InStr(1, data, needle, vbBinaryCompare)
2110         Do While pos > 0 And Not found
2111             before = ""
2112             after = ""
2113             If pos > unit Then before = Mid$(data, pos - unit, 1)
2114             If pos + Len(needle) <= Len(data) Then after = Mid$(data, pos + Len(needle), 1)
2115             If word Then
2116                 If (Len(before) = 0 Or Not IsAsciiAlnum(before)) And (Len(after) = 0 Or Not IsAsciiAlnum(after)) Then found = True
            Else
2118                 If (before = "\" Or before = "/") And (after = "\" Or after = "/") Then found = True
            End If
2120             pos = InStr(pos + 1, data, needle, vbBinaryCompare)
        Loop
    End If
2123     NeedleInBytes = found
End Function

Private Function StrayHasNeedle(ByVal path As String) As Boolean
    ' True when a needle (the user name, the profile folder's name, the computer, domain or logon-server name) is in the file's bytes as
    ' UTF-8, UTF-16-LE or ANSI. A file over 4 MB or one that cannot be read raises.
    ' Each name is tried as written, lower-cased and upper-cased (Unicode-aware), so a Cyrillic name in another case is found too.
    Dim data As String, words(0 To 4) As String, k As Long, hit As Boolean, word As String, forms(0 To 2) As String, f As Long, isWord As Boolean
2131     data = AsciiLower(ReadLatin1(path, 4194304))
2132     words(0) = EnvText("USERNAME")
2133     words(1) = LeafOf(Replace(EnvText("USERPROFILE"), "/", "\"))
2134     words(2) = EnvText("COMPUTERNAME")
2135     words(3) = EnvText("USERDOMAIN")
2136     words(4) = Replace(EnvText("LOGONSERVER"), "\", "")
2137     For k = 0 To 4
2138         word = words(k)
2139         If Len(word) > 0 Then
2140             isWord = NameInsideComponents(LCase$(word))
2141             forms(0) = word
2142             forms(1) = LCase$(word)
2143             forms(2) = UCase$(word)
2144             For f = 0 To 2
2145                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "utf-8")), False, isWord) Then hit = True
2146                 If NeedleInBytes(data, AsciiLower(BytesAsLatin1(forms(f), "unicode")), True, isWord) Then hit = True
2147                 If Len(AnsiAsLatin1(forms(f))) > 0 Then
2148                     If NeedleInBytes(data, AsciiLower(AnsiAsLatin1(forms(f))), False, isWord) Then hit = True
                Else
2150                     sweepAnsiSkipped = True        ' the codepage cannot hold it: never read as "matches nothing" in silence (PrivacySweep notes it)
                End If
            Next f
        End If
    Next k
2155     StrayHasNeedle = hit
End Function

Private Function SweepDelete(ByVal fs As Object, ByVal path As String) As Boolean
    Dim attempt As Long, done As Boolean
2160     For attempt = 1 To 3
2161         If Not done Then
2162             On Error Resume Next
2163             Err.Clear
2164             If fs.FileExists(path) Then fs.DeleteFile path, True
2165             done = (Err.Number = 0 And Not fs.FileExists(path))
2166             Err.Clear
2167             On Error GoTo 0
        End If
    Next attempt
2170     SweepDelete = done
