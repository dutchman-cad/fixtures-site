Private Sub SweepFolder(ByVal fs As Object, ByVal dirPath As String, ByRef notes As String)
    Dim item As Object, list As String, entries As Variant, i As Long, here As Object, children As Object
2280     On Error Resume Next
2281     Err.Clear
2282     Set here = fs.GetFolder(dirPath)
2283     If Err.Number = 0 Then Set children = here.Files
2284     If Err.Number = 0 Then
2285         For Each item In children
2286             list = list & item.Path & vbLf
        Next item
    End If
2289     If Err.Number <> 0 Then SweepListFailure dirPath, notes
2290     entries = Split(list, vbLf)
2291     For i = 0 To UBound(entries)
2292         If Len(entries(i)) > 0 Then SweepFile fs, CStr(entries(i)), notes
    Next i
2294     list = ""
2295     If Not here Is Nothing Then Set children = here.SubFolders
2296     If Err.Number = 0 And Not here Is Nothing Then
2297         For Each item In children
2298             list = list & item.Path & vbLf
        Next item
    End If
2301     If Err.Number <> 0 Then SweepListFailure dirPath, notes
2302     entries = Split(list, vbLf)
2303     For i = 0 To UBound(entries)
2304         If Len(entries(i)) > 0 Then SweepFolder fs, CStr(entries(i)), notes
    Next i
End Sub

Private Function PrivacySweep(ByVal folder As String) As String
