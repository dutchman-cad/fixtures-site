Private Sub HelixReadBack(ByVal helix As Object, ByVal expected As Variant, ByVal label As String, ByVal wantVariable As Boolean, ByVal regionCount As Long)
    ' Log the definition SolidWorks shows (Height, Pitch, Revolution ...), then fail if it differs from the recipe.
    ' expected = Array(height m, pitch m, revolutions); -1 means not checked.
    Dim helixData As Object, text As String, problems As String, pitchCount As String, variableFlag As Boolean
    stepLabel = currentIdentity & ": HelixReadBack GetDefinition"
9312     Set helixData = helix.GetDefinition()
9313     If helixData Is Nothing Then
9314         AppendLog currentFolder, currentIdentity, "helix read-back", 0, 0, label & ": the helix definition is unavailable (IFeature.GetDefinition returned nothing)"
9315         Exit Sub
    End If
9317     pitchCount = "n/a"
9318     If wantVariable Then
9319         pitchCount = "unreadable"
9320         On Error Resume Next
    stepLabel = currentIdentity & ": HelixReadBack PitchCount"
9322         pitchCount = CStr(helixData.PitchCount)
9323         If Err.Number <> 0 Then pitchCount = "unreadable"
9324         Err.Clear
9325         On Error GoTo 0
    End If
    stepLabel = currentIdentity & ": HelixReadBack VariablePitch"
9328     variableFlag = helixData.VariablePitch
    stepLabel = currentIdentity & ": HelixReadBack DefinedBy"
9330     text = label & ": DefinedBy=" & CStr(helixData.DefinedBy) & " Height=" & NumberList(Array(helixData.Height * 1000#)) & " mm Pitch=" & NumberList(Array(helixData.Pitch * 1000#)) & _
        " mm Revolution=" & NumberList(Array(helixData.Revolution)) & " StartingAngle=" & NumberList(Array(helixData.StartingAngle * 180# / 3.14159265358979)) & _
        " deg Clockwise=" & YesNo(helixData.Clockwise) & " ReverseDirection=" & YesNo(helixData.ReverseDirection) & " Taper=" & YesNo(helixData.Taper) & _
        " TaperAngle=" & NumberList(Array(helixData.TaperAngle * 180# / 3.14159265358979)) & " deg TaperOutward=" & YesNo(helixData.TaperOutward) & _
        " VariablePitch=" & YesNo(variableFlag) & " PitchCount=" & pitchCount
9335     AppendLog currentFolder, currentIdentity, "helix read-back", 0, 0, text
9336     If expected(0) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Height"
9338         If Abs(helixData.Height - expected(0)) > 0.000000001 Then problems = problems & "; Height " & NumberList(Array(helixData.Height * 1000#)) & ", expected " & NumberList(Array(expected(0) * 1000#))
    End If
9340     If expected(1) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Pitch"
9342         If Abs(helixData.Pitch - expected(1)) > 0.000000001 Then problems = problems & "; Pitch " & NumberList(Array(helixData.Pitch * 1000#)) & ", expected " & NumberList(Array(expected(1) * 1000#))
    End If
9344     If expected(2) >= 0# Then
    stepLabel = currentIdentity & ": HelixReadBack Revolution"
9346         If Abs(helixData.Revolution - expected(2)) > 0.000001 Then problems = problems & "; Revolution " & NumberList(Array(helixData.Revolution)) & ", expected " & NumberList(Array(expected(2)))
    End If
9348     If wantVariable And Not variableFlag Then problems = problems & "; VariablePitch False, expected a variable-pitch helix"
9349     If wantVariable And IsNumeric(pitchCount) Then
9350         If CLng(pitchCount) <> regionCount Then problems = problems & "; PitchCount " & pitchCount & ", expected " & CStr(regionCount) & " regions"
    End If
9352     If Len(problems) > 0 Then Err.Raise 5, , "The " & label & " SolidWorks built differs from the recipe:" & Mid$(problems, 2) & " (" & text & ")"
End Sub

