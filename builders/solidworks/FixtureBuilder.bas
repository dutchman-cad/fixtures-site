Private Sub MirrorRestore(ByVal rungName As String, ByVal before As Object, ByVal treeBefore As String)
    ' Put the assembly back to what it was before the first mirror call, by diff and not by undo count (a successful ModifyDefinition adds an undo
    ' entry of its own, so one undo takes only that): EditUndo2 until the top-level components and the feature tree equal the snapshot, at most 4
    ' times, and not again after one that changed nothing of the mirror (it took something else). Round 28: where that leaves them different (SolidWorks 2023 does not undo a MirrorComponents3 result) the new mirror features and
    ' components are deleted (mirror-cleanup-delete). If they still differ the rung is named, with what was left, and the ladder stops.
    Dim attempt As Long, remains As String, remainsAfter As String
4602     remains = MirrorLeft(before, treeBefore)
4603     For attempt = 1 To 4
4604         If Len(remains) = 0 Then Exit Sub
    stepLabel = currentIdentity & ": MirrorRestore EditUndo2"
4606         doc.EditUndo2 1
4607         remainsAfter = MirrorLeft(before, treeBefore)
        ' An undo that changed nothing of the mirror took something else (the mirror plane, an earlier recipe's feature): no more of them.
4609         If remainsAfter = remains Then Exit For
4610         remains = remainsAfter
    Next attempt
4612     If Len(remains) = 0 Then Exit Sub
4613     RecordMitigation "mirror-cleanup-delete", True, True
4614     NoteOption "mirror cleanup after " & rungName & ": EditUndo2 left " & remains & "; deleting what the mirror made"
4615     MirrorDeleteMade before, treeBefore
4616     remainsAfter = MirrorLeft(before, treeBefore)
4617     If Len(remainsAfter) > 0 Then
4618         stepLabel = currentIdentity & ": MirrorRestore the assembly after the try"
4619         Err.Raise 5, , "the mirror rung " & rungName & " left " & remainsAfter & " in the assembly (EditUndo2 left " & remains & "; deleting the mirror feature and components did not clear it)"
    End If
4621     fallbackSuccesses("mirror-cleanup-delete") = fallbackSuccesses("mirror-cleanup-delete") + 1
4622     NoteOption "mirror cleanup after " & rungName & ": the assembly is back to its snapshot"
End Sub

Private Function MirrorCheck(ByVal madeComponent As Object, ByVal sourceComponent As Object, ByVal axisIndex As Long, ByVal offset As Double, ByVal corner As Variant, ByVal wanted As Variant, ByVal showPoint As Boolean, ByVal label As String) As String
    ' The corner test of one mirror try, logged: "" when the part's rounded corner (the fillet's axis, read from the part's own geometry) is at the
    ' mirror image of the original's, else what was found. The same test for an instance and for a new part.
    Dim values As Variant, point(2) As Double, worst As Double, r As Long, c As Long, problem As String
    Dim cornerLower As Long, cornerUpper As Long, valueLower As Long, valueUpper As Long
4630     problem = MirrorGeometryProblem(madeComponent, sourceComponent, axisIndex, offset)
4631     ArrayItems corner, cornerLower, cornerUpper
    stepLabel = currentIdentity & ": MirrorCheck GetTotalTransform"
4633     values = madeComponent.GetTotalTransform(True).ArrayData
4634     If Not ArrayItems(values, valueLower, valueUpper) Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered no array"
4635     If valueUpper - valueLower < 12 Then Err.Raise 5, , "GetTotalTransform of the mirrored component answered " & CStr(valueUpper - valueLower + 1) & " numbers, not 16"
4636     For r = 0 To 2
4637         point(r) = CDbl(values(valueLower + 9 + r)) * 1000#
4638         For c = 0 To 2
4639             point(r) = point(r) + CDbl(values(valueLower + 3 * c + r)) * CDbl(corner(cornerLower + c))
        Next c
    Next r
4642     If showPoint Then
4643         For r = 0 To 2
4644             If Abs(point(r) - CDbl(wanted(r))) > worst Then worst = Abs(point(r) - CDbl(wanted(r)))
        Next r
4646         NoteOption label & " puts the rounded corner at (" & NoteList(point) & ") mm" & IIf(worst <= 0.5, "", ", wanted (" & NoteList(wanted) & ")")
    End If
4648     If Len(problem) = 0 Then
4649         NoteOption label & ": the rounded corner (the fillet axis read from its own geometry) is at the mirror image of the original"
    Else
4651         NoteOption label & ": " & problem
    End If
4653     MirrorCheck = problem
End Function

Private Function MirrorLadder(ByVal plane As Object, ByVal sourceComponent As Object, ByVal path As String, ByVal before As Object, ByVal corner As Variant, ByVal wanted As Variant, ByVal axisIndex As Long, ByVal offset As Double, ByVal orientationList As Variant, ByVal treeBefore As String, ByRef problem As String, ByRef ladder As String) As Object
    ' Round 25 (field 2026.11.25.3, A20b: the orientation argument did not reach SolidWorks in the array form): the rungs after the orientation loop,
    ' each logged and judged by the same corner test, stopping at the first that is right. 0 and 1: mirror-orientation-int-array (an Integer array,
    ' then a Variant array); 2: mirror-orientation-definition (the orientation set through IMirrorComponentFeatureData and ModifyDefinition);
    ' 3: mirror-orientation-center-of-mass-off. problem is "" when a rung worked; ladder lists every try's result. The assembly is put back to its
    ' snapshot (MirrorRestore) before the first try and after every try that fails, made or not.
    Dim rung As Long, number As Long, lower As Long, upper As Long, orientation As Long, rungName As String, how As String
    Dim madeComponent As Object, label As String, reason As String, fresh As Variant, entry As Object, nameText As String, freshLower As Long, freshUpper As Long
4664     problem = "no rung ran"
4665     ladder = ""
4666     If Not ArrayItems(orientationList, lower, upper) Then Exit Function
4667     MirrorRestore "the orientation loop", before, treeBefore
4668     For rung = 0 To 3
4669         Select Case rung
            Case 0
4671                 rungName = "mirror-orientation-int-array": how = "Integer array"
            Case 1
4673                 rungName = "mirror-orientation-int-array": how = "Variant array"
            Case 2
4675                 rungName = "mirror-orientation-definition": how = "definition"
            Case Else
4677                 rungName = "mirror-orientation-center-of-mass-off": how = "OrientAboutCenterOfMass False"
        End Select
4679         If rung <> 1 Then RecordMitigation rungName, True, True
4680         For number = lower To upper
4681             orientation = CLng(orientationList(number))
4682             label = "mirror rung " & rungName & " (" & how & "), orientation " & CStr(orientation)
4683             reason = ""
4684             Set madeComponent = Nothing
4685             On Error Resume Next
4686             Select Case rung
                Case 0
4688                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 1, -1)
                Case 1
4690                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 2, -1)
                Case 2
4692                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, CLng(orientationList(lower)), before, 0, -1)
                Case Else
4694                     Set madeComponent = MirrorCall(plane, sourceComponent, False, path, orientation, before, 0, 0)
            End Select
4696             If Err.Number <> 0 Then reason = CleanError(Err.Description)
4697             Err.Clear
4698             On Error GoTo 0
4699             If Len(reason) = 0 Then
4700                 If rung = 2 Then
4701                     reason = MirrorDefine(orientation)
4702                     If Len(reason) = 0 Then
4703                         RebuildNoted doc, "the mirror definition"
4704                         fresh = NewComponents(before)
4705                         If ArrayItems(fresh, freshLower, freshUpper) Then
4706                             If freshUpper > freshLower Then
4707                                 reason = CStr(freshUpper - freshLower + 1) & " new components after the definition changed, where one was expected"
                            ElseIf ItemAt(fresh, freshLower, entry, nameText) Then
4709                                 Set madeComponent = entry
                            End If
                        End If
                    End If
                End If
            End If
4715             If Len(reason) > 0 Then
4716                 NoteOption label & ": " & reason
4717                 problem = reason
            Else
4719                 problem = MirrorCheck(madeComponent, sourceComponent, axisIndex, offset, corner, wanted, True, label)
4720                 If Len(problem) = 0 Then
4721                     fallbackSuccesses(rungName) = fallbackSuccesses(rungName) + 1
4722                     ladder = ""
4723                     Set MirrorLadder = madeComponent
4724                     Exit Function
                End If
4726                 reason = problem
            End If
4728             ladder = ladder & "; " & rungName & " (" & how & "), orientation " & CStr(orientation) & ": " & reason
4729             MirrorRestore rungName, before, treeBefore
        Next number
    Next rung
4732     Set MirrorLadder = madeComponent
End Function

Private Function MirrorCall(ByVal plane As Object, ByVal sourceComponent As Object, ByVal newPart As Boolean, ByVal path As String, ByVal orientation As Long, ByVal before As Object, ByVal arrayKind As Long, ByVal centerMode As Long) As Object
    ' MirrorComponents3 in the five forms in turn (MirrorFormText), starting from the one that made a component last. A form succeeds only if it
    ' yields a component: an object in its answer, or a new top-level component after a rebuild (field 2026.11.24.3: forms 0 and 1 answered an
    ' EMPTY array and made nothing, which was taken for success). Nothing is undone between forms. Round 25: arrayKind is the element type of the
    ' orientation array (0 Long, 1 Integer, 2 Variant) and centerMode 0 puts OrientAboutCenterOfMass False (-1: as the form says).
