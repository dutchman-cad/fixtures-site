Private Function ProbeMateEntity(ByVal componentName As String, ByVal kind As String, ByVal x As Double, ByVal y As Double, ByVal z As Double, ByVal nx As Double, ByVal ny As Double, ByVal nz As Double) As Object
    ' Round 9 probe candidates for the distance part of an insert mate: the edge itself (candidates edge-*), or the planar face bounded by
    ' the circular edge whose normal is along the circleData's axis (candidates face-*), mapped into the assembly.
