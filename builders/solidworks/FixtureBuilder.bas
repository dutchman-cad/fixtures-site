Private Function PlaneMap(ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' Sketch (x, y) on a default plane or a plane offset from it: XY = Front
    ' (x=X, y=Y), XZ = Top (x=X, y=-Z), YZ = Right (x=-Z, y=Y). Sketch z is 0.
6506     Select Case sketchPlane
        Case "XY": PlaneMap = Array(x, y, 0#)
        Case "XZ": PlaneMap = Array(x, -z, 0#)
        Case "YZ": PlaneMap = Array(-z, y, 0#)
    End Select
End Function

Private Function MatrixUsable(ByVal matrix As Variant) As Boolean
    ' IMathTransform.ArrayData: rotation 0-8, translation 9-11, scale 12.
    Dim i As Long, j As Long, k As Long, first As Long, dot As Double, expected As Double
6516     If Not IsArray(matrix) Then Exit Function
6517     first = LBound(matrix)
6518     If UBound(matrix) - first < 12 Then Exit Function
6519     For i = 0 To 12
6520         If Not IsNumeric(matrix(first + i)) Then Exit Function
    Next i
6522     For i = 0 To 2
6523         For j = 0 To 2
6524             dot = 0#
6525             For k = 0 To 2
6526                 dot = dot + CDbl(matrix(first + 3 * i + k)) * CDbl(matrix(first + 3 * j + k))
            Next k
6528             expected = 0#
6529             If i = j Then expected = 1#
6530             If Abs(dot - expected) > 0.000001 Then Exit Function
        Next j
    Next i
6533     MatrixUsable = Abs(CDbl(matrix(first + 12))) > 0.000000001
End Function

Private Function MatrixPoint(ByVal matrix As Variant, ByVal x As Double, ByVal y As Double, ByVal z As Double) As Variant
    ' Row-vector convention: local = (p x R) * scale + translation.
    Dim first As Long, scaleFactor As Double, result(2) As Double, j As Long
6539     first = LBound(matrix)
6540     scaleFactor = CDbl(matrix(first + 12))
6541     For j = 0 To 2
6542         result(j) = (x * CDbl(matrix(first + j)) + y * CDbl(matrix(first + 3 + j)) + z * CDbl(matrix(first + 6 + j))) * scaleFactor + CDbl(matrix(first + 9 + j))
    Next j
6544     MatrixPoint = Array(result(0), result(1), result(2))
End Function

