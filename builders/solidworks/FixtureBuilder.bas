Private Function PlanLine(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A line through the point that is perpendicular to the measuring direction.
    Dim record As Object, a As Variant, b As Variant, runX As Double, runY As Double, size As Double, along As Double, off As Double
8200     For Each record In records
8201         If record("kind") = "line" Then
8202             a = record("a")
8203             b = record("b")
8204             runX = b(0) - a(0)
8205             runY = b(1) - a(1)
8206             size = Sqr(runX * runX + runY * runY)
8207             If size > 0.000000001 Then
8208                 If Abs(runX * ux + runY * uy) <= 0.000001 * size Then
8209                     along = ((point(0) - a(0)) * runX + (point(1) - a(1)) * runY) / (size * size)
8210                     off = Abs((point(0) - a(0)) * runY - (point(1) - a(1)) * runX) / size
8211                     If along >= -0.000000001 And along <= 1.000000001 And off <= 0.000001 Then
8212                         Set PlanLine = record
8213                         Exit Function
                    End If
                End If
            End If
        End If
    Next record
End Function

Private Function PlanReference(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle centered on the point, else a line through it that is perpendicular to the measuring direction (D05a's own choice, tried first).
    Dim record As Object
8224     For Each record In records
8225         If record("kind") = "circle" Then
8226             If NearFlat(record("a"), point) Then
8227                 Set PlanReference = record
8228                 Exit Function
            End If
        End If
    Next record
8232     Set PlanReference = PlanLine(records, point, ux, uy)
End Function

Private Function PlanRim(ByVal records As Collection, ByVal point As Variant, ByVal ux As Double, ByVal uy As Double) As Object
    ' A circle seen edge-on (its axis known to lie across the view) is the straight line through its center, 2 x radius long, perpendicular to its axis: it
    ' is a reference when the point is on that line and the measuring direction is the axis's own.
    Dim record As Object, axisFlat As Variant, centre As Variant, runX As Double, runY As Double
8239     For Each record In records
8240         If record("kind") = "circle" Then
8241             If record("faceOn") = 0 Then
8242                 centre = record("a")
8243                 axisFlat = record("flatAxis")
8244                 runX = point(0) - centre(0)
8245                 runY = point(1) - centre(1)
8246                 If Abs(-axisFlat(1) * ux + axisFlat(0) * uy) <= 0.000001 And Abs(runX * axisFlat(0) + runY * axisFlat(1)) <= 0.000001 _
                   And Abs(-runX * axisFlat(1) + runY * axisFlat(0)) <= CDbl(record("radius")) + 0.000000001 Then
8248                     Set PlanRim = CloneRecord(record, "drawing-dimension-edge-on-circles")
8249                     Exit Function
                End If
            End If
        End If
    Next record
End Function

Private Function DimensionPlan(ByVal records As Collection, ByVal first As Variant, ByVal second As Variant) As Collection
    ' The one or two edges whose selection makes SolidWorks measure the distance between two flattened points, or Nothing when the view cannot show
    ' it. D05a's own plan (a line, or two references) is tried first; the diameter and edge-on forms only when it finds nothing.
    Dim lineRecord As Object, one As Object, two As Object, dx As Double, dy As Double, length As Double
8260     dx = second(0) - first(0)
8261     dy = second(1) - first(1)
8262     length = Sqr(dx * dx + dy * dy)
8263     If length < 0.000000001 Then Err.Raise 5, , "The two dimension points coincide in the view"
8264     Set lineRecord = PlanSingle(records, first, second)
8265     If Not lineRecord Is Nothing Then
8266         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8268         DimensionPlan.Add lineRecord
8269         Exit Function
    End If
8271     Set one = PlanReference(records, first, dx / length, dy / length)
8272     Set two = PlanReference(records, second, dx / length, dy / length)
8273     If Not one Is Nothing And Not two Is Nothing Then
8274         If Not one Is two Then
8275             Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8277             DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8279             DimensionPlan.Add two
8280             Exit Function
        End If
    End If
8283     Set lineRecord = PlanDiameter(records, first, second, length)
8284     If Not lineRecord Is Nothing Then
8285         Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8287         DimensionPlan.Add lineRecord
8288         Exit Function
    End If
8290     Set one = PlanRim(records, first, dx / length, dy / length)
8291     Set two = PlanRim(records, second, dx / length, dy / length)
8292     If one Is Nothing And two Is Nothing Then Exit Function
8293     If one Is Nothing Then Set one = PlanReference(records, first, dx / length, dy / length)
8294     If two Is Nothing Then Set two = PlanReference(records, second, dx / length, dy / length)
8295     If one Is Nothing Or two Is Nothing Then Exit Function
8296     If one("entity") Is two("entity") Then Exit Function
8297     Set DimensionPlan = New Collection
    stepLabel = currentIdentity & ": DimensionPlan Add"
8299     DimensionPlan.Add one
    stepLabel = currentIdentity & ": DimensionPlan Add"
8301     DimensionPlan.Add two
End Function

