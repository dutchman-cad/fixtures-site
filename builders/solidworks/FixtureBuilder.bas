Private Function ViewDrop(ByVal view As Object) As Long
    ' The model axis a drawing view looks along: the z column of its model-to-view rotation (row-vector
    ' convention). Round 8 (field, 34.4.0): the view beside the Top view has the rows (0,0,1), (-1,0,0),
    ' (0,-1,0), so its z column names X and its z row Y; the rotation only has to be a signed axis
    ' permutation (one +-1 and two zeros in every row and column, within 1e-9). A tilted view fails.
    Dim matrix As Variant, i As Long, j As Long, first As Long, ones As Long, zeros As Long, value As Double
    stepLabel = currentIdentity & ": ViewDrop ArrayData"
8196     matrix = view.ModelToViewTransform.ArrayData
8197     If Not MatrixUsable(matrix) Then Err.Raise 5, , "The drawing view transform is not a rotation"
8198     first = LBound(matrix)
8199     For i = 0 To 5
8200         ones = 0
8201         zeros = 0
8202         For j = 0 To 2
8203             If i < 3 Then
8204                 value = CDbl(matrix(first + 3 * i + j))
            Else
8206                 value = CDbl(matrix(first + 3 * j + (i - 3)))
            End If
8208             If Abs(Abs(value) - 1#) <= 0.000000001 Then ones = ones + 1
8209             If Abs(value) <= 0.000000001 Then zeros = zeros + 1
        Next j
8211         If ones <> 1 Or zeros <> 2 Then Err.Raise 5, , "The drawing view is not an axis-aligned view: its rotation is not a signed axis permutation: " & NumberList(matrix)
    Next i
8213     For i = 0 To 2
8214         If Abs(CDbl(matrix(first + 3 * i + 2))) > 0.5 Then ViewDrop = i
    Next i
End Function

Private Function ViewToModel(ByVal matrix As Variant, ByVal point As Variant) As Variant
    ' Undo IView.ModelToViewTransform: view = (model x R) * scale + t, R orthonormal.
    Dim first As Long, i As Long, j As Long, v(2) As Double, result(2) As Double
8221     first = LBound(matrix)
8222     For j = 0 To 2
8223         v(j) = (CDbl(point(j)) - CDbl(matrix(first + 9 + j))) / CDbl(matrix(first + 12))
    Next j
8225     For i = 0 To 2
8226         For j = 0 To 2
8227             result(i) = result(i) + v(j) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
8230     ViewToModel = Array(result(0), result(1), result(2))
End Function

Private Function RotateToModel(ByVal matrix As Variant, ByVal axis As Variant) As Variant
    ' A direction from view space to model space: the rotation of ViewToModel only, no scale and no translation.
    Dim first As Long, i As Long, j As Long, result(2) As Double
8236     first = LBound(matrix)
8237     For i = 0 To 2
8238         For j = 0 To 2
8239             result(i) = result(i) + CDbl(axis(j)) * CDbl(matrix(first + 3 * i + j))
        Next j
    Next i
8242     RotateToModel = Array(result(0), result(1), result(2))
End Function

