3890     original = originalMm * 0.001
3891     height = heightMm * 0.001
3892     Set lastDimension = DepthDimension(model, original)
    stepLabel = currentIdentity & ": PartConfiguration ConfigurationManager"
3894     Set configManager = model.ConfigurationManager
3895     Require configManager, "Configuration configManager unavailable"
    stepLabel = currentIdentity & ": PartConfiguration Name"
3897     defaultName = CStr(configManager.ActiveConfiguration.Name)
    ' The depth is the Z extent of the body: checked once in the original configuration, so a wrong axis assumption is an error, not a silent one.
3899     If Abs(PartDepthGeometry(model) - original) > 0.000001 Then Err.Raise 5, , "The part geometry is " & CStr(PartDepthGeometry(model)) & " m along Z in configuration " & defaultName & " but its extrusion depth is " & CStr(original) & " m: the depth is not the Z extent of its box"
    stepLabel = currentIdentity & ": PartConfiguration AddConfiguration"
3901     Set addedConfig = configManager.AddConfiguration(configName, "", "", 0, "", "")
3902     Require addedConfig, "AddConfiguration returned no configuration: name=" & configName
3903     SetDepth lastDimension, height, swSetValue_InSpecificConfigurations, configName
3904     tallDepth = ConfigurationDepth(model, lastDimension, configName)
3905     defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
3906     For route = 0 To 2
3907         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) > 0.000001 Then
            ' The new depth is right and the original is not: set the original back in its own configuration with a fresh handle.
3909             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3910             enteredFresh = True
3911             ActivateConfiguration model, defaultName, "the original configuration"
3912             SetDepth DepthDimension(model, -1#), original, swSetValue_InSpecificConfigurations, defaultName
3913             usedName = "config-dimension-fresh-handle"
3914             tallDepth = ConfigurationDepth(model, lastDimension, configName)
3915             defaultDepth = ConfigurationDepth(model, lastDimension, defaultName)
        End If
3917         If Abs(tallDepth - height) <= 0.000001 And Abs(defaultDepth - original) <= 0.000001 Then Exit For
3918         If route = 2 Then Err.Raise 5, , "Configuration depths read back " & configName & " " & CStr(tallDepth) & " m and " & defaultName & " " & CStr(defaultDepth) & " m (by the geometry), wanted " & CStr(height) & " and " & CStr(original) & ", after SetSystemValue3 for the specific configuration, for this configuration, with a fresh handle, and the original set back"
3919         If route = 0 Then
3920             If Not enteredThis Then RecordMitigation "config-dimension-this-configuration", True, True
3921             enteredThis = True
3922             ActivateConfiguration model, configName, "the new configuration"
3923             SetDepth lastDimension, height, swSetValue_InThisConfiguration, ""
3924             usedName = "config-dimension-this-configuration"
        Else
3926             If Not enteredFresh Then RecordMitigation "config-dimension-fresh-handle", True, True
3927             enteredFresh = True
3928             ActivateConfiguration model, configName, "the new configuration"
3929             SetDepth DepthDimension(model, -1#), height, swSetValue_InThisConfiguration, ""
3930             usedName = "config-dimension-fresh-handle"
