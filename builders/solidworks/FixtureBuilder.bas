6011         fallbackSuccesses("configuration-activate-after-add") = fallbackSuccesses("configuration-activate-after-add") + 1
    End If
6013     For Each item In targets
        ' Round 7: fetch the component again in the now-active configuration (the object from before the
        ' switch can be stale); if SetSuppression2 still fails, rebuild once and try again.
6016         instance = CStr(components(CStr(item)).Name2)
6017         statuses = ""
6018         For attempt = 0 To 1
6019             If attempt = 1 Then
6020                 RecordMitigation "configuration-suppress-rebuild", True, True
    stepLabel = currentIdentity & ": AddConfigurationState EditRebuild3"
6022                 statuses = statuses & "EditRebuild3 returned " & CStr(doc.EditRebuild3()) & "; "
            End If
    stepLabel = currentIdentity & ": AddConfigurationState ClearSelection2"
6025             doc.ClearSelection2 True
    stepLabel = currentIdentity & ": AddConfigurationState GetComponentByName"
