Public Sub main()
    Dim revision As String, pieces As Variant, version As String, build As String
    Dim target As String, folder As String, i As Long, attempt As Long
    Dim oldStep As Long, fs As Object, preferenceSet As Boolean
    Dim oldInput As Boolean, inputSaved As Boolean, oldRebuild As Boolean, rebuildSaved As Boolean
    Dim oldWarn As Boolean, warnSaved As Boolean, oldAction As Long, actionSaved As Boolean
    Dim finalMessage As String, fatalDescription As String, fatalStep As String
    Dim fatalNumber As Long, fatalLine As Long
    Dim finishText As String, launched As Boolean, zipMade As Boolean
    Dim noticeNote As String, sweepNotes As String, zipError As String, swept As Boolean
229     On Error GoTo Fatal
230     currentIdentity = "setup"
    ' First of all, before a preference is touched or a folder made: an output folder that carries a personal path is refused.
232     target = OUTPUT_FOLDER
233     If Len(target) = 0 Then target = DefaultOutputRoot()
234     finalMessage = PersonalPathReason(target)
235     If Len(finalMessage) > 0 Then GoTo Cleanup
    stepLabel = currentIdentity & ": main SldWorks"
237     Set app = Application.SldWorks
    ' The launcher sets LaunchedBy first and shows the finish text itself, so the builder stays quiet then.
239     launched = (GetSetting("DutchmanFixtures", "SolidWorksBuilder", "LaunchedBy", "") = "launcher")
    ' A template under a personal path is refused before anything is built (a drawing keeps the path of its template).
241     finalMessage = TemplateRefusal()
242     If Len(finalMessage) > 0 Then GoTo Cleanup
    ' The up-front notice, once per run (the launcher shows it itself): Cancel builds nothing.
244     noticeNote = NoticeStep(launched)
245     If Len(noticeNote) = 0 Then
246         finalMessage = "Canceled at the user name notice. Nothing was built."
247         GoTo Cleanup
    End If
249     For i = 2 To 5
250         rbStatus(i) = ""
    Next i
252     sweepEmptied = ""
253     sweepEmptiedCount = 0
254     sweepListFailed = False
255     sweepAnsiSkipped = False
    ' Ask once (a launcher macro normally sets RunMode first); the answer is remembered.
257     If Len(GetSetting("DutchmanFixtures", "SolidWorksBuilder", "RunMode", "")) = 0 Then
258         If MsgBox("Build only the recipes that haven't built yet on this SolidWorks version? (No = build everything)", vbYesNo + vbQuestion + vbDefaultButton1) = vbYes Then
259             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "left"
        Else
261             SaveSetting "DutchmanFixtures", "SolidWorksBuilder", "RunMode", "full"
        End If
    End If
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
265     oldInput = app.GetUserPreferenceToggle(swInputDimValOnCreate)
266     inputSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
268     app.SetUserPreferenceToggle swInputDimValOnCreate, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
270     oldRebuild = app.GetUserPreferenceToggle(swShowErrorsEveryRebuild)
271     rebuildSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
273     app.SetUserPreferenceToggle swShowErrorsEveryRebuild, False
    stepLabel = currentIdentity & ": main GetUserPreferenceToggle"
275     oldWarn = app.GetUserPreferenceToggle(swWarnSaveUpdateErrors)
276     warnSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceToggle"
278     app.SetUserPreferenceToggle swWarnSaveUpdateErrors, False
    stepLabel = currentIdentity & ": main GetUserPreferenceIntegerValue"
280     oldAction = app.GetUserPreferenceIntegerValue(swRebuildErrorAction)
281     actionSaved = True
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
283     If Not app.SetUserPreferenceIntegerValue(swRebuildErrorAction, swContinueResponse_Stop) Then Err.Raise 5, , "Cannot disable rebuild prompt"
    stepLabel = currentIdentity & ": main RevisionNumber"
285     revision = app.RevisionNumber()
286     pieces = Split(revision, ".")
287     swMajor = CLng(pieces(0))
288     version = CStr(CLng(pieces(0)) + 1992)
289     build = "0"
290     If UBound(pieces) > 0 Then
291         build = pieces(1)
292         For i = 2 To UBound(pieces)
293             build = build & "-" & pieces(i)
        Next i
    End If
296     Set fs = CreateObject("Scripting.FileSystemObject")
    ' SolidWorks' working directory is often its install folder, which is not writable; the default root is made when missing.
298     EnsureFolder fs, target
    ' Always a NEW folder: FixtureBuilder-SolidWorks-<version>, then -2, -3 ... Never deleted or reused.
300     root = "FixtureBuilder-SolidWorks-" & BUILDER_VERSION
    stepLabel = currentIdentity & ": main BuildPath"
302     folder = fs.BuildPath(target, root)
303     attempt = 1
    stepLabel = currentIdentity & ": main FolderExists"
305     Do While fs.FolderExists(folder) Or fs.FileExists(folder & ".zip")
306         attempt = attempt + 1
307         root = "FixtureBuilder-SolidWorks-" & BUILDER_VERSION & "-" & CStr(attempt)
    stepLabel = currentIdentity & ": main BuildPath"
309         folder = fs.BuildPath(target, root)
    Loop
    stepLabel = currentIdentity & ": main CreateFolder" & " " & apiInputs & " " & callInputs
312     fs.CreateFolder folder
    stepLabel = currentIdentity & ": main GetUserPreferenceIntegerValue"
314     oldStep = app.GetUserPreferenceIntegerValue(78)
315     preferenceSet = True
    stepLabel = currentIdentity & ": main SetUserPreferenceIntegerValue"
317     If Not app.SetUserPreferenceIntegerValue(78, 214) Then Err.Raise 5, , "Cannot set AP214"
